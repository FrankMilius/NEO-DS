{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-hint",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["form", "text", "help"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-hint-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-form-hint" },
    "slots": [
      { "name": "icon", "element": ".nc-form-hint__icon", "optional": true },
      { "name": "text", "element": ".nc-form-hint__text", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "Flexbox-Layout: Icon + Text nebeneinander, align-items: flex-start.",
      "Icon ist ein SVG (stroke-basiert, 1em), optisch via margin-top: 0.2em an Text ausgerichtet.",
      "Text erbt Styles vom Block (font-size, color, line-height).",
      "margin-block: gap oben, spacing-02 unten — Abstand zum Input und zum naechsten Element.",
      "Wird via aria-describedby am zugehoerigen Input verknuepft (id='hint-{name}').",
      "Kann vor oder nach dem Input im .nc-form-field Wrapper platziert werden."
    ]
  },

  "axes": {
    "content": {
      "label": "Content",
      "description": "Inhaltsvarianten — text-only (nur Text), with-icon (Info-Icon + Text)",
      "values": {
        "text-only": { "modifier": null, "tokenGroups": [], "renderHint": "form-hint-text" },
        "with-icon": { "modifier": null, "tokenGroups": [], "slotConfig": { "icon": true }, "renderHint": "form-hint-icon" }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Hint-Text wird via aria-describedby am Input referenziert (id='hint-{name}'). Rein informativ, kein role noetig. Icon ist dekorativ (aria-hidden='true')."
    },
    "overrides": []
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["aria-describedby"], "notes": ["Hint muss via aria-describedby mit dem zugehoerigen Input verknuepft sein."] }
    ],
    "copy": {
      "text": {
        "maxChars": 200,
        "note": "Hint soll kurze, hilfreiche Zusatzinformation zum Feld geben (Format, Beispiel, Einschraenkung)."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-form-hint"],
    "baseTokenGroups": ["core-geometry", "core-colors"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-form-hint-font-size",
          "nc-form-hint-gap"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-form-hint-color"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "text-only",
      "label": "Text Only",
      "description": "Hint nur mit Text (Standard)",
      "matrix": {
        "axes": { "content": ["text-only"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "text-only" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Sekundaere Textfarbe muss 4.5:1 Kontrast gegen Hintergrund haben."
      }
    },
    {
      "id": "with-icon",
      "label": "With Icon",
      "description": "Hint mit Info-Icon und Text",
      "matrix": {
        "axes": { "content": ["with-icon"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "with-icon" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon ist dekorativ (aria-hidden='true'). Icon-Farbe erbt vom Text — gleicher Kontrast."
      }
    },
    {
      "id": "content-variants",
      "label": "Content Variants",
      "description": "Text-only vs mit Icon im Vergleich",
      "matrix": {
        "axes": { "content": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "content" },
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Beide Varianten muessen gut lesbar sein. Icon verbessert Erkennbarkeit optional."
      }
    },
    {
      "id": "with-input-above",
      "label": "Below Input Field",
      "description": "Hint unterhalb eines Input-Feldes (typischer Anwendungsfall)",
      "composes": ["input"],
      "matrix": {
        "axes": { "content": ["text-only"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-hint-below-input", "label": "below input" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Input hat aria-describedby='hint-{name}', Hint hat id='hint-{name}'. Abstand via margin-block."
      }
    },
    {
      "id": "multi-line",
      "label": "Multi-Line Hint",
      "description": "Hint mit langem Text (mehrzeilig)",
      "matrix": {
        "axes": { "content": ["with-icon"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-hint-multiline", "label": "multi-line" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon bleibt oben ausgerichtet (flex-start), Text bricht um. line-height: 1.4 fuer Lesbarkeit."
      }
    },
    {
      "id": "in-form-field",
      "label": "In Form Field Context",
      "description": "Hint im .nc-form-field Wrapper zusammen mit Label, Input und Error",
      "composes": ["form-field", "input", "form-error"],
      "matrix": {
        "axes": { "content": ["text-only"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-complete", "label": "form-field" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Im Form-Field: aria-describedby verweist auf Hint UND Error (Leerzeichen-getrennt). Disabled-State graut Hint aus."
      }
    }
  ]
}
