{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "facts",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["display", "content", "data"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/facts-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-facts-block" },
    "slots": [
      { "name": "title", "element": ".nc-facts-title", "optional": true },
      { "name": "list", "element": ".nc-facts-list", "optional": false },
      { "name": "term", "element": ".nc-facts-term", "optional": false },
      { "name": "desc", "element": ".nc-facts-desc", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "Block: background-base, radius-xl, elevation-raised.",
      "List: CSS Grid 2-Spalten (auto 1fr). Term: semibold. Desc: text-secondary."
    ]
  },
  "axes": {
    "content": {
      "label": "Content",
      "description": "Inhalt — with-title, without-title",
      "values": {
        "with-title":    { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true }, "renderHint": "facts-with-title" },
        "without-title": { "modifier": null, "tokenGroups": [], "renderHint": "facts-without-title" }
      }
    }
  },
  "states": { "supported": ["default"], "precedence": ["default"], "rules": [], "interactive": false },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Semantisch: <dl> mit <dt>/<dd> Paaren. Titel als Heading."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["nc-facts-block"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "default", "label": "Facts Block",
      "description": "Fakten-Block mit Titel und Term/Desc Paaren",
      "matrix": { "axes": { "content": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "content" }, "render": { "label": "{content}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Term 4.5:1, Desc (text-secondary) 4.5:1 gegen background-base." }
    }
  ]
}
