{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "checkbox-group",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "form",
      "interactive",
      "grouping"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/checkbox-group-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "A: Neuer header-Slot fuer Select-All / Master-Checkbox mit Indeterminate-Support",
          "B: Size-Axis (sm/md/lg) koppelt Gap an Checkbox-Groesse — groessere Checkboxen = groesserer Abstand",
          "C: Neuer hint-Slot fuer Gruppen-Hilfetext (form-hint) mit aria-describedby",
          "D: Neue Tokens: nc-group-gap-sm, nc-group-gap-lg, nc-group-header-gap, nc-group-header-border, nc-group-hint-margin-top"
        ]
      }
    ],
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_checkbox-group.scss"
      ],
      "story": "stories/organisms/checkbox-group.stories.js",
      "arena": null,
      "drupal": [],
      "docs": "docs/checkbox-group-docs.html"
    },
    "dependencies": [
      "checkbox",
      "form"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-checkbox-group"
    },
    "slots": [
      {
        "name": "header",
        "element": ".nc-checkbox-group__header",
        "optional": true
      },
      {
        "name": "hint",
        "element": ".nc-checkbox-group__hint",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Flex-Column Container fuer mehrere .nc-checkbox Elemente.",
      "Gap via --nc-group-gap. Horizontal: flex-row, flex-wrap, --nc-group-gap-horizontal.",
      "Size-Modifier (--sm / --lg) koppelt Gap an Checkbox-Groesse: sm=8px, md=12px (default), lg=16px.",
      "Header-Slot: Enthaelt Master-Checkbox (.nc-checkbox) fuer Select-All. Separator via border-bottom.",
      "Master-Checkbox nutzt :indeterminate wenn nur Teilmenge ausgewaehlt (JS: input.indeterminate = true).",
      "Hint-Slot: Enthaelt .nc-form-hint fuer Gruppen-Hilfetext. Verknuepft via aria-describedby auf dem Gruppen-Container.",
      "Error: propagiert border-error auf alle Checkbox-Controls.",
      "Disabled: opacity + pointer-events:none auf gesamte Gruppe."
    ]
  },
  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Layout — vertical (Standard), horizontal (nebeneinander)",
      "values": {
        "vertical": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "checkbox-group-vertical"
        },
        "horizontal": {
          "modifier": "nc-checkbox-group--horizontal",
          "tokenGroups": [],
          "renderHint": "checkbox-group-horizontal"
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "Koppelt den Gruppen-Gap an die Checkbox-Groesse — sm (8px), md (12px, Standard), lg (16px)",
      "values": {
        "sm": {
          "modifier": "nc-checkbox-group--sm",
          "tokenGroups": [
            "group-geometry"
          ]
        },
        "md": {
          "modifier": null,
          "tokenGroups": [
            "group-geometry"
          ]
        },
        "lg": {
          "modifier": "nc-checkbox-group--lg",
          "tokenGroups": [
            "group-geometry"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "error",
      "disabled"
    ],
    "precedence": [
      "disabled",
      "error",
      "default"
    ],
    "rules": [
      {
        "state": "error",
        "unless": [
          "disabled"
        ],
        "note": "Error: border-error auf allen Checkbox-Controls. aria-describedby auf Error-Text."
      },
      {
        "state": "disabled",
        "unless": [],
        "note": "Disabled: opacity-disabled, pointer-events:none. Checkboxen zusaetzlich nativ disabled."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "role='group' + aria-labelledby auf Legend/Label. Einzelne Checkboxen haben eigene A11y."
    },
    "overrides": [
      {
        "when": {
          "states": [
            "error"
          ]
        },
        "suggest": [
          "aria-describedby"
        ],
        "note": "Error: aria-describedby auf Gruppen-Error-Text."
      },
      {
        "when": {
          "slots": [
            "header"
          ]
        },
        "suggest": [
          "aria-checked-mixed"
        ],
        "note": "Master-Checkbox im Header: Bei Teilauswahl input.indeterminate=true + aria-checked='mixed'. JS muss Zustand synchronisieren: alle gecheckt→checked, keins→unchecked, teilweise→indeterminate."
      },
      {
        "when": {
          "slots": [
            "hint"
          ]
        },
        "suggest": [
          "aria-describedby"
        ],
        "note": "Hint wird via aria-describedby auf dem Gruppen-Container verknuepft (id='hint-{groupname}')."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-group",
          "aria-labelledby"
        ],
        "notes": [
          "role='group' + aria-labelledby auf Legend oder Label."
        ]
      },
      {
        "when": {
          "slots": [
            "header"
          ]
        },
        "require": [
          "indeterminate-sync"
        ],
        "notes": [
          "JS muss Master-Checkbox Indeterminate-State synchronisieren: alle=checked, keins=unchecked, teilweise=indeterminate+aria-checked='mixed'."
        ]
      }
    ],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-checkbox-group"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "group-geometry": {
        "label": "Geometry (Gap)",
        "tokens": [
          "nc-group-gap",
          "nc-group-gap-sm",
          "nc-group-gap-lg",
          "nc-group-gap-horizontal"
        ]
      },
      "group-header": {
        "label": "Header (Select-All)",
        "tokens": [
          "nc-group-header-gap",
          "nc-group-header-border"
        ]
      },
      "group-hint": {
        "label": "Hint",
        "tokens": [
          "nc-group-hint-margin-top"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.layout.values.*.modifier",
        "axes.size.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "komposition": [
    { "art": "enthaelt", "recipe": "checkbox" }
  ],
  "specimens": [
    {
      "id": "layout-variants",
      "label": "Layout Variants",
      "description": "Vertical vs Horizontal",
      "matrix": {
        "axes": {
          "layout": "*",
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "layout"
      },
      "render": {
        "label": "{layout}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Beide Layouts: role='group'. Horizontal: wrap bei Platzmangel."
      }
    },
    {
      "id": "size-comparison",
      "label": "Size × Gap",
      "description": "Gap-Abstufung gekoppelt an Checkbox-Groesse: sm (8px), md (12px), lg (16px)",
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "size": "*"
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "group-geometry"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Groessere Checkboxen brauchen proportional mehr Abstand fuer Touch-Targets."
      }
    },
    {
      "id": "select-all",
      "label": "Select-All (Master-Checkbox)",
      "description": "Header mit Master-Checkbox: unchecked (keins), indeterminate (teilweise), checked (alle)",
      "composes": [
        "checkbox"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "group-header"
      ],
      "layout": "row",
      "render": {
        "compositionType": "checkbox-group-select-all",
        "label": "select-all"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Master-Checkbox: aria-checked='mixed' im Indeterminate-State. Screen Reader muessen 'teilweise ausgewaehlt' ankuendigen."
      }
    },
    {
      "id": "with-hint",
      "label": "With Group Hint",
      "description": "Gruppen-Hilfetext unterhalb der Optionen via form-hint",
      "composes": [
        "checkbox",
        "form-hint"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "group-hint"
      ],
      "layout": "row",
      "render": {
        "compositionType": "checkbox-group-with-hint",
        "label": "with-hint"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hint via aria-describedby auf dem Gruppen-Container verknuepft."
      }
    },
    {
      "id": "states",
      "label": "States",
      "description": "Default, Error, Disabled",
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "size": [
            "md"
          ]
        },
        "states": [
          "default",
          "error",
          "disabled"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Error: border-error sichtbar. Disabled: opacity-disabled."
      }
    }
  ]
}
