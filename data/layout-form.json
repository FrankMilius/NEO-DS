{
  "$schema": "./layout-spec-schema.json",
  "meta": {
    "id": "layout-form",
    "label": "Form",
    "description": "Zentriertes Layout fuer Formulare und Einstellungen. Schmaler Container, Standard-Gap, Standard-Padding.",
    "tags": ["form", "settings", "input"],
    "templateClass": ".t-form"
  },
  "container": {
    "ref": "container.narrow",
