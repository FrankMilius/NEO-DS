{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "icon",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["static", "visual", "icon"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/icon-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".icon" },
    "slots": [],
    "convenience": [],
    "domNotes": [
      "Icon ist ein <span class='icon'> mit inline SVG als Kind-Element.",
      "Default-Groesse: sm (20px). Kein md-Default — sm ist der Standard.",
      "SVG nutzt fill: currentColor — Farbe wird via CSS color gesteuert.",
      "Nicht-BEM Konvention: .icon statt .nc-icon (historisch gewachsen).",
      "Deprecated: .icon--2xs (12px, altes xs), .icon--high/--mid/--low (alte Farbnamen).",
      "Interactive-Modifier (.icon--interactive): min 44x44px Touch-Target via Padding, hover + focus-ring.",
      "Interactive Icons brauchen ein umschliessendes <button> oder role='button' + tabindex.",
      "Icon-Logo (.icon-logo): Spezialfall mit fester Groesse 88x22px."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "7 Groessenabstufungen — 2xs (12px, deprecated) / xs (16px) / sm (20px, Standard) / md (24px) / lg (28px) / xl (32px) / 2xl (36px)",
      "values": {
        "xs":  { "modifier": "icon--xs",  "tokenGroups": [] },
        "sm":  { "modifier": "icon--sm",  "tokenGroups": [] },
        "md":  { "modifier": "icon--md",  "tokenGroups": [] },
        "lg":  { "modifier": "icon--lg",  "tokenGroups": [] },
        "xl":  { "modifier": "icon--xl",  "tokenGroups": [] },
        "2xl": { "modifier": "icon--2xl", "tokenGroups": [] }
      }
    },

    "color": {
      "label": "Color",
      "description": "Semantische Farb-Variante — primary (Standard), secondary, tertiary, inverse, disabled",
      "values": {
        "primary":   { "modifier": "icon--primary",   "tokenGroups": [] },
        "secondary": { "modifier": "icon--secondary",  "tokenGroups": [] },
        "tertiary":  { "modifier": "icon--tertiary",   "tokenGroups": [] },
        "inverse":   { "modifier": "icon--inverse",    "tokenGroups": [] },
        "disabled":  { "modifier": "icon--disabled",   "tokenGroups": [] }
      }
    },

    "interactive": {
      "label": "Interactive",
      "description": "Interaktivitaet — none (Standard, rein dekorativ), interactive (Touch-Target 44px, hover, focus-ring)",
      "values": {
        "none":        { "modifier": null,                "tokenGroups": [] },
        "interactive": { "modifier": "icon--interactive", "tokenGroups": ["touch-target"] }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus"],
    "precedence": ["focus", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": [],       "note": "Hover nur auf interactive Icons (via --interactive Modifier)" },
      { "state": "focus", "unless": [],       "note": "Focus-Ring nur auf interactive Icons (:focus-visible)" }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [],
      "note": "Dekorative Icons sind aria-hidden='true'. Informative Icons brauchen aria-label oder role='img' + aria-label. Interactive Icons brauchen ein umschliessendes <button> oder role='button'."
    },
    "overrides": [
      {
        "when": { "axes": { "interactive": ["interactive"] } },
        "require": ["hasAccessibleName", "supportsKeyboard"],
        "note": "Interactive Icons brauchen aria-label und muessen tastaturzugaenglich sein. Touch-Target mindestens 44x44px (WCAG 2.5.5)."
      },
      {
        "when": { "axes": { "color": ["inverse"] } },
        "suggest": [],
        "note": "Inverse Icons brauchen dunklen Hintergrund fuer 3:1 Kontrast."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "interactive": ["interactive"] } }, "require": ["accessible-name", "keyboard-support"], "notes": ["Interactive Icons brauchen aria-label und Keyboard-Support."] }
    ],
    "copy": {}
  },

  "styling": {
    "baseClasses": ["icon"],
    "baseTokenGroups": ["core-sizing", "core-colors"],

    "tokenGroups": {
      "core-sizing": {
        "label": "Sizing",
        "tokens": [
          "nc-icon-size-xs",
          "nc-icon-size-sm",
          "nc-icon-size-md",
          "nc-icon-size-lg",
          "nc-icon-size-xl",
          "nc-icon-size-2xl"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-icon-color-default",
          "nc-icon-color-secondary",
          "nc-icon-color-tertiary",
          "nc-icon-color-inverse",
          "nc-icon-color-disabled"
        ]
      },
      "touch-target": {
        "label": "Touch Target",
        "tokens": [
          "nc-icon-touch-target"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.color.values.*.modifier",
        "axes.interactive.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "size-scale",
      "label": "Size Scale — XS to 2XL",
      "description": "Alle 6 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "color": ["primary"], "interactive": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-sizing"],
      "layout": "row",
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Icons muessen 3:1 Kontrast gegen den Hintergrund haben. Groesse beeinflusst nicht den Kontrast."
      }
    },
    {
      "id": "color-variants",
      "label": "Color Variants",
      "description": "Alle 5 semantischen Farben in MD-Groesse",
      "matrix": {
        "axes": { "size": ["md"], "color": "*", "interactive": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-colors"],
      "layout": "row",
      "render": { "label": "{color}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Primary, Secondary, Tertiary muessen 3:1 auf hellem BG einhalten. Inverse braucht dunklen BG. Disabled ist bewusst unter 3:1."
      }
    },
    {
      "id": "inverse-on-dark",
      "label": "Inverse on Dark Background",
      "description": "Inverse-Farbe auf dunklem Hintergrund",
      "matrix": {
        "axes": { "size": ["sm", "md", "lg"], "color": ["inverse"], "interactive": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{size}", "bgVariant": "dark" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Weisses Icon auf dunklem BG. Muss 3:1 Kontrast einhalten."
      }
    },
    {
      "id": "interactive-states",
      "label": "Interactive Icon States",
      "description": "Interactive Icon mit Touch-Target, Hover und Focus",
      "matrix": {
        "axes": { "size": ["md"], "color": ["primary"], "interactive": ["interactive"] },
        "states": ["default", "hover", "focus"]
      },
      "focusTokenGroups": ["touch-target"],
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Touch-Target mindestens 44x44px. Hover zeigt background-secondary. Focus braucht sichtbaren Ring."
      }
    },
    {
      "id": "interactive-sizes",
      "label": "Interactive — All Sizes",
      "description": "Interactive Icons in verschiedenen Groessen — Touch-Target bleibt 44px",
      "matrix": {
        "axes": { "size": "*", "color": ["primary"], "interactive": ["interactive"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["touch-target", "core-sizing"],
      "layout": "row",
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Padding passt sich an Groesse an, sodass Touch-Target immer 44px bleibt. Kleine Icons haben mehr Padding."
      }
    },
    {
      "id": "in-context",
      "label": "Icon in Text",
      "description": "Icons inline neben Text-Elementen",
      "composes": ["text"],
      "matrix": {
        "axes": { "size": ["sm"], "color": ["primary", "secondary"], "interactive": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "icon-in-text", "label": "{color}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Inline-Icons sind aria-hidden='true' wenn der begleitende Text die Bedeutung traegt. flex-shrink: 0 verhindert Quetschen."
      }
    }
  ]
}
