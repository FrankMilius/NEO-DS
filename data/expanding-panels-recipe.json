      {
        "version": "1.1.0",
        "changes": [
          "06.10.2026 (Plan v3, Phase 4, duenne Recipes): Specimen ohne-deko (Slots num und bg aus); default beschreibt die Zustaende (Standard ohne Skript, Geoeffnet wie auf der Website)"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiale Implementierung: horizontale Panels, die bei Hover/Fokus/Aktiv expandieren (flex-grow)",
          "Vertikales Label im Ruhezustand, das beim Expandieren ausgeblendet wird; Body fadet ein",
          "Single-Open Verhalten: das aktive Panel hat aria-expanded='true', alle anderen 'false'",
          "Panel ist ein <button> fuer native Tastatur-/Fokus-Semantik (Enter/Space, ArrowLeft/Right)",
          "Mobil (820px): vertikales Akkordeon, Label horizontal",
          "Token-gesteuert ueber --nc-expanding-panels-* mit --mod-* Override und Foundation-Fallback"
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_expanding-panels.scss"
      ],
      "story": "stories/organisms/expanding-panels.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [
        "block--block-content--neo-expanding-panels.html.twig",
        "block--inline-block--neo-expanding-panels.html.twig"
      ],
      "docs": null
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-expanding-panels"
    },
    "slots": [
      {
        "name": "panel",
        "element": ".nc-expanding-panels__panel",
        "optional": false,
        "description": "Einzelnes Panel. <button> mit aria-expanded. Expandiert bei Hover/Fokus/Aktiv via flex-grow."
      },
      {
        "name": "label",
        "element": ".nc-expanding-panels__label",
        "optional": false,
        "description": "Vertikales Label im Ruhezustand. Wird beim Expandieren ausgeblendet."
      },
      {
        "name": "num",
        "element": ".nc-expanding-panels__num",
        "optional": true,
        "description": "Laufende Nummer oben links."
      },
      {
        "name": "body",
        "element": ".nc-expanding-panels__body",
        "optional": false,
        "description": "Detail-Inhalt, sichtbar wenn Panel aktiv. Enthaelt Chip, Titel, Text."
      },
      {
        "name": "bg",
        "element": ".nc-expanding-panels__bg",
        "optional": true,
        "description": "Dekorativer Radial-Hintergrund pro Panel. aria-hidden."
      }
    ],
    "domNotes": [
      "Root .nc-expanding-panels: display:flex, gap, feste Hoehe (--nc-expanding-panels-height).",
      "Panel: button[aria-expanded], flex:1; bei :hover/:focus-within/[aria-expanded=true] flex-grow:--nc-expanding-panels-grow.",
      "Label (.nc-expanding-panels__label): writing-mode:vertical-rl + rotate(180deg); opacity:0 wenn Panel aktiv.",
      "Body (.nc-expanding-panels__body): position:absolute, justify-content:flex-end; opacity:0/translateY bis aktiv.",
      "Chip im Body: margin-bottom:auto schiebt ihn nach oben.",
      "Single-Open: JS setzt aria-expanded='true' am geklickten Panel, 'false' an allen anderen; initial erstes Panel aktiv.",
      "Tastatur: Enter/Space aktiviert (nativer Button-Klick); ArrowLeft/Right wechselt das aktive Panel.",
      "Responsive 820px: flex-direction:column (vertikales Akkordeon); Label horizontal; Body zentriert.",
      "prefers-reduced-motion: keine Transitions."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Einzige Variante",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "xpanels-default"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus",
      "open"
    ],
    "precedence": [
      "open",
      "focus",
      "hover",
      "default"
    ],
    "rules": [],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Panels sind <button> mit aria-expanded. Sichtbarer Fokusring. Body-Titel als h3 (Sektions-h2 davor). Hintergrund-Layer dekorativ. Keyboard: Enter/Space aktiviert, ArrowLeft/Right navigiert."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-button",
          "aria-expanded",
          "keyboard-navigation"
        ],
        "notes": [
          "Disclosure-Pattern: jedes Panel ist ein Button mit aria-expanded; genau eines ist offen (single-open)."
        ]
      }
    ]
  },
  "styling": {
    "baseClasses": [
      "nc-expanding-panels"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-expanding-panels-gap",
          "nc-expanding-panels-height",
          "nc-expanding-panels-radius",
          "nc-expanding-panels-grow"
        ]
      },
      "surface": {
        "label": "Surface & Border",
        "tokens": [
          "nc-expanding-panels-surface",
          "nc-expanding-panels-border"
        ]
      },
      "accent": {
        "label": "Accent & Text",
        "tokens": [
          "nc-expanding-panels-accent",
          "nc-expanding-panels-title",
          "nc-expanding-panels-text"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "default",
      "label": "Expanding Panels",
      "description": "Vier horizontale Panels. Standard: alle zu (ohne Skript); Geöffnet: erstes Panel offen, so startet die Website. Hover und Fokus erweitern per CSS.",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default",
          "open"
        ]
      },
      "focusTokenGroups": [
        "layout",
        "surface",
        "accent"
      ],
      "layout": "row",
      "render": {
        "compositionType": "expanding-panels",
        "label": "horizontal expand"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label und Body-Text 4.5:1 gegen Surface."
      }
    },
    {
      "id": "ohne-deko",
      "label": "Ohne Nummer und Hintergrund",
      "description": "Optionale Slots num und bg aus.",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "open"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "expanding-panels",
        "label": "ohne num/bg",
        "slotConfig": {
          "num": false,
          "bg": false
        }
      }
    }
  ]
}