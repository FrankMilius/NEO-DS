{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "pricing",
    "version": "1.1.0",
    "status": "stable",
    "tags": [
      "display",
      "content",
      "commerce"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/pricing-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_pricing.scss"
      ],
      "story": "stories/organisms/pricing.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/pricing-docs.html"
    },
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Specimen raster (drei Karten in nc-pricing-grid aus 04-objects/_section.scss, die mittlere is-featured); Vorlage ohne die Inline-Polsterung/-Rahmen der Doku-Ernte — sichtbar wird, was styles.css gestaltet",
          "Befund (Entscheidungsfall, website-sichtbar): .nc-pricing-card hat weder Polsterung noch Rahmen, .is-featured setzt nur border-color — der Akzentrahmen aus der Anatomie erscheint nicht",
          "pipeline.arena zeigt auf die RecipeArena"
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-pricing-card"
    },
    "slots": [
      {
        "name": "price",
        "element": ".nc-price",
        "optional": false
      },
      {
        "name": "feature-list",
        "element": ".nc-pricing-features",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Card: background-base, radius-xl, elevation-raised.",
      "Featured (.is-featured): accent Border, elevation-floating.",
      "Price: font-heading, fs-xl. Feature-List: Checkmark-Icon, accent-Farbe."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Variante — default, featured",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "pricing-default"
        },
        "featured": {
          "modifier": "is-featured",
          "tokenGroups": [],
          "renderHint": "pricing-featured"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Preis und Features muessen als Text lesbar sein. Featured visuell hervorgehoben."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-pricing-card"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": []
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison",
      "label": "Pricing Variants",
      "description": "Default vs Featured",
      "matrix": {
        "axes": {
          "variant": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Featured: accent Border 3:1 gegen BG."
      }
    },
    {
      "id": "raster",
      "label": "Tarif-Raster",
      "description": "Drei Tarife im Seitenraster nc-pricing-grid, der mittlere hervorgehoben (is-featured)",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "composition",
      "render": {
        "compositionType": "raster"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hervorhebung nicht nur ueber Farbe: der Tarif braucht einen Hinweis im Text (z. B. „Empfohlen“), den das DS nicht vorgibt."
      }
    }
  ]
}
