{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "marquee",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["display", "animation", "decorative"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/marquee-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-marquee" },
    "slots": [
      { "name": "track", "element": ".nc-marquee__track", "optional": false },
      { "name": "text", "element": ".nc-marquee__text", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "Overflow:hidden Container. Track: inline-flex, gap 2.5rem, will-change:transform.",
      "Text: uppercase, letter-spacing 0.08em, clamp font-size."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Einzige Variante",
      "values": {
        "default": { "modifier": null, "tokenGroups": [], "renderHint": "marquee-default" }
      }
    }
  },
  "states": { "supported": ["default"], "precedence": ["default"], "rules": [], "interactive": false },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Dekorativ. prefers-reduced-motion: Animation stoppen. Inhalt alternativ als statischer Text."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["nc-marquee"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "default", "label": "Marquee",
      "description": "Horizontaler Lauftext/Logo-Ticker",
      "matrix": { "axes": { "variant": ["default"] }, "states": ["default"] },
      "layout": "row", "render": { "label": "marquee" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Reduced Motion: Animation stoppen." }
    }
  ]
}
