{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "badge",
    "version": "2.2.0",
    "status": "stable",
    "tags": ["static", "indicator", "label"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/badge-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-badge" },
    "slots": [
      { "name": "icon", "element": ".nc-badge__icon", "optional": true },
      { "name": "label", "element": ".nc-badge__label", "optional": false }
    ],
    "domNotes": [
      "Badge ist NIEMALS fokussierbar — immer <span>, kein role='button', kein tabindex.",
      "Farbe nie als einziges Signal verwenden — immer mit Text oder Icon kombinieren.",
      "Dot-Mode: slot-loses Display, zeigt nur Farbe ohne Text. Benoetigt begleitendes aria-label.",
      "Counter-Mode: numerischer Inhalt mit min-width fuer gleichmaessige Kreise.",
      "Decorator-Mode: position:absolute auf Parent (braucht position:relative). Ring-Shadow fuer Abgrenzung.",
      "Pulse-Animation: --dot.--pulse fuer kritische Status (error). Dezentes Pulsieren.",
      "Status-String: --status-string — reiner Text ohne BG, fuer Tabellen / dichte UIs."
    ]
  },

  "axes": {
    "tone": {
      "label": "Tone",
      "description": "Farb-Semantik der Badge",
      "values": {
        "default":   { "modifier": null,                  "tokenGroups": ["tone-default"] },
        "secondary": { "modifier": "nc-badge--secondary", "tokenGroups": ["tone-secondary"] },
        "success":   { "modifier": "nc-badge--success",   "tokenGroups": ["tone-success"] },
        "warning":   { "modifier": "nc-badge--warning",   "tokenGroups": ["tone-warning"] },
        "error":     { "modifier": "nc-badge--error",     "tokenGroups": ["tone-error"] },
        "info":      { "modifier": "nc-badge--info",      "tokenGroups": ["tone-info"] }
      }
    },
    "emphasis": {
      "label": "Emphasis",
      "description": "Visuelle Gewichtung — Solid (Standard), Outline (Rand), Soft (reduzierte Deckkraft)",
      "values": {
        "solid":   { "modifier": null,                "tokenGroups": [] },
        "outline": { "modifier": "nc-badge--outline", "tokenGroups": ["emphasis-outline"] },
        "soft":    { "modifier": "nc-badge--soft",    "tokenGroups": ["emphasis-soft"] }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groessenabstufung — SM (20px) / MD (24px, Standard)",
      "values": {
        "sm": { "modifier": "nc-badge--sm", "tokenGroups": [] },
        "md": { "modifier": null,           "tokenGroups": [] }
      }
    },
    "decorator": {
      "label": "Decorator",
      "description": "Zusaetzliche visuelle Elemente oder Render-Modi",
      "values": {
        "none":    { "modifier": null,            "tokenGroups": [] },
        "icon":    { "modifier": null,            "tokenGroups": ["core-extras"], "slotConfig": { "icon": true } },
        "dot":     { "modifier": "nc-badge--dot", "tokenGroups": ["core-extras"], "excludeAxes": ["size"] },
        "counter":       { "modifier": null,                        "tokenGroups": ["core-extras"], "renderHint": "counter" },
        "decorator":     { "modifier": "nc-badge--decorator",      "tokenGroups": ["positioning"] },
        "pulse":         { "modifier": "nc-badge--dot nc-badge--pulse", "tokenGroups": ["core-extras", "pulse"], "excludeAxes": ["size"] },
        "status-string": { "modifier": "nc-badge--status-string",  "tokenGroups": ["status-string"], "excludeAxes": ["size", "emphasis"] }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "doNotRelyOnColorOnly"],
      "note": "Badge ist nicht interaktiv. Farbe nie als einziges Signal verwenden — immer mit Text oder Icon kombinieren."
    },
    "overrides": [
      {
        "when": { "axes": { "decorator": ["dot"] } },
        "require": ["aria-label"],
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Dot-Mode benoetigt immer ein begleitendes Text-Label oder aria-label. Dot allein ist nicht zugaenglich."
      },
      {
        "when": { "axes": { "decorator": ["counter"] } },
        "suggest": ["aria-label"],
        "note": "Counter zeigt visuell '99+', aber aria-label muss den echten Wert enthalten (z.B. aria-label='142 Benachrichtigungen')."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "decorator": ["dot"] } }, "require": ["aria-label"], "notes": ["Dot-Mode benoetigt aria-label oder begleitendes Text-Label."] },
      { "when": { "axes": { "decorator": ["counter"] } }, "suggest": ["aria-label"], "notes": ["Counter-Overflow (99+) muss echten Wert im aria-label haben."] }
    ],
    "copy": {
      "label": {
        "maxChars": 20,
        "truncation": "ellipsis",
        "note": "Labels ueber 20 Zeichen werden mit text-overflow: ellipsis abgeschnitten. Kurze, praegnante Labels bevorzugen."
      },
      "counter": {
        "maxValue": 99,
        "overflowLabel": "99+",
        "note": "Numerische Werte ueber 99 werden als '99+' dargestellt."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-badge"],
    "baseTokenGroups": ["core-geometry", "core-typography"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-badge-height-sm",
          "nc-badge-height-md",
          "nc-badge-radius",
          "nc-badge-padding-x-sm",
          "nc-badge-padding-x-md",
          "nc-badge-gap"
        ]
      },
      "core-typography": {
        "label": "Typography",
        "tokens": [
          "nc-badge-font-size-sm",
          "nc-badge-font-size-md",
          "nc-badge-font-weight",
          "nc-badge-letter-spacing",
          "nc-badge-line-height",
          "nc-badge-label-max-width"
        ]
      },
      "core-extras": {
        "label": "Extras (Dot / Icon)",
        "tokens": [
          "nc-badge-dot-size",
          "nc-badge-dot-radius",
          "nc-badge-icon-size"
        ]
      },
      "tone-default": {
        "label": "Default",
        "tokens": ["nc-badge-default-bg", "nc-badge-default-color", "nc-badge-default-border"]
      },
      "tone-secondary": {
        "label": "Secondary",
        "tokens": ["nc-badge-secondary-bg", "nc-badge-secondary-color", "nc-badge-secondary-border"]
      },
      "tone-success": {
        "label": "Success",
        "tokens": ["nc-badge-success-bg", "nc-badge-success-color", "nc-badge-success-border"]
      },
      "tone-warning": {
        "label": "Warning",
        "tokens": ["nc-badge-warning-bg", "nc-badge-warning-color", "nc-badge-warning-border"]
      },
      "tone-error": {
        "label": "Error",
        "tokens": ["nc-badge-error-bg", "nc-badge-error-color", "nc-badge-error-border"]
      },
      "tone-info": {
        "label": "Info",
        "tokens": ["nc-badge-info-bg", "nc-badge-info-color", "nc-badge-info-border"]
      },
      "emphasis-outline": {
        "label": "Outline",
        "tokens": ["nc-badge-outline-bg", "nc-badge-outline-color", "nc-badge-outline-border", "nc-badge-border-width"]
      },
      "emphasis-soft": {
        "label": "Soft",
        "tokens": ["nc-badge-soft-opacity"]
      },
      "positioning": {
        "label": "Positioning (Decorator)",
        "tokens": ["nc-badge-top-offset", "nc-badge-right-offset", "nc-badge-ring-width", "nc-badge-ring-color"]
      },
      "pulse": {
        "label": "Pulse Animation",
        "tokens": ["nc-badge-pulse-duration", "nc-badge-pulse-scale", "nc-badge-pulse-opacity"]
      },
      "status-string": {
        "label": "Status String",
        "tokens": ["nc-badge-status-font-weight"]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.tone.values.*.modifier",
        "axes.emphasis.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.decorator.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "variants",
      "label": "All Variants — MD",
      "description": "Alle Tone-Varianten in Standardgroesse",
      "matrix": {
        "axes": { "tone": "*", "emphasis": ["solid"], "size": ["md"], "decorator": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{tone}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "doNotRelyOnColorOnly": true,
        "note": "Jede Farbvariante muss zusaetzlich durch Text unterscheidbar sein."
      }
    },
    {
      "id": "emphasis-grid",
      "label": "Emphasis × Tone",
      "description": "Solid, Outline und Soft je Tone — visuelles QA-Grid",
      "matrix": {
        "axes": { "tone": "*", "emphasis": "*", "size": ["md"], "decorator": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["tone-default", "tone-secondary", "tone-success", "tone-warning", "tone-error", "tone-info", "emphasis-outline", "emphasis-soft"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "tone", "colAxis": "emphasis" },
      "render": { "label": "{tone}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Outline und Soft Varianten muessen ebenfalls 4.5:1 Kontrast einhalten. Soft-BG darf Lesbarkeit nicht beeintraechtigen."
      }
    },
    {
      "id": "sizes",
      "label": "Size Scale — SM / MD",
      "description": "Jede Variante in SM und MD",
      "matrix": {
        "axes": { "tone": "*", "emphasis": ["solid"], "size": "*", "decorator": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-geometry", "core-typography"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "tone", "colAxis": "size" },
      "render": { "label": "{tone}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "SM-Variante (11px) muss Mindestkontrast einhalten. font-size unter 14px erfordert 4.5:1."
      }
    },
    {
      "id": "with-icon",
      "label": "With Icon",
      "description": "Leading-Icon je nach Variante",
      "matrix": {
        "axes": { "tone": "*", "emphasis": ["solid"], "size": ["md"], "decorator": ["icon"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{tone}", "icon": "{tone}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon ist dekorativ (aria-hidden='true'). Label traegt die Bedeutung."
      }
    },
    {
      "id": "dot-mode",
      "label": "Dot Mode",
      "description": "Status-Kreise pro Variante",
      "matrix": {
        "axes": { "tone": "*", "emphasis": ["solid"], "decorator": ["dot"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-extras", "tone-default", "tone-secondary", "tone-success", "tone-error", "tone-info", "tone-warning"],
      "layout": "row",
      "render": { "label": "{tone}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "doNotRelyOnColorOnly": true,
        "roleSuggestion": "role=\"status\" aria-label=\"Online\"",
        "note": "Dot-Mode benoetigt immer ein begleitendes Text-Label oder aria-label. Dot allein ist nicht zugaenglich — Farbe ist nie der einzige Indikator."
      }
    },
    {
      "id": "counters",
      "label": "Counter Badges",
      "description": "Notification Counts — Default und Error",
      "matrix": {
        "axes": { "tone": ["default", "error"], "emphasis": ["solid"], "size": ["sm"], "decorator": ["counter"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "tone" },
      "render": { "counterValues": ["1", "9", "99", "99+"] },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "roleSuggestion": "aria-label=\"{n} Benachrichtigungen\"",
        "note": "Visuell '99+', aber aria-label muss den echten Wert enthalten (z.B. aria-label='142 Benachrichtigungen'). Counter ohne Kontext-Element (z.B. Icon-Button) ist nicht zugaenglich."
      }
    },
    {
      "id": "on-avatar",
      "label": "Badge on Avatar",
      "description": "Integration mit Avatar-Komponente",
      "composes": ["avatar"],
      "matrix": {
        "axes": { "tone": ["success", "error", "info"], "emphasis": ["solid"], "size": ["sm"], "decorator": ["counter"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "avatar-badge", "counterValues": ["3", "99+", "New"] },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "roleSuggestion": "aria-label=\"{name}, {n} Benachrichtigungen\"",
        "note": "Badge-Inhalt muss im aria-label des umschliessenden Avatar-Elements enthalten sein. Nicht als eigenstaendiges interaktives Element verwenden."
      }
    },
    {
      "id": "decorator-on-icon",
      "label": "Decorator (Badge on Icon)",
      "description": "Absolute positioniertes Badge auf Icon-Button mit Ring-Abgrenzung",
      "composes": ["icon"],
      "matrix": {
        "axes": { "tone": ["error"], "emphasis": ["solid"], "size": ["sm"], "decorator": ["decorator"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["positioning"],
      "layout": "row",
      "render": { "compositionType": "icon-badge", "counterValues": ["3", "99+"] }
    },
    {
      "id": "pulse-dots",
      "label": "Pulse Dots (Critical Status)",
      "description": "Pulsierende Dots fuer kritische Status-Anzeige",
      "matrix": {
        "axes": { "tone": ["error", "warning", "success"], "emphasis": ["solid"], "decorator": ["pulse"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["pulse", "core-extras"],
      "layout": "row",
      "render": { "label": "{tone}" },
      "a11y": {
        "note": "prefers-reduced-motion deaktiviert die Pulse-Animation automatisch."
      }
    },
    {
      "id": "status-strings",
      "label": "Status Strings (Table Context)",
      "description": "Reiner Text ohne BG — fuer Tabellenzellen und dichte UIs",
      "matrix": {
        "axes": { "tone": ["success", "warning", "error", "info"], "decorator": ["status-string"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["status-string"],
      "layout": "row",
      "render": { "labels": ["Active", "Pending", "Failed", "Draft"] }
    }
  ]
}
