{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "toggle-group",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "selection",
      "group",
      "toolbar",
      "multi-select"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/toggle-group-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "Soft-Variante: Helle Markenfarbe fuer Selected (weniger dominant als filled)",
          "Underline-Indicator: Dicke Linie unter dem gewaehlten Item (tab-aehnlich, ideal fuer single-select)",
          "Equal-Width-Modus: Alle Items exakt gleich breit (flex: 1) fuer visuelle Ruhe",
          "Divider-Modifier: Subtile vertikale Trennlinien (50% Hoehe) statt voller Border-Linien",
          "Container-Shadow-Token: Optionaler Schatten fuer Filled-Variante",
          "Neue Tokens: soft-bg, soft-color, underline-width, underline-color, divider-width/height/color, shadow",
          "prefers-reduced-motion: Transitions werden deaktiviert",
          "Abgrenzung zu Segmented Control: Toggle-Group = multi-select/toolbar-optimiert, Segmented Control = single-select/navigation"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiales Recipe: filled/outline, single/multiple, 3 Groessen, icon-text/icon-only"
        ]
      }
    ],
    "layer": "atom",
    "pipeline": {
      "scss": [
        "scss/scss/05-atoms/_toggle-group.scss"
      ],
      "story": "stories/organisms/toggle-group.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": null
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-toggle-group"
    },
    "slots": [
      {
        "name": "item",
        "element": ".nc-toggle-group__item",
        "optional": false
      },
      {
        "name": "icon",
        "element": ".nc-toggle-group__icon",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Container ist ein <div class='nc-toggle-group'>.",
      "Items sind <button class='nc-toggle-group__item'>.",
      "Single-Select: role='radiogroup' auf Container, role='radio' + aria-checked auf Items. Arrow-Key Navigation (roving tabindex).",
      "Multi-Select: role='group' auf Container, aria-pressed='true'/'false' auf Items. Tab-Navigation zwischen Items.",
      "Items haben keinen eigenen border-radius — Container hat overflow: hidden + border-radius.",
      "Divider-Modifier (--divider): Subtile vertikale Trennlinien via ::before (50% Hoehe, margin-block: auto). Moderner als volle Border-Linien. Divider wird bei selected-Nachbar ausgeblendet.",
      "Underline-Modifier (--underline): Container hat keinen Rahmen/BG, nur border-block-end. Selected-Item bekommt ::after Underline.",
      "Soft-Variante (--soft): Selected = helle Markenfarbe (12% interactive via color-mix). Weniger dominant als filled.",
      "Equal-Width (--equal): flex: 1 auf Items. Alle gleich breit.",
      "Groessen-Modifier am Container (--sm, --lg) propagieren zu allen Items.",
      "Icon-only Items brauchen aria-label fuer Accessibility.",
      "Abgrenzung zu Segmented Control: Toggle-Group primaer fuer multi-select Toolbars. Segmented Control fuer single-select Navigation mit Sliding Indicator."
    ]
  },
  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px). Nutzt Button-Size-Tokens.",
      "values": {
        "sm": {
          "modifier": "nc-toggle-group--sm",
          "tokenGroups": []
        },
        "md": {
          "modifier": null,
          "tokenGroups": []
        },
        "lg": {
          "modifier": "nc-toggle-group--lg",
          "tokenGroups": []
        }
      }
    },
    "type": {
      "label": "Type",
      "description": "Auswahl-Modus — single (Radio-Pattern, genau 1 selektiert), multiple (Toggle-Pattern, 0–n selektiert)",
      "values": {
        "single": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "toggle-single",
          "elementHint": "radiogroup"
        },
        "multiple": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "toggle-multiple",
          "elementHint": "group"
        }
      }
    },
    "variant": {
      "label": "Variant",
      "description": "Visueller Stil — filled (kraeftige Selektion), outline (transparenter BG, subtil), soft (helle Markenfarbe, weniger dominant)",
      "values": {
        "filled": {
          "modifier": null,
          "tokenGroups": []
        },
        "outline": {
          "modifier": "nc-toggle-group--outline",
          "tokenGroups": []
        },
        "soft": {
          "modifier": "nc-toggle-group--soft",
          "tokenGroups": [
            "item-soft"
          ]
        }
      }
    },
    "indicator": {
      "label": "Indicator",
      "description": "Selektions-Indikator — bg (Background-Wechsel, Standard), underline (dicke Linie unter dem gewaehlten Item, tab-aehnlich)",
      "values": {
        "bg": {
          "modifier": null,
          "tokenGroups": []
        },
        "underline": {
          "modifier": "nc-toggle-group--underline",
          "tokenGroups": [
            "underline"
          ]
        }
      }
    },
    "width": {
      "label": "Width",
      "description": "Item-Breite — auto (natuerliche Breite), equal (alle gleich breit, flex: 1)",
      "values": {
        "auto": {
          "modifier": null,
          "tokenGroups": []
        },
        "equal": {
          "modifier": "nc-toggle-group--equal",
          "tokenGroups": []
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhalt der Items — text (nur Text), icon-text (Icon + Text), icon-only (nur Icon, aria-label noetig)",
      "values": {
        "text": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "toggle-text"
        },
        "icon-text": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "icon": true
          },
          "renderHint": "toggle-icon-text"
        },
        "icon-only": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "icon": true
          },
          "renderHint": "toggle-icon-only"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "selected",
      "disabled",
      "focus"
    ],
    "precedence": [
      "disabled",
      "focus",
      "selected",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "disabled"
        ],
        "note": "Hover auf allen nicht-disabled Items (auch selected)"
      },
      {
        "state": "selected",
        "unless": [
          "disabled"
        ],
        "note": "Selected zeigt interactive-Farbe. Disabled ueberschreibt."
      },
      {
        "state": "focus",
        "unless": [
          "disabled"
        ],
        "note": "Focus-Ring auf das aktuelle Item"
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Single-Select: role='radiogroup' + role='radio' + aria-checked + Arrow-Keys. Multi-Select: role='group' + aria-pressed + Tab-Navigation. Immer aria-label auf Container."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "type": [
              "single"
            ]
          }
        },
        "require": [
          "role-radiogroup",
          "aria-checked"
        ],
        "note": "Single-Select braucht role='radiogroup' auf Container und role='radio' + aria-checked auf Items."
      },
      {
        "when": {
          "axes": {
            "type": [
              "multiple"
            ]
          }
        },
        "require": [
          "role-group",
          "aria-pressed"
        ],
        "note": "Multi-Select braucht role='group' auf Container und aria-pressed auf Items."
      },
      {
        "when": {
          "axes": {
            "content": [
              "icon-only"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "note": "Icon-only Items brauchen aria-label — kein sichtbarer Text vorhanden."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt. Einzelne Items oder gesamte Gruppe koennen disabled sein."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Container braucht aria-label."
        ]
      },
      {
        "when": {
          "axes": {
            "type": [
              "single"
            ]
          }
        },
        "require": [
          "role-radiogroup",
          "role-radio",
          "aria-checked"
        ],
        "notes": [
          "Single: radiogroup + radio + aria-checked."
        ]
      },
      {
        "when": {
          "axes": {
            "type": [
              "multiple"
            ]
          }
        },
        "require": [
          "role-group",
          "aria-pressed"
        ],
        "notes": [
          "Multiple: group + aria-pressed."
        ]
      },
      {
        "when": {
          "axes": {
            "content": [
              "icon-only"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "notes": [
          "Icon-only Items brauchen aria-label."
        ]
      }
    ],
    "copy": {
      "label": {
        "maxChars": 20,
        "note": "Item-Labels sollen kurz sein. Gleichmaessige Laengen bevorzugt fuer visuelles Gleichgewicht."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-toggle-group"
    ],
    "baseTokenGroups": [
      "container-geometry",
      "item-default",
      "item-selected",
      "animation"
    ],
    "tokenGroups": {
      "container-geometry": {
        "label": "Container",
        "tokens": [
          "nc-toggle-group-gap",
          "nc-toggle-group-radius",
          "nc-toggle-group-border",
          "nc-toggle-group-bg",
          "nc-toggle-group-shadow"
        ]
      },
      "item-default": {
        "label": "Item Default",
        "tokens": [
          "nc-toggle-group-item-bg",
          "nc-toggle-group-item-color",
          "nc-toggle-group-item-border"
        ]
      },
      "item-hover": {
        "label": "Item Hover",
        "tokens": [
          "nc-toggle-group-item-bg-hover"
        ]
      },
      "item-selected": {
        "label": "Item Selected",
        "tokens": [
          "nc-toggle-group-item-selected-bg",
          "nc-toggle-group-item-selected-color",
          "nc-toggle-group-item-selected-border"
        ]
      },
      "item-soft": {
        "label": "Soft Selected",
        "tokens": [
          "nc-toggle-group-item-soft-bg",
          "nc-toggle-group-item-soft-color"
        ]
      },
      "underline": {
        "label": "Underline Indicator",
        "tokens": [
          "nc-toggle-group-underline-width",
          "nc-toggle-group-underline-color"
        ]
      },
      "divider": {
        "label": "Divider",
        "tokens": [
          "nc-toggle-group-divider-width",
          "nc-toggle-group-divider-height",
          "nc-toggle-group-divider-color"
        ]
      },
      "item-disabled": {
        "label": "Item Disabled",
        "tokens": [
          "nc-toggle-group-item-disabled-bg",
          "nc-toggle-group-item-disabled-color",
          "nc-toggle-group-item-disabled-opacity"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-toggle-group-transition-duration"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.type.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.indicator.values.*.modifier",
        "axes.width.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD, Single",
      "description": "Toggle Group mit Items in allen Zustaenden (Single-Select)",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "type": [
            "single"
          ],
          "variant": [
            "filled"
          ],
          "indicator": [
            "bg"
          ],
          "width": [
            "auto"
          ],
          "content": [
            "text"
          ]
        },
        "states": [
          "default",
          "hover",
          "selected",
          "disabled",
          "focus"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Selected hat interactive-BG mit on-interactive Text. Focus braucht sichtbaren Ring."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": {
          "size": "*",
          "type": [
            "single"
          ],
          "variant": [
            "filled"
          ],
          "indicator": [
            "bg"
          ],
          "width": [
            "auto"
          ],
          "content": [
            "text"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "container-geometry"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hoehe folgt Button-Scale (32/40/48px). Container-Radius bleibt konstant."
      }
    },
    {
      "id": "variant-comparison",
      "label": "Filled vs Outline vs Soft",
      "description": "Alle 3 visuellen Varianten im Vergleich",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "type": [
            "single"
          ],
          "variant": "*",
          "indicator": [
            "bg"
          ],
          "width": [
            "auto"
          ],
          "content": [
            "text"
          ]
        },
        "states": [
          "default",
          "selected"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Filled: Selected = interactive-BG. Outline: Selected = background-secondary. Soft: Selected = helle Markenfarbe (12%)."
      }
    },
    {
      "id": "indicator-comparison",
      "label": "BG vs Underline Indicator",
      "description": "Background-Wechsel vs Underline als Selektions-Indikator",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "type": [
            "single"
          ],
          "variant": [
            "filled"
          ],
          "indicator": "*",
          "width": [
            "auto"
          ],
          "content": [
            "text"
          ]
        },
        "states": [
          "default",
          "selected"
        ]
      },
      "focusTokenGroups": [
        "underline"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "indicator"
      },
      "render": {
        "label": "{indicator}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Underline: Dicke Linie (2px) unter dem Item. Kein BG-Wechsel. Ideal fuer tab-aehnliche Single-Select."
      }
    },
    {
      "id": "single-vs-multiple",
      "label": "Single vs Multiple",
      "description": "Radio-Pattern (genau 1) vs Toggle-Pattern (0–n)",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "type": "*",
          "variant": [
            "filled"
          ],
          "indicator": [
            "bg"
          ],
          "width": [
            "auto"
          ],
          "content": [
            "text"
          ]
        },
        "states": [
          "default",
          "selected"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "type"
      },
      "render": {
        "label": "{type}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Single: role='radiogroup' + Arrow-Keys. Multiple: role='group' + Tab. Visuell identisch, Verhalten unterscheidet sich."
      }
    },
    {
      "id": "equal-width",
      "label": "Equal Width",
      "description": "Auto (natuerliche Breite) vs Equal (alle gleich breit)",
      "matrix": {
        "axes": {
