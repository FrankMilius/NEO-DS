    {
      "id": "divider-variant",
      "label": "Divider (subtle separators)",
      "description": "Subtile vertikale Trennlinien statt voller Border-Linien — moderner, weniger kastig",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "type": [
            "single"
          ],
          "variant": [
            "filled"
          ],
          "indicator": [
            "bg"
          ],
          "width": [
            "auto"
          ],
          "content": [
