{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "toggle-group",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["interactive", "selection", "group"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/toggle-group-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-toggle-group" },
    "slots": [
      { "name": "item", "element": ".nc-toggle-group__item", "optional": false },
      { "name": "icon", "element": ".nc-toggle-group__icon", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Container ist ein <div class='nc-toggle-group'>.",
      "Items sind <button class='nc-toggle-group__item'>.",
      "Single-Select: role='radiogroup' auf Container, role='radio' + aria-checked auf Items. Arrow-Key Navigation (roving tabindex).",
      "Multi-Select: role='group' auf Container, aria-pressed='true'/'false' auf Items. Tab-Navigation zwischen Items.",
      "Items haben keinen eigenen border-radius — Container hat overflow: hidden + border-radius.",
      "Border-Separator: border-inline-end auf Items, letztes Item ohne Border.",
      "Groessen-Modifier am Container (--sm, --lg) propagieren zu allen Items.",
      "Outline-Variante (--outline): transparenter BG, Selected = background-secondary statt interactive.",
      "Icon-only Items brauchen aria-label fuer Accessibility."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px). Nutzt Button-Size-Tokens.",
      "values": {
        "sm": { "modifier": "nc-toggle-group--sm", "tokenGroups": [] },
        "md": { "modifier": null,                  "tokenGroups": [] },
        "lg": { "modifier": "nc-toggle-group--lg", "tokenGroups": [] }
      }
    },

    "type": {
      "label": "Type",
      "description": "Auswahl-Modus — single (Radio-Pattern, genau 1 selektiert), multiple (Toggle-Pattern, 0–n selektiert)",
      "values": {
        "single":   { "modifier": null, "tokenGroups": [], "renderHint": "toggle-single",   "elementHint": "radiogroup" },
        "multiple": { "modifier": null, "tokenGroups": [], "renderHint": "toggle-multiple",  "elementHint": "group" }
      }
    },

    "variant": {
      "label": "Variant",
      "description": "Visueller Stil — filled (Standard, Selected = interactive-Farbe), outline (transparenter BG, subtilere Selektion)",
      "values": {
        "filled":  { "modifier": null,                       "tokenGroups": [] },
        "outline": { "modifier": "nc-toggle-group--outline", "tokenGroups": [] }
      }
    },

    "content": {
      "label": "Content",
      "description": "Inhalt der Items — text (nur Text), icon-text (Icon + Text), icon-only (nur Icon, aria-label noetig)",
      "values": {
        "text":      { "modifier": null, "tokenGroups": [],                     "renderHint": "toggle-text" },
        "icon-text": { "modifier": null, "tokenGroups": [], "slotConfig": { "icon": true }, "renderHint": "toggle-icon-text" },
        "icon-only": { "modifier": null, "tokenGroups": [], "slotConfig": { "icon": true }, "renderHint": "toggle-icon-only" }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "selected", "disabled", "focus"],
    "precedence": ["disabled", "focus", "selected", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": ["disabled"],           "note": "Hover auf allen nicht-disabled Items (auch selected)" },
      { "state": "selected", "unless": ["disabled"],        "note": "Selected zeigt interactive-Farbe. Disabled ueberschreibt." },
      { "state": "focus", "unless": ["disabled"],           "note": "Focus-Ring auf das aktuelle Item" }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Single-Select: role='radiogroup' + role='radio' + aria-checked + Arrow-Keys. Multi-Select: role='group' + aria-pressed + Tab-Navigation. Immer aria-label auf Container."
    },
    "overrides": [
      {
        "when": { "axes": { "type": ["single"] } },
        "require": ["role-radiogroup", "aria-checked"],
        "note": "Single-Select braucht role='radiogroup' auf Container und role='radio' + aria-checked auf Items."
      },
      {
        "when": { "axes": { "type": ["multiple"] } },
        "require": ["role-group", "aria-pressed"],
        "note": "Multi-Select braucht role='group' auf Container und aria-pressed auf Items."
      },
      {
        "when": { "axes": { "content": ["icon-only"] } },
        "require": ["aria-label"],
        "note": "Icon-only Items brauchen aria-label — kein sichtbarer Text vorhanden."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": ["aria-disabled"],
        "note": "aria-disabled='true' bevorzugt. Einzelne Items oder gesamte Gruppe koennen disabled sein."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["accessible-name"], "notes": ["Container braucht aria-label."] },
      { "when": { "axes": { "type": ["single"] } }, "require": ["role-radiogroup", "role-radio", "aria-checked"], "notes": ["Single: radiogroup + radio + aria-checked."] },
      { "when": { "axes": { "type": ["multiple"] } }, "require": ["role-group", "aria-pressed"], "notes": ["Multiple: group + aria-pressed."] },
      { "when": { "axes": { "content": ["icon-only"] } }, "require": ["aria-label"], "notes": ["Icon-only Items brauchen aria-label."] }
    ],
    "copy": {
      "label": {
        "maxChars": 20,
        "note": "Item-Labels sollen kurz sein. Gleichmaessige Laengen bevorzugt fuer visuelles Gleichgewicht."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-toggle-group"],
    "baseTokenGroups": ["container-geometry", "item-default", "item-selected", "animation"],

    "tokenGroups": {
      "container-geometry": {
        "label": "Container",
        "tokens": [
          "nc-toggle-group-gap",
          "nc-toggle-group-radius",
          "nc-toggle-group-border",
          "nc-toggle-group-bg"
        ]
      },
      "item-default": {
        "label": "Item Default",
        "tokens": [
          "nc-toggle-group-item-bg",
          "nc-toggle-group-item-color",
          "nc-toggle-group-item-border"
        ]
      },
      "item-hover": {
        "label": "Item Hover",
        "tokens": [
          "nc-toggle-group-item-bg-hover"
        ]
      },
      "item-selected": {
        "label": "Item Selected",
        "tokens": [
          "nc-toggle-group-item-selected-bg",
          "nc-toggle-group-item-selected-color",
          "nc-toggle-group-item-selected-border"
        ]
      },
      "item-disabled": {
        "label": "Item Disabled",
        "tokens": [
          "nc-toggle-group-item-disabled-bg",
          "nc-toggle-group-item-disabled-color",
          "nc-toggle-group-item-disabled-opacity"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-toggle-group-transition-duration"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.type.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD, Single",
      "description": "Toggle Group mit Items in allen Zustaenden (Single-Select)",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "variant": ["filled"], "content": ["text"] },
        "states": ["default", "hover", "selected", "disabled", "focus"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Selected hat interactive-BG mit on-interactive Text. Focus braucht sichtbaren Ring."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "type": ["single"], "variant": ["filled"], "content": ["text"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["container-geometry"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hoehe folgt Button-Scale (32/40/48px). Container-Radius bleibt konstant."
      }
    },
    {
      "id": "single-vs-multiple",
      "label": "Single vs Multiple",
      "description": "Radio-Pattern (genau 1) vs Toggle-Pattern (0–n)",
      "matrix": {
        "axes": { "size": ["md"], "type": "*", "variant": ["filled"], "content": ["text"] },
        "states": ["default", "selected"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "type" },
      "render": { "label": "{type}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Single: role='radiogroup' + Arrow-Keys. Multiple: role='group' + Tab. Visuell identisch, Verhalten unterscheidet sich."
      }
    },
    {
      "id": "filled-vs-outline",
      "label": "Filled vs Outline",
      "description": "Default (filled, interactive-BG bei Selected) vs Outline (subtile Selektion)",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "variant": "*", "content": ["text"] },
        "states": ["default", "selected"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Filled: Selected = interactive-BG (blau) + weisser Text. Outline: Selected = background-secondary + text-primary. Beide brauchen 4.5:1 Kontrast."
      }
    },
    {
      "id": "content-types",
      "label": "Content Types",
      "description": "Text-only vs Icon+Text vs Icon-only",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "variant": ["filled"], "content": "*" },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon-only Items brauchen aria-label. Icons muessen 3:1 Non-Text-Kontrast einhalten."
      }
    },
    {
      "id": "disabled-states",
      "label": "Disabled States",
      "description": "Einzelne disabled Items und komplett disabled Gruppe",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "variant": ["filled"], "content": ["text"] },
        "states": ["default", "selected", "disabled"]
      },
      "focusTokenGroups": ["item-disabled"],
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled Items haben disabled-BG + reduzierte Opacity. Nicht anklickbar. aria-disabled='true' auf dem Item."
      }
    }
  ]
}
