      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "width"
      },
      "render": {
        "label": "{width}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Equal-Width: flex: 1 auf Items. Alle gleich breit fuer visuelle Ruhe."
      }
    },
    {
      "id": "content-types",
      "label": "Content Types",
