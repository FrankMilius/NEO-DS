{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "spinner",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["static", "loading", "indicator"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/spinner-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-spinner" },
    "slots": [],
    "convenience": [
      { "name": "overlay", "element": ".nc-spinner-overlay", "optional": true, "description": "Absolut positionierter Overlay-Container mit semi-transparentem Hintergrund. Zentriert den Spinner ueber einem Parent-Element." }
    ],
    "domNotes": [
      "Spinner ist ein <div class='nc-spinner' role='status'> mit ::after Pseudo-Element fuer den rotierenden Ring.",
      "Braucht ein .u-sr-only Kind-Element mit 'Wird geladen...' oder aria-label auf dem Container.",
      "Ring: border-color = Track, border-top-color = Active. Animation: fnd-spin (360° Rotation).",
      "prefers-reduced-motion verlangsamt die Rotation (2s statt 700ms).",
      "Overlay (.nc-spinner-overlay): position:absolute, inset:0, semi-transparenter BG."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "5 Groessenabstufungen — xs (16px), sm (20px), md (24px, Standard), lg (40px), xl (56px)",
      "values": {
        "xs": { "modifier": "nc-spinner--xs", "tokenGroups": [] },
        "sm": { "modifier": "nc-spinner--sm", "tokenGroups": [] },
        "md": { "modifier": null,             "tokenGroups": [] },
        "lg": { "modifier": "nc-spinner--lg", "tokenGroups": [] },
        "xl": { "modifier": "nc-spinner--xl", "tokenGroups": [] }
      }
    },

    "color": {
      "label": "Color",
      "description": "Farb-Variante — default (interactive), inverse (weiss), success (gruen), danger (rot)",
      "values": {
        "default": { "modifier": null,                   "tokenGroups": [] },
        "inverse": { "modifier": "nc-spinner--inverse",  "tokenGroups": [] },
        "success": { "modifier": "nc-spinner--success",  "tokenGroups": [] },
        "danger":  { "modifier": "nc-spinner--danger",   "tokenGroups": [] }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Spinner braucht role='status' und ein .u-sr-only Kind-Element mit 'Wird geladen...' oder aria-label. prefers-reduced-motion wird respektiert (langsamere Rotation)."
    },
    "overrides": [
      {
        "when": {},
        "require": ["role-status", "accessible-name"],
        "note": "role='status' erzeugt eine implizite aria-live='polite' Region. Screen Reader kuendigt den Ladezustand an."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["role-status", "accessible-name"], "notes": ["Spinner braucht role='status' und .u-sr-only oder aria-label fuer Screen Reader."] }
    ],
    "copy": {}
  },

  "styling": {
    "baseClasses": ["nc-spinner"],
    "baseTokenGroups": ["core-colors", "core-animation"],

    "tokenGroups": {
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-spinner-color",
          "nc-spinner-track-color"
        ]
      },
      "core-animation": {
        "label": "Animation",
        "tokens": [
          "nc-spinner-duration",
          "nc-spinner-ease"
        ]
      },
      "core-sizing": {
        "label": "Sizing",
        "tokens": [
          "nc-spinner-size-xs",
          "nc-spinner-size-sm",
          "nc-spinner-size-md",
          "nc-spinner-size-lg",
          "nc-spinner-size-xl"
        ]
      },
      "core-border": {
        "label": "Border Width",
        "tokens": [
          "nc-spinner-border-width-xs",
          "nc-spinner-border-width-sm",
          "nc-spinner-border-width-md",
          "nc-spinner-border-width-lg",
          "nc-spinner-border-width-xl"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.color.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "size-scale",
      "label": "Size Scale — XS / SM / MD / LG / XL",
      "description": "Alle 5 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "color": ["default"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-sizing", "core-border"],
      "layout": "row",
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Active-Segment muss 3:1 Kontrast gegen den Hintergrund haben. Border-Width skaliert mit Groesse."
      }
    },
    {
      "id": "color-variants",
      "label": "Color Variants",
      "description": "Alle Farb-Varianten in MD-Groesse",
      "matrix": {
        "axes": { "size": ["md"], "color": "*" },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-colors"],
      "layout": "row",
      "render": { "label": "{color}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Jede Farb-Variante muss 3:1 Kontrast einhalten. Inverse braucht dunklen Hintergrund."
      }
    },
    {
      "id": "inverse-on-dark",
      "label": "Inverse on Dark Background",
      "description": "Inverse-Variante auf dunklem Hintergrund",
      "matrix": {
        "axes": { "size": ["md", "lg"], "color": ["inverse"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{size}", "bgVariant": "dark" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Weisser Spinner auf dunklem BG. Track-Color ist 25% weiss — muss unterscheidbar sein."
      }
    },
    {
      "id": "in-button",
      "label": "Spinner in Button",
      "description": "Spinner als Lade-Indikator innerhalb eines Buttons",
      "composes": ["button"],
      "matrix": {
        "axes": { "size": ["sm"], "color": ["default", "inverse"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "spinner-in-button", "label": "{color}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Spinner im Button ersetzt Button-Text. Button braucht aria-disabled='true' und aria-busy='true' waehrend des Ladens."
      }
    },
    {
      "id": "overlay",
      "label": "Spinner Overlay",
      "description": "Spinner zentriert ueber einem Container mit semi-transparentem Overlay",
      "composes": ["overlay"],
      "matrix": {
        "axes": { "size": ["lg"], "color": ["default"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "spinner-overlay", "label": "overlay" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Overlay blockiert Interaktion (pointer-events: none auf darunterliegenden Inhalt). Spinner bleibt zugaenglich."
      }
    },
    {
      "id": "reduced-motion",
      "label": "Reduced Motion",
      "description": "Verhalten bei prefers-reduced-motion",
      "matrix": {
        "axes": { "size": ["md"], "color": ["default"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-animation"],
      "layout": "row",
      "render": { "label": "reduced-motion", "motionVariants": ["default", "reduced"] },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Bei prefers-reduced-motion: Rotation verlangsamt auf 2s. Spinner bleibt als Ladeindikator erkennbar."
      }
    }
  ]
}
