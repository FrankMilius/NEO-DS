{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "faq",
    "version": "1.1.0",
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "06.10.2026 (Plan v3, Phase 4, duenne Recipes): Specimen default zeigt die Zustaende default/open; neu mehrere-offen",
          "„Ausprobieren\" in der Arena: Auf- und Zuklappen macht der Browser (<details>); das Akkordeon-Verhalten aus neo-behaviors bindet nur .nc-accordion"
        ]
      }
    ],
    "status": "stable",
    "tags": [
      "content",
      "interactive",
      "accordion"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/faq-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_faq.scss"
      ],
      "story": "stories/organisms/faq.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/faq-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-faq"
    },
    "slots": [
      {
        "name": "item",
        "element": ".nc-faq__item",
        "optional": false
      },
      {
        "name": "question",
        "element": ".nc-faq__question",
        "optional": false
      },
      {
        "name": "answer",
        "element": ".nc-faq__answer",
        "optional": false
      }
    ],
    "convenience": [],
    "domNotes": [
      "Grid-Container mit FAQ-Items. Item: border, radius-3xl, padding.",
      "Question: semibold, cursor:pointer. Answer: text-secondary.",
      "Aufklappbar via <details>/<summary> oder JS."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Einzige Variante",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "faq-default"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "open"
    ],
    "precedence": [
      "open",
      "default"
    ],
    "rules": [
      {
        "state": "open",
        "unless": [],
        "note": "Open: Answer sichtbar."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "FAQ via <details>/<summary> oder aria-expanded. Keyboard: Enter/Space oeffnet."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-faq"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": []
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "default",
      "label": "FAQ List",
      "description": "FAQ-Liste mit aufklappbaren Fragen (<details>/<summary>). Standard: alle zu; Geöffnet: erster Eintrag offen (open-Attribut).",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default",
          "open"
        ]
      },
      "layout": "row",
      "render": {
        "label": "faq"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Question: semibold 4.5:1. Answer: text-secondary 4.5:1."
      }
    },
    {
      "id": "mehrere-offen",
      "label": "Mehrere offen",
      "description": "Native <details>: mehrere Einträge können zugleich offen sein — kein „nur eines offen\" wie beim Akkordeon.",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "zwei offen",
        "offen": [
          0,
          2
        ]
      }
    }
  ]
}
