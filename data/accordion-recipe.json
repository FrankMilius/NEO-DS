{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "accordion",
    "version": "3.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "disclosure",
      "content",
      "navigation",
      "faq",
      "selection"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/accordion-docs"
    },
    "changelog": [
      {
        "version": "3.0.0",
        "changes": [
          "Nested Variant: Hierarchische Accordions mit Einrueckung und reduziertem Icon",
          "Selection Variant: Checkable Accordion mit Checkbox/Radio im Trigger. Farbiger Rahmen bei Auswahl.",
          "Actionable Header: trigger-suffix Slot fuer Badges und Action-Buttons",
          "Sticky Trigger: Trigger bleibt bei langem Inhalt am oberen Rand (position:sticky)",
          "Scroll-Into-View: Neu geoeffneter Trigger scrollt sanft in den Viewport (single mode)",
          "Always-Open Item: data-allow-close='false' verhindert Schliessen",
          "Neue Slots: trigger-prefix, trigger-suffix, footer",
          "12 neue Tokens: nested, selection, actions, sticky, footer"
        ]
      },
      {
        "version": "2.0.0",
        "changes": [
          "Context-Aware Accordion mit Varianten, Density, Media-Slot und CSS-Grid-Animation",
          "Varianten: ghost, separated, elevated",
          "Density: compact, spacious",
          "Media-Layout: top, side"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiales Recipe: default + flush, single/multiple, native details/summary"
        ]
      }
    ],
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_accordion.scss"
      ],
      "story": "stories/molecules/accordion.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/AccordionArena.vue",
      "drupal": [
        "block--block-content--neo-accordion.html.twig",
        "block--inline-block--neo-accordion.html.twig"
      ],
      "docs": "docs/accordion-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-accordion"
    },
    "slots": [
      {
        "name": "item",
        "element": ".nc-accordion__item",
        "optional": false,
        "description": "Einzelnes Accordion-Item (details Element)."
      },
      {
        "name": "trigger",
        "element": ".nc-accordion__trigger",
        "optional": false,
        "description": "Klickbarer Header (summary Element). Enthaelt Text, Icon, optional Prefix/Suffix."
      },
      {
        "name": "icon",
        "element": ".nc-accordion__icon",
        "optional": true,
        "description": "Toggle-Icon (Chevron). Rotiert bei Open."
      },
      {
        "name": "content",
        "element": ".nc-accordion__content",
        "optional": false,
        "description": "Content-Container. grid-template-rows: 0fr/1fr Animation."
      },
      {
        "name": "content-inner",
        "element": ".nc-accordion__content-inner",
        "optional": false,
        "description": "Innerer Content mit overflow:hidden."
      },
      {
        "name": "media",
        "element": ".nc-accordion__media",
        "optional": true,
        "description": "Optionaler Bild/Video-Container."
      },
      {
        "name": "trigger-prefix",
        "element": ".nc-accordion__trigger-prefix",
        "optional": true,
        "description": "Platz fuer Checkbox, Radio oder Status-Icon links im Trigger."
      },
      {
        "name": "trigger-suffix",
        "element": ".nc-accordion__trigger-suffix",
        "optional": true,
        "description": "Platz fuer Badges oder Action-Buttons rechts im Trigger (vor dem Toggle-Icon)."
      },
      {
        "name": "footer",
        "element": ".nc-accordion__footer",
        "optional": true,
        "description": "Optionaler Footer am Ende des Contents fuer Buttons/Actions."
      }
    ],
    "convenience": [],
    "domNotes": [
      "Natives <details>/<summary> oder ARIA-Pattern (role='region').",
      "BEM: .nc-accordion > __item > __trigger + __content > __content-inner.",
      "CSS-Grid-Animation: grid-template-rows 0fr→1fr fuer fluessige Hoehen-Animation.",
      "Trigger-Layout: [prefix] [text] [suffix] [icon] via Flexbox.",
      "Nested: nc-accordion innerhalb eines nc-accordion__content-inner. Eingerueckt via padding-left.",
      "Selection: .nc-accordion__trigger-prefix enthaelt Checkbox/Radio. Checked-State: farbiger Rahmen + BG auch bei geschlossenem Item.",
      "Actionable Header: .nc-accordion__trigger-suffix fuer Badges (rechts, vor Icon).",
      "Sticky Trigger: position:sticky auf dem Trigger bei offenem Item (nur bei langem Content).",
      "Scroll-Into-View: scrollIntoView({behavior:'smooth'}) auf den Trigger nach Auto-Close im Single-Mode.",
      "Always Open: data-allow-close='false' auf dem Item verhindert Schliessen.",
      "Footer: Optionaler Aktionsbereich am Content-Ende (z.B. 'Weiter'-Button).",
      "prefers-reduced-motion: Transitions deaktiviert."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visueller Stil — default, flush, ghost, separated, elevated, nested, selection",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "core-geometry",
            "core-colors"
          ],
          "renderHint": "accordion-bordered"
        },
        "flush": {
          "modifier": "nc-accordion--flush",
          "tokenGroups": [
            "core-geometry",
            "core-colors"
          ],
          "renderHint": "accordion-flush"
        },
        "ghost": {
          "modifier": "nc-accordion--ghost",
          "tokenGroups": [
            "core-geometry",
            "core-colors"
          ],
          "renderHint": "accordion-ghost"
        },
        "separated": {
          "modifier": "nc-accordion--separated",
          "tokenGroups": [
            "core-geometry",
            "core-colors",
            "separated"
          ],
          "renderHint": "accordion-separated"
        },
        "elevated": {
          "modifier": "nc-accordion--elevated",
          "tokenGroups": [
            "core-geometry",
            "core-colors",
            "elevated"
          ],
          "renderHint": "accordion-elevated"
        },
        "nested": {
          "modifier": "nc-accordion--nested",
          "tokenGroups": [
            "core-geometry",
            "core-colors",
            "nested"
          ],
          "renderHint": "accordion-nested"
        },
        "selection": {
          "modifier": "nc-accordion--selection",
          "tokenGroups": [
            "core-geometry",
            "core-colors",
            "selection"
          ],
          "renderHint": "accordion-selection",
          "slotConfig": {
            "trigger-prefix": true
          }
        },
        "register": {
          "modifier": "nc-accordion--register",
          "tokenGroups": [
            "register"
          ],
          "renderHint": "accordion-register",
          "description": "Zweispaltig. Fuer Listen, in denen man sucht statt liest — Glossare, Integrationen, Downloads. Ab acht kurzen Eintraegen. Nicht, wenn die Reihenfolge etwas bedeutet: zwei Spalten heissen zwei Anfaenge."
        },
        "lese": {
          "modifier": "nc-accordion--lese",
          "tokenGroups": [
            "lese"
          ],
          "renderHint": "accordion-lese",
          "description": "Volle Breite, grosse Ausloeser, Medium im Textfluss. Fuer Schrittfolgen und Erklaerstuecke, die gelesen und nicht ueberflogen werden. Drei bis fuenf Eintraege."
        }
      }
    },
    "density": {
      "label": "Density",
      "description": "Platzbedarf — default, compact, spacious",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-density-default"
        },
        "compact": {
          "modifier": "nc-accordion--compact",
          "tokenGroups": [
            "density-compact"
          ],
          "renderHint": "accordion-density-compact"
        },
        "spacious": {
          "modifier": "nc-accordion--spacious",
          "tokenGroups": [
            "density-spacious"
          ],
          "renderHint": "accordion-density-spacious"
        }
      }
    },
    "behavior": {
      "label": "Behavior",
      "description": "Oeffnungs-Verhalten — multiple, single, single-scroll (mit Scroll-Into-View)",
      "values": {
        "multiple": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-multi"
        },
        "single": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-single"
        },
        "single-scroll": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-single-scroll"
        }
      }
    },
    "media-layout": {
      "label": "Media Layout",
      "description": "Medien-Positionierung — none, top, side",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-no-media"
        },
        "top": {
          "modifier": "nc-accordion--media-top",
          "tokenGroups": [
            "media"
          ],
          "renderHint": "accordion-media-top",
          "slotConfig": {
            "media": true
          }
        },
        "side": {
          "modifier": "nc-accordion--media-side",
          "tokenGroups": [
            "media"
          ],
          "renderHint": "accordion-media-side",
          "slotConfig": {
            "media": true
          }
        }
      }
    },
    "sticky": {
      "label": "Sticky Trigger",
      "description": "Trigger bleibt am oberen Rand bei langem Content",
      "values": {
        "off": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-no-sticky"
        },
        "on": {
          "modifier": "nc-accordion--sticky",
          "tokenGroups": [
            "sticky"
          ],
          "renderHint": "accordion-sticky"
        }
      }
    },
    "deepLink": {
      "label": "Sprungziel",
      "description": "Jeder Eintrag traegt eine Kennung. /seite#kennung oeffnet ihn und springt hin; der offene Eintrag bekommt eine Marke, damit man sieht, wo man gelandet ist.",
      "values": {
        "on": {
          "modifier": null,
          "tokenGroups": [
            "target"
          ],
          "renderHint": "accordion-deeplink"
        }
      }
    },
    "expandAll": {
      "label": "Alle aufklappen",
      "description": "Schalter ueber der Liste. Sinnvoll ab etwa acht Eintraegen. Bei Verhalten `single` wirkungslos — dort widerspraeche er sich selbst.",
      "values": {
        "off": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "accordion-expand-off"
        },
        "on": {
          "modifier": "nc-accordion-toggle-all",
          "tokenGroups": [],
          "renderHint": "accordion-expand-on"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "open",
      "hover",
      "focus",
      "disabled",
      "selected"
    ],
    "precedence": [
      "disabled",
      "focus",
      "selected",
      "open",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "disabled"
        ],
        "note": "Hover auf Trigger: background-color Feedback."
      },
      {
        "state": "open",
        "unless": [
          "disabled"
        ],
        "note": "Content sichtbar, Icon rotiert 180deg."
      },
      {
        "state": "focus",
        "unless": [
          "disabled"
        ],
        "note": "Focus-Ring auf Trigger."
      },
      {
        "state": "disabled",
        "unless": [],
        "note": "Opacity reduziert, pointer-events:none."
      },
      {
        "state": "selected",
        "unless": [
          "disabled"
        ],
        "note": "Selection-Variante: Farbiger Rahmen + BG, auch bei geschlossenem Item."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Natives <details>/<summary> ist inhaerent accessible. Trigger per Tab erreichbar, Enter/Space toggelt."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "variant": [
              "selection"
            ]
          }
        },
        "suggest": [
          "aria-checked"
        ],
        "note": "Selection: Checkbox/Radio braucht aria-checked State."
      },
      {
        "when": {
          "axes": {
            "variant": [
              "nested"
            ]
          }
        },
        "suggest": [
          "aria-level"
        ],
        "note": "Nested: aria-level fuer Hierarchie-Ebene."
      },
      {
        "when": {
          "axes": {
            "sticky": [
              "on"
            ]
          }
        },
        "suggest": [],
        "note": "Sticky: Trigger muss nach dem Scrollen noch interagierbar sein."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Trigger braucht sichtbaren Text oder aria-label."
        ]
      },
      {
        "when": {
          "axes": {
            "variant": [
              "separated"
            ]
          }
        },
        "require": [
          "item-gap"
        ],
        "notes": [
          "Gap via --nc-accordion-item-gap."
        ]
      },
      {
        "when": {
          "axes": {
            "variant": [
              "nested"
            ]
          }
        },
        "require": [
          "max-nesting"
        ],
        "notes": [
          "Max 3 Ebenen empfohlen fuer Usability."
        ]
      }
    ],
    "copy": {
      "trigger": {
        "maxChars": 80,
        "note": "Trigger-Text: klar und beschreibend."
      },
      "badge": {
        "maxChars": 15,
        "note": "Badge-Text im trigger-suffix."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-accordion"
    ],
    "baseTokenGroups": [
      "core-geometry",
      "core-colors",
      "animation"
    ],
    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-accordion-border",
          "nc-accordion-padding",
          "nc-accordion-icon-size"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-accordion-trigger-font-weight",
          "nc-accordion-trigger-color",
          "nc-accordion-content-color",
          "nc-accordion-icon-color",
          "nc-accordion-trigger-hover-bg",
          "nc-accordion-content-font-size"
        ]
      },
      "separated": {
        "label": "Separated",
        "tokens": [
          "nc-accordion-item-gap",
          "nc-accordion-item-radius",
          "nc-accordion-item-shadow",
          "nc-accordion-item-bg"
        ]
      },
      "elevated": {
        "label": "Elevated",
        "tokens": [
          "nc-accordion-elevated-shadow"
        ]
      },
      "density-compact": {
        "label": "Compact",
        "tokens": [
          "nc-accordion-padding-compact",
          "nc-accordion-content-font-size-compact"
        ]
      },
      "density-spacious": {
        "label": "Spacious",
        "tokens": [
          "nc-accordion-padding-spacious"
        ]
      },
      "media": {
        "label": "Media",
        "tokens": [
          "nc-accordion-media-radius",
          "nc-accordion-media-max-height",
          "nc-accordion-media-gap"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-accordion-transition-duration"
        ]
      },
      "nested": {
        "label": "Nested",
        "tokens": [
          "nc-accordion-nested-indent",
          "nc-accordion-nested-border-width",
          "nc-accordion-nested-icon-size"
        ]
      },
      "selection": {
        "label": "Selection",
        "tokens": [
          "nc-accordion-selection-border-active",
          "nc-accordion-selection-bg-active",
          "nc-accordion-selection-indicator-size"
        ]
      },
      "actions": {
        "label": "Header Actions",
        "tokens": [
          "nc-accordion-actions-gap",
          "nc-accordion-actions-color",
          "nc-accordion-actions-hover-color"
        ]
      },
      "sticky": {
        "label": "Sticky Trigger",
        "tokens": [
          "nc-accordion-trigger-sticky-z",
          "nc-accordion-trigger-sticky-bg"
        ]
      },
      "footer": {
        "label": "Footer",
        "tokens": [
          "nc-accordion-footer-padding",
          "nc-accordion-footer-border"
        ]
      },
      "trigger-type": {
        "label": "Typografie des Ausloesers",
        "description": "Der Ausloeser ist die Ueberschrift eines Eintrags und traegt deshalb Ueberschriftenschrift und eine Stufe aus der Typoskala — nicht die Fliesstextgroesse.",
        "tokens": [
          "nc-accordion-trigger-family",
          "nc-accordion-trigger-size",
          "nc-accordion-trigger-lh",
          "nc-accordion-trigger-tracking",
          "nc-accordion-trigger-font-weight",
          "nc-accordion-trigger-color",
          "nc-accordion-trigger-hover-bg",
          "nc-accordion-trigger-sticky-z",
          "nc-accordion-trigger-sticky-bg",
          "nc-accordion-kicker-family",
          "nc-accordion-kicker-size",
          "nc-accordion-kicker-weight",
          "nc-accordion-kicker-tracking",
          "nc-accordion-kicker-color",
          "nc-accordion-kicker-gap",
          "nc-accordion-content-lh",
          "nc-accordion-content-measure",
          "nc-accordion-gutter"
        ]
      },
      "register": {
        "label": "Register",
        "description": "Zweispaltige Fassung.",
        "tokens": [
          "nc-accordion-register-columns",
          "nc-accordion-register-gap"
        ]
      },
      "lese": {
        "label": "Lesefassung",
        "description": "Grosse Ausloeser, Medium im Textfluss.",
        "tokens": [
          "nc-accordion-lese-trigger-size",
          "nc-accordion-lese-content-size",
          "nc-accordion-lese-measure",
          "nc-accordion-lese-padding",
          "nc-accordion-lese-media-max"
        ]
      },
      "target": {
        "label": "Sprungziel",
        "description": "Marke des per Adresse geoeffneten Eintrags.",
        "tokens": [
          "nc-accordion-target-marker",
          "nc-accordion-target-width"
        ]
      },
      "block": {
        "label": "Blockraster",
        "description": "Breitenverhaeltnis von Kopf und Akkordeon.",
        "tokens": [
          "nc-accordion-cols",
          "nc-accordion-voll-measure"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.density.values.*.modifier",
        "axes.media-layout.values.*.modifier",
        "axes.sticky.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "keyboard": {
    "Enter": {
      "action": "toggle-item",
      "note": "Oeffnet/schliesst das fokussierte Accordion-Item."
    },
    "Space": {
      "action": "toggle-item",
      "note": "Oeffnet/schliesst das fokussierte Accordion-Item."
    },
    "ArrowDown": {
      "action": "focus-next-trigger",
      "note": "Fokussiert naechsten Accordion-Trigger."
    },
    "ArrowUp": {
      "action": "focus-prev-trigger",
      "note": "Fokussiert vorherigen Accordion-Trigger."
    },
    "Home": {
      "action": "focus-first-trigger",
      "note": "Springt zum ersten Trigger."
    },
    "End": {
      "action": "focus-last-trigger",
      "note": "Springt zum letzten Trigger."
    }
  },
  "testSelectors": {
    "root": "[data-testid='accordion']",
    "item": "[data-testid='accordion-item']",
    "trigger": "[data-testid='accordion-trigger']",
    "content": "[data-testid='accordion-content']"
  },
  "events": {
    "accordion-toggle": {
      "bubbles": true,
      "detail": {
        "itemId": "string",
        "open": "boolean"
      },
      "note": "Gefeuert wenn ein Item geoeffnet/geschlossen wird."
    }
  },
  "specimens": [
    {
      "id": "all-states",
      "label": "All States",
      "description": "Accordion-Item in allen Zustaenden",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "density": [
            "default"
          ],
          "behavior": [
            "multiple"
          ],
          "media-layout": [
            "none"
          ],
          "sticky": [
            "off"
          ]
        },
        "states": [
          "default",
          "open",
          "hover",
          "focus",
          "disabled"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen klar unterscheidbar sein."
      }
    },
    {
      "id": "variant-comparison",
      "label": "Variant Comparison",
      "description": "Alle 7 Varianten im Vergleich",
      "matrix": {
        "axes": {
          "variant": "*",
          "density": [
            "default"
          ],
          "behavior": [
            "multiple"
          ],
          "media-layout": [
            "none"
          ],
          "sticky": [
            "off"
          ]
        },
        "states": [
          "default",
          "open"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle Varianten: klare Item-Grenzen."
      }
    },
    {
      "id": "nested-hierarchy",
      "label": "Nested Hierarchy",
      "description": "Hierarchisches Accordion mit 2 Ebenen (z.B. Kategorie > Unterkategorie).",
      "matrix": {
        "axes": {
          "variant": [
            "nested"
          ],
          "density": [
            "default"
          ],
          "behavior": [
            "multiple"
          ],
          "media-layout": [
            "none"
          ],
          "sticky": [
            "off"
          ]
        },
        "states": [
          "default",
          "open"
        ]
      },
      "focusTokenGroups": [
        "nested"
      ],
      "layout": "single",
      "render": {
        "compositionType": "accordion-nested",
        "label": "nested"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Nested: aria-level pro Ebene. Max 3 Ebenen."
      }
    },
    {
      "id": "selection-checkable",
