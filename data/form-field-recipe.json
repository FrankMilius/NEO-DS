{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-field",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["form", "layout", "wrapper"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-field-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-form-field" },
    "slots": [
      { "name": "label", "element": ".nc-form-label", "optional": true },
      { "name": "hint-above", "element": ".nc-form-hint", "optional": true },
      { "name": "control", "element": ".nc-input | .nc-textarea | .nc-select | .nc-checkbox", "optional": false },
      { "name": "error", "element": ".nc-form-error", "optional": true },
      { "name": "hint-below", "element": ".nc-form-hint", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Flex-Column-Container der Label, Input, Hint und Error zusammenfasst.",
      "gap via --nc-form-field-gap (4px) — Label margin-bottom wird auf 0 gesetzt.",
      "Error-Modifier propagiert border-color auf Kind-Inputs (nc-input, nc-textarea, nc-select).",
      "Success-Modifier propagiert success-border-color auf Kind-Inputs.",
      "Disabled-Modifier graut Label und Hint aus (text-disabled, cursor: not-allowed).",
      "Horizontal-Modifier: flex-direction: row ab Tablet, Label 200px breit, Input flex: 1.",
      "Hint kann vor oder nach dem Input platziert werden.",
      "Input hat aria-describedby mit IDs von Hint und/oder Error (Leerzeichen-getrennt)."
    ]
  },

  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Anordnung — vertical (Standard, Label oben), horizontal (Label links, Input rechts, ab Tablet)",
      "values": {
        "vertical":   { "modifier": null,                          "tokenGroups": [], "renderHint": "form-field-vertical" },
        "horizontal": { "modifier": "nc-form-field--horizontal",   "tokenGroups": [], "renderHint": "form-field-horizontal" }
      }
    },

    "validation": {
      "label": "Validation",
      "description": "Validierungs-State — none (Standard), error (Fehler), success (Erfolg)",
      "values": {
        "none":    { "modifier": null,                        "tokenGroups": [], "renderHint": "form-field-default" },
        "error":   { "modifier": "nc-form-field--error",      "tokenGroups": [], "slotConfig": { "error": true }, "renderHint": "form-field-error" },
        "success": { "modifier": "nc-form-field--success",    "tokenGroups": [], "renderHint": "form-field-success" }
      }
    },

    "content": {
      "label": "Content",
      "description": "Inhaltskombination — minimal (Label + Input), with-hint (+ Hint), full (Label + Hint + Input + Error)",
      "values": {
        "minimal":   { "modifier": null, "tokenGroups": [], "renderHint": "form-field-minimal" },
        "with-hint": { "modifier": null, "tokenGroups": [], "slotConfig": { "hint-below": true }, "renderHint": "form-field-hint" },
        "full":      { "modifier": null, "tokenGroups": [], "slotConfig": { "hint-below": true, "error": true }, "renderHint": "form-field-full" }
      }
    }
  },

  "states": {
    "supported": ["default", "disabled"],
    "precedence": ["disabled", "default"],
    "rules": [
      { "state": "disabled", "unless": [], "note": "Disabled: Label und Hint werden ausgegraut (text-disabled). Kind-Input ist ebenfalls disabled." }
    ],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Form-Field ist ein Layout-Wrapper ohne eigene ARIA-Rolle. Accessibility liegt auf den Kind-Elementen: Label (for), Input (aria-describedby, aria-invalid, aria-required), Error (role='alert'), Hint (id)."
    },
    "overrides": [
      {
        "when": { "axes": { "validation": ["error"] } },
        "suggest": ["aria-invalid"],
        "note": "Error-State: Kind-Input braucht aria-invalid='true'. Error-Message via aria-describedby verknuepft."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": [],
        "note": "Disabled-State: Kind-Input hat disabled-Attribut oder aria-disabled='true'."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["accessible-name"], "notes": ["Kind-Input muss via Label (for-Attribut) oder aria-label benannt sein."] },
      { "when": { "axes": { "validation": ["error"] } }, "require": ["aria-invalid", "aria-describedby"], "notes": ["Error-State erfordert aria-invalid='true' und aria-describedby auf dem Input."] }
    ],
    "copy": {}
  },

  "styling": {
    "baseClasses": ["nc-form-field"],
    "baseTokenGroups": ["core-geometry"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-form-field-gap"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.layout.values.*.modifier",
        "axes.validation.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "minimal",
      "label": "Minimal (Label + Input)",
      "description": "Einfachste Form: Label ueber Input",
      "composes": ["form-label", "input"],
      "matrix": {
        "axes": { "layout": ["vertical"], "validation": ["none"], "content": ["minimal"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-minimal", "label": "minimal" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label hat for-Attribut, Input hat id. Gap via Token gesteuert."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "None vs Error vs Success — mit Label, Input und ggf. Error-Message",
      "composes": ["form-label", "input", "form-error"],
      "matrix": {
        "axes": { "layout": ["vertical"], "validation": "*", "content": ["minimal"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "validation" },
      "render": { "compositionType": "form-field-validation", "label": "{validation}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Error: Input border-color wechselt zu danger, aria-invalid='true'. Success: border-color wechselt zu success."
      }
    },
    {
      "id": "with-hint",
      "label": "With Hint",
      "description": "Label + Input + Hint unterhalb",
      "composes": ["form-label", "input", "form-hint"],
      "matrix": {
        "axes": { "layout": ["vertical"], "validation": ["none"], "content": ["with-hint"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-hint", "label": "with hint" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Input hat aria-describedby mit Hint-ID. Hint-Text ist sekundaere Farbe."
      }
    },
    {
      "id": "full-composition",
      "label": "Full (Label + Hint + Input + Error)",
      "description": "Vollstaendige Komposition mit allen Slots",
      "composes": ["form-label", "input", "form-hint", "form-error"],
      "matrix": {
        "axes": { "layout": ["vertical"], "validation": ["error"], "content": ["full"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-full", "label": "full" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "aria-describedby auf Input verweist auf Hint- UND Error-ID (Leerzeichen-getrennt). Error hat role='alert'."
      }
    },
    {
      "id": "layout-variants",
      "label": "Vertical vs Horizontal",
      "description": "Standard (vertical) vs Horizontal (Label links, Input rechts)",
      "composes": ["form-label", "input"],
      "matrix": {
        "axes": { "layout": "*", "validation": ["none"], "content": ["minimal"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "layout" },
      "render": { "compositionType": "form-field-layout", "label": "{layout}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Horizontal: Label 200px breit, vertikal ausgerichtet via padding-top. Responsive: unter Tablet faellt auf vertical zurueck."
      }
    },
    {
      "id": "disabled-state",
      "label": "Disabled State",
      "description": "Disabled Form-Field — Label und Hint ausgegraut",
      "composes": ["form-label", "input", "form-hint"],
      "matrix": {
        "axes": { "layout": ["vertical"], "validation": ["none"], "content": ["with-hint"] },
        "states": ["default", "disabled"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-disabled", "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled: Label und Hint erhalten text-disabled Farbe. Kind-Input hat disabled-Attribut."
      }
    }
  ]
}
