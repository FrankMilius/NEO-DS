{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-field",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "form",
      "layout",
      "wrapper"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-field-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_form-field.scss"
      ],
      "story": "stories/molecules/form-field.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/FormFieldArena.vue",
      "drupal": [],
      "docs": "docs/form-field-docs.html"
    },
    "dependencies": [
      "checkbox",
      "form",
      "input",
      "select",
      "textarea"
    ],
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "29.09.2026: requirement ohne Modifier — nc-form-field--required/--optional gab es nie im CSS; Anzeige ueber form-label (indicator)."
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-form-field"
    },
    "slots": [
      {
        "name": "label",
        "element": ".nc-form-label",
        "optional": true
      },
      {
        "name": "hint-above",
        "element": ".nc-form-hint",
        "optional": true
      },
      {
        "name": "control",
        "element": ".nc-input | .nc-textarea | .nc-select | .nc-checkbox",
        "optional": false
      },
      {
        "name": "error",
        "element": ".nc-form-error",
        "optional": true
      },
      {
        "name": "hint-below",
        "element": ".nc-form-hint",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Flex-Column-Container der Label, Input, Hint und Error zusammenfasst.",
      "gap via --nc-form-field-gap (4px) — Label margin-bottom wird auf 0 gesetzt.",
      "Error-Modifier propagiert border-color auf Kind-Inputs (nc-input, nc-textarea, nc-select).",
      "Success-Modifier propagiert success-border-color auf Kind-Inputs.",
      "Disabled-Modifier graut Label und Hint aus (text-disabled, cursor: not-allowed).",
      "Horizontal-Modifier: flex-direction: row ab Tablet, Label 200px breit, Input flex: 1.",
      "Hint kann vor oder nach dem Input platziert werden.",
      "Input hat aria-describedby mit IDs von Hint und/oder Error (Leerzeichen-getrennt).",
      "Required: .nc-form-label__required zeigt '*' (aria-hidden='true'). Der Input bekommt required oder aria-required='true'.",
      "Optional: .nc-form-label__optional zeigt '(Optional)' — optionaler visueller Hinweis.",
      "Fieldset-Gruppierung: Wenn mehrere Form-Fields zusammengehoeren (z.B. Adresse), wird ein <fieldset> mit <legend> statt <div> verwendet. Siehe fieldset-recipe fuer Details."
    ]
  },
  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Anordnung — vertical (Standard, Label oben), horizontal (Label links, Input rechts, ab Tablet)",
      "values": {
        "vertical": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-vertical"
        },
        "horizontal": {
          "modifier": "nc-form-field--horizontal",
          "tokenGroups": [],
          "renderHint": "form-field-horizontal"
        }
      }
    },
    "requirement": {
      "label": "Requirement",
      "description": "Pflichtfeld-Markierung — none (kein Indikator), required (Sternchen '*' am Label), optional ('(Optional)' am Label) — Kompositionsachse: Pflicht/Optional zeigt die Form-Label-Komponente (Slot required/optional), der Wrapper hat dafuer keine eigene Klasse.",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-default"
        },
        "required": {
          "modifier": null,
          "tokenGroups": [
            "requirement"
          ],
          "slotConfig": {
            "label": true
          },
          "renderHint": "form-field-required"
        },
        "optional": {
          "modifier": null,
          "tokenGroups": [
            "requirement"
          ],
          "slotConfig": {
            "label": true
          },
          "renderHint": "form-field-optional"
        }
      }
    },
    "validation": {
      "label": "Validation",
      "description": "Validierungs-State — none (Standard), error (Fehler), success (Erfolg)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-default"
        },
        "error": {
          "modifier": "nc-form-field--error",
          "tokenGroups": [],
          "slotConfig": {
            "error": true
          },
          "renderHint": "form-field-error"
        },
        "success": {
          "modifier": "nc-form-field--success",
          "tokenGroups": [],
          "renderHint": "form-field-success"
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhaltskombination — minimal (Label + Input), with-hint (+ Hint), full (Label + Hint + Input + Error)",
      "values": {
        "minimal": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-minimal"
        },
        "with-hint": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "hint-below": true
          },
          "renderHint": "form-field-hint"
        },
        "full": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "hint-below": true,
            "error": true
          },
          "renderHint": "form-field-full"
        }
      }
    },
    "grouping": {
      "label": "Grouping",
      "description": "Element-Typ — div (Standard-Wrapper), fieldset (semantische Gruppierung mit <legend>)",
      "values": {
        "div": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-div",
          "elementHint": "div"
        },
        "fieldset": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-field-fieldset",
          "elementHint": "fieldset"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "disabled"
    ],
    "precedence": [
      "disabled",
      "default"
    ],
    "rules": [
      {
        "state": "disabled",
        "unless": [],
        "note": "Disabled: Label und Hint werden ausgegraut (text-disabled). Kind-Input ist ebenfalls disabled."
      }
    ],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName"
      ],
      "note": "Form-Field ist ein Layout-Wrapper ohne eigene ARIA-Rolle. Accessibility liegt auf den Kind-Elementen: Label (for), Input (aria-describedby, aria-invalid, aria-required), Error (role='alert'), Hint (id)."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "requirement": [
              "required"
            ]
          }
        },
        "suggest": [
          "aria-required",
          "required"
        ],
        "note": "Required: Kind-Input braucht required-Attribut oder aria-required='true'. Das Sternchen '*' im Label hat aria-hidden='true' — Screen Reader liest aria-required am Input statt das visuelle Zeichen."
      },
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "suggest": [
          "aria-invalid"
        ],
        "note": "Error-State: Kind-Input braucht aria-invalid='true'. Error-Message via aria-describedby verknuepft."
      },
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ],
            "requirement": [
              "required"
            ]
          }
        },
        "suggest": [
          "aria-invalid",
          "aria-required"
        ],
        "note": "Required + Error: Input braucht sowohl aria-invalid='true' als auch required/aria-required='true'. Error-Message erklaert, warum das Pflichtfeld nicht valide ist."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [],
        "note": "Disabled-State: Kind-Input hat disabled-Attribut oder aria-disabled='true'."
      },
      {
        "when": {
          "axes": {
            "grouping": [
              "fieldset"
            ]
          }
        },
        "suggest": [
          "fieldset",
          "legend"
        ],
        "note": "Fieldset-Gruppierung: Root-Element wird zu <fieldset>, Label-Slot wird zu <legend>. Semantische Gruppierung fuer Screen Reader. Kein aria-labelledby noetig wenn <legend> vorhanden."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Kind-Input muss via Label (for-Attribut) oder aria-label benannt sein."
        ]
      },
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "notes": [
          "Error-State erfordert aria-invalid='true' und aria-describedby auf dem Input."
        ]
      },
      {
        "when": {
          "axes": {
            "requirement": [
              "required"
            ]
          }
        },
        "require": [
          "required-attribute"
        ],
        "notes": [
          "Required-Felder muessen required oder aria-required='true' auf dem Input haben.",
          "Das Sternchen '*' ist rein visuell und wird mit aria-hidden='true' vor Screen Readern versteckt.",
          "HTML-Markup: <span class='nc-form-label__required' aria-hidden='true'>*</span>"
        ]
      },
      {
        "when": {
          "axes": {
            "grouping": [
              "fieldset"
            ]
          }
        },
        "require": [
          "native-fieldset",
          "legend"
        ],
        "notes": [
          "Muss natives <fieldset>-Element sein — kein <div role='group'> als Ersatz.",
          "Label wird als <legend> statt <label> gerendert.",
          "Fuer volle Fieldset-Styling-Optionen (Border, Borderless, Nested): siehe fieldset-recipe."
        ]
      }
    ],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-form-field"
    ],
    "baseTokenGroups": [
      "core-geometry"
    ],
    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-form-field-gap"
        ]
      },
      "requirement": {
        "label": "Requirement Indicators",
        "description": "Tokens fuer Pflichtfeld- und Optional-Markierungen im Label",
        "tokens": [
          "nc-form-label-required-color",
          "nc-form-label-optional-color"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.layout.values.*.modifier",
        "axes.requirement.values.*.modifier",
        "axes.validation.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "minimal",
      "label": "Minimal (Label + Input)",
      "description": "Einfachste Form: Label ueber Input",
      "composes": [
        "form-label",
        "input"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "none"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "minimal"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-minimal",
        "label": "minimal"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label hat for-Attribut, Input hat id. Gap via Token gesteuert."
      }
    },
    {
      "id": "requirement-variants",
      "label": "Requirement Variants",
      "description": "None vs Required (*) vs Optional — Label-Indikatoren",
      "composes": [
        "form-label",
        "input"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": "*",
          "validation": [
            "none"
          ],
          "content": [
            "minimal"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "requirement"
      },
      "render": {
        "compositionType": "form-field-requirement",
        "label": "{requirement}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Required: '*' hat aria-hidden='true'. Input hat required/aria-required='true'. Optional: '(Optional)' ist rein visuell."
      }
    },
    {
      "id": "required-with-error",
      "label": "Required + Error",
      "description": "Pflichtfeld im Error-State — typisches Pattern wenn Pflichtfeld leer abgeschickt wird",
      "composes": [
        "form-label",
        "input",
        "form-error"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "required"
          ],
          "validation": [
            "error"
          ],
          "content": [
            "full"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-required-error",
        "label": "required + error"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Input: aria-invalid='true' + aria-required='true' + aria-describedby → Error-ID. '*' hat aria-hidden='true'. Error hat role='alert'."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "None vs Error vs Success — mit Label, Input und ggf. Error-Message",
      "composes": [
        "form-label",
        "input",
        "form-error"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "none"
          ],
          "validation": "*",
          "content": [
            "minimal"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "validation"
      },
      "render": {
        "compositionType": "form-field-validation",
        "label": "{validation}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Error: Input border-color wechselt zu danger, aria-invalid='true'. Success: border-color wechselt zu success."
      }
    },
    {
      "id": "with-hint",
      "label": "With Hint",
      "description": "Label + Input + Hint unterhalb",
      "composes": [
        "form-label",
        "input",
        "form-hint"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "none"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "with-hint"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-hint",
        "label": "with hint"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Input hat aria-describedby mit Hint-ID. Hint-Text ist sekundaere Farbe."
      }
    },
    {
      "id": "full-composition",
      "label": "Full (Label + Hint + Input + Error)",
      "description": "Vollstaendige Komposition mit allen Slots",
      "composes": [
        "form-label",
        "input",
        "form-hint",
        "form-error"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "required"
          ],
          "validation": [
            "error"
          ],
          "content": [
            "full"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-full",
        "label": "full"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "aria-describedby auf Input verweist auf Hint- UND Error-ID (Leerzeichen-getrennt). Error hat role='alert'. '*' hat aria-hidden='true'."
      }
    },
    {
      "id": "layout-variants",
      "label": "Vertical vs Horizontal",
      "description": "Standard (vertical) vs Horizontal (Label links, Input rechts)",
      "composes": [
        "form-label",
        "input"
      ],
      "matrix": {
        "axes": {
          "layout": "*",
          "requirement": [
            "none"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "minimal"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "layout"
      },
      "render": {
        "compositionType": "form-field-layout",
        "label": "{layout}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Horizontal: Label 200px breit, vertikal ausgerichtet via padding-top. Responsive: unter Tablet faellt auf vertical zurueck."
      }
    },
    {
      "id": "disabled-state",
      "label": "Disabled State",
      "description": "Disabled Form-Field — Label und Hint ausgegraut",
      "composes": [
        "form-label",
        "input",
        "form-hint"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "none"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "with-hint"
          ],
          "grouping": [
            "div"
          ]
        },
        "states": [
          "default",
          "disabled"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-disabled",
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled: Label und Hint erhalten text-disabled Farbe. Kind-Input hat disabled-Attribut."
      }
    },
    {
      "id": "fieldset-grouping",
      "label": "Fieldset Grouping",
      "description": "Form-Field als <fieldset> mit <legend> — fuer zusammengehoerige Felder (z.B. Adresse)",
      "composes": [
        "form-label",
        "input",
        "fieldset"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ],
          "requirement": [
            "none"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "minimal"
          ],
          "grouping": [
            "fieldset"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-field-fieldset",
        "label": "fieldset"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Root: <fieldset> statt <div>. Label: <legend> statt <label>. Screen Reader liest Legend als Gruppen-Label. Fuer volle Fieldset-Varianten (Border, Borderless): siehe fieldset-recipe."
      }
    }
  ]
}
