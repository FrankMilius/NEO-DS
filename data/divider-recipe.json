{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "divider",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["static", "layout", "separator"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/divider-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-divider" },
    "slots": [],
    "convenience": [
      { "name": "label-wrapper", "element": ".nc-divider-label", "optional": true, "description": "Flex-Container fuer Divider mit Label-Text (eigene Klasse, kein BEM-Element)" }
    ],
    "domNotes": [
      "Standard: <hr class='nc-divider'>. Nativer role='separator' ist implizit.",
      "Vertikal: .nc-divider--vertical. Braucht aria-orientation='vertical'.",
      "Label-Variante: <div class='nc-divider-label' role='separator'><span>Text</span></div>.",
      "Label-Variante nutzt ::before/::after Pseudo-Elemente fuer die Linien links und rechts.",
      "Spacing-Modifier: --sm (8px), --lg (24px), --none (0).",
      "Style-Modifier: --dashed, --dotted (aendert border-style).",
      "Strong-Modifier: --strong (dickere Linie, staerkere Farbe)."
    ]
  },

  "axes": {
    "orientation": {
      "label": "Orientation",
      "description": "Ausrichtung — horizontal (Standard) oder vertikal",
      "values": {
        "horizontal": { "modifier": null,                    "tokenGroups": [] },
        "vertical":   { "modifier": "nc-divider--vertical",  "tokenGroups": [] }
      }
    },

    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default, strong (dickere Linie), with-label (Text in der Mitte)",
      "values": {
        "default":    { "modifier": null,                    "tokenGroups": [] },
        "strong":     { "modifier": "nc-divider--strong",    "tokenGroups": ["variant-strong"] },
        "with-label": { "modifier": null,                    "tokenGroups": ["variant-label"], "renderHint": "divider-with-label", "elementHint": "div" }
      }
    },

    "style": {
      "label": "Style",
      "description": "Linien-Stil — solid (Standard), dashed, dotted",
      "values": {
        "solid":  { "modifier": null,                    "tokenGroups": [] },
        "dashed": { "modifier": "nc-divider--dashed",    "tokenGroups": [] },
        "dotted": { "modifier": "nc-divider--dotted",    "tokenGroups": [] }
      }
    },

    "spacing": {
      "label": "Spacing",
      "description": "Abstand ober-/unterhalb — sm (8px), md (16px, Standard), lg (24px), none (0)",
      "values": {
        "sm":   { "modifier": "nc-divider--sm",   "tokenGroups": [] },
        "md":   { "modifier": null,               "tokenGroups": [] },
        "lg":   { "modifier": "nc-divider--lg",   "tokenGroups": [] },
        "none": { "modifier": "nc-divider--none", "tokenGroups": [] }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [],
      "note": "Natives <hr> hat implizit role='separator'. Rein dekorativ — kein interaktives Element."
    },
    "overrides": [
      {
        "when": { "axes": { "orientation": ["vertical"] } },
        "require": ["aria-orientation"],
        "note": "Vertikaler Divider braucht aria-orientation='vertical' fuer korrekte Screen-Reader-Semantik."
      },
      {
        "when": { "axes": { "variant": ["with-label"] } },
        "suggest": ["role-separator"],
        "note": "Label-Variante nutzt <div> statt <hr> — braucht explizites role='separator'. Label-Text ist rein dekorativ."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "orientation": ["vertical"] } }, "require": ["aria-orientation"], "notes": ["Vertikaler Divider braucht aria-orientation='vertical'."] },
      { "when": { "axes": { "variant": ["with-label"] } }, "require": ["role-separator"], "notes": ["Label-Variante nutzt <div> — braucht role='separator'."] }
    ],
    "copy": {
      "label": {
        "maxChars": 20,
        "note": "Label-Text soll sehr kurz sein (z.B. 'oder', 'Abschnitt'). Uppercase per CSS."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-divider"],
    "baseTokenGroups": ["core-line"],

    "tokenGroups": {
      "core-line": {
        "label": "Line",
        "tokens": [
          "nc-divider-color",
          "nc-divider-width",
          "nc-divider-style",
          "nc-divider-spacing"
        ]
      },
      "variant-strong": {
        "label": "Strong",
        "tokens": [
          "nc-divider-strong-color",
          "nc-divider-strong-width"
        ]
      },
      "variant-label": {
        "label": "Label",
        "tokens": [
          "nc-divider-label-color",
          "nc-divider-label-size",
          "nc-divider-label-weight",
          "nc-divider-label-gap"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.orientation.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.style.values.*.modifier",
        "axes.spacing.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "orientations",
      "label": "Horizontal vs Vertical",
      "description": "Beide Ausrichtungen im Vergleich",
      "matrix": {
        "axes": { "orientation": "*", "variant": ["default"], "style": ["solid"], "spacing": ["md"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{orientation}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Linie muss 3:1 Kontrast zum Hintergrund haben. Vertikaler Divider braucht aria-orientation='vertical'."
      }
    },
    {
      "id": "variants",
      "label": "Variants — Default / Strong / With Label",
      "description": "Alle visuellen Varianten im Vergleich",
      "matrix": {
        "axes": { "orientation": ["horizontal"], "variant": "*", "style": ["solid"], "spacing": ["md"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-strong", "variant-label"],
      "layout": "row",
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Strong hat dickere Linie + staerkere Farbe. Label-Text muss 4.5:1 Kontrast einhalten."
      }
    },
    {
      "id": "line-styles",
      "label": "Line Styles — Solid / Dashed / Dotted",
      "description": "Alle Linien-Stile im Vergleich",
      "matrix": {
        "axes": { "orientation": ["horizontal"], "variant": ["default"], "style": "*", "spacing": ["md"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{style}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Alle Stile muessen 3:1 Kontrast einhalten. Dashed/Dotted koennen bei sehr kleinen Groessen schwer erkennbar sein."
      }
    },
    {
      "id": "spacing-scale",
      "label": "Spacing Scale",
      "description": "Alle Spacing-Varianten im Vergleich",
      "matrix": {
        "axes": { "orientation": ["horizontal"], "variant": ["default"], "style": ["solid"], "spacing": "*" },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-line"],
      "layout": "row",
      "render": { "label": "{spacing}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Spacing 'none' ist fuer eng gepackte Layouts. Minimum-Spacing sollte der Lesbarkeit dienen."
      }
    },
    {
      "id": "with-label",
      "label": "Divider with Label",
      "description": "Label-Variante mit verschiedenen Texten",
      "matrix": {
        "axes": { "orientation": ["horizontal"], "variant": ["with-label"], "style": ["solid"], "spacing": ["md"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-label"],
      "layout": "row",
      "render": { "label": "with-label" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label-Text (uppercase, xs) muss 4.5:1 Kontrast einhalten. Text ist rein dekorativ — nicht als Heading verwenden."
      }
    },
    {
      "id": "strong-vertical",
      "label": "Strong × Orientation",
      "description": "Strong-Variante in beiden Ausrichtungen",
      "matrix": {
        "axes": { "orientation": "*", "variant": ["strong"], "style": ["solid"], "spacing": ["md"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-strong"],
      "layout": "row",
      "render": { "label": "{orientation}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Strong-Farbe (border-strong) muss in beiden Orientierungen 3:1 Kontrast haben."
      }
    }
  ]
}
