{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-error",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["form", "validation", "feedback"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-error-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-form-error" },
    "slots": [
      { "name": "icon", "element": ".nc-form-error__icon", "optional": true },
      { "name": "text", "element": ".nc-form-error__text", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "Flexbox-Layout: Icon + Text nebeneinander, align-items: flex-start.",
      "Icon ist ein SVG (stroke-basiert, 16px), optisch via margin-top: 0.1em an Text ausgerichtet.",
      "Text erbt Styles vom Block (font-size, color, font-weight).",
      "Wird via aria-describedby am zugehoerigen Input verknuepft (id='error-{name}').",
      "role='alert' fuer sofortige Screenreader-Ansage, aria-live='polite' fuer sanfte Updates."
    ]
  },

  "axes": {
    "content": {
      "label": "Content",
      "description": "Inhaltsvarianten — text-only (nur Text), with-icon (Icon + Text)",
      "values": {
        "text-only": { "modifier": null,  "tokenGroups": [], "renderHint": "form-error-text" },
        "with-icon": { "modifier": null,  "tokenGroups": [], "slotConfig": { "icon": true }, "renderHint": "form-error-icon" }
      }
    },

    "severity": {
      "label": "Severity",
      "description": "Schweregrad der Meldung — error (Fehler, Standard), warning (Warnung), success (Erfolg/Bestaetigung)",
      "values": {
        "error":   { "modifier": null,                        "tokenGroups": [],             "renderHint": "form-error-danger" },
        "warning": { "modifier": "nc-form-error--warning",    "tokenGroups": [],             "renderHint": "form-error-warning" },
        "success": { "modifier": "nc-form-error--success",    "tokenGroups": [],             "renderHint": "form-error-success" }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Error-Message wird via aria-describedby am Input referenziert. role='alert' oder aria-live='polite' fuer dynamische Anzeige. Icon ist dekorativ (aria-hidden='true')."
    },
    "overrides": [
      {
        "when": { "axes": { "severity": ["error"] } },
        "suggest": ["role-alert"],
        "note": "Error: role='alert' fuer sofortige Screenreader-Ansage bei Validierungsfehlern."
      },
      {
        "when": { "axes": { "severity": ["warning", "success"] } },
        "suggest": ["aria-live-polite"],
        "note": "Warning/Success: aria-live='polite' fuer sanftes Update ohne Unterbrechung."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["aria-describedby"], "notes": ["Error-Message muss via aria-describedby mit dem zugehoerigen Input verknuepft sein."] }
    ],
    "copy": {
      "text": {
        "maxChars": 120,
        "note": "Fehlermeldung soll kurz, klar und handlungsorientiert sein."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-form-error"],
    "baseTokenGroups": ["core-geometry", "core-colors"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-form-error-font-size",
          "nc-form-error-font-weight",
          "nc-form-error-icon-size",
          "nc-form-error-gap"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-form-error-color"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.content.values.*.modifier",
        "axes.severity.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "error-default",
      "label": "Error (Default)",
      "description": "Standard-Fehlermeldung mit Icon und Text",
      "matrix": {
        "axes": { "content": ["with-icon"], "severity": ["error"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "error" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Fehler-Farbe (danger) muss 4.5:1 Kontrast gegen Hintergrund haben. role='alert' fuer sofortige Ansage."
      }
    },
    {
      "id": "severity-variants",
      "label": "Severity Variants",
      "description": "Alle Schweregrade im Vergleich: Error, Warning, Success",
      "matrix": {
        "axes": { "content": ["with-icon"], "severity": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "severity" },
      "render": { "label": "{severity}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Severity-Farbe muss 4.5:1 Kontrast haben. Farbe ist nie alleiniges Signal — Icon + Text ergaenzen."
      }
    },
    {
      "id": "content-variants",
      "label": "Content Variants",
      "description": "Text-only vs mit Icon",
      "matrix": {
        "axes": { "content": "*", "severity": ["error"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "content" },
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Text-only funktioniert, aber Icon verbessert Erkennbarkeit. Icon ist aria-hidden='true'."
      }
    },
    {
      "id": "with-input",
      "label": "With Input Field",
      "description": "Fehlermeldung unterhalb eines Input-Feldes (typischer Anwendungsfall)",
      "composes": ["input"],
      "matrix": {
        "axes": { "content": ["with-icon"], "severity": ["error"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-error-with-input", "label": "input + error" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Input hat aria-describedby='error-{name}', Error-Message hat id='error-{name}'. Input-Border wird rot bei Error."
      }
    },
    {
      "id": "multi-line",
      "label": "Multi-Line Error",
      "description": "Fehlermeldung mit langem Text (mehrzeilig)",
      "matrix": {
        "axes": { "content": ["with-icon"], "severity": ["error"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-error-multiline", "label": "multi-line" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon bleibt oben ausgerichtet (flex-start), Text bricht um. line-height: 1.4 fuer Lesbarkeit."
      }
    },
    {
      "id": "form-hint",
      "label": "Form Hint (Related)",
      "description": "Hint-Text unterhalb eines Feldes — verwandte Komponente, aehnliches Pattern",
      "matrix": {
        "axes": { "content": ["text-only"], "severity": ["error"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-hint", "label": "hint" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hint-Text ist sekundaere Farbe (text-secondary). Verknuepft via aria-describedby. Kein role='alert' noetig."
      }
    }
  ]
}
