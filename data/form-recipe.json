{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "form",
      "layout",
      "interactive"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-docs"
    },
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_form.scss"
      ],
      "story": "stories/organisms/form.stories.js",
      "arena": null,
      "drupal": [
        "block--block-content--neo-form.html.twig",
        "block--inline-block--neo-form.html.twig"
      ],
      "docs": null
    },
    "dependencies": [
      "fieldset"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-form"
    },
    "slots": [],
    "convenience": [],
    "domNotes": [
      "Root: <form> mit flex-column Layout. Gap via nc-form-gap (24px).",
      "Enthaelt .nc-form-field, .nc-fieldset, .nc-form-section, .nc-form-actions.",
      "Inline: flex-row, flex-wrap. Fields auto-width. Submit am Ende.",
      "Two-Column: CSS Grid, 1fr mobile → repeat(2,1fr) ab md. Fieldsets/Buttons: grid-column 1/-1.",
      "Disabled: opacity-disabled, pointer-events:none. Native Controls zusaetzlich deaktivieren.",
      "novalidate + Custom-Validation empfohlen."
    ]
  },
  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Layout — vertical (Standard, flex-column), inline (flex-row), two-column (CSS Grid 2-Spalten)",
      "values": {
        "vertical": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-vertical"
        },
        "inline": {
          "modifier": "nc-form--inline",
          "tokenGroups": [],
          "renderHint": "form-inline"
        },
        "two-column": {
          "modifier": "nc-form--two-column",
          "tokenGroups": [],
          "renderHint": "form-two-column"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "disabled"
    ],
    "precedence": [
      "disabled",
      "default"
    ],
    "rules": [
      {
        "state": "disabled",
        "unless": [],
        "note": "Disabled: opacity-disabled, pointer-events:none. Controls muessen separat disabled werden."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName"
      ],
      "note": "<form> mit aria-label oder aria-labelledby. novalidate empfohlen fuer Custom-Validation. Enter submitted das Formular. Screen Reader: Landmark 'Formular'."
    },
    "overrides": [
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [
          "aria-disabled"
        ],
        "note": "Disabled: aria-disabled='true' auf dem <form> plus disabled auf allen Controls."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "form-element",
          "aria-label"
        ],
        "notes": [
          "<form> Element mit aria-label oder aria-labelledby."
        ]
      }
    ],
    "copy": {
      "ariaLabel": {
        "maxChars": 60,
        "note": "aria-label: 'Registrierung', 'Kontaktformular', 'Suchformular'."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-form"
    ],
    "baseTokenGroups": [
      "layout",
      "label",
      "hint",
      "error",
      "field"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-form-gap"
        ]
      },
      "label": {
        "label": "Label",
        "tokens": [
          "nc-form-label-font-size",
          "nc-form-label-font-weight",
          "nc-form-label-color",
          "nc-form-label-gap",
          "nc-form-label-required-color",
          "nc-form-label-optional-color"
        ]
      },
      "hint": {
        "label": "Hint",
        "tokens": [
          "nc-form-hint-font-size",
          "nc-form-hint-color",
          "nc-form-hint-gap"
        ]
      },
      "error": {
        "label": "Error",
        "tokens": [
          "nc-form-error-font-size",
          "nc-form-error-font-weight",
          "nc-form-error-color",
          "nc-form-error-icon-size",
          "nc-form-error-gap"
        ]
      },
      "field": {
        "label": "Field",
        "tokens": [
          "nc-form-field-gap"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.layout.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "layout-variants",
      "label": "Layout Variants",
      "description": "Vertical, Inline, Two-Column Layouts",
      "matrix": {
        "axes": {
          "layout": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "layout"
      },
      "render": {
        "label": "{layout}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle Layouts: gleiche A11y. Two-Column: Reihenfolge row-by-row, nicht column-by-column."
      }
    },
    {
      "id": "vertical-form",
      "label": "Vertical Form",
      "description": "Standard vertikales Formular mit Sections und Actions",
      "composes": [
        "form-field",
        "form-section",
        "form-actions"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-vertical",
        "label": "vertical"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "aria-label auf <form>. Fields mit Labels. Submit-Button am Ende."
      }
    },
    {
      "id": "inline-form",
      "label": "Inline Form",
      "description": "Horizontales Formular (z.B. Suche, Filter)",
      "composes": [
        "form-field",
        "button"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "inline"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-inline",
        "label": "inline"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Inline: Fields und Button in einer Reihe. Wrap bei Platzmangel."
      }
    },
    {
      "id": "two-column-form",
      "label": "Two-Column Form",
      "description": "Responsives 2-Spalten-Grid (mobile: 1 Spalte)",
      "composes": [
        "form-field",
        "fieldset"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "two-column"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-two-column",
        "label": "two-column"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Grid: Tab-Reihenfolge folgt DOM (row-by-row). Fieldsets: grid-column 1/-1."
      }
    },
    {
      "id": "disabled-form",
      "label": "Disabled Form",
      "description": "Deaktiviertes Formular",
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ]
        },
        "states": [
          "disabled"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-disabled",
        "label": "disabled"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "aria-disabled='true' auf <form>. Alle Controls disabled. Opacity-disabled visuell."
      }
    },
    {
      "id": "with-validation",
      "label": "With Validation",
      "description": "Formular mit Validation-Summary und Inline-Fehlern",
      "composes": [
        "validation-summary",
        "form-field",
        "form-error"
      ],
      "matrix": {
        "axes": {
          "layout": [
            "vertical"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-validation",
        "label": "validation"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Validation-Summary am Anfang. Inline-Fehler via aria-describedby. Focus auf Summary nach Submit."
      }
    }
  ]
}
