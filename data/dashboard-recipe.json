{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "dashboard",
    "version": "1.0.0",
    "status": "draft",
    "tags": [
      "templates",
      "layout",
      "app"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/template-dashboard-docs"
    },
    "changelog": [
      {
        "version": "1.0.0",
        "changes": [
          "Plan v3, Phase 5: Recipe angelegt — Anatomie, Achsen und Zustaende aus scss/scss/08-templates/_dashboard.scss; Specimens aus der Doku template-dashboard.",
          "Status draft: Anatomie und Achsen sind aus dem Bestand abgeleitet, nicht entworfen — vor der Freigabe durchsehen."
        ]
      }
    ],
    "layer": "template",
    "pipeline": {
      "scss": [
        "scss/scss/08-templates/_dashboard.scss"
      ],
      "story": "stories/templates/templates.stories.js",
      "arena": null,
      "drupal": [],
      "docs": "/docs/template-dashboard-docs"
    }
  },
  "anatomy": {
    "root": {
      "element": ".t-dashboard"
    },
    "slots": [
      {
        "name": "sidebar",
        "element": ".t-dashboard__sidebar",
        "optional": false,
        "description": "Linke Spalte (<nav>), sticky; unter md ausgeblendet."
      },
      {
        "name": "sidebar-nav",
        "element": ".t-dashboard__sidebar-nav",
        "optional": false,
        "description": "Liste der Links."
      },
      {
        "name": "sidebar-link",
        "element": ".t-dashboard__sidebar-link",
        "optional": false,
        "description": "Link; aria-current=\"page\" fuer die aktuelle Seite."
      },
      {
        "name": "header",
        "element": ".t-dashboard__header",
        "optional": false,
        "description": "Sticky-Kopf mit Seitentitel."
      },
      {
        "name": "title",
        "element": ".t-dashboard__title",
        "optional": false,
        "description": "h1."
      },
      {
        "name": "main",
        "element": ".t-dashboard__main",
        "optional": false,
        "description": "<main>, Spalte mit gap."
      },
      {
        "name": "metrics",
        "element": ".t-dashboard__metrics",
        "optional": true,
        "description": "Raster der Kennzahlen (auto-fit, min 220 px)."
      },
      {
        "name": "metric-card",
        "element": ".t-dashboard__metric-card",
        "optional": true,
        "description": "Kennzahl-Karte (layer-01)."
      },
      {
        "name": "metric-label",
        "element": ".t-dashboard__metric-label",
        "optional": true,
        "description": "Bezeichnung."
      },
      {
        "name": "metric-value",
        "element": ".t-dashboard__metric-value",
        "optional": true,
        "description": "Wert."
      },
      {
        "name": "card",
        "element": ".t-dashboard__card",
        "optional": false,
        "description": "Inhalts-Karte (<section>)."
      },
      {
        "name": "card-header",
        "element": ".t-dashboard__card-header",
        "optional": false,
        "description": "Kopfzeile der Karte."
      },
      {
        "name": "card-title",
        "element": ".t-dashboard__card-title",
        "optional": false,
        "description": "h2."
      }
    ],
    "convenience": [],
    "domNotes": [
      "Im SCSS als DEPRECATED markiert: die Layout-Struktur uebernimmt das Shell-Preset <body data-layout=\"dashboard\"> mit .nc-shell; die Bauteil-Stile bleiben. Kein Verwender auf der Website.",
      "Grid 260px 1fr / auto 1fr, min-height 100vh; geschachtelte Flaechen ueber die Layer-Tokens."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variante",
      "description": "Einzige Variante",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Standard"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Ein h1 im Kopf, h2 je Karte; Sidebar als <nav aria-label>, aktuelle Seite per aria-current."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "t-dashboard"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "description": "Foundation-Tokens, die das SCSS nutzt — das Bauteil hat keine eigenen Komponenten-Tokens.",
        "tokens": [
          "fnd-color-background-base",
          "fnd-color-border-secondary",
          "fnd-color-interactive-default",
          "fnd-color-layer-01",
          "fnd-color-layer-02",
          "fnd-color-on-layer-01",
          "fnd-color-text-on-interactive",
          "fnd-color-text-primary",
          "fnd-color-text-secondary",
          "fnd-content-max-width",
          "fnd-elevation-base",
          "fnd-font-weight-medium",
          "fnd-font-weight-regular",
          "fnd-radius-sm",
          "fnd-spacing-01",
          "fnd-spacing-02",
          "fnd-spacing-03",
          "fnd-spacing-04",
          "fnd-spacing-05",
          "fnd-spacing-06",
          "fnd-z-sticky"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "uebersicht",
      "label": "Uebersicht",
      "description": "Sidebar, Kopf, drei Kennzahlen und eine Inhalts-Karte (Doku).",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "composition",
      "render": {
        "slotConfig": {
          "metrics": true
        }
      }
    },
    {
      "id": "ohne-kennzahlen",
      "label": "Ohne Kennzahlen",
      "description": "Nur Inhalts-Karten (Doku, Abschnitt Ueberschriften).",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "composition",
      "render": {
        "slotConfig": {
          "metrics": false
        }
      }
    }
  ]
}
