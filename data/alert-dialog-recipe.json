{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "alert-dialog",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["overlay", "interactive", "dialog", "confirmation"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/alert-dialog-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-alert-dialog" },
    "slots": [
      { "name": "header", "element": ".nc-alert-dialog__header", "optional": false },
      { "name": "title", "element": ".nc-alert-dialog__title", "optional": false },
      { "name": "description", "element": ".nc-alert-dialog__description", "optional": true },
      { "name": "footer", "element": ".nc-alert-dialog__footer", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "Root: natives <dialog> Element. showModal() fuer modale Anzeige.",
      "Verwendet --nc-dialog-* Tokens (geteilt mit Modal).",
      "Header: flex-column, Title + Description. Gap via header-gap.",
      "Footer: flex, justify-end, Cancel + Action Buttons.",
      "[open]: display:flex. Zentriert via fixed + margin:auto.",
      "Backdrop: ::backdrop mit overlay-bg Fade-in Animation.",
      "Body Scroll Lock: body:has(.nc-alert-dialog[open]) { overflow: hidden }."
    ]
  },
  "axes": {
    "intent": {
      "label": "Intent",
      "description": "Intention — default (neutral), destructive (Loeschen/Gefahr)",
      "values": {
        "default":     { "modifier": null,                            "tokenGroups": [], "renderHint": "alert-dialog-default" },
        "destructive": { "modifier": "nc-alert-dialog--destructive",  "tokenGroups": [], "renderHint": "alert-dialog-destructive" }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhalt — with-description (Title + Description), title-only (nur Title)",
      "values": {
        "with-description": { "modifier": null, "tokenGroups": [], "slotConfig": { "description": true }, "renderHint": "alert-dialog-description" },
        "title-only":       { "modifier": null, "tokenGroups": [], "renderHint": "alert-dialog-title-only" }
      }
    }
  },
  "states": {
    "supported": ["default", "open"],
    "precedence": ["open", "default"],
    "rules": [
      { "state": "open", "unless": [], "note": "Open: display:flex, opacity:1, translate(0,0). Animation via @starting-style." }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Natives <dialog> liefert role='dialog', aria-modal='true' bei showModal(). aria-labelledby → Title. aria-describedby → Description. ESC schliesst nativ. Fokus-Trap nativ. Action-Button mit autofocus."
    },
    "overrides": [
      { "when": { "axes": { "intent": ["destructive"] } }, "suggest": ["autofocus-cancel"], "note": "Destructive: autofocus auf Cancel-Button statt Action, um versehentliches Loeschen zu verhindern." }
    ]
  },
  "constraints": {
    "rules": [
      { "when": {}, "require": ["dialog-element", "aria-labelledby", "aria-describedby"], "notes": ["<dialog> mit showModal(). aria-labelledby → Title, aria-describedby → Description."] }
    ],
    "copy": {
      "title": { "maxChars": 60, "note": "Alert-Titel: 'Eintrag loeschen?', 'Sitzung beenden?', 'Aenderungen verwerfen?'." },
      "description": { "maxChars": 120, "note": "Beschreibung: 'Diese Aktion kann nicht rueckgaengig gemacht werden.'" }
    }
  },
  "styling": {
    "baseClasses": ["nc-alert-dialog"],
    "baseTokenGroups": ["container", "header", "footer"],
    "tokenGroups": {
      "container": {
        "label": "Container",
        "tokens": ["nc-dialog-max-width", "nc-dialog-padding", "nc-dialog-radius", "nc-dialog-bg", "nc-dialog-shadow", "nc-dialog-overlay-bg", "nc-dialog-section-gap"]
      },
      "header": {
        "label": "Header",
        "tokens": ["nc-dialog-title-font-size", "nc-dialog-title-font-weight", "nc-dialog-title-color", "nc-dialog-header-gap"]
      },
      "footer": {
        "label": "Footer",
        "tokens": ["nc-dialog-description-font-size", "nc-dialog-description-color", "nc-dialog-footer-gap"]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses", "axes.intent.values.*.modifier"],
      "tokenGroups": ["styling.baseTokenGroups", "axes.*.values.*.tokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "default", "label": "Default Alert Dialog",
      "description": "Neutraler Bestaetigungsdialog mit Title, Description und Buttons",
      "matrix": { "axes": { "intent": ["default"], "content": ["with-description"] }, "states": ["default"] },
      "layout": "row", "render": { "compositionType": "alert-dialog-default", "label": "default" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "aria-labelledby → Title. aria-describedby → Description. Action: autofocus." }
    },
    {
      "id": "destructive", "label": "Destructive Alert Dialog",
      "description": "Loeschen-Bestaetigungsdialog mit Danger-Button",
      "composes": ["button"],
      "matrix": { "axes": { "intent": ["destructive"], "content": ["with-description"] }, "states": ["default"] },
      "layout": "row", "render": { "compositionType": "alert-dialog-destructive", "label": "destructive" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Destructive: Cancel autofocus. Danger-Button visuell hervorgehoben." }
    },
    {
      "id": "intent-comparison", "label": "Intent Comparison",
      "description": "Default vs Destructive",
      "matrix": { "axes": { "intent": "*", "content": ["with-description"] }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "intent" }, "render": { "label": "{intent}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Default: Action autofocus. Destructive: Cancel autofocus." }
    },
    {
      "id": "content-variants", "label": "Content Variants",
      "description": "With Description vs Title Only",
      "matrix": { "axes": { "intent": ["default"], "content": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "content" }, "render": { "label": "{content}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Title-Only: aria-describedby entfaellt. aria-labelledby genuegt." }
    },
    {
      "id": "session-timeout", "label": "Session Timeout",
      "description": "Typisches Pattern: Sitzung abgelaufen, Verlaengern oder Abmelden",
      "matrix": { "axes": { "intent": ["default"], "content": ["with-description"] }, "states": ["default"] },
      "layout": "row", "render": { "compositionType": "alert-dialog-session", "label": "session" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Session-Timeout: Verlaengern autofocus. Timer ggf. als aria-live Region." }
    },
    {
      "id": "unsaved-changes", "label": "Unsaved Changes",
      "description": "Aenderungen verwerfen Dialog mit 3 Buttons",
      "matrix": { "axes": { "intent": ["destructive"], "content": ["with-description"] }, "states": ["default"] },
      "layout": "row", "render": { "compositionType": "alert-dialog-unsaved", "label": "unsaved" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "3 Buttons: Speichern, Verwerfen, Abbrechen. Cancel (Abbrechen) autofocus." }
    }
  ]
}
