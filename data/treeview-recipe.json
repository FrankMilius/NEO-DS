{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "treeview",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["navigation", "interactive", "hierarchy"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/treeview-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-treeview" },
    "slots": [
      { "name": "node", "element": ".nc-treeview__node", "optional": false },
      { "name": "label", "element": ".nc-treeview__label", "optional": false },
      { "name": "icon", "element": ".nc-treeview__icon", "optional": true },
      { "name": "toggle", "element": ".nc-treeview__toggle", "optional": true },
      { "name": "children", "element": ".nc-treeview__children", "optional": true },
      { "name": "badge", "element": ".nc-treeview__badge", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Hierarchische Baumstruktur mit role=tree und role=treeitem.",
      "Inline-Tokens: --nc-treeview-* (bg, border, radius, padding, gap, icon-size, indent, toggle-size, font-size, line-height, color-*, badge-*).",
      "Varianten: default, bordered, compact, flush. Expand/Collapse mit aria-expanded.",
      "Keyboard: ArrowUp/Down/Left/Right, Enter/Space, Home/End."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default, bordered, compact, flush",
      "values": {
        "default":  { "modifier": null,                     "tokenGroups": [], "renderHint": "treeview-default" },
        "bordered": { "modifier": "nc-treeview--bordered",  "tokenGroups": [], "renderHint": "treeview-bordered" },
        "compact":  { "modifier": "nc-treeview--compact",   "tokenGroups": [], "renderHint": "treeview-compact" },
        "flush":    { "modifier": "nc-treeview--flush",     "tokenGroups": [], "renderHint": "treeview-flush" }
      }
    }
  },
  "states": {
    "supported": ["default", "hover", "active", "focus", "expanded", "selected", "disabled"],
    "precedence": ["disabled", "active", "focus", "selected", "expanded", "hover", "default"],
    "rules": [
      { "state": "expanded", "condition": "aria-expanded=true" },
      { "state": "selected", "condition": "aria-selected=true oder .is-selected" },
      { "state": "disabled", "condition": "aria-disabled=true" }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "role=tree auf Root, role=treeitem auf Nodes. aria-expanded fuer Eltern. Keyboard-Navigation: Pfeiltasten, Enter/Space, Home/End. Focus-Ring auf aktiven Node."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["nc-treeview"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses", "axes.variant.values.*.modifier"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison", "label": "Variants",
      "description": "Default, Bordered, Compact, Flush",
      "matrix": { "axes": { "variant": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "variant" }, "render": { "label": "{variant}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Bordered: border-Kontrast 3:1. Alle: focus-ring auf Nodes." }
    },
    {
      "id": "states", "label": "Interactive States",
      "description": "Hover, Selected, Expanded, Disabled",
      "matrix": { "axes": { "variant": ["default"] }, "states": ["default", "hover", "selected", "expanded", "disabled"] },
      "layout": "grid", "render": { "label": "{state}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Disabled: opacity + aria-disabled. Selected: visuell hervorgehoben." }
    }
  ]
}
