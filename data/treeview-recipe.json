{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "treeview",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "navigation",
      "interactive",
      "hierarchy"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/treeview-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_treeview.scss"
      ],
      "story": "stories/organisms/treeview.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/treeview-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-treeview"
    },
    "slots": [
      {
        "name": "node",
        "element": ".nc-treeview__node",
        "optional": false
      },
      {
        "name": "toggle",
        "element": ".nc-treeview__toggle",
        "optional": true
      },
      {
        "name": "checkbox",
        "element": ".nc-treeview__checkbox",
        "optional": true
      },
      {
        "name": "icon",
        "element": ".nc-treeview__icon",
        "optional": true
      },
      {
        "name": "label",
        "element": ".nc-treeview__label",
        "optional": false
      },
      {
        "name": "badge",
        "element": ".nc-treeview__badge",
        "optional": true
      },
      {
        "name": "actions",
        "element": ".nc-treeview__actions",
        "optional": true
      },
      {
        "name": "drag-handle",
        "element": ".nc-treeview__drag-handle",
        "optional": true
      },
      {
        "name": "children",
        "element": ".nc-treeview__children",
        "optional": true
      }
    ],
    "domNotes": [
      "Hierarchische Baumstruktur mit role=tree und role=treeitem.",
      "Toggle-Chevron rotiert sanft 0° auf 90° bei Expand (CSS transition).",
      "Children-Slot nutzt CSS-Grid 0fr→1fr Animation fuer Slide-Down.",
      "Action-Slot (rechts) wird nur bei Hover/Focus-within sichtbar.",
      "Guide-Lines: Vertikale Linien verbinden Eltern mit Kindern (optional).",
      "Checkbox-Mode: Checkboxen pro Node fuer Multi-Select (aria-checked).",
      "Drag-Handle: 6-dots Griff, nur bei --draggable Modifier sichtbar."
    ]
  },
  "api": {
    "elements": {
      "default": {
        "element": "nav",
        "attributes": [
          "aria-label?"
        ]
      }
    },
    "attributes": [
      {
        "name": "role",
        "appliesTo": [
          "ul"
        ],
        "type": "string",
        "values": [
          "tree",
          "group"
        ]
      },
      {
        "name": "role",
        "appliesTo": [
          "li"
        ],
        "type": "string",
        "values": [
          "treeitem"
        ]
      },
      {
        "name": "aria-expanded",
        "appliesTo": [
          "li"
        ],
        "type": "boolean"
      },
      {
        "name": "aria-selected",
        "appliesTo": [
          "li"
        ],
        "type": "boolean"
      },
      {
        "name": "aria-checked",
        "appliesTo": [
          "li"
        ],
        "type": "string",
        "values": [
          "true",
          "false",
          "mixed"
        ]
      },
      {
        "name": "aria-disabled",
        "appliesTo": [
          "li"
        ],
        "type": "boolean"
      },
      {
        "name": "aria-level",
        "appliesTo": [
          "li"
        ],
        "type": "number"
      },
      {
        "name": "aria-setsize",
        "appliesTo": [
          "li"
        ],
        "type": "number"
      },
      {
        "name": "aria-posinset",
        "appliesTo": [
          "li"
        ],
        "type": "number"
      }
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default, bordered, compact, flush",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "layout",
            "colors"
          ]
        },
        "bordered": {
          "modifier": "nc-treeview--bordered",
          "tokenGroups": [
            "layout",
            "colors",
            "bordered"
          ]
        },
        "compact": {
          "modifier": "nc-treeview--compact",
          "tokenGroups": [
            "layout",
            "colors"
          ]
        },
        "flush": {
          "modifier": "nc-treeview--flush",
          "tokenGroups": [
            "layout",
            "colors"
          ]
        }
      }
    },
    "selection": {
      "label": "Selection Mode",
      "description": "Selektionsmodus — single (aria-selected) oder multiple (Checkboxen)",
      "values": {
        "single": {
          "modifier": null,
          "tokenGroups": []
        },
        "multiple": {
          "modifier": "nc-treeview--checkboxes",
          "tokenGroups": [
            "checkbox"
          ]
        }
      }
    },
    "lines": {
      "label": "Line Style",
      "description": "Vertikale Guide-Lines zur Orientierung in tiefen Baeumen",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "solid": {
          "modifier": "nc-treeview--lines-solid",
          "tokenGroups": [
            "guide-lines"
          ]
        },
        "dashed": {
          "modifier": "nc-treeview--lines-dashed",
          "tokenGroups": [
            "guide-lines"
          ]
        }
      }
    },
    "interaction": {
      "label": "Interaction",
      "description": "Interaktionsmodus — static (nur Expand/Select) oder draggable (Drag & Drop)",
      "values": {
        "static": {
          "modifier": null,
          "tokenGroups": []
        },
        "draggable": {
          "modifier": "nc-treeview--draggable",
          "tokenGroups": [
            "drag-drop"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "active",
      "focus-visible",
      "expanded",
      "selected",
      "disabled"
    ],
    "precedence": [
      "disabled",
      "active",
      "focus-visible",
      "selected",
      "expanded",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "expanded",
        "attributes": {
          "aria-expanded": true
        },
        "note": "Children werden sichtbar. Toggle-Chevron rotiert 90°. CSS-Grid slide-down Animation."
      },
      {
        "state": "selected",
        "attributes": {
          "aria-selected": true
        },
        "note": "Kraeftigere Hintergrundfarbe + Akzent-Border (border-inline-start). Font-weight medium."
      },
      {
        "state": "disabled",
        "effects": [
          "blockInteraction"
        ],
        "attributes": {
          "aria-disabled": true
        },
        "note": "Opacity reduziert, pointer-events: none."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "focusIndicator": "focus-ring mixin, :focus-visible",
      "assertions": [
        "hasAccessibleName",
        "focusIndicatorVisible"
      ],
      "note": "role=tree auf Root-<ul>. role=treeitem auf <li>. role=group auf verschachtelten <ul>. aria-expanded fuer Branch-Items. Keyboard: ArrowUp/Down navigiert, ArrowLeft/Right collapsed/expanded, Home/End springt, Enter/Space selektiert."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "selection": [
              "multiple"
            ]
          }
        },
        "require": [
          "aria-checked"
        ],
        "note": "Im Checkbox-Mode: aria-checked='true|false|mixed'. Eltern-Checkbox nutzt 'mixed' wenn nur einige Kinder ausgewaehlt."
      },
      {
        "when": {
          "axes": {
            "interaction": [
              "draggable"
            ]
          }
        },
        "note": "Drag-Handle benoetigt aria-label='Element verschieben'. Drop-Targets brauchen aria-dropeffect='move'. aria-grabbed auf gezogenem Item."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {
          "axes": {
            "selection": [
              "multiple"
            ]
          }
        },
        "require": [
          "aria-checked"
        ]
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "effects": [
          "blockInteraction"
        ]
      }
    ],
    "copy": {
      "label": {
        "minChars": 1,
        "note": "Node-Labels sollten den Inhalt klar beschreiben. Maximal 2-3 Woerter fuer schmale Sidebars."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-treeview"
    ],
    "baseTokenGroups": [
      "layout",
      "typography",
      "colors"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-treeview-indent",
          "nc-treeview-item-height",
          "nc-treeview-item-height-compact",
          "nc-treeview-item-padding-x",
          "nc-treeview-gap",
          "nc-treeview-radius"
        ]
      },
      "toggle": {
        "label": "Toggle",
        "tokens": [
          "nc-treeview-toggle-size",
          "nc-treeview-toggle-color",
          "nc-treeview-toggle-color-hover",
          "nc-treeview-toggle-transition"
        ]
      },
      "typography": {
        "label": "Typography",
        "tokens": [
          "nc-treeview-label-font-size",
          "nc-treeview-label-color",
          "nc-treeview-label-font-weight",
          "nc-treeview-label-font-weight-selected",
          "nc-treeview-icon-size",
          "nc-treeview-icon-color"
        ]
      },
      "colors": {
        "label": "Colors",
        "tokens": [
          "nc-treeview-bg-hover",
          "nc-treeview-bg-selected",
          "nc-treeview-bg-active",
          "nc-treeview-border-selected",
          "nc-treeview-border-selected-width",
          "nc-treeview-disabled-opacity",
          "nc-treeview-transition-duration"
        ]
      },
      "links": {
        "label": "Links",
        "tokens": [
          "nc-treeview-link-color",
          "nc-treeview-link-color-hover"
        ]
      },
      "guide-lines": {
        "label": "Guide-Lines",
        "tokens": [
          "nc-treeview-guide-color",
          "nc-treeview-guide-width",
          "nc-treeview-guide-style",
          "nc-treeview-guide-opacity"
        ]
      },
      "actions": {
        "label": "Action-Slot",
        "tokens": [
          "nc-treeview-action-gap",
          "nc-treeview-action-color",
          "nc-treeview-action-color-hover",
          "nc-treeview-action-size"
        ]
      },
      "checkbox": {
        "label": "Checkbox",
        "tokens": [
          "nc-treeview-checkbox-size",
          "nc-treeview-checkbox-gap"
        ]
      },
      "badge": {
        "label": "Badge",
        "tokens": [
          "nc-treeview-badge-font-size",
          "nc-treeview-badge-radius",
          "nc-treeview-badge-padding",
          "nc-treeview-badge-bg",
          "nc-treeview-badge-color"
        ]
      },
      "drag-drop": {
        "label": "Drag & Drop",
        "tokens": [
          "nc-treeview-drop-indicator-color",
          "nc-treeview-drop-indicator-width",
          "nc-treeview-drag-opacity"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-treeview-expand-duration"
        ]
      },
      "bordered": {
        "label": "Bordered Variant",
        "tokens": [
          "nc-treeview-bordered-border-color",
          "nc-treeview-bordered-border-width",
          "nc-treeview-bordered-radius",
          "nc-treeview-bordered-padding"
        ]
      }
    },
    "tokenDependencies": [
      {
        "source": "nc-item-gap",
        "target": "nc-treeview-gap",
        "reason": "Abstand zwischen Icon und Label identisch zum Item-Recipe (visuelle Konsistenz)."
      },
      {
        "source": "nc-badge-radius",
        "target": "nc-treeview-badge-radius",
        "reason": "Badges innerhalb des Trees folgen der globalen Badge-Logik."
      }
    ]
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.selection.values.*.modifier",
        "axes.lines.values.*.modifier",
        "axes.interaction.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups",
        "states.rules[*].tokenGroups (matching state)"
      ]
    }
  },
  "keyboard": {
    "ArrowDown": {
      "action": "focus-next-item",
      "note": "Naechster sichtbarer Eintrag (kein Rundum, gesperrte uebersprungen)."
    },
    "ArrowUp": {
      "action": "focus-prev-item",
      "note": "Vorheriger sichtbarer Eintrag."
    },
    "ArrowRight": {
      "action": "expand-or-focus-child",
      "note": "Zweig zu: klappt auf (Fokus bleibt). Zweig offen: erstes Kind. Blatt: nichts."
    },
    "ArrowLeft": {
      "action": "collapse-or-focus-parent",
      "note": "Zweig offen: klappt zu. Sonst: Eltern-Eintrag."
    },
    "Home": {
      "action": "focus-first-item",
      "note": "Erster Eintrag des Baums."
    },
    "End": {
      "action": "focus-last-item",
      "note": "Letzter sichtbarer Eintrag."
    },
    "Enter": {
      "action": "select",
      "note": "Waehlt den Eintrag (single: aria-selected) bzw. hakt ihn an (multiple: aria-checked samt Nachfahren). Steht ein Link in der Zeile (__link), folgt Enter ihm."
    },
    "Space": {
      "action": "select",
      "note": "Wie Enter, ohne dem Link zu folgen."
    },
    "Tab": {
      "action": "leave-tree",
      "note": "Genau eine Zeile (.nc-treeview__node) ist im Tab-Fluss (roving tabindex); Tab verlaesst den Baum."
    }
  },
  "events": {
    "treeview-toggle": {
      "bubbles": true,
      "detail": {
        "value": "string",
        "expanded": "boolean"
      },
      "note": "Gefeuert beim Auf- und Zuklappen eines Zweigs."
    },
    "treeview-select": {
      "bubbles": true,
      "detail": {
        "value": "string",
        "selected": "boolean",
        "values": "string[]"
      },
      "note": "Gefeuert bei Auswahl (single) bzw. Anhaken (multiple). values: alle gewaehlten Eintraege nach der Aenderung."
    }
  },
  "specimens": [
    {
      "id": "variant-comparison",
      "label": "Variants",
      "description": "Default, Bordered, Compact, Flush — je mit 3 Ebenen",
      "matrix": {
        "axes": {
          "variant": "*",
          "selection": [
            "single"
          ],
          "lines": [
            "none"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Bordered: Border-Kontrast 3:1. Alle: focus-ring auf Nodes."
      }
    },
    {
      "id": "states",
      "label": "Interactive States",
      "description": "Hover, Selected, Expanded, Disabled nebeneinander",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "none"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default",
          "hover",
          "selected",
          "expanded",
          "disabled"
        ]
      },
      "layout": "grid",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled: opacity + aria-disabled. Selected: kraeftige Hervorhebung."
      }
    },
    {
      "id": "guide-lines",
      "label": "Guide-Lines",
      "description": "Vertikale Verbindungslinien: none vs. solid vs. dashed",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": "*",
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "guide-lines"
      ],
      "layout": "grid",
      "layoutConfig": {
        "colAxis": "lines"
      },
      "render": {
        "label": "{lines}"
      }
    },
    {
      "id": "checkbox-mode",
      "label": "Checkbox Multi-Select",
      "description": "Checkboxen pro Node mit Mixed-State auf Eltern",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "multiple"
          ],
          "lines": [
            "solid"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "checkbox"
      ],
      "layout": "row",
      "render": {
        "label": "Multi-Select Tree"
      },
      "a11y": {
        "note": "aria-checked='true|false|mixed'. Eltern mit teilweise ausgewaehlten Kindern nutzen 'mixed'."
      }
    },
    {
      "id": "with-actions",
      "label": "With Actions",
      "description": "Kontextuelle Aktionen (Drei-Punkte-Menue, Loeschen) bei Hover sichtbar",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "none"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "actions"
      ],
      "layout": "row",
      "render": {
        "label": "Tree with Actions",
        "slotConfig": {
          "actions": true
        }
      }
    },
    {
      "id": "with-badges",
      "label": "With Badges",
      "description": "Count-Badges an Nodes (z.B. Anzahl Kinder, ungelesene Items)",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "none"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "badge"
      ],
      "layout": "row",
      "render": {
        "label": "Tree with Badges",
        "slotConfig": {
          "badge": true
        }
      }
    },
    {
      "id": "drag-drop",
      "label": "Drag & Drop",
      "description": "Draggable Nodes mit Drop-Indikatoren (before/inside/after)",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "solid"
          ],
          "interaction": [
            "draggable"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "drag-drop"
      ],
      "layout": "row",
      "render": {
        "label": "Draggable Tree"
      },
      "a11y": {
        "note": "Drag-Handle: aria-label='Element verschieben'. aria-grabbed auf gezogenem Item."
      }
    },
    {
      "id": "deep-hierarchy",
      "label": "Deep Hierarchy (5 Levels)",
      "description": "Tiefer Baum mit Guide-Lines und Compact-Density",
      "matrix": {
        "axes": {
          "variant": [
            "compact"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "solid"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "layout",
        "guide-lines"
      ],
      "layout": "row",
      "render": {
        "label": "5-Level Deep Tree"
      }
    },
    {
      "id": "file-explorer",
      "label": "File Explorer Pattern",
      "description": "Icons + Actions + Badges — typisches File-Explorer Layout",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "selection": [
            "single"
          ],
          "lines": [
            "solid"
          ],
          "interaction": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "actions",
        "badge",
        "guide-lines"
      ],
      "layout": "row",
      "render": {
        "label": "File Explorer",
        "slotConfig": {
          "icon": true,
          "actions": true,
          "badge": true
        }
      }
    }
  ]
}
