{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "rating",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["interactive", "form", "feedback"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/rating-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-rating" },
    "slots": [
      { "name": "input", "element": ".nc-rating__input", "optional": true },
      { "name": "item", "element": ".nc-rating__item", "optional": false },
      { "name": "value", "element": ".nc-rating__value", "optional": true },
      { "name": "count", "element": ".nc-rating__count", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Interaktiv: <div class='nc-rating' role='radiogroup' aria-label='Bewertung'> mit versteckten Radio-Inputs + Labels.",
      "Jeder Stern: <input type='radio' class='nc-rating__input' name='rating' value='N'> + <label class='nc-rating__item'>.",
      "Readonly: <div class='nc-rating nc-rating--readonly' role='img' aria-label='Bewertung: 4 von 5 Sternen'>.",
      "Items mit --active Modifier sind gefuellte Sterne, --half fuer halbe Sterne.",
      "Hover: Sterne bis zum Cursor leuchten auf (warning-Farbe). Scale(1.15) auf Hover-Stern.",
      "Focus: :focus-visible auf dem versteckten Input → focus-ring auf dem zugehoerigen Label.",
      "Value (__value): Numerischer Wert neben den Sternen (z.B. '4.5').",
      "Count (__count): Anzahl Bewertungen (z.B. '(128 Bewertungen)').",
      "Forced-Colors: active = Highlight, inactive = ButtonText (High Contrast Mode)."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (18px) / md (24px, Standard) / lg (36px)",
      "values": {
        "sm": { "modifier": "nc-rating--sm", "tokenGroups": [] },
        "md": { "modifier": null,            "tokenGroups": [] },
        "lg": { "modifier": "nc-rating--lg", "tokenGroups": [] }
      }
    },

    "mode": {
      "label": "Mode",
      "description": "Interaktions-Modus — interactive (Radio-Inputs, klickbar), readonly (nur Anzeige, keine Interaktion)",
      "values": {
        "interactive": { "modifier": null,                   "tokenGroups": [],               "elementHint": "radiogroup", "renderHint": "rating-interactive" },
        "readonly":    { "modifier": "nc-rating--readonly",  "tokenGroups": [],               "elementHint": "img",        "renderHint": "rating-readonly" }
      }
    },

    "display": {
      "label": "Display",
      "description": "Anzeige-Optionen — stars-only (nur Sterne), with-value (Sterne + Zahl), with-count (Sterne + Zahl + Anzahl)",
      "values": {
        "stars-only": { "modifier": null, "tokenGroups": [],                                                               "renderHint": "rating-stars" },
        "with-value": { "modifier": null, "tokenGroups": [], "slotConfig": { "value": true },                              "renderHint": "rating-value" },
        "with-count": { "modifier": null, "tokenGroups": [], "slotConfig": { "value": true, "count": true },               "renderHint": "rating-count" }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus", "disabled"],
    "precedence": ["disabled", "focus", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": ["disabled"],  "note": "Hover nur im interactive-Modus auf nicht-disabled Items. Sterne leuchten auf." },
      { "state": "focus", "unless": ["disabled"],  "note": "Focus-Ring auf dem Label des fokussierten Radio-Inputs." },
      { "state": "disabled", "unless": [],         "note": "Reduzierte Opacity, pointer-events: none." }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Interaktiv: role='radiogroup' + aria-label auf Container. Jeder Stern ist ein Radio-Input mit Label. Arrow-Keys navigieren. Readonly: role='img' + aria-label mit Wert."
    },
    "overrides": [
      {
        "when": { "axes": { "mode": ["readonly"] } },
        "require": ["role-img", "aria-label"],
        "note": "Readonly braucht role='img' und aria-label='Bewertung: X von Y Sternen'. Keine Interaktion."
      },
      {
        "when": { "axes": { "mode": ["interactive"] } },
        "require": ["role-radiogroup", "aria-label"],
        "note": "Interaktiv: role='radiogroup' + aria-label. Jeder Stern braucht eigenen Radio-Input mit zugehoerigem Label."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": ["aria-disabled"],
        "note": "aria-disabled='true' auf dem Container. Opacity reduziert, keine Interaktion."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "mode": ["interactive"] } }, "require": ["role-radiogroup", "accessible-name"], "notes": ["Interaktiver Modus braucht role='radiogroup' und aria-label."] },
      { "when": { "axes": { "mode": ["readonly"] } }, "require": ["role-img", "aria-label"], "notes": ["Readonly braucht role='img' und aria-label mit Wert."] }
    ],
    "copy": {
      "ariaLabel": {
        "maxChars": 50,
        "note": "aria-label beschreibt den Wert: 'Bewertung: 4 von 5 Sternen' oder 'Bewertung abgeben'."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-rating"],
    "baseTokenGroups": ["core-geometry", "core-colors"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-rating-size",
          "nc-rating-gap"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-rating-color-active",
          "nc-rating-color-inactive",
          "nc-rating-hover-color"
        ]
      },
      "state-disabled": {
        "label": "Disabled",
        "tokens": [
          "nc-rating-disabled-opacity"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.mode.values.*.modifier",
        "axes.display.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "interactive-states",
      "label": "Interactive States",
      "description": "Interaktives Rating in allen Zustaenden",
      "matrix": {
        "axes": { "size": ["md"], "mode": ["interactive"], "display": ["stars-only"] },
        "states": ["default", "hover", "focus", "disabled"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Active-Sterne (warning-Farbe) muessen 3:1 Kontrast gegen BG haben. Focus-Ring auf dem aktuellen Stern. Hover leuchtet alle Sterne bis zum Cursor auf."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "mode": ["readonly"], "display": ["stars-only"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-geometry"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Stern-Groesse skaliert via calc() (0.75×, 1×, 1.5×). Gap bleibt konstant."
      }
    },
    {
      "id": "interactive-vs-readonly",
      "label": "Interactive vs Readonly",
      "description": "Vergleich beider Modi mit 4 von 5 Sternen",
      "matrix": {
        "axes": { "size": ["md"], "mode": "*", "display": ["stars-only"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "mode" },
      "render": { "label": "{mode}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Interactive: role='radiogroup', cursor:pointer. Readonly: role='img', pointer-events:none. Visuell identisch."
      }
    },
    {
      "id": "display-options",
      "label": "Display Options",
      "description": "Stars-only vs mit Wert vs mit Wert + Anzahl",
      "matrix": {
        "axes": { "size": ["md"], "mode": ["readonly"], "display": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "display" },
      "render": { "label": "{display}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Value und Count sind Text-Elemente — brauchen 4.5:1 Kontrast. aria-label auf dem Container traegt den vollen Wert unabhaengig von sichtbaren Elementen."
      }
    },
    {
      "id": "half-stars",
      "label": "Half Star Values",
      "description": "Verschiedene Bewertungswerte mit halben Sternen (2.5, 3.5, 4.5)",
      "matrix": {
        "axes": { "size": ["md"], "mode": ["readonly"], "display": ["with-value"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "half-stars" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Halbe Sterne: linke Haelfte aktiv, rechte inaktiv. Via Clip-Path oder SVG-Gradient. aria-label muss den genauen Wert enthalten."
      }
    },
    {
      "id": "error-state",
      "label": "Error State",
      "description": "Rating mit Error-Markierung (Pflichtfeld nicht ausgefuellt)",
      "matrix": {
        "axes": { "size": ["md"], "mode": ["interactive"], "display": ["stars-only"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "error" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error: Sterne in Error-Farbe (nc-input-border-error). Zusaetzlich Fehlermeldung via aria-describedby. Farbe nie alleiniges Signal."
      }
    }
  ]
}
