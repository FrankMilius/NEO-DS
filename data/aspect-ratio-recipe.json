{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "aspect-ratio",
    "version": "1.1.0",
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "06.10.2026 (Plan v3, Phase 4, duenne Recipes): Specimen eigenes-verhaeltnis (Instanzwert --nc-aspect-ratio-ratio statt Preset-Modifier)",
          "Form ans Schema angeglichen: Achse ratio als Objekt (Werte mit tokenGroups), states mit default, Specimen-Layout row"
        ]
      }
    ],
    "status": "stable",
    "tags": [
      "layout",
      "object",
      "media"
    ],
    "links": {
      "docs": "/docs/media-ratios-docs"
    },
    "layer": "unknown",
    "pipeline": {
      "scss": [],
      "story": null,
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": null
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-aspect-ratio"
    },
    "slots": [
      {
        "name": "content",
        "element": ".nc-aspect-ratio__content",
        "optional": false,
        "description": "Child-Element (img, video, iframe). Fuellt Container absolut."
      }
    ],
    "domNotes": [
      "Nutzt native CSS aspect-ratio Property.",
      "Alle Ratios ueber --nc-aspect-ratio-ratio Token steuerbar.",
      "Custom Ratio via Inline-Style: style=\"--nc-aspect-ratio-ratio: 21 / 9\".",
      "Reines Layout-Primitive — keine ARIA-Attribute noetig. Semantik kommt vom Child."
    ]
  },
  "axes": {
    "ratio": {
      "label": "Seitenverhaeltnis",
      "description": "Vordefiniertes Seitenverhaeltnis.",
      "values": {
        "1-1": {
          "modifier": "nc-aspect-ratio--1-1",
          "label": "Square (1:1)",
          "tokenGroups": []
        },
        "4-3": {
          "modifier": "nc-aspect-ratio--4-3",
          "label": "Landscape Klassisch (4:3)",
          "tokenGroups": []
        },
        "3-4": {
          "modifier": "nc-aspect-ratio--3-4",
          "label": "Portrait Klassisch (3:4)",
          "tokenGroups": []
        },
        "16-9": {
          "modifier": "nc-aspect-ratio--16-9",
          "label": "Widescreen (16:9, Default)",
          "default": true,
          "tokenGroups": []
        },
        "9-16": {
          "modifier": "nc-aspect-ratio--9-16",
          "label": "Vertikal / Stories (9:16)",
          "tokenGroups": []
        },
        "2-1": {
          "modifier": "nc-aspect-ratio--2-1",
          "label": "Panorama (2:1)",
          "tokenGroups": []
        },
        "1-2": {
          "modifier": "nc-aspect-ratio--1-2",
          "label": "Tall Portrait (1:2)",
          "tokenGroups": []
        },
        "3-2": {
          "modifier": "nc-aspect-ratio--3-2",
          "label": "Classic Landscape (3:2)",
          "tokenGroups": []
        },
        "2-3": {
          "modifier": "nc-aspect-ratio--2-3",
          "label": "Classic Portrait (2:3)",
          "tokenGroups": []
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": []
  },
  "styling": {
    "baseClasses": [
      ".nc-aspect-ratio"
    ],
    "tokenGroups": {
      "aspect-ratio": {
        "label": "Aspect Ratio",
        "tokens": [
          {
            "token": "nc-aspect-ratio-ratio",
            "property": "aspect-ratio",
            "description": "Seitenverhaeltnis (z.B. 16/9)"
          }
        ]
      }
    }
  },
  "specimens": [
    {
      "id": "all-ratios",
      "label": "Alle Seitenverhaeltnisse",
      "matrix": {
        "axes": {
          "ratio": "*"
        }
      },
      "layout": "row"
    },
    {
      "id": "eigenes-verhaeltnis",
      "label": "Eigenes Verhältnis",
      "description": "Eigenes Verhältnis als Instanzwert über die Komponenten-Variable (style=\"--nc-aspect-ratio-ratio: 21 / 9\"), wie im SCSS-Kopf beschrieben — überschreibt das Preset 16:9 am selben Element.",
      "matrix": {
        "axes": {
          "ratio": [
            "16-9"
          ]
        },
        "states": [
          "default"
        ]
      },
      "render": {
        "eigenesVerhaeltnis": "21 / 9",
        "label": "Eigenes Verhältnis 21:9"
      },
      "layout": "row"
    }
  ],
  "a11y": {
    "base": {
      "role": null,
      "assertions": [
        "Reines Layout-Primitive, keine eigene Semantik. Alt-Text und ARIA kommen vom Child-Element (img, video)."
      ]
    }
  }
