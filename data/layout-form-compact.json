{
  "$schema": "./layout-spec-schema.json",
  "meta": {
    "id": "layout-form-compact",
    "label": "Form Compact",
    "description": "Kompaktes Formular-Layout mit reduziertem Padding. Fuer Inline-Formulare und modale Dialoge.",
    "extends": "layout-form",
    "tags": ["form", "compact", "inline"],
    "templateClass": ".t-form-compact"
  },
  "container": {
    "ref": "container.narrow",
    "overrides": {}
  },
  "grid": {
    "ref": "grid.default",
    "overrides": {}
  },
  "spacing": {
    "ref": "spacing.element",
    "overrides": {}
  },
  "section": {
    "ref": "section.compact",
    "overrides": {}
  }
}
