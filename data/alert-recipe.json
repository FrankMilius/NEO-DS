{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "alert",
    "version": "2.0.0",
    "status": "stable",
    "tags": ["static", "feedback", "notification", "inline"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/alert-docs"
    },
    "changelog": [
      { "version": "2.0.0", "changes": ["Progressive Disclosure: Details-Slot (Accordion-Toggle) fuer lange Fehlermeldungen", "Inline-Variante: Ohne Hintergrund, nur Icon + farbiger Text — subtiles Feedback an Eingabefeldern", "Banner-Abgrenzung: Klare semantische Trennung (Banner = Global, Alert = Kontextuell/Lokal)", "Neue Tokens: title-font-weight, description-opacity, close-size, inline-gap, inline-font-size, details-margin-top, details-font-size", "Visuelle Konsistenz: Alert-Danger und Alert-Dialog-Destructive teilen identische Farbsprache"] },
      { "version": "1.0.0", "changes": ["Initiales Recipe: 4 Varianten, Icon + Content + Action + Close, role=alert/status"] }
    ]
  },

  "anatomy": {
    "root": { "element": ".nc-alert" },
    "slots": [
      { "name": "icon", "element": ".nc-alert__icon", "optional": true },
      { "name": "content", "element": ".nc-alert__content", "optional": false },
      { "name": "title", "element": ".nc-alert__title", "optional": true },
      { "name": "description", "element": ".nc-alert__description", "optional": true },
      { "name": "details", "element": ".nc-alert__details", "optional": true },
      { "name": "action", "element": ".nc-alert__action", "optional": true },
      { "name": "close", "element": ".nc-alert__close", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Alert ist ein <div class='nc-alert' role='alert|status'>.",
      "Layout: Flex Row — Icon | Content (Title + Description + Details + Action) | Close.",
      "4 semantische Varianten: info (Standard), success, warning, danger.",
      "role='alert' fuer danger/warning (urgent, unterbricht Screen Reader).",
      "role='status' fuer info/success (polite, unterbricht nicht).",
      "Icon ist aria-hidden='true' — Text liefert die Information.",
      "Close-Button braucht aria-label='Schliessen'.",
      "Details-Slot: Natives <details> Element fuer Progressive Disclosure. Toggle zeigt/verbirgt Zusatzinformationen (z.B. Stacktrace, Validierungsdetails).",
      "Inline-Variante (--inline): Kein Hintergrund, kein Border, kein Padding. Nur Icon + farbiger Text. Ideal als Alternative zu form-hint direkt an Eingabefeldern.",
      "Banner-Abgrenzung: Alert ist kontextuell/lokal (innerhalb einer Section). Banner (.nc-banner) ist global (oberer Seitenrand, volle Breite, sticky). Verwende Alert fuer Formular-Feedback, Banner fuer systemweite Meldungen.",
      "Deprecated: --destructive ist Alias fuer --danger.",
      "Farbe nie alleiniges Signal — immer mit Icon + Text (R7)."
    ]
  },

  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Semantische Feedback-Variante — info (Standard, blau), success (gruen), warning (gelb/orange), danger (rot)",
      "values": {
        "info":    { "modifier": "nc-alert--info",     "tokenGroups": ["variant-info"] },
        "success": { "modifier": "nc-alert--success",  "tokenGroups": ["variant-success"] },
        "warning": { "modifier": "nc-alert--warning",  "tokenGroups": ["variant-warning"] },
        "danger":  { "modifier": "nc-alert--danger",   "tokenGroups": ["variant-danger"] }
      }
    },

    "content": {
      "label": "Content",
      "description": "Inhalts-Komposition — title-only, full, with-action, dismissible, with-details",
      "values": {
        "title-only":    { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true },                                                               "renderHint": "alert-title-only" },
        "full":          { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true, "description": true },                                           "renderHint": "alert-full" },
        "with-action":   { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true, "description": true, "action": true },                           "renderHint": "alert-with-action" },
        "dismissible":   { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true, "description": true, "close": true },                            "renderHint": "alert-dismissible" },
        "with-details":  { "modifier": null, "tokenGroups": ["details"], "slotConfig": { "title": true, "description": true, "details": true },                 "renderHint": "alert-with-details" }
      }
    },

    "display": {
      "label": "Display",
      "description": "Darstellungsmodus — block (Standard mit Hintergrund), inline (nur Icon + Text)",
      "values": {
        "block":  { "modifier": null,                  "tokenGroups": [] },
        "inline": { "modifier": "nc-alert--inline",    "tokenGroups": ["inline"] }
      }
    }
  },

  "states": {
    "supported": ["default"],
    "precedence": ["default"],
    "rules": [],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Alert braucht role='alert' (danger/warning) oder role='status' (info/success). Icon ist aria-hidden='true'. Farbe nie alleiniges Signal."
    },
    "overrides": [
      {
        "when": { "axes": { "variant": ["danger", "warning"] } },
        "require": ["role-alert"],
        "note": "role='alert' erzeugt implizit aria-live='assertive' — unterbricht Screen Reader sofort."
      },
      {
        "when": { "axes": { "variant": ["info", "success"] } },
        "suggest": ["role-status"],
        "note": "role='status' erzeugt implizit aria-live='polite' — kuendigt an, ohne zu unterbrechen."
      },
      {
        "when": { "axes": { "content": ["dismissible"] } },
        "require": ["aria-label"],
        "note": "Close-Button braucht aria-label='Schliessen' oder aequivalent."
      },
      {
        "when": { "axes": { "content": ["with-details"] } },
        "suggest": ["aria-expanded"],
        "note": "Details-Toggle: Natives <details> liefert semantisch korrektes Disclosure-Pattern. Zusaetzlich aria-expanded auf <summary> empfohlen fuer aeltere Screen Reader."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "variant": ["danger", "warning"] } }, "require": ["role-alert"], "notes": ["Danger/Warning braucht role='alert'."] },
      { "when": { "axes": { "content": ["dismissible"] } }, "require": ["aria-label"], "notes": ["Close-Button braucht aria-label."] }
    ],
    "copy": {
      "title": {
        "maxChars": 60,
        "note": "Titel soll kurz und praegnant sein."
      },
      "description": {
        "maxChars": 200,
        "note": "Beschreibung ergaenzt den Titel mit Details oder Handlungsanweisungen."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-alert"],
    "baseTokenGroups": ["core-geometry"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry & Typography",
        "tokens": [
          "nc-alert-padding",
          "nc-alert-radius",
          "nc-alert-border-width",
          "nc-alert-icon-size",
          "nc-alert-gap",
          "nc-alert-title-font-weight",
          "nc-alert-description-opacity",
          "nc-alert-close-size"
        ]
      },
      "variant-info": {
        "label": "Info Colors",
        "tokens": [
          "nc-alert-info-bg",
          "nc-alert-info-color",
          "nc-alert-info-border",
          "nc-alert-info-icon-color"
        ]
      },
      "variant-success": {
        "label": "Success Colors",
        "tokens": [
          "nc-alert-success-bg",
          "nc-alert-success-color",
          "nc-alert-success-border",
          "nc-alert-success-icon-color"
        ]
      },
      "variant-warning": {
        "label": "Warning Colors",
        "tokens": [
          "nc-alert-warning-bg",
          "nc-alert-warning-color",
          "nc-alert-warning-border",
          "nc-alert-warning-icon-color"
        ]
      },
      "variant-danger": {
        "label": "Danger Colors",
        "tokens": [
          "nc-alert-danger-bg",
          "nc-alert-danger-color",
          "nc-alert-danger-border",
          "nc-alert-danger-icon-color"
        ]
      },
      "inline": {
        "label": "Inline Variant",
        "tokens": [
          "nc-alert-inline-gap",
          "nc-alert-inline-font-size"
        ]
      },
      "details": {
        "label": "Details Toggle",
        "tokens": [
          "nc-alert-details-margin-top",
          "nc-alert-details-font-size"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.content.values.*.modifier",
        "axes.display.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants",
      "description": "Alle 4 semantischen Varianten mit Titel + Beschreibung",
      "matrix": {
        "axes": { "variant": "*", "content": ["full"], "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Variante muss 4.5:1 Text-Kontrast gegen ihren BG haben. Border-Farbe muss 3:1 gegen Seiten-BG einhalten. Icon-Farbe verstaerkt die semantische Bedeutung."
      }
    },
    {
      "id": "content-compositions",
      "label": "Content Compositions",
      "description": "Verschiedene Inhalts-Kombinationen der Info-Variante",
      "matrix": {
        "axes": { "variant": ["info"], "content": "*", "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "content" },
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Title-only ist minimale Form. Dismissible: Close-Button braucht aria-label. With-action: Action-Button erbt nicht die Alert-Farbe. With-details: Natives <details> fuer Progressive Disclosure."
      }
    },
    {
      "id": "dismissible-variants",
      "label": "Dismissible Variants",
      "description": "Alle Varianten mit Close-Button",
      "composes": ["close"],
      "matrix": {
        "axes": { "variant": "*", "content": ["dismissible"], "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Close-Button: aria-label='Schliessen'. Hover zeigt opacity:1 + color-mix BG. Focus braucht sichtbaren Ring."
      }
    },
    {
      "id": "with-action-variants",
      "label": "With Action Button",
      "description": "Alle Varianten mit Action-Button",
      "composes": ["action"],
      "matrix": {
        "axes": { "variant": "*", "content": ["with-action"], "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Action-Button ist eigenstaendiges interaktives Element innerhalb des Alerts. Muss eigenen Kontrast einhalten."
      }
    },
    {
      "id": "title-only-variants",
      "label": "Title Only — Compact",
      "description": "Minimale Form: nur Titel, alle Varianten",
      "matrix": {
        "axes": { "variant": "*", "content": ["title-only"], "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Kompakte Form — Icon + Titel reichen fuer einfache Nachrichten. Titel traegt die gesamte Information."
      }
    },
    {
      "id": "danger-detail",
      "label": "Danger — Role Alert Detail",
      "description": "Danger-Variante in allen Content-Kompositionen (role='alert')",
      "matrix": {
        "axes": { "variant": ["danger"], "content": "*", "display": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "content" },
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Danger nutzt role='alert' (assertive). Screen Reader unterbricht sofort. Sparsam einsetzen — nur fuer echte Fehler/Gefahren."
      }
    },
    {
      "id": "progressive-disclosure",
      "label": "Progressive Disclosure",
      "description": "Alert mit Details-Toggle fuer lange Fehlermeldungen",
      "matrix": {
        "axes": { "variant": ["danger", "warning"], "content": ["with-details"], "display": ["block"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["details"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant} + details" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Details-Toggle: Natives <details> liefert Disclosure-Semantik. Verbirgt lange Validierungsdetails oder Stacktraces hinter einem Toggle."
      }
    },
    {
      "id": "inline-variants",
      "label": "Inline Feedback",
      "description": "Inline-Variante ohne Hintergrund — subtiles Feedback an Eingabefeldern",
      "matrix": {
        "axes": { "variant": "*", "content": ["full"], "display": ["inline"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["inline"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant" },
      "render": { "label": "{variant} inline" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Inline-Alert: Kein BG/Border — Icon-Farbe und Text muessen gegen den Seiten-Hintergrund 4.5:1 Kontrast einhalten."
      }
    }
  ]
}
