          },
          {
            "token": "fnd-color-text-on-interactive",
            "role": "Primaere Textfarbe (invertiert)"
          },
          {
            "token": "fnd-color-on-accent",
            "role": "Sekundaere Textfarbe (on-accent)"
          },
          {
            "token": "nc-section-accent-color-secondary",
            "role": "Divider-Farbe auf Akzent"
          }
        ]
      }
    ]
  },
  "website": {
    "description": "Klassen, die die Website (Drupal, Theme neo_fe) fuer diesen Baustein setzt. Sie stehen in styles.css (aufgenommen aus neo-overrides.css) und werden hier nur beschrieben — Aenderungen daran sind website-sichtbar und brauchen eine Freigabe.",
    "klassen": [
      {
        "klasse": "nc-section",
        "element": "section",
        "scss": "scss/scss/04-objects/_section.scss",
        "beschreibung": "Abschnitt der Website: padding-block aus --nc-section-padding-block (Fallback --fnd-spacing-10). Kein Hintergrund (ausser mit --muted), keine Dichte-Modifier. Mit .nc-text-media darin: position relative, overflow hidden, der Container darueber (z-index 2).",
        "tokens": [
          "nc-section-padding-block",
          "fnd-spacing-10"
        ],
        "markup": "<section class=\"nc-section\"><div class=\"nc-container\">…</div></section>",
        "specimen": "website-nc-section"
      },
      {
        "klasse": "nc-section--full",
        "basis": "nc-section",
        "element": "section",
        "scss": "scss/scss/04-objects/_section.scss",
        "beschreibung": "Randloser Abschnitt: padding-block 0, der Inhalt traegt seine Polsterung selbst.",
        "tokens": [],
        "markup": "<section class=\"nc-section nc-section--full\">…</section>",
        "specimen": "website-nc-section-full"
      },
      {
        "klasse": "nc-section--muted",
        "basis": "nc-section",
        "element": "section",
        "scss": "scss/scss/04-objects/_section.scss",
        "beschreibung": "Gedaempfte Flaeche: background-color background-secondary (wie section--muted), am Element aufgeloest. Drupal: Agenda der Event-Detailseite (node--event--full.html.twig).",
        "tokens": [
          "fnd-color-background-secondary"
        ],
        "markup": "<section class=\"nc-section nc-section--muted\"><div class=\"nc-container\">…</div></section>",
        "specimen": "website-nc-section-muted"
      }
    ]
  },
