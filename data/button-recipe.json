{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "button",
    "version": "1.1.0",
    "status": "stable",
    "tags": ["interactive", "control"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": ""
    }
  },

  "anatomy": {
    "root": { "element": ".nc-button" },
    "slots": [
      { "name": "icon", "element": ".nc-button__icon", "optional": true },
      { "name": "label", "element": ".nc-button__label", "optional": false },
      { "name": "spinner", "element": ".nc-button__spinner", "optional": true }
    ],
    "domNotes": [
      "Buttons muessen immer ein zugaengliches Label haben — entweder sichtbarer Text oder aria-label fuer Icon-Only.",
      "Spinner wird im State 'loading' angezeigt und blockiert Interaktion."
    ]
  },

  "api": {
    "elements": {
      "default": { "element": "button", "attributes": ["type=button"] },
      "link": { "element": "a", "attributes": ["href?"] }
    },
    "attributes": [
      { "name": "disabled", "appliesTo": ["button"], "type": "boolean" },
      { "name": "aria-disabled", "appliesTo": ["a"], "type": "boolean" },
      { "name": "aria-busy", "appliesTo": ["button", "a"], "type": "boolean" },
      { "name": "aria-pressed", "appliesTo": ["button", "a"], "type": "boolean" },
      { "name": "aria-label", "appliesTo": ["button", "a"], "type": "string" }
    ]
  },

  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante / Semantik des Buttons",
      "values": {
        "primary": { "modifier": null, "tokenGroups": ["primary"] },
        "secondary": { "modifier": "nc-button--secondary", "tokenGroups": ["secondary"] },
        "accent": { "modifier": "nc-button--accent", "tokenGroups": ["accent"] },
        "outline": { "modifier": "nc-button--outline", "tokenGroups": ["outline"] },
        "ghost": { "modifier": "nc-button--ghost", "tokenGroups": ["ghost"] },
        "success": { "modifier": "nc-button--success", "tokenGroups": ["success"] },
        "warning": { "modifier": "nc-button--warning", "tokenGroups": ["warning"] },
        "error": { "modifier": "nc-button--error", "tokenGroups": ["error"] },
        "info": { "modifier": "nc-button--info", "tokenGroups": ["info"] }
      }
    },

    "size": {
      "label": "Size",
      "description": "Groessenabstufung des Buttons",
      "values": {
        "xs": { "modifier": "nc-button--xs", "tokenGroups": ["size-scale"] },
        "sm": { "modifier": "nc-button--sm", "tokenGroups": ["size-scale"] },
        "md": { "modifier": null, "tokenGroups": [] },
        "lg": { "modifier": "nc-button--lg", "tokenGroups": ["size-scale"] }
      }
    },

    "pattern": {
      "label": "Pattern",
      "description": "Render-Muster / Slot-Konfiguration",
      "values": {
        "standard": { "modifier": null, "tokenGroups": [], "slotConfig": { "label": true } },
        "with-icon": { "modifier": null, "tokenGroups": ["icon-sizing"], "slotConfig": { "icon": true, "label": true } },
        "icon-only": {
          "modifier": "nc-button--icon-only",
          "tokenGroups": ["icon-sizing"],
          "slotConfig": { "icon": true, "label": false },
          "renderHint": "icon-only"
        }
      }
    },

    "composition": {
      "label": "Composition",
      "description": "Kompositions-/Verwendungsform",
      "values": {
        "single": { "modifier": null, "tokenGroups": [] },
        "group": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "button-group",
          "wrapper": {
            "element": "div",
            "className": "nc-button-group",
            "attributes": { "role": "group", "aria-label": "Aktionen" }
          }
        },
        "toggle": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "toggle",
          "wrapper": {
            "element": "div",
            "className": "nc-button-group nc-button-group--toggle",
            "attributes": { "role": "group", "aria-label": "Formatierung" }
          }
        },
        "link": { "modifier": null, "tokenGroups": [], "elementHint": "a", "renderHint": "link" }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "active", "focus-visible", "disabled", "loading", "pressed"],
    "precedence": ["disabled", "loading", "pressed", "active", "hover", "focus-visible", "default"],
    "rules": [
      {
        "state": "loading",
        "effects": ["blockInteraction"],
        "attributes": { "aria-busy": true, "aria-disabled": true },
        "slotConfig": { "spinner": true },
        "tokenGroups": ["spinner"]
      },
      {
        "state": "disabled",
        "effects": ["blockInteraction"],
        "attributes": { "disabled?": true, "aria-disabled": true },
        "tokenGroups": ["disabled"]
      },
      {
        "state": "pressed",
        "onlyWhen": { "axes": { "composition": ["toggle"] } },
        "attributes": { "aria-pressed": "true|false" }
      }
    ]
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "focusIndicator": "focus-ring mixin, :focus-visible",
      "assertions": ["hasAccessibleName", "focusIndicatorVisible"],
      "note": "Buttons muessen immer ein zugaengliches Label haben — entweder sichtbarer Text oder aria-label fuer Icon-Only."
    },
    "overrides": [
      {
        "when": { "axes": { "pattern": ["icon-only"] } },
        "require": ["aria-label"],
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Icon-Only Buttons benoetigen immer aria-label. Quadratische Flaeche fuer einfaches Treffen."
      },
      {
        "when": { "axes": { "composition": ["group"] } },
        "suggest": ["role=group", "aria-label=Aktionen"],
        "note": "Button-Group benoetigt role='group' mit aria-label. Mittlere Buttons haben keinen Radius."
      },
      {
        "when": { "axes": { "composition": ["toggle"] } },
        "require": ["aria-pressed"],
        "note": "Toggle-Buttons muessen aria-pressed verwenden. Aktiver Zustand kann zu Primary-Farben wechseln (Resolver-Regel)."
      },
      {
        "when": { "axes": { "composition": ["link"] } },
        "note": "Links als Buttons gestylt benoetigen role='button' und Keyboard-Handling, wenn sie keine Navigation ausloesen."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "pattern": ["icon-only"] } }, "require": ["aria-label"] },
      { "when": { "states": ["loading"] }, "effects": ["blockInteraction"], "notes": ["Loading-Buttons blockieren Interaktion."] },
      { "when": { "axes": { "composition": ["toggle"] } }, "require": ["aria-pressed"] }
    ],
    "copy": {
      "label": {
        "minChars": 1,
        "note": "Button-Labels sollten kurz und handlungsorientiert sein (z.B. 'Speichern', 'Abbrechen')."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-button"],
    "baseTokenGroups": ["geometry", "typography", "interaction"],

    "tokenGroups": {
      "geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-button-height-xs",
          "nc-button-height-sm",
          "nc-button-height-md",
          "nc-button-height-lg",
          "nc-button-padding-x-xs",
          "nc-button-padding-x-sm",
          "nc-button-padding-x-md",
          "nc-button-padding-x-lg",
          "nc-button-padding-y-xs",
          "nc-button-padding-y-sm",
          "nc-button-padding-y-md",
          "nc-button-padding-y-lg",
          "nc-button-radius-xs",
          "nc-button-radius-sm",
          "nc-button-radius-md",
          "nc-button-radius-lg",
          "nc-button-radius-full",
          "nc-button-border-width-sm",
          "nc-button-border-width-lg"
        ]
      },

      "typography": {
        "label": "Typography",
        "tokens": [
          "nc-button-font-size-xs",
          "nc-button-font-size-sm",
          "nc-button-font-size-md",
          "nc-button-font-size-lg",
          "nc-button-line-height",
          "nc-button-font-weight",
          "nc-button-gap",
          "nc-button-min-width",
          "nc-button-label-compact",
          "nc-button-label-expressive"
        ]
      },

      "interaction": {
        "label": "Interaction",
        "tokens": [
          "nc-button-transition-duration",
          "nc-button-scale-active",
          "nc-button-opacity-disabled"
        ]
      },

      "icon-sizing": {
        "label": "Icon Sizing",
        "tokens": [
          "nc-button-icon-gap-xs",
          "nc-button-icon-gap-sm",
          "nc-button-icon-gap-md",
          "nc-button-icon-gap-lg",
          "nc-button-icon-size-xs",
          "nc-button-icon-size-sm",
          "nc-button-icon-size-md",
          "nc-button-icon-size-lg"
        ]
      },

      "size-scale": {
        "label": "Size Scale",
        "tokens": [
          "nc-button-height-xs",
          "nc-button-height-sm",
          "nc-button-height-md",
          "nc-button-height-lg",
          "nc-button-padding-x-xs",
          "nc-button-padding-x-sm",
          "nc-button-padding-x-md",
          "nc-button-padding-x-lg",
          "nc-button-font-size-xs",
          "nc-button-font-size-sm",
          "nc-button-font-size-md",
          "nc-button-font-size-lg"
        ]
      },

      "primary": {
        "label": "Primary",
        "tokens": [
          "nc-button-primary-bg",
          "nc-button-primary-bg-hover",
          "nc-button-primary-bg-active",
          "nc-button-primary-color",
          "nc-button-primary-border"
        ]
      },

      "secondary": {
        "label": "Secondary",
        "tokens": [
          "nc-button-secondary-bg",
          "nc-button-secondary-bg-hover",
          "nc-button-secondary-bg-active",
          "nc-button-secondary-color",
          "nc-button-secondary-border"
        ]
      },

      "outline": {
        "label": "Outline",
        "tokens": [
          "nc-button-outline-bg",
          "nc-button-outline-bg-hover",
          "nc-button-outline-bg-active",
          "nc-button-outline-color",
          "nc-button-outline-border"
        ]
      },

      "ghost": {
        "label": "Ghost",
        "tokens": [
          "nc-button-ghost-bg",
          "nc-button-ghost-bg-hover",
          "nc-button-ghost-bg-active",
          "nc-button-ghost-color",
          "nc-button-ghost-border"
        ]
      },

      "accent": {
        "label": "Accent",
        "tokens": [
          "nc-button-accent-bg",
          "nc-button-accent-bg-hover",
          "nc-button-accent-bg-active",
          "nc-button-accent-color",
          "nc-button-accent-border"
        ]
      },

      "success": {
        "label": "Success",
        "tokens": [
          "nc-button-success-bg",
          "nc-button-success-bg-hover",
          "nc-button-success-bg-active",
          "nc-button-success-color",
          "nc-button-success-border"
        ]
      },

      "warning": {
        "label": "Warning",
        "tokens": [
          "nc-button-warning-bg",
          "nc-button-warning-bg-hover",
          "nc-button-warning-bg-active",
          "nc-button-warning-color",
          "nc-button-warning-border"
        ]
      },

      "error": {
        "label": "Error",
        "tokens": [
          "nc-button-error-bg",
          "nc-button-error-bg-hover",
          "nc-button-error-bg-active",
          "nc-button-error-color",
          "nc-button-error-border"
        ]
      },

      "info": {
        "label": "Info",
        "tokens": [
          "nc-button-info-bg",
          "nc-button-info-bg-hover",
          "nc-button-info-bg-active",
          "nc-button-info-color",
          "nc-button-info-border"
        ]
      },

      "disabled": {
        "label": "Disabled",
        "tokens": [
          "nc-button-disabled-bg",
          "nc-button-disabled-color",
          "nc-button-disabled-border",
          "nc-button-opacity-disabled"
        ]
      },

      "icon-button": {
        "label": "Icon Button",
        "tokens": [
          "nc-icon-button-size",
          "nc-icon-button-padding",
          "nc-icon-button-radius",
          "nc-icon-button-bg",
          "nc-icon-button-bg-hover",
          "nc-icon-button-color"
        ]
      },

      "spinner": {
        "label": "Spinner / Loading",
        "tokens": ["nc-button-spinner-size", "nc-button-spinner-border-width"]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.pattern.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups",
        "states.rules[*].tokenGroups (matching state)"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants — MD",
      "description": "Alle 9 Varianten in Standardgroesse",
      "matrix": {
        "axes": { "variant": "*", "size": ["md"], "pattern": ["standard"], "composition": ["single"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Variante muss 4.5:1 Kontrast zwischen Label und Hintergrund einhalten."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — XS / SM / MD / LG",
      "description": "Primary-Variante in allen 4 Groessen",
      "matrix": {
        "axes": { "variant": ["primary"], "size": "*", "pattern": ["standard"], "composition": ["single"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["geometry", "typography", "size-scale"],
      "layout": "row",
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "XS (12px) und SM (12px) muessen trotz kompakter Schrift Mindestkontrast einhalten."
      }
    },
    {
      "id": "with-icon",
      "label": "With Icon",
      "description": "Alle Varianten mit Leading-Icon",
      "matrix": {
        "axes": { "variant": "*", "size": ["md"], "pattern": ["with-icon"], "composition": ["single"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{variant}", "icon": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon ist dekorativ (aria-hidden='true'). Label traegt die Bedeutung."
      }
    },
    {
      "id": "icon-only",
      "label": "Icon Only",
      "description": "Primary, Secondary, Ghost — alle Groessen",
      "matrix": {
        "axes": { "variant": ["primary", "secondary", "ghost"], "size": "*", "pattern": ["icon-only"], "composition": ["single"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["geometry", "icon-sizing"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "variant", "colAxis": "size" },
      "render": { "icon": "default" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Icon-Only Buttons benoetigen immer aria-label. Quadratische Flaeche fuer einfaches Treffen."
      }
    },
    {
      "id": "loading",
      "label": "Loading",
      "description": "Primary und Secondary im Lade-Zustand",
      "matrix": {
        "axes": { "variant": ["primary", "secondary"], "size": ["md"], "pattern": ["standard"], "composition": ["single"] },
        "states": ["loading"]
      },
      "focusTokenGroups": ["spinner", "primary", "secondary"],
      "layout": "row",
      "render": { "label": "{variant}", "state": "loading" },
      "a11y": {
        "note": "Loading-Buttons muessen aria-busy='true' und aria-disabled='true' haben."
      }
    },
    {
      "id": "button-group",
      "label": "Button Group",
      "description": "Outline-Buttons als zusammenhaengende Gruppe",
      "matrix": {
        "axes": { "variant": ["outline"], "size": ["md"], "pattern": ["standard"], "composition": ["group"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["outline", "geometry"],
      "layout": "composition",
      "render": { "compositionType": "button-group", "groupLabels": ["Left", "Center", "Right"] },
      "a11y": {
        "roleSuggestion": "role=\"group\" aria-label=\"Aktionen\"",
        "note": "Button-Group benoetigt role='group' mit aria-label. Mittlere Buttons haben keinen Radius."
      }
    },
    {
      "id": "toggle",
      "label": "Toggle",
      "description": "Outline-Basis mit aria-pressed An/Aus-Zustand",
      "matrix": {
        "axes": { "variant": ["outline"], "size": ["md"], "pattern": ["with-icon"], "composition": ["toggle"] },
        "states": ["pressed"]
      },
      "focusTokenGroups": ["outline", "primary"],
      "layout": "row",
      "render": { "compositionType": "toggle", "toggleLabels": ["Bold", "Italic", "Underline"] },
      "a11y": {
        "roleSuggestion": "aria-pressed=\"true|false\"",
        "note": "Toggle-Buttons muessen aria-pressed verwenden. Aktiver Zustand wechselt zu Primary-Farben."
      }
    },
    {
      "id": "link-as-button",
      "label": "Link as Button",
      "description": "Primary, Secondary, Ghost als <a>-Elemente",
      "matrix": {
        "axes": { "variant": ["primary", "secondary", "ghost"], "size": ["md"], "pattern": ["standard"], "composition": ["link"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["primary", "secondary", "ghost"],
      "layout": "row",
      "render": { "compositionType": "link", "label": "{variant}" },
      "a11y": {
        "roleSuggestion": "role=\"button\" (wenn keine Navigation)",
        "note": "Links als Buttons gestylt benoetigen role='button' wenn sie keine Navigation ausloesen."
      }
    },

    {
      "id": "neg-pressed-without-toggle",
      "type": "negative",
      "label": "QA: Pressed ohne Toggle-Composition",
      "description": "Pressed-State auf Single-Composition — onlyWhen nicht erfuellt, Rule matcht nicht",
      "matrix": {
        "axes": { "variant": ["primary"], "size": ["md"], "pattern": ["standard"], "composition": ["single"] },
        "states": ["pressed"]
      },
      "layout": "row",
      "render": { "label": "{variant}" },
      "expected": [
        { "ruleId": "STATE_NO_MATCHING_RULE", "severity": "warn", "messageContains": "pressed" }
      ]
    },

    {
      "id": "neg-disabled-loading",
      "type": "negative",
      "label": "QA: Disabled + Loading Precedence-Konflikt",
      "description": "Multi-State disabled+loading — blockInteraction aus zwei Rules",
      "matrix": {
        "axes": { "variant": ["primary"], "size": ["md"], "pattern": ["standard"], "composition": ["single"] },
        "states": [["disabled", "loading"]]
      },
      "layout": "row",
      "render": { "label": "{variant}" },
      "expected": [
        { "ruleId": "STATE_PRECEDENCE_CONFLICT", "severity": "warn", "messageContains": "blockInteraction" }
      ]
    }
  ]
}
