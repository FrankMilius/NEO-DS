  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.pattern.values.*.modifier",
        "axes.width.values.*.modifier",
        "axes.composition.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups",
        "states.rules[*].tokenGroups (matching state)"
      ]
    }
  },
  "keyboard": {
    "Enter": {
      "action": "activate",
      "note": "Loest den Click-Handler aus (nativ). Toggle (.nc-button--toggle): schaltet aria-pressed um (neo-behaviors button)."
    },
    "Space": {
      "action": "activate",
      "note": "Loest den Click-Handler aus (nativ, beim Loslassen). Verhindert Page-Scroll. Toggle: schaltet aria-pressed um wie Enter."
    }
  },
  "testSelectors": {
    "root": "[data-testid='button']",
    "label": "[data-testid='button-label']",
    "icon": "[data-testid='button-icon']",
    "spinner": "[data-testid='button-spinner']"
  },
  "events": {
    "click": {
      "bubbles": true,
      "note": "Standard DOM click Event."
    },
    "button-toggle": {
      "bubbles": true,
      "detail": {
        "pressed": "boolean",
        "value": "string"
      },
      "note": "Gefeuert, wenn ein Umschaltknopf (.nc-button--toggle) aria-pressed wechselt. value: data-value, sonst aria-label, sonst die Beschriftung. Gesperrte Knoepfe melden nichts.",
      "onlyWhen": {
        "axes": {
          "composition": [
            "toggle"
          ]
        }
      }
    }
  },
  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants — MD",
      "description": "Alle 11 Varianten in Standardgroesse (inkl. Soft + Inverted)",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "md"
          ],
          "pattern": [
            "standard"
          ],
          "width": [
            "auto"
          ],
          "composition": [
            "single"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Variante muss 4.5:1 Kontrast zwischen Label und Hintergrund einhalten."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — XS / SM / MD / LG",
      "description": "Primary-Variante in allen 4 Groessen. XS/SM mit Touch-Target.",
