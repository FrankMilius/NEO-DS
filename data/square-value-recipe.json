{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "square-value",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["display", "animation", "3d"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/square-value-docs" }
  },
  "anatomy": {
    "root": { "element": ".square-value" },
    "slots": [
      { "name": "wrapper", "element": ".square-value-wrapper", "optional": false },
      { "name": "square-wrapper", "element": ".square-wrapper", "optional": false },
      { "name": "square-block", "element": ".square-block", "optional": false }
    ],
    "convenience": [],
    "domNotes": [
      "3D-Wuerfel: transform-style preserve-3d, rotateX/rotateY fuer Flaechen.",
      "4 Faces pro Wuerfel: background-inverse, radius-sm, text-inverse.",
      "Richtungs-Varianten: mobile-vertical, tablet-vertical, desktop-vertical.",
      "Animationen: enter (scale 0→1), exit (scale→0), rotate-once/-twice/-thrice, char-square Textanimation."
    ]
  },
  "axes": {
    "orientation": {
      "label": "Orientation",
      "description": "Wuerfel-Rotation — horizontal (default), mobile-vertical, tablet-vertical, desktop-vertical",
      "values": {
        "horizontal":       { "modifier": null,                "tokenGroups": [], "renderHint": "square-horizontal" },
        "mobile-vertical":  { "modifier": "mobile-vertical",   "tokenGroups": [], "renderHint": "square-mobile-vertical" },
        "tablet-vertical":  { "modifier": "tablet-vertical",   "tokenGroups": [], "renderHint": "square-tablet-vertical" },
        "desktop-vertical": { "modifier": "desktop-vertical",  "tokenGroups": [], "renderHint": "square-desktop-vertical" }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhalt der Wuerfel-Flaechen — text, image, video",
      "values": {
        "text":  { "modifier": null, "tokenGroups": [], "renderHint": "square-content-text" },
        "image": { "modifier": null, "tokenGroups": [], "renderHint": "square-content-image" },
        "video": { "modifier": null, "tokenGroups": [], "renderHint": "square-content-video" }
      }
    }
  },
  "states": { "supported": ["default"], "precedence": ["default"], "rules": [], "interactive": false },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA large text (3:1)",
      "assertions": [],
      "note": "Dekorativ/informativ. prefers-reduced-motion: 3D-Rotation und Char-Animation stoppen. Text auf inverse BG muss kontrastreich sein."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["square-value"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses", "axes.orientation.values.*.modifier"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "orientation-comparison", "label": "Orientations",
      "description": "Horizontal vs Vertical Varianten",
      "matrix": { "axes": { "orientation": "*", "content": ["text"] }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "orientation" }, "render": { "label": "{orientation}" },
      "a11y": { "contrastTarget": "WCAG AA large text (3:1)", "note": "Reduced Motion: 3D-Rotation stoppen." }
    },
    {
      "id": "content-comparison", "label": "Content Types",
      "description": "Text, Bild, Video",
      "matrix": { "axes": { "orientation": ["horizontal"], "content": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "content" }, "render": { "label": "{content}" },
      "a11y": { "contrastTarget": "WCAG AA large text (3:1)", "note": "Video/Bild: alt-Text oder aria-label." }
    }
  ]
}
