{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "select",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["interactive", "form", "selection"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/select-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-select" },
    "slots": [
      { "name": "indicator", "element": ".nc-select__indicator", "optional": true }
    ],
    "convenience": [
      { "name": "wrapper", "element": ".nc-select-wrapper", "optional": true, "description": "Positionierungs-Container fuer custom Indicator (position: relative). Wenn vorhanden, wird background-image auf Select entfernt." }
    ],
    "domNotes": [
      "Select ist ein natives <select class='nc-select'>. Kein JS fuer Basis-Funktion noetig.",
      "Custom Arrow via background-image (SVG Chevron Down) oder via __indicator im Wrapper.",
      "Nutzt --nc-input-* Tokens als Basis (gleiche form-control Mixins wie Input).",
      "Eigene --nc-select-* Tokens nur fuer Indicator und Extra-Padding.",
      "Multi-Select: .nc-select--multiple oder [multiple]. Kein Arrow, height: auto.",
      "::-ms-expand wird versteckt (IE11 Arrow entfernen).",
      "Error via .nc-select--error ODER [aria-invalid='true']."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px). Nutzt Input-Size-Tokens.",
      "values": {
        "sm": { "modifier": "nc-select--sm", "tokenGroups": [] },
        "md": { "modifier": null,            "tokenGroups": [] },
        "lg": { "modifier": "nc-select--lg", "tokenGroups": [] }
      }
    },

    "type": {
      "label": "Type",
      "description": "Auswahl-Typ — single (Standard-Dropdown), multiple (native Mehrfachauswahl)",
      "values": {
        "single":   { "modifier": null,                    "tokenGroups": [],              "elementHint": "select", "renderHint": "select-single" },
        "multiple": { "modifier": "nc-select--multiple",   "tokenGroups": [],              "elementHint": "select", "renderHint": "select-multiple" }
      }
    },

    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": {
        "none":    { "modifier": null,                  "tokenGroups": [] },
        "error":   { "modifier": "nc-select--error",    "tokenGroups": ["state-error"] },
        "success": { "modifier": "nc-select--success",  "tokenGroups": ["state-success"] }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus", "disabled"],
    "precedence": ["disabled", "focus", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": ["disabled", "focus"], "note": "Hover nur wenn nicht disabled oder fokussiert" },
      { "state": "focus", "unless": ["disabled"],          "note": "Focus nur wenn nicht disabled" }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Natives <select> — inhaerent accessible. Braucht zugehoeriges <label> (via for/id) oder aria-label. Arrow-Keys navigieren Optionen."
    },
    "overrides": [
      {
        "when": { "axes": { "validation": ["error"] } },
        "require": ["aria-invalid", "aria-describedby"],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby auf Fehlermeldung."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": ["aria-disabled"],
        "note": "aria-disabled='true' bevorzugt wenn Select Teil eines sichtbaren Formulars ist."
      },
      {
        "when": { "axes": { "type": ["multiple"] } },
        "suggest": ["aria-multiselectable"],
        "note": "Multiple-Select hat implizit aria-multiselectable. Ctrl+Click fuer Mehrfachauswahl."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["accessible-name"], "notes": ["Select braucht immer <label for='...'> oder aria-label."] },
      { "when": { "axes": { "validation": ["error"] } }, "require": ["aria-invalid", "aria-describedby"], "notes": ["Error braucht aria-invalid='true' + Verweis auf Fehlermeldung."] }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 40,
        "note": "Erste <option> als Placeholder (disabled, selected, value=''). Z.B. 'Bitte waehlen...'."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-select"],
    "baseTokenGroups": ["core-indicator"],

    "tokenGroups": {
      "core-indicator": {
        "label": "Indicator",
        "tokens": [
          "nc-select-indicator-size",
          "nc-select-indicator-color",
          "nc-select-padding-right"
        ]
      },
      "state-error": {
        "label": "Error",
        "tokens": []
      },
      "state-success": {
        "label": "Success",
        "tokens": []
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.type.values.*.modifier",
        "axes.validation.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD",
      "description": "Select in allen interaktiven Zustaenden",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "validation": ["none"] },
        "states": ["default", "hover", "focus", "disabled"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring. Arrow-Indicator muss in allen States erkennbar bleiben."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "type": ["single"], "validation": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-indicator"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Arrow-Position passt sich an Groesse an. SM hat reduzierten padding-right."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "Error und Success im Vergleich zu Default",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "validation": "*" },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["state-error", "state-success"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "validation" },
      "render": { "label": "{validation}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-/Success-Border muss 3:1 Kontrast haben. Farbe nie als einziges Signal."
      }
    },
    {
      "id": "single-vs-multiple",
      "label": "Single vs Multiple",
      "description": "Standard-Dropdown vs native Mehrfachauswahl",
      "matrix": {
        "axes": { "size": ["md"], "type": "*", "validation": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{type}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Multiple-Select hat keinen Arrow und auto-Height. Ctrl+Click fuer Mehrfachauswahl — schwer discoverable, ggf. Hinweis geben."
      }
    },
    {
      "id": "with-indicator",
      "label": "With Custom Indicator",
      "description": "Select im Wrapper mit custom SVG-Indicator statt background-image",
      "composes": ["indicator"],
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "validation": ["none"] },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["core-indicator"],
      "layout": "row",
      "render": { "compositionType": "select-with-indicator", "label": "indicator" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Custom Indicator hat pointer-events: none — Klick geht durch zum Select. Indicator ist rein dekorativ."
      }
    },
    {
      "id": "with-placeholder",
      "label": "With Placeholder Option",
      "description": "Select mit disabled Placeholder-Option als Hinweis",
      "matrix": {
        "axes": { "size": ["md"], "type": ["single"], "validation": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "placeholder" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Placeholder-Option: <option disabled selected value=''>Bitte waehlen...</option>. Placeholder-Farbe via ::placeholder nicht moeglich — nutzt normalen Text-Style."
      }
    }
  ]
}
