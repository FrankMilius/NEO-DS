{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "textarea",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["interactive", "form", "text-input"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/textarea-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-textarea" },
    "slots": [
      { "name": "counter", "element": ".nc-textarea__counter", "optional": true }
    ],
    "convenience": [
      { "name": "wrapper", "element": ".nc-textarea-wrapper", "optional": true, "description": "Positionierungs-Container (position: relative). Analog zu Input-Wrapper." }
    ],
    "domNotes": [
      "Textarea ist ein natives <textarea class='nc-textarea'>. Kein JS fuer Basis-Funktion noetig.",
      "Nutzt --nc-input-* Tokens als Basis (gleiche form-control Mixins wie Input).",
      "Eigene --nc-textarea-* Tokens nur fuer min-height, padding und resize-Verhalten.",
      "height: auto ueberschreibt die feste Hoehe aus form-control-size.",
      "Autosize (.nc-textarea--autosize): resize: none, overflow: hidden — JS steuert Hoehe.",
      "Character Counter (__counter): Nutzt --nc-form-hint-* Tokens. --limit aendert auf Error-Farbe.",
      "Error via .nc-textarea--error ODER [aria-invalid='true']."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (min-height 60px) / md (80px, Standard) / lg (120px). Nutzt Input-Size-Tokens.",
      "values": {
        "sm": { "modifier": "nc-textarea--sm", "tokenGroups": [] },
        "md": { "modifier": null,              "tokenGroups": [] },
        "lg": { "modifier": "nc-textarea--lg", "tokenGroups": [] }
      }
    },

    "resize": {
      "label": "Resize",
      "description": "Resize-Verhalten — default (vertical), autosize (JS-gesteuert, kein Resize), no-resize (fixe Hoehe)",
      "values": {
        "default":   { "modifier": null,                      "tokenGroups": [],              "renderHint": "textarea-resizable" },
        "autosize":  { "modifier": "nc-textarea--autosize",   "tokenGroups": [],              "renderHint": "textarea-autosize" },
        "no-resize": { "modifier": "nc-textarea--no-resize",  "tokenGroups": [],              "renderHint": "textarea-fixed" }
      }
    },

    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": {
        "none":    { "modifier": null,                    "tokenGroups": [] },
        "error":   { "modifier": "nc-textarea--error",    "tokenGroups": ["state-error"] },
        "success": { "modifier": "nc-textarea--success",  "tokenGroups": ["state-success"] }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus", "disabled"],
    "precedence": ["disabled", "focus", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": ["disabled", "focus"], "note": "Hover nur wenn nicht disabled oder fokussiert" },
      { "state": "focus", "unless": ["disabled"],          "note": "Focus nur wenn nicht disabled" }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Natives <textarea> — inhaerent accessible. Braucht zugehoeriges <label> (via for/id) oder aria-label. Resize-Griff ist nativ tastaturzugaenglich."
    },
    "overrides": [
      {
        "when": { "axes": { "validation": ["error"] } },
        "require": ["aria-invalid", "aria-describedby"],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby auf Fehlermeldung."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": ["aria-disabled"],
        "note": "aria-disabled='true' bevorzugt wenn Textarea Teil eines sichtbaren Formulars ist."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["accessible-name"], "notes": ["Textarea braucht immer <label for='...'> oder aria-label."] },
      { "when": { "axes": { "validation": ["error"] } }, "require": ["aria-invalid", "aria-describedby"], "notes": ["Error braucht aria-invalid='true' + Verweis auf Fehlermeldung."] }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 80,
        "note": "Placeholder als Hinweis, nicht als Label. Verschwindet bei Eingabe."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-textarea"],
    "baseTokenGroups": ["core-geometry"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-textarea-min-height",
          "nc-textarea-padding",
          "nc-textarea-resize"
        ]
      },
      "state-error": {
        "label": "Error",
        "tokens": []
      },
      "state-success": {
        "label": "Success",
        "tokens": []
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.resize.values.*.modifier",
        "axes.validation.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD",
      "description": "Textarea in allen interaktiven Zustaenden",
      "matrix": {
        "axes": { "size": ["md"], "resize": ["default"], "validation": ["none"] },
        "states": ["default", "hover", "focus", "disabled"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring. Resize-Griff muss in allen States erkennbar bleiben."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "resize": ["default"], "validation": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["core-geometry"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "min-height skaliert mit Groesse. SM = 60px, MD = 80px, LG = 120px."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "Error und Success im Vergleich zu Default",
      "matrix": {
        "axes": { "size": ["md"], "resize": ["default"], "validation": "*" },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["state-error", "state-success"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "validation" },
      "render": { "label": "{validation}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-/Success-Border muss 3:1 Kontrast haben. Farbe nie als einziges Signal."
      }
    },
    {
      "id": "resize-variants",
      "label": "Resize Variants",
      "description": "Default (vertical) vs Autosize vs No-Resize",
      "matrix": {
        "axes": { "size": ["md"], "resize": "*", "validation": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{resize}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Autosize entfernt Resize-Griff — visuell klar kommunizieren (z.B. dynamisches Wachsen). No-Resize hat keinen Griff."
      }
    },
    {
      "id": "with-counter",
      "label": "With Character Counter",
      "description": "Textarea mit Zeichenzaehler (normal und Limit erreicht)",
      "composes": ["counter"],
      "matrix": {
        "axes": { "size": ["md"], "resize": ["default"], "validation": ["none", "error"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "textarea-with-counter", "label": "counter" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Counter braucht aria-live='polite' oder via aria-describedby verknuepft. --limit Farbe (Error) nie als einziges Signal."
      }
    },
    {
      "id": "with-placeholder",
      "label": "With Placeholder",
      "description": "Textarea mit Placeholder-Text in verschiedenen Groessen",
      "matrix": {
        "axes": { "size": "*", "resize": ["default"], "validation": ["none"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Placeholder ist kein Ersatz fuer Label. Placeholder-Farbe muss 4.5:1 Kontrast haben."
      }
    }
  ]
}
