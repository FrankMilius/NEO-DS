{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "textarea",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "form",
      "text-input"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/textarea-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "A: Scrollbar-Styling via nc-textarea-scrollbar-width Token (overlay, thin, auto)",
          "B: Neuer Actions-Slot (.nc-textarea__actions) fuer Copy/Clear/AI Buttons",
          "C: Visual Feedback fuer Resize-Limit via nc-textarea-max-height Token",
          "D: State-Logik: :placeholder-shown (Empty) und :focus-within fuer Actions-Sichtbarkeit"
        ]
      }
    ],
    "layer": "atom",
    "pipeline": {
      "scss": [
        "scss/scss/05-atoms/_textarea.scss"
      ],
      "story": "stories/atoms/textarea.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/textarea-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-textarea"
    },
    "slots": [
      {
        "name": "counter",
        "element": ".nc-textarea__counter",
        "optional": true
      },
      {
        "name": "actions",
        "element": ".nc-textarea__actions",
        "optional": true
      }
    ],
    "convenience": [
      {
        "name": "wrapper",
        "element": ".nc-textarea-wrapper",
        "optional": true,
        "description": "Positionierungs-Container (position: relative). Analog zu Input-Wrapper. Pflicht wenn Actions-Slot genutzt wird."
      }
    ],
    "domNotes": [
      "Textarea ist ein natives <textarea class='nc-textarea'>. Kein JS fuer Basis-Funktion noetig.",
      "Nutzt --nc-input-* Tokens als Basis (gleiche form-control Mixins wie Input).",
      "Eigene --nc-textarea-* Tokens fuer min-height, max-height, padding, resize und Scrollbar.",
      "height: auto ueberschreibt die feste Hoehe aus form-control-size.",
      "max-height: Bei gesetztem Wert (nicht 'none') erzwingt overflow-y: auto einen Scrollbar.",
      "scrollbar-width: 'thin' (Standard) fuer schmalere Scrollbars. Webkit-Fallback via ::-webkit-scrollbar.",
      "Autosize (.nc-textarea--autosize): resize: none, overflow: hidden — JS steuert Hoehe.",
      "Character Counter (__counter): Nutzt --nc-form-hint-* Tokens. --limit aendert auf Error-Farbe.",
      "Actions-Slot (__actions): Flex-Container unterhalb der Textarea fuer interaktive Buttons (Copy, Clear, AI-Assist). Wrapper muss :has(.nc-textarea__actions) sein, damit Textarea unteren Radius verliert.",
      "Empty vs. Focus-Within: :placeholder-shown kennzeichnet leere Textarea. Wrapper :focus-within steuert Actions-Sichtbarkeit — Actions werden ausgeblendet wenn Textarea leer UND nicht fokussiert.",
      "Error via .nc-textarea--error ODER [aria-invalid='true']."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — outlined (Standard, Rahmen), filled (Flaeche mit Unterstreichung), borderless (minimalistisch)",
      "values": {
        "outlined": {
          "modifier": null,
          "tokenGroups": [
            "core-colors"
          ],
          "description": "Standard-Stil mit Rahmen auf allen 4 Seiten."
        },
        "filled": {
          "modifier": "nc-textarea--filled",
          "tokenGroups": [
            "core-colors-filled"
          ],
          "description": "Hintergrund-Flaeche mit Unterstreichung (border-bottom only)."
        },
        "borderless": {
          "modifier": "nc-textarea--borderless",
          "tokenGroups": [
            "core-colors-minimal"
          ],
          "description": "Minimalistischer Stil ohne sichtbaren Rahmen. Fuer transparente Integration."
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (min-height 60px) / md (80px, Standard) / lg (120px). Nutzt Input-Size-Tokens.",
      "values": {
        "sm": {
          "modifier": "nc-textarea--sm",
          "tokenGroups": []
        },
        "md": {
          "modifier": null,
          "tokenGroups": []
        },
        "lg": {
          "modifier": "nc-textarea--lg",
          "tokenGroups": []
        }
      }
    },
    "resize": {
      "label": "Resize",
      "description": "Resize-Verhalten — default (vertical), autosize (JS-gesteuert, kein Resize), no-resize (fixe Hoehe)",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "textarea-resizable"
        },
        "autosize": {
          "modifier": "nc-textarea--autosize",
          "tokenGroups": [],
          "renderHint": "textarea-autosize"
        },
        "no-resize": {
          "modifier": "nc-textarea--no-resize",
          "tokenGroups": [],
          "renderHint": "textarea-fixed"
        }
      }
    },
    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "error": {
          "modifier": "nc-textarea--error",
          "tokenGroups": [
            "state-error"
          ]
        },
        "success": {
          "modifier": "nc-textarea--success",
          "tokenGroups": [
            "state-success"
          ]
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhaltsvarianten — plain (nur Textarea), with-actions (Textarea + Actions-Leiste)",
      "values": {
        "plain": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "textarea-plain"
        },
        "with-actions": {
          "modifier": null,
          "tokenGroups": [
            "actions-slot"
          ],
          "slotConfig": {
            "actions": true
          },
          "renderHint": "textarea-with-actions"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus",
      "disabled",
      "empty",
      "focus-within"
    ],
    "precedence": [
      "disabled",
      "focus",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "disabled",
          "focus"
        ],
        "note": "Hover nur wenn nicht disabled oder fokussiert"
      },
      {
        "state": "focus",
        "unless": [
          "disabled"
        ],
        "note": "Focus nur wenn nicht disabled"
      },
      {
        "state": "empty",
        "css": ":placeholder-shown",
        "note": "Textarea hat keinen Inhalt (Placeholder sichtbar). Kein expliziter Modifier — rein CSS-basiert."
      },
      {
        "state": "focus-within",
        "css": ":focus-within",
        "note": "Wrapper-Level State — Textarea oder ein Kind-Element hat Focus. Steuert Actions-Sichtbarkeit."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Natives <textarea> — inhaerent accessible. Braucht zugehoeriges <label> (via for/id) oder aria-label. Resize-Griff ist nativ tastaturzugaenglich."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby auf Fehlermeldung."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt wenn Textarea Teil eines sichtbaren Formulars ist."
      },
      {
        "when": {
          "axes": {
            "content": [
              "with-actions"
            ]
          }
        },
        "suggest": [
          "focusVisible",
          "aria-label-actions"
        ],
        "note": "Action-Buttons muessen :focus-visible mit focus-ring haben. Jeder Button braucht aria-label oder sichtbaren Text. Actions-Container kann role='toolbar' mit aria-label='Textarea Aktionen' haben."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Textarea braucht immer <label for='...'> oder aria-label."
        ]
      },
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "notes": [
          "Error braucht aria-invalid='true' + Verweis auf Fehlermeldung."
        ]
      },
      {
        "when": {
          "axes": {
            "content": [
              "with-actions"
            ]
          }
        },
        "require": [
          "wrapper",
          "focus-ring"
        ],
        "notes": [
          "Actions-Slot benoetigt .nc-textarea-wrapper als Eltern-Container.",
          "Alle Action-Buttons muessen :focus-visible mit @include focus-ring haben.",
          "Actions-Container kann role='toolbar' fuer Screenreader nutzen."
        ]
      }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 80,
        "note": "Placeholder als Hinweis, nicht als Label. Verschwindet bei Eingabe."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-textarea"
    ],
    "baseTokenGroups": [
      "core-geometry",
      "core-colors",
      "scrollbar"
    ],
    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-textarea-min-height",
          "nc-textarea-max-height",
          "nc-textarea-padding",
          "nc-textarea-resize"
        ]
      },
      "core-colors": {
        "label": "Colors (Outlined)",
        "tokens": [
          "nc-form-control-bg",
          "nc-form-control-border-color",
          "nc-form-control-color"
        ]
      },
      "core-colors-filled": {
        "label": "Colors (Filled)",
        "tokens": [
          "nc-form-control-filled-bg",
          "nc-form-control-filled-border-bottom",
          "nc-form-control-filled-color"
        ]
      },
      "core-colors-minimal": {
        "label": "Colors (Borderless)",
        "tokens": [
          "nc-form-control-minimal-bg-hover",
          "nc-form-control-minimal-border-focus"
        ]
      },
      "scrollbar": {
        "label": "Scrollbar",
        "tokens": [
          "nc-textarea-scrollbar-width"
        ]
      },
      "actions-slot": {
        "label": "Actions",
        "tokens": [
          "nc-textarea-actions-gap",
          "nc-textarea-actions-padding"
        ]
      },
      "state-error": {
        "label": "Error",
        "tokens": []
      },
      "state-success": {
        "label": "Success",
        "tokens": []
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.resize.values.*.modifier",
        "axes.validation.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "komposition": [
    {
      "art": "teilt",
      "recipe": "input",
      "tokenPraefix": "nc-input-",
      "hinweis": "Gleiche Formular-Basis wie der Input."
    }
  ],
  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD",
      "description": "Textarea in allen interaktiven Zustaenden",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default",
          "hover",
          "focus",
          "disabled"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring. Resize-Griff muss in allen States erkennbar bleiben."
      }
    },
    {
      "id": "variant-comparison",
      "label": "Variant Comparison",
      "description": "Outlined vs Filled vs Borderless — alle 3 Varianten im Vergleich",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default",
          "hover",
          "focus"
        ]
      },
      "focusTokenGroups": [
        "core-colors",
        "core-colors-filled",
        "core-colors-minimal"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Borderless muss bei Hover/Focus eine sichtbare Abgrenzung zeigen. Filled-Unterstreichung braucht 3:1 Kontrast."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": "*",
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "core-geometry"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "min-height skaliert mit Groesse. SM = 60px, MD = 80px, LG = 120px."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "Error und Success im Vergleich zu Default",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": "*",
          "content": [
            "plain"
          ]
        },
        "states": [
          "default",
          "focus"
        ]
      },
      "focusTokenGroups": [
        "state-error",
        "state-success"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "validation"
      },
      "render": {
        "label": "{validation}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-/Success-Border muss 3:1 Kontrast haben. Farbe nie als einziges Signal."
      }
    },
    {
      "id": "resize-variants",
      "label": "Resize Variants",
      "description": "Default (vertical) vs Autosize vs No-Resize",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": "*",
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{resize}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Autosize entfernt Resize-Griff — visuell klar kommunizieren (z.B. dynamisches Wachsen). No-Resize hat keinen Griff."
      }
    },
    {
      "id": "with-counter",
      "label": "With Character Counter",
      "description": "Textarea mit Zeichenzaehler (normal und Limit erreicht)",
      "composes": [
        "counter"
      ],
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none",
            "error"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "textarea-with-counter",
        "label": "counter"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Counter braucht aria-live='polite' oder via aria-describedby verknuepft. --limit Farbe (Error) nie als einziges Signal."
      }
    },
    {
      "id": "with-placeholder",
      "label": "With Placeholder",
      "description": "Textarea mit Placeholder-Text in verschiedenen Groessen",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": "*",
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Placeholder ist kein Ersatz fuer Label. Placeholder-Farbe muss 4.5:1 Kontrast haben."
      }
    },
    {
      "id": "with-actions",
      "label": "With Actions Toolbar",
      "description": "Textarea mit Actions-Leiste (Copy, Clear, AI-Assist Buttons)",
      "composes": [
        "actions"
      ],
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "with-actions"
          ]
        },
        "states": [
          "default",
          "focus"
        ]
      },
      "focusTokenGroups": [
        "actions-slot"
      ],
      "layout": "row",
      "render": {
        "compositionType": "textarea-with-actions",
        "label": "with-actions"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Actions-Container kann role='toolbar' haben. Buttons brauchen :focus-visible. Actions werden bei leerer, nicht-fokussierter Textarea ausgeblendet."
      }
    },
    {
      "id": "scrollbar-preview",
      "label": "Scrollbar Styling",
      "description": "Textarea mit max-height und Scrollbar (thin vs auto)",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "no-resize"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "scrollbar"
      ],
      "layout": "row",
      "render": {
        "compositionType": "textarea-scrollbar",
        "label": "scrollbar"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Scrollbar muss sichtbar genug sein um Scroll-Moeglichkeit zu signalisieren. thin-Modus reduziert Breite, nicht Sichtbarkeit."
      }
    },
    {
      "id": "max-height-limit",
      "label": "Max Height Resize Limit",
      "description": "Textarea mit max-height — Scroll-Enforcement bei Ueberschreitung",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "plain"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "core-geometry"
      ],
      "layout": "row",
      "render": {
        "compositionType": "textarea-max-height",
        "label": "max-height"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Textarea waechst vertikal per Resize bis max-height, dann greift Scrollbar. Visual Cue: Scrollbar erscheint bei Grenze."
      }
    },
    {
      "id": "empty-vs-filled",
      "label": "Empty vs. Filled States",
      "description": "Vergleich: Leere Textarea (:placeholder-shown) vs. befuellte Textarea",
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "with-actions"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "textarea-empty-filled",
        "label": "empty-vs-filled"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Actions-Leiste wird bei leerer, nicht-fokussierter Textarea ausgeblendet. Bei Inhalt oder Focus erscheinen die Actions."
      }
    },
    {
      "id": "full-composition",
      "label": "Full Form Composition",
      "description": "Textarea im Form-Field: Label, Textarea mit Actions, Counter, Hint",
      "composes": [
        "form-field",
        "form-label",
        "counter",
        "form-hint",
        "actions"
      ],
      "matrix": {
        "axes": {
          "variant": [
            "outlined"
          ],
          "size": [
            "md"
          ],
          "resize": [
            "default"
          ],
          "validation": [
            "none"
          ],
          "content": [
            "with-actions"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "textarea-full-form",
        "label": "full-composition"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Vollstaendige Form-Integration: Label via for/id, Hint via aria-describedby, Counter via aria-describedby (Leerzeichen-getrennt), Actions mit role='toolbar'."
      }
    }
  ]
}
