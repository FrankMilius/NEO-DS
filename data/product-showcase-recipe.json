{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "product-showcase",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "display",
      "product",
      "gallery"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/product-showcase-docs"
    },
    "changelog": [
      {
        "version": "1.0.0",
        "changes": [
          "Initiale Implementierung: Options-Liste + Media-Panel mit Slide-Animation",
          "Layout-Achse: horizontal (Options links, Media rechts) / stacked (Options oben, Media unten)",
          "Animation-Achse: slide (von rechts), fade, none",
          "Selection-State: selected Option bekommt aktive Farbe, alle anderen gedimmt",
          "Media: Bild oder Video pro Option, animierter Wechsel bei Klick",
          "Token-gesteuert: Farben, Spacing, Animation-Duration, Layout-Gap, Media-Radius"
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_product-showcase.scss"
      ],
      "story": "stories/organisms/product-showcase.stories.js",
      "arena": null,
      "drupal": [
        "block--block-content--neo-product-showcase.html.twig",
        "block--inline-block--neo-product-showcase.html.twig"
      ],
      "docs": null
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-product-showcase"
    },
    "slots": [
      {
        "name": "options",
        "element": ".nc-product-showcase__options",
        "optional": false,
        "description": "Vertikale oder horizontale Liste der auswaehlbaren Optionen."
      },
      {
        "name": "option",
        "element": ".nc-product-showcase__option",
        "optional": false,
        "description": "Einzelne Option. Klick triggert Media-Wechsel. Button mit role='tab'."
      },
      {
        "name": "label",
        "element": ".nc-product-showcase__label",
        "optional": true,
        "description": "Kategorie-Label ueber den Optionen (z.B. 'Waehlen Sie eine Farbe')."
      },
      {
        "name": "media-panel",
        "element": ".nc-product-showcase__media-panel",
        "optional": false,
        "description": "Container fuer das aktive Bild/Video. role='tabpanel'."
      },
      {
        "name": "media-item",
        "element": ".nc-product-showcase__media-item",
        "optional": false,
        "description": "Einzelnes Bild/Video. Sichtbar wenn zugehoerige Option selected."
      }
    ],
    "convenience": [
      {
        "name": "option-indicator",
        "element": ".nc-product-showcase__option-indicator",
        "slot": "option",
        "description": "Optionaler visueller Indikator (Farbpunkt, Thumbnail) links der Option."
      },
      {
        "name": "option-text",
        "element": ".nc-product-showcase__option-text",
        "slot": "option",
        "description": "Text-Label der Option."
      }
    ],
    "domNotes": [
      "Root: Display Grid/Flex. Layout horizontal (Options links, Media rechts) oder stacked (Options oben, Media darunter).",
      "Options: role='tablist'. Jede Option ist ein button[role='tab'] mit aria-selected='true|false' und aria-controls.",
      "Media-Panel: role='tabpanel', aria-labelledby zeigt auf die aktive Option.",
      "Media-Item: position:absolute innerhalb des Panels. Aktives Item: opacity:1 + transform:translateX(0). Inaktiv: opacity:0 + transform:translateX(100%) (slide) oder opacity:0 (fade).",
      "Animation: transition auf opacity + transform. Duration via --nc-product-showcase-animation-duration.",
      "Selected-State: .nc-product-showcase__option[aria-selected='true'] bekommt --nc-product-showcase-option-color-active.",
      "Unselected: opacity oder color gedimmt via --nc-product-showcase-option-color.",
      "Label: Kleiner Kategorie-Text (z.B. 'Waehlen Sie eine Farbe'), optional, font-size xs, text-tertiary.",
      "Option-Indicator: Kleiner Farbpunkt oder Thumbnail links der Option. Border-Radius full fuer Kreise.",
      "Responsive: Auf Mobile wechselt horizontal zu stacked. Options werden horizontal scrollbar.",
      "Keyboard: ArrowUp/Down (vertikal) oder ArrowLeft/Right (horizontal) navigiert Optionen. Enter/Space selektiert.",
      "prefers-reduced-motion: Animationen deaktiviert, sofortiger Wechsel."
    ]
  },
  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Anordnung — horizontal (Options links, Media rechts) oder stacked (Options oben, Media darunter)",
      "values": {
        "horizontal": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "showcase-horizontal"
        },
        "stacked": {
          "modifier": "nc-product-showcase--stacked",
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "showcase-stacked"
        }
      }
    },
    "animation": {
      "label": "Animation",
      "description": "Uebergangs-Animation beim Wechsel — slide (von rechts), fade (einblenden), none (sofort)",
      "values": {
        "slide": {
          "modifier": null,
          "tokenGroups": [
            "animation"
          ],
          "renderHint": "showcase-slide"
        },
        "fade": {
          "modifier": "nc-product-showcase--fade",
          "tokenGroups": [
            "animation"
          ],
          "renderHint": "showcase-fade"
        },
        "none": {
          "modifier": "nc-product-showcase--no-anim",
          "tokenGroups": [],
          "renderHint": "showcase-none"
        }
      }
    },
    "optionStyle": {
      "label": "Option Style",
      "description": "Darstellung der Optionen — text (nur Text), indicator (mit Farbpunkt/Thumbnail), card (als Karten)",
      "values": {
        "text": {
          "modifier": null,
          "tokenGroups": [
            "options"
          ],
          "renderHint": "showcase-text"
        },
        "indicator": {
          "modifier": "nc-product-showcase--indicator",
          "tokenGroups": [
            "options"
          ],
          "slotConfig": {
            "option-indicator": true
          },
          "renderHint": "showcase-indicator"
        },
        "card": {
          "modifier": "nc-product-showcase--card",
          "tokenGroups": [
            "options"
          ],
          "renderHint": "showcase-card"
        }
      }
    },
    "interaktion": {
      "label": "Interaktion",
      "description": "Wie der Screen gewechselt wird — tabs (Klick auf die Option, Grundfassung), accordion (Klick auf Etikett und Ueberschrift, der Text klappt gleichzeitig auf), scroll (der Wechsel folgt der Scrollposition).",
      "values": {
        "tabs": {
          "modifier": null,
          "tokenGroups": [
            "options"
          ],
          "renderHint": "showcase-tabs"
        },
        "accordion": {
          "modifier": "nc-product-showcase--accordion",
          "tokenGroups": [
            "accordion"
          ],
          "renderHint": "showcase-accordion"
        },
        "scroll": {
          "modifier": "nc-product-showcase--sticky",
          "tokenGroups": [
            "sticky"
          ],
          "renderHint": "showcase-scroll"
        }
      }
    },
    "mediaSide": {
      "label": "Seite des Mediums",
      "description": "Auf welcher Seite das Medium steht. Bei der Akkordeon-Fassung ist links die Vorgabe: Wer eine App zeigt, zeigt zuerst die App. Ab md gestapelt — dann steht das Medium immer oben.",
      "values": {
        "start": {
          "modifier": null,
          "tokenGroups": [
            "accordion"
          ],
          "renderHint": "showcase-media-start"
        },
        "end": {
          "modifier": "nc-product-showcase--media-end",
          "tokenGroups": [
            "accordion"
          ],
          "renderHint": "showcase-media-end"
        }
      }
    },
    "mediaFrame": {
      "label": "Geraeterahmen",
      "description": "Ohne Rahmen fuellt das Medium das Panel im vorgegebenen Seitenverhaeltnis. Mit Rahmen gibt das Panel sein Seitenverhaeltnis auf und ueberlaesst es dem Geraet (nc-device) — noetig fuer App-Screens im Format 1:2.",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "showcase-frame-none"
        },
        "device": {
          "modifier": "nc-product-showcase--device",
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "showcase-frame-device"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus-visible"
    ],
    "precedence": [
      "focus-visible",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "focus-visible"
        ],
        "note": "Hover auf unselected Option: opacity erhoehen."
      },
      {
        "state": "focus-visible",
        "unless": [],
        "note": "Focus-Ring auf der aktiven Option."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Options: role='tablist'. Option: role='tab', aria-selected, aria-controls. Media-Panel: role='tabpanel', aria-labelledby. Keyboard: Arrow-Keys navigieren, Enter/Space selektiert."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "animation": [
              "slide",
              "fade"
            ]
          }
        },
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Animation muss bei prefers-reduced-motion deaktivierbar sein."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-tablist",
          "role-tab",
          "role-tabpanel",
          "aria-selected",
          "aria-controls"
        ],
        "notes": [
          "Tabs-Pattern fuer Options + Media-Panel. Jede Option kontrolliert ein Panel."
        ]
      },
      {
        "when": {},
        "require": [
          "keyboard-navigation"
        ],
        "notes": [
          "ArrowUp/Down oder ArrowLeft/Right je nach Layout. Enter/Space selektiert."
        ]
      }
    ],
    "copy": {
      "label": {
        "maxChars": 40,
        "note": "Kategorie-Label (z.B. 'Waehlen Sie eine Farbe')."
      },
      "optionText": {
        "maxChars": 30,
        "note": "Options-Text (z.B. 'Storm Matt', 'Snow')."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-product-showcase"
    ],
    "baseTokenGroups": [
      "layout",
      "headline",
      "options",
      "description",
      "media",
      "animation"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-product-showcase-gap",
          "nc-product-showcase-options-width",
          "nc-product-showcase-padding"
        ]
      },
      "options": {
        "label": "Options",
        "tokens": [
          "nc-product-showcase-option-font-size",
          "nc-product-showcase-option-font-weight",
          "nc-product-showcase-option-color",
          "nc-product-showcase-option-color-active",
          "nc-product-showcase-option-color-hover",
          "nc-product-showcase-option-gap",
          "nc-product-showcase-option-padding",
          "nc-product-showcase-label-font-size",
          "nc-product-showcase-label-color",
          "nc-product-showcase-indicator-size",
          "nc-product-showcase-indicator-radius",
          "nc-product-showcase-option-font-family",
          "nc-product-showcase-options-align",
          "nc-product-showcase-label-font-family"
        ]
      },
      "headline": {
        "label": "Headline",
        "tokens": [
          "nc-product-showcase-headline-size",
          "nc-product-showcase-headline-weight",
          "nc-product-showcase-headline-color"
        ]
      },
      "description": {
        "label": "Description",
        "tokens": [
          "nc-product-showcase-desc-size",
          "nc-product-showcase-desc-color"
        ]
      },
      "media": {
        "label": "Media Panel",
        "tokens": [
          "nc-product-showcase-media-radius",
          "nc-product-showcase-media-aspect-ratio",
          "nc-product-showcase-media-bg"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-product-showcase-animation-duration",
          "nc-product-showcase-animation-easing"
        ]
      },
      "accordion": {
        "label": "Akkordeon",
        "description": "Typografie und Geometrie der Klick-Fassung: Etikett, Ueberschrift, aufklappender Text, Trennlinie und Marke der offenen Station.",
        "tokens": [
          "nc-product-showcase-acc-label-family",
          "nc-product-showcase-acc-label-size",
          "nc-product-showcase-acc-label-weight",
          "nc-product-showcase-acc-label-tracking",
          "nc-product-showcase-acc-label-color",
          "nc-product-showcase-acc-title-family",
          "nc-product-showcase-acc-title-size",
          "nc-product-showcase-acc-title-weight",
          "nc-product-showcase-acc-title-lh",
          "nc-product-showcase-acc-title-tracking",
          "nc-product-showcase-acc-title-color",
          "nc-product-showcase-acc-text-size",
          "nc-product-showcase-acc-text-lh",
          "nc-product-showcase-acc-text-color",
          "nc-product-showcase-acc-text-max",
          "nc-product-showcase-acc-gap",
          "nc-product-showcase-acc-pad",
          "nc-product-showcase-acc-rule",
          "nc-product-showcase-acc-marker",
          "nc-product-showcase-acc-marker-width",
          "nc-product-showcase-acc-device-col",
          "nc-product-showcase-acc-duration"
        ]
      },
      "sticky": {
        "label": "Mitlaufendes Medium",
        "description": "Abstand des klebenden Medienpanels zur Oberkante des Fensters.",
        "tokens": [
          "nc-product-showcase-sticky-top"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.layout.values.*.modifier",
        "axes.animation.values.*.modifier",
        "axes.optionStyle.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "horizontal-slide",
      "label": "Horizontal + Slide",
      "description": "Standard: Options links, Media rechts. Bild fliegt von rechts rein bei Klick.",
      "matrix": {
        "axes": {
          "layout": [
            "horizontal"
          ],
          "animation": [
            "slide"
          ],
          "optionStyle": [
            "text"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "layout",
        "options",
        "media",
        "animation"
      ],
      "layout": "row",
      "render": {
        "compositionType": "showcase-horizontal",
        "label": "horizontal + slide"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Options: 4.5:1 gegen BG. Active Option deutlich unterscheidbar."
      }
    },
    {
      "id": "horizontal-fade",
      "label": "Horizontal + Fade",
      "description": "Options links, Media rechts. Bild blendet sanft ein/aus.",
      "matrix": {
        "axes": {
          "layout": [
            "horizontal"
          ],
          "animation": [
            "fade"
          ],
          "optionStyle": [
            "text"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "animation"
      ],
      "layout": "row",
      "render": {
        "compositionType": "showcase-horizontal",
        "label": "horizontal + fade"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Fade-Animation bei reduced-motion deaktivieren."
      }
    },
    {
      "id": "with-indicators",
      "label": "With Color Indicators",
      "description": "Options mit Farbpunkt-Indikatoren (Polestar-Style).",
      "matrix": {
        "axes": {
          "layout": [
            "horizontal"
          ],
          "animation": [
            "slide"
          ],
          "optionStyle": [
            "indicator"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "options"
      ],
      "layout": "row",
      "render": {
        "compositionType": "showcase-indicator",
        "label": "with indicators"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Indikator-Farbe darf nicht allein Bedeutung vermitteln — Text ist primaer."
      }
    },
    {
      "id": "stacked",
      "label": "Stacked Layout",
      "description": "Options oben, Media darunter. Fuer Mobile oder Produkt-Detail-Seiten.",
      "matrix": {
        "axes": {
          "layout": [
            "stacked"
          ],
          "animation": [
            "slide"
          ],
          "optionStyle": [
            "text"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "layout"
      ],
      "layout": "row",
      "render": {
        "compositionType": "showcase-stacked",
        "label": "stacked"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Stacked: Options horizontal scrollbar auf kleinen Screens."
      }
    },
    {
      "id": "option-styles",
      "label": "Option Styles",
      "description": "Text vs Indicator vs Card — alle 3 Option-Darstellungen.",
      "matrix": {
        "axes": {
          "layout": [
            "horizontal"
          ],
          "animation": [
            "slide"
          ],
          "optionStyle": "*"
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "options"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "optionStyle"
      },
      "render": {
        "label": "{optionStyle}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Card-Variante: Focus-Ring um die gesamte Karte."
      }
    },
    {
      "id": "animation-comparison",
      "label": "Animation Variants",
      "description": "Slide vs Fade vs None — Uebergangs-Animationen.",
      "matrix": {
        "axes": {
          "layout": [
            "horizontal"
          ],
          "animation": "*",
          "optionStyle": [
            "text"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "animation"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "animation"
      },
      "render": {
        "label": "{animation}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "prefers-reduced-motion: alle Animationen deaktivieren."
      }
    }
  ]
}
