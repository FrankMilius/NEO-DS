    },
    {
      "id": "skeleton",
      "label": "Skeleton",
      "description": "CSS-only Ladeanimation. Shimmer auf allen Convenience-Elementen.",
      "category": "state",
      "root": "article",
      "classes": ["nc-card", "nc-card--skeleton"],
      "slots": {
        "media": {},
        "content": { "elements": ["kicker", "title", "description", "meta"] }
      },
      "tokens": ["basis"],
      "states": [],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card nc-card--skeleton\">\n  <div class=\"nc-card__media\"></div>\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__kicker\">&nbsp;</span>\n    <h3 class=\"nc-card__title\">&nbsp;</h3>\n    <p class=\"nc-card__description\">&nbsp;</p>\n    <span class=\"nc-card__meta\">&nbsp;</span>\n  </div>\n</article>"
    }
  ],

  "tokenGroups": {
    "basis": {
      "label": "Basis",
      "tokens": [
        "nc-card-bg", "nc-card-color", "nc-card-border", "nc-card-radius",
        "nc-card-padding", "nc-card-shadow", "nc-card-shadow-hover",
        "nc-card-border-width", "nc-card-disabled-opacity"
      ]
    },
    "spacing": {
      "label": "Spacing",
      "tokens": [
        "nc-card-header-padding", "nc-card-header-gap",
        "nc-card-content-padding",
        "nc-card-footer-padding", "nc-card-footer-gap"
      ]
    },
    "typography": {
      "label": "Typografie",
      "tokens": [
        "nc-card-title-font-size", "nc-card-title-font-weight",
        "nc-card-title-color", "nc-card-title-line-height",
        "nc-card-description-font-size", "nc-card-description-color",
        "nc-card-description-line-height"
      ]
    },
    "interactive": {
      "label": "Interaktiv",
      "tokens": [
        "nc-card-transition-duration", "nc-card-hover-border",
        "nc-card-nav-color-hover"
      ]
    },
    "selectable": {
      "label": "Selectable",
      "tokens": [
        "nc-card-selected-border", "nc-card-selected-bg",
        "nc-card-selected-ring-width"
      ]
    },
    "expandable": {
      "label": "Expandable",
      "tokens": [
        "nc-card-summary-font-weight", "nc-card-summary-padding",
        "nc-card-details-content-padding", "nc-card-expand-icon-size"
      ]
    },
    "status": {
      "label": "Status",
      "tokens": [
        "nc-card-status-border-width",
        "nc-card-status-success-border", "nc-card-status-warning-border",
        "nc-card-status-danger-border", "nc-card-status-info-border"
      ]
    },
    "preview": {
      "label": "Preview",
      "tokens": [
        "nc-card-preview-media-ratio", "nc-card-preview-title-size"
      ]
    },
    "summary": {
