{
  "$schema": "card-recipes-schema",
  "version": "1.0.0",
  "_deprecated": "Abgeloest durch card-recipe.json (v3.1.0). Diese Datei wird noch vom CardArena.vue konsumiert und wird entfernt, sobald CardArena migriert ist.",
  "description": "Single Source of Truth für alle Card-Varianten. Konsumiert von Docs, Theme Configurator und Lint-Scripts.",

  "anatomy": {
    "slots": [
      { "name": "media",   "element": ".nc-card__media",   "optional": true,  "description": "Bild, Video oder Platzhalter. Standard aspect-ratio 3:2." },
      { "name": "content", "element": ".nc-card__content", "optional": false, "description": "Freier Inhaltsbereich. flex-grow: 1, Padding via Token." },
      { "name": "footer",  "element": ".nc-card__footer",  "optional": true,  "description": "Aktionen, Meta. margin-top: auto, immer am unteren Rand." }
    ],
    "convenience": [
      { "name": "kicker",        "element": ".nc-card__kicker",        "slot": "content", "description": "Eyebrow/Badge-Text (uppercase, xs, secondary)" },
      { "name": "title",         "element": ".nc-card__title",         "slot": "content", "description": "Hauptüberschrift, konsumiert --nc-card-title-* Tokens" },
      { "name": "title-link",    "element": ".nc-card__title-link",    "slot": "content", "description": "Stretched Link im Titel, ::after { inset: 0 }" },
      { "name": "description",   "element": ".nc-card__description",   "slot": "content", "description": "Fließtext, konsumiert --nc-card-description-* Tokens" },
      { "name": "meta",          "element": ".nc-card__meta",          "slot": "content", "description": "Metadaten-Zeile (flex row, tertiary, xs)" },
      { "name": "icon",          "element": ".nc-card__icon",          "slot": "content", "description": "Icon, Größe via --nc-card-action-icon-size" },
      { "name": "input",         "element": ".nc-card__input",         "slot": "content", "description": "Hidden input (radio/checkbox) für Selectable" },
      { "name": "footer-action", "element": ".nc-card__footer-action", "slot": "footer",  "description": "Button im Footer, z-index: 1 über title-link" },
      { "name": "summary",       "element": ".nc-card__summary",       "slot": null,      "description": "Summary-Element für Expandable (details/summary)" },
      { "name": "expand-icon",   "element": ".nc-card__expand-icon",   "slot": null,      "description": "Chevron-Icon, rotiert bei [open]" },
      { "name": "details-content","element": ".nc-card__details-content","slot": null,     "description": "Content innerhalb von details" }
    ]
  },

  "behaviors": [
    { "modifier": null,               "description": "Nicht klickbar, rein informativ" },
    { "modifier": "--navigational",    "description": "Whole-card click: <a>, hover shadow, focus-ring-inset" },
    { "modifier": "--selectable",      "description": "Radio/Checkbox: <label>, :has(:checked), focus-ring-inset" },
    { "modifier": "--expandable",      "description": "Aufklappbar: <details>, summary, expand-icon" },
    { "modifier": "--action",          "description": "Footer mit Top-Border, Hover background-shift" },
    { "modifier": "--status",          "description": "Linker Rand-Indikator, 4 Farben" },
    { "modifier": "--preview",         "description": "Media 3:2, Title line-clamp(2), Desc line-clamp(3)" },
    { "modifier": "--summary",         "description": "Zentriert, Media als runder Avatar" },
    { "modifier": "--horizontal",      "description": "flex-direction: row ab md Breakpoint" },
    { "modifier": "--skeleton",        "description": "CSS-only Skeleton Shimmer auf allen Slots" },
    { "modifier": "--disabled",        "description": "opacity + pointer-events: none" },
    { "modifier": "--featured",        "description": "Sub-Modifier von --preview: horizontal ab md, Title heading-m" },
    { "modifier": "--square-media",    "description": "Sub-Modifier von --summary: normaler Radius statt rund" }
  ],

  "grids": [
    { "class": "nc-card-grid",           "minWidth": "280px", "gap": "spacing-06", "useCase": "Standard (3 Spalten Desktop)" },
    { "class": "nc-card-grid--compact",  "minWidth": "160px", "gap": "spacing-04", "useCase": "Cities, Team (6 Spalten Desktop)" },
    { "class": "nc-card-grid--pair",     "minWidth": "320px", "gap": "spacing-06", "useCase": "Stories, Featured (2 Spalten Desktop)" },
    { "class": "nc-card-grid--links",    "minWidth": "200px", "gap": "spacing-06", "useCase": "Quick Links (4 Spalten Desktop)" }
  ],

  "recipes": [
    {
      "id": "informational",
      "label": "Informational",
      "description": "Einfache Darstellung von Inhalten. Nicht fokussierbar, nicht klickbar.",
      "category": "base",
      "root": "article",
      "classes": ["nc-card"],
      "slots": {
        "media": { "optional": true },
        "content": { "elements": ["title", "description"] }
      },
      "tokens": ["basis"],
      "states": [],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card\">\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Projektstatus</h3>\n    <p class=\"nc-card__description\">Aktuelle Informationen zum Sprint</p>\n  </div>\n</article>",
      "htmlWithMedia": "<article class=\"nc-card\">\n  <div class=\"nc-card__media\">\n    <img src=\"bild.jpg\" alt=\"Beschreibung\" />\n  </div>\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Projektstatus</h3>\n    <p class=\"nc-card__description\">Aktuelle Informationen zum Sprint</p>\n  </div>\n</article>"
    },
    {
      "id": "nav-entire",
      "label": "Navigational (Entire)",
      "description": "Gesamte Kartenfläche ist ein Link. Hover: Shadow + Border. Focus: ring-inset.",
      "category": "base",
      "root": "a",
      "classes": ["nc-card", "nc-card--navigational"],
      "slots": {
        "media": { "optional": true },
        "content": { "elements": ["title", "description"] }
      },
      "tokens": ["basis", "interactive"],
      "states": ["hover", "focus", "active", "disabled"],
      "grid": "nc-card-grid",
      "html": "<a href=\"/ziel\" class=\"nc-card nc-card--navigational\">\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Link-Titel</h3>\n    <p class=\"nc-card__description\">Gesamte Fläche ist klickbar</p>\n  </div>\n</a>"
    },
    {
      "id": "nav-partial",
      "label": "Navigational (Partial)",
      "description": "Nur der Titel ist verlinkt. Footer-Buttons per z-index darüber.",
      "category": "base",
      "root": "article",
      "classes": ["nc-card"],
      "slots": {
        "media": { "optional": true },
        "content": { "elements": ["title-link", "description"] },
        "footer": { "optional": true, "elements": ["footer-action"] }
      },
      "tokens": ["basis", "interactive"],
      "states": ["hover", "focus", "active", "disabled"],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card\">\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">\n      <a href=\"/ziel\" class=\"nc-card__title-link\">Partieller Link</a>\n    </h3>\n    <p class=\"nc-card__description\">Nur der Titel ist verlinkt</p>\n  </div>\n</article>"
    },
    {
      "id": "action",
      "label": "Action Card",
      "description": "Footer mit Top-Border als visuelle Trennung. Hover: background-secondary Shift.",
      "category": "base",
      "root": "article",
      "classes": ["nc-card", "nc-card--action"],
      "slots": {
        "media": { "optional": true },
        "content": { "elements": ["title", "description"] },
        "footer": { "elements": ["footer-action"] }
      },
      "tokens": ["basis", "action"],
      "states": ["hover", "disabled"],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card nc-card--action\">\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Benutzer einladen</h3>\n    <p class=\"nc-card__description\">Sende eine Einladung per E-Mail.</p>\n  </div>\n  <div class=\"nc-card__footer\">\n    <button class=\"nc-button nc-button--outline nc-button--sm nc-card__footer-action\">Abbrechen</button>\n    <button class=\"nc-button nc-button--sm nc-card__footer-action\">Einladen</button>\n  </div>\n</article>"
    },
    {
      "id": "selectable-radio",
      "label": "Selectable (Radio)",
      "description": "Exklusive Auswahl. Container: <label>, Input: sr-only. :has(:checked) → selected.",
      "category": "base",
      "root": "label",
      "classes": ["nc-card", "nc-card--selectable"],
      "slots": {
        "content": { "elements": ["input", "title", "description"] }
      },
      "inputType": "radio",
      "tokens": ["basis", "selectable"],
      "states": ["hover", "focus", "selected", "disabled"],
      "grid": "nc-card-grid",
      "html": "<label class=\"nc-card nc-card--selectable\">\n  <input class=\"nc-card__input\" type=\"radio\" name=\"plan\" value=\"basic\" />\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__title\">Basic</span>\n    <span class=\"nc-card__description\">5 GB Speicher</span>\n  </div>\n</label>"
    },
    {
      "id": "selectable-checkbox",
      "label": "Selectable (Checkbox)",
      "description": "Mehrfachauswahl. Container: <label>, Input: sr-only. :has(:checked) → selected.",
      "category": "base",
      "root": "label",
      "classes": ["nc-card", "nc-card--selectable"],
      "slots": {
        "content": { "elements": ["input", "title", "description"] }
      },
      "inputType": "checkbox",
      "tokens": ["basis", "selectable"],
      "states": ["hover", "focus", "selected", "disabled"],
      "grid": "nc-card-grid",
      "html": "<label class=\"nc-card nc-card--selectable\">\n  <input class=\"nc-card__input\" type=\"checkbox\" name=\"features\" value=\"analytics\" />\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__title\">Analytics</span>\n    <span class=\"nc-card__description\">Auswertungen &amp; Reports</span>\n  </div>\n</label>"
    },
    {
      "id": "expandable",
      "label": "Expandable",
      "description": "Aufklappbare Card via <details>/<summary>. Expand-Icon rotiert bei [open].",
      "category": "base",
      "root": "details",
      "classes": ["nc-card", "nc-card--expandable"],
      "slots": {},
      "specialElements": ["summary", "expand-icon", "details-content"],
      "tokens": ["basis", "expandable"],
      "states": ["hover", "focus", "open"],
      "grid": "nc-card-grid",
      "html": "<details class=\"nc-card nc-card--expandable\">\n  <summary class=\"nc-card__summary\">\n    <span class=\"nc-card__title\">FAQ-Frage hier?</span>\n    <svg class=\"nc-card__expand-icon\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n  </summary>\n  <div class=\"nc-card__details-content\">\n    <p>Antwort auf die Frage.</p>\n  </div>\n</details>"
    },
    {
      "id": "status",
      "label": "Status Card",
      "description": "Linker Rand-Indikator via border-left. 4 Status-Farben: success, warning, danger, info.",
      "category": "base",
      "root": "article",
      "classes": ["nc-card", "nc-card--status", "nc-card--status-{level}"],
      "statusLevels": ["success", "warning", "danger", "info"],
      "slots": {
        "content": { "elements": ["title", "description"] }
      },
      "tokens": ["basis", "status"],
      "states": [],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card nc-card--status nc-card--status-success\">\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Erfolgreich</h3>\n    <p class=\"nc-card__description\">Alle Tests bestanden</p>\n  </div>\n</article>"
    },

    {
      "id": "event-preview",
      "label": "Event Preview",
      "description": "Event-Teaser mit Bild, Kategorie-Kicker, Titel, Beschreibung und Datum/Lesezeit-Meta.",
      "category": "recipe",
      "root": "a",
      "classes": ["nc-card", "nc-card--preview", "nc-card--navigational"],
      "slots": {
        "media": {},
        "content": { "elements": ["kicker", "title", "description", "meta"] }
      },
      "tokens": ["basis", "interactive", "preview"],
      "states": ["hover", "focus", "active", "disabled"],
      "grid": "nc-card-grid",
      "html": "<a href=\"/event\" class=\"nc-card nc-card--preview nc-card--navigational\">\n  <div class=\"nc-card__media\">\n    <img src=\"event.jpg\" alt=\"Event-Bild\" />\n  </div>\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__kicker\">Webinar</span>\n    <h3 class=\"nc-card__title\">Cloud Migration Best Practices</h3>\n    <p class=\"nc-card__description\">Erfahren Sie, wie Sie Ihre Infrastruktur sicher in die Cloud migrieren.</p>\n    <span class=\"nc-card__meta\">15. M\u00e4rz 2026 \u00b7 14:00 Uhr</span>\n  </div>\n</a>"
    },
    {
      "id": "story-featured",
      "label": "Story Featured",
      "description": "Hervorgehobene Erfolgsgeschichte. Ab md horizontal mit 50% Media.",
      "category": "recipe",
      "root": "a",
      "classes": ["nc-card", "nc-card--preview", "nc-card--featured", "nc-card--navigational"],
      "slots": {
        "media": {},
        "content": { "elements": ["kicker", "title", "description"] }
      },
      "tokens": ["basis", "interactive", "preview"],
      "states": ["hover", "focus", "active", "disabled"],
      "responsive": { "md": "horizontal, media 50%, title heading-m" },
      "grid": "nc-card-grid--pair",
      "html": "<a href=\"/story\" class=\"nc-card nc-card--preview nc-card--featured nc-card--navigational\">\n  <div class=\"nc-card__media\">\n    <img src=\"story.jpg\" alt=\"Kundenstory\" />\n  </div>\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__kicker\">Customer Success</span>\n    <h3 class=\"nc-card__title\">Festo modernisiert WeNet und PeopleNet</h3>\n    <p class=\"nc-card__description\">Mit PIIPE Workplace setzt Festo neue Ma\u00dfst\u00e4be f\u00fcr die interne Kommunikation.</p>\n  </div>\n</a>"
    },
    {
      "id": "team-member",
      "label": "Team Member",
      "description": "Personenkarte mit rundem Avatar, Name und Rolle. Zentriert.",
      "category": "recipe",
      "root": "article",
      "classes": ["nc-card", "nc-card--summary"],
      "slots": {
        "media": {},
        "content": { "elements": ["title", "description"] }
      },
      "tokens": ["basis", "summary"],
      "states": [],
      "grid": "nc-card-grid--compact",
      "html": "<article class=\"nc-card nc-card--summary\">\n  <div class=\"nc-card__media\">\n    <img src=\"avatar.jpg\" alt=\"Anna M\u00fcller\" />\n  </div>\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Anna M\u00fcller</h3>\n    <p class=\"nc-card__description\">Lead Developer</p>\n  </div>\n</article>"
    },
    {
      "id": "city-location",
      "label": "City / Location",
      "description": "Standortkarte mit rundem Avatar und Stadtname. Klickbar.",
      "category": "recipe",
      "root": "a",
      "classes": ["nc-card", "nc-card--summary", "nc-card--navigational"],
      "slots": {
        "media": {},
        "content": { "elements": ["title", "description"] }
      },
      "tokens": ["basis", "interactive", "summary"],
      "states": ["hover", "focus", "active"],
      "grid": "nc-card-grid--compact",
      "html": "<a href=\"/standort/berlin\" class=\"nc-card nc-card--summary nc-card--navigational\">\n  <div class=\"nc-card__media\">\n    <img src=\"berlin.jpg\" alt=\"Berlin\" />\n  </div>\n  <div class=\"nc-card__content\">\n    <h3 class=\"nc-card__title\">Berlin</h3>\n    <p class=\"nc-card__description\">42 Mitarbeitende</p>\n  </div>\n</a>"
    },
    {
      "id": "quick-link",
      "label": "Quick Link",
      "description": "Schnellzugriff mit Icon, Titel und kurzer Beschreibung. Footer-Link.",
      "category": "recipe",
      "root": "a",
      "classes": ["nc-card", "nc-card--action", "nc-card--navigational"],
      "slots": {
        "content": { "elements": ["icon", "title", "description"] }
      },
      "tokens": ["basis", "interactive", "action"],
      "states": ["hover", "focus", "active"],
      "grid": "nc-card-grid--links",
      "html": "<a href=\"/feature\" class=\"nc-card nc-card--action nc-card--navigational\">\n  <div class=\"nc-card__content\">\n    <svg class=\"nc-card__icon\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2v20M2 12h20\"/></svg>\n    <h3 class=\"nc-card__title\">Feature entdecken</h3>\n    <p class=\"nc-card__description\">Kurze Beschreibung des Features</p>\n  </div>\n</a>"
    },
    {
      "id": "testimonial-quote",
      "label": "Testimonial / Quote",
      "description": "Zitat mit Autor-Avatar, Name und Firma. Description als Zitat, Title als Autorenname.",
      "category": "recipe",
      "root": "article",
      "classes": ["nc-card"],
      "slots": {
        "content": { "elements": ["description", "meta"] },
        "footer": { "elements": ["footer-action"] }
      },
      "tokens": ["basis"],
      "states": [],
      "note": "Description = Zitat, Meta = Autor + Firma. Kein eigener Modifier nötig.",
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card\">\n  <div class=\"nc-card__content\">\n    <p class=\"nc-card__description\">\u201eMit PIIPE Workplace haben wir unsere interne Kommunikation revolutioniert.\u201c</p>\n    <span class=\"nc-card__meta\">Anna M\u00fcller \u00b7 CTO, Festo SE</span>\n  </div>\n</article>"
    },
    {
      "id": "pricing-tier",
      "label": "Pricing Tier",
      "description": "Preisplan als selectable Card. Titel = Planname, Description = Features, Footer = Preis + CTA.",
      "category": "recipe",
      "root": "label",
      "classes": ["nc-card", "nc-card--selectable"],
      "slots": {
        "content": { "elements": ["input", "kicker", "title", "description"] },
        "footer": { "elements": ["footer-action"] }
      },
      "inputType": "radio",
      "tokens": ["basis", "selectable"],
      "states": ["hover", "focus", "selected", "disabled"],
      "grid": "nc-card-grid",
      "html": "<label class=\"nc-card nc-card--selectable\">\n  <input class=\"nc-card__input\" type=\"radio\" name=\"pricing\" value=\"pro\" />\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__kicker\">Empfohlen</span>\n    <span class=\"nc-card__title\">Pro</span>\n    <span class=\"nc-card__description\">50 GB, Priority Support, API-Zugang</span>\n  </div>\n  <div class=\"nc-card__footer\">\n    <span class=\"nc-card__meta\">\u20ac 29 / Monat</span>\n  </div>\n</label>"
    },
    {
      "id": "dashboard-metric",
      "label": "Dashboard Metric",
      "description": "KPI-Anzeige mit Status-Indikator. Kicker = Label, Title = Wert, Meta = Trend.",
      "category": "recipe",
      "root": "article",
      "classes": ["nc-card", "nc-card--status", "nc-card--status-{level}"],
      "statusLevels": ["success", "warning", "danger", "info"],
      "slots": {
        "content": { "elements": ["kicker", "title", "meta"] }
      },
      "tokens": ["basis", "status"],
      "states": [],
      "grid": "nc-card-grid",
      "html": "<article class=\"nc-card nc-card--status nc-card--status-success\">\n  <div class=\"nc-card__content\">\n    <span class=\"nc-card__kicker\">Umsatz Q1</span>\n    <h3 class=\"nc-card__title\">\u20ac 1.2M</h3>\n    <span class=\"nc-card__meta\">\u2191 12% vs. Vorjahr</span>\n  </div>\n</article>"
    },
    {
      "id": "media-gallery",
      "label": "Media Gallery",
      "description": "Reine Bildkarte ohne Text-Content. Nur Media-Slot, klickbar.",
      "category": "recipe",
      "root": "a",
