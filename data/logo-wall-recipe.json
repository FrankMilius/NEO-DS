            "layout",
            "item",
            "marquee"
          ],
          "renderHint": "logo-wall-marquee"
        },
        "cluster": {
          "modifier": "nc-logo-wall--cluster",
          "tokenGroups": [
            "layout",
            "item"
          ],
          "renderHint": "logo-wall-cluster"
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groesse der Logo-Boxen — sm (kompakt/Footer), md (Standard), lg (Feature)",
      "values": {
        "sm": {
          "modifier": "nc-logo-wall--sm",
          "tokenGroups": [
            "sizing"
          ],
          "renderHint": "logo-wall-sm"
        },
        "md": {
          "modifier": null,
          "tokenGroups": [
            "sizing"
          ],
          "renderHint": "logo-wall-md"
        },
        "lg": {
          "modifier": "nc-logo-wall--lg",
          "tokenGroups": [
            "sizing"
          ],
          "renderHint": "logo-wall-lg"
        }
      }
    },
    "appearance": {
      "label": "Appearance",
      "description": "Darstellung — original (Markenfarben), mono (Grayscale, Hover = Farbe)",
      "values": {
        "original": {
          "modifier": null,
          "tokenGroups": [
            "logo"
          ],
          "renderHint": "logo-wall-original"
        },
        "mono": {
          "modifier": "nc-logo-wall--mono",
          "tokenGroups": [
            "logo"
          ],
          "renderHint": "logo-wall-mono"
        }
      }
    },
    "animation": {
      "label": "Animation",
      "description": "Einblendung — none (sofort), fadein (gestaffeltes Einblenden per Intersection Observer)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "logo-wall-no-anim"
        },
        "fadein": {
          "modifier": "nc-logo-wall--fadein",
          "tokenGroups": [
            "animation"
          ],
          "renderHint": "logo-wall-fadein"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "paused",
      "stopped"
    ],
    "precedence": [
      "hover",
      "stopped",
      "paused",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [],
        "note": "Hover auf Pill: Shadow + Border-Color Transition. Mono-Modus: Filter entfernt."
      },
      {
        "state": "paused",
        "unless": [],
        "note": "Laufband: Maus ueber der Spur oder Fokus darin — .is-paused (Behavior marquee)."
      },
      {
        "state": "stopped",
        "unless": [],
        "note": "Laufband: per Knopf angehalten — .is-stopped."
      }
    ],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "2.2.2: Laufband mit Pause-Knopf vor der Spur (Beschriftung wechselt), Maus/Fokus halten voruebergehend an, prefers-reduced-motion: stehend (Behavior marquee).",
        "2.4.3/4.1.2: Kopien im Laufband inert — nicht fokussierbar, nicht vorgelesen.",
        "4.1.2: Kein aria-label an div ohne Rolle; Name aus alt bzw. Linktext.",
        "3.2.5/2.4.4: Externe Links mit Hinweis „öffnet in neuem Fenster“ (.u-sr-only)."
      ],
      "note": "Logos: img mit alt-Text (bei Links Linkname aus alt + Hinweis neues Fenster). Laufband: Verhalten aus marquee (Pause-Knopf, inerte Kopien)."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "layout": [
              "marquee"
            ]
          }
        },
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Marquee muss bei prefers-reduced-motion pausieren."
      },
      {
        "when": {
          "axes": {
            "animation": [
              "fadein"
            ]
          }
        },
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Fade-In bei reduced-motion deaktivieren."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "alt-text-or-aria"
        ],
        "notes": [
          "Jedes Logo braucht alt-Text auf img (bzw. Text in der Pille); kein aria-label an Pille oder Wand."
        ]
      },
      {
        "when": {
          "layout": "marquee"
        },
        "require": [
          "autoplay-control"
        ],
        "notes": [
          "Laufband nur mit Pause-Knopf (WCAG 2.2.2): Twig rendert .nc-logo-wall__pause vor der Spur; fehlt er, legt das Behavior marquee ihn an."
        ]
      }
    ],
    "copy": {
      "altText": {
        "maxChars": 50,
        "note": "Alt-Text des Logos (z.B. 'Firmenname Logo')."
      },
      "externerLink": {
        "de": "öffnet in neuem Fenster",
        "en": "opens in a new window",
        "note": "Hinweis fuer target=_blank als .u-sr-only im Link (Drupal.t im Theme)."
      }
    }
  },
