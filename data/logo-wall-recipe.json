{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "logo-wall",
    "version": "2.1.0",
    "status": "stable",
    "tags": [
      "display",
      "branding",
      "logos",
      "partner",
      "marquee"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/logo-wall-docs"
    },
    "changelog": [
      {
        "version": "2.1.0",
        "changes": [
          "Plan v4, Phase 2 (12.10.2026; Freigabe ausstehend, WCAG 2.2.2): Laufband (Layout marquee) mit Pause-Knopf .nc-logo-wall__pause vor der Spur; Verhalten aus neo-behaviors marquee (teilt Knopf-Tokens --nc-marquee-pause-* und Verhalten). Maus/Fokus halten voruebergehend an, reduzierte Bewegung = stehend.",
          "Duplikate der Spur inert (vorher nur aria-hidden — als Links fokussierbar). Kein aria-label mehr an der Wand (div ohne Rolle) und an den Pillen: der Name kommt aus alt bzw. dem Text; externe Links (target=_blank) tragen den Hinweis „öffnet in neuem Fenster“ als .u-sr-only.",
          "Laufband-Wurzel als Block statt Flex: der Knopf steht in eigener Zeile ueber der Spur; die Spur behaelt die Breite ihres Inhalts (max-content). Ungebunden haelt weiter die Maus an (:hover), gebunden steuert das Behavior (.is-paused/.is-stopped)."
        ]
      },
      {
        "version": "2.0.0",
        "changes": [
          "Layout-Achse: grid (auto-fit), marquee (Ticker), cluster (organisch)",
          "Size-Achse: sm (120px), md (160px), lg (220px)",
          "Darstellung-Achse: original (Markenfarben), mono (grayscale + hover-reveal)",
          "Animation-Achse: none, fadein (staggered Intersection Observer)",
          "Marquee: Endlose Laufschrift, pause-on-hover, prefers-reduced-motion",
          "35 Token-gesteuerte Custom Properties",
          "Hover-Effekte: Shadow + Border-Color Transition"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiale Implementierung: Auto-fit Grid mit Pill-Items"
        ]
      }
    ],
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_logo-wall.scss"
      ],
      "story": "stories/molecules/logo-wall.stories.js",
      "arena": null,
      "drupal": [
        "block/block--block-content--neo-logo-wall.html.twig",
        "block/block--inline-block--neo-logo-wall.html.twig"
      ],
      "docs": "docs/logo-wall-docs.html"
    },
    "source": {
      "drupal": "neo_fe: block--block-content--neo-logo-wall.html.twig (inline_block per include): Wand ohne aria-label, im Laufband Knopf .nc-logo-wall__pause und Spur; js/neo-theme.js Drupal.behaviors.neoLogoWall baut die Pillen aus script[data-logo-wall-data] (Kopien aria-hidden, externe Links mit .u-sr-only-Hinweis) und bindet im Laufband mit NeoBehaviors.anbinden(wand, ['marquee']); neo_fe_preprocess_block: _neo_fe_behaviors_anhaengen($variables, ['marquee']) fuer neo_logo_wall.",
      "behavior": "packages/neo-behaviors/marquee.js (Behavior des Recipes marquee; nurAusdruecklich)"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-logo-wall"
    },
    "slots": [
      {
        "name": "pill",
        "element": ".nc-logo-pill",
        "optional": false,
        "description": "Einzelnes Logo-Item. Flex-Container mit Border, Radius, Padding."
      },
      {
        "name": "track",
        "element": ".nc-logo-wall__track",
        "optional": true,
        "description": "Marquee-Track. Flex-Container mit verdoppeltem Inhalt fuer Endlosschleife."
      },
      {
        "name": "pause",
        "element": ".nc-logo-wall__pause",
        "optional": true,
        "description": "Pause-Knopf des Laufbands vor der Spur (WCAG 2.2.2): Symbol .nc-logo-wall__pause-icon (Pfade -pause/-play, Wahl per data-playing) und Beschriftung .nc-logo-wall__pause-label „Laufband anhalten“/„Laufband fortsetzen“; Tokens und Verhalten aus marquee."
      }
    ],
    "convenience": [
      {
        "name": "img",
        "element": ".nc-logo-pill__img",
        "slot": "pill",
        "description": "Logo-Bild. object-fit:contain, max-height via Token. Filter/Opacity fuer Mono-Modus."
      },
      {
        "name": "pause-icon",
        "element": ".nc-logo-wall__pause-icon",
        "slot": "pause",
        "description": "Symbol des Pause-Knopfs (aria-hidden): Pfade .nc-logo-wall__pause-pause und .nc-logo-wall__pause-play, Wahl per data-playing."
      },
      {
        "name": "pause-label",
        "element": ".nc-logo-wall__pause-label",
        "slot": "pause",
        "description": "Sichtbare Beschriftung des Pause-Knopfs (setzt das Behavior marquee)."
      }
    ],
    "domNotes": [
      "Root: display:grid (default), display:flex (marquee/cluster). Gap via Token.",
      "Pill: Flex-Container, align-items:center, justify-content:center. Border + Radius + Shadow.",
      "Pill-Img: object-fit:contain. Max-height begrenzt Logo-Groesse.",
      "Monochrome: CSS filter:grayscale(100%) auf Img. Hover entfernt Filter.",
      "Fade-In: Intersection Observer setzt .is-visible + transition-delay pro Index.",
      "Cluster: flex-wrap:wrap, justify-content:center. Organisches Layout.",
      "prefers-reduced-motion: Marquee stoppt. Fade-In ohne Animation.",
      "Marquee: Wurzel als Block; Knopf .nc-logo-wall__pause, dann die Spur (.nc-logo-wall__track, max-content) mit dupliziertem Inhalt, @keyframes translateX(-50%). Kopien aria-hidden und inert (neo-behaviors marquee); Ruhe per .is-paused/.is-stopped (ungebunden :hover).",
      "Name: img alt bzw. Text der Pille — kein aria-label an Pille oder Wand (div ohne Rolle). Externe Links (target=_blank) mit .u-sr-only „öffnet in neuem Fenster“."
    ]
  },
  "axes": {
    "layout": {
      "label": "Layout",
      "description": "Anordnung — grid (responsives Raster), marquee (Endlos-Ticker), cluster (organisch)",
      "values": {
        "grid": {
          "modifier": null,
          "tokenGroups": [
            "layout",
            "item"
          ],
          "renderHint": "logo-wall-grid"
        },
        "marquee": {
          "modifier": "nc-logo-wall--marquee",
