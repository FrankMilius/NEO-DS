{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "drawer",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "overlay",
      "interactive",
      "dialog",
      "bottom-sheet",
      "side-panel"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/drawer-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "Elevation: elevation-modal (L3, gleiche Ebene wie Dialog/Modal)",
          "Spring Animation (cubic-bezier(0.175, 0.885, 0.32, 1.275))",
          "Handle-Finesse: 32×4px, nur bei bottom/top sichtbar",
          "Light Dismiss: Klick auf Backdrop schliesst Drawer (JS)",
          "Sticky Header/Footer bei langen Listen",
          "Header/Footer Scroll-Border bei gescrolltem Content",
          "Close-Button auf allen Richtungen sichtbar",
          "Token-Migration: Component Tokens in :root statt .nc-drawer",
          "Mobile Prioritaet: bottom als bevorzugte Richtung fuer Touch",
          "Close-Button Tokens (size, radius, bg, bg-hover, icon-size, offset)",
          "High Contrast Mode",
          "Side-Width als Token"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiales Recipe: 4 Richtungen, Handle, Header/Content/Footer, natives <dialog>"
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_drawer.scss"
      ],
      "story": "stories/organisms/drawer.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/DrawerArena.vue",
      "drupal": [],
      "docs": "docs/drawer-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-drawer"
    },
    "slots": [
      {
        "name": "handle",
        "element": ".nc-drawer__handle",
        "optional": true
      },
      {
        "name": "header",
        "element": ".nc-drawer__header",
        "optional": true
      },
      {
        "name": "title",
        "element": ".nc-drawer__title",
        "optional": true
      },
      {
        "name": "description",
        "element": ".nc-drawer__description",
        "optional": true
      },
      {
        "name": "content",
        "element": ".nc-drawer__content",
        "optional": false
      },
      {
        "name": "footer",
        "element": ".nc-drawer__footer",
        "optional": true
      },
      {
        "name": "close",
        "element": ".nc-drawer__close",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Natives <dialog> mit showModal(). Slide-in von 4 Richtungen mit Spring-Animation.",
      "Modifiers: --top, --right, --left (default: bottom).",
      "Handle: 32×4px abgerundeter Balken, aria-hidden='true'. Nur bei bottom/top sichtbar. Signalisiert Swipe-to-Dismiss.",
      "Content: scrollbar. Header und Footer bleiben sticky bei langen Listen.",
      "Header Scroll-Border: JS setzt .is-scrolled Klasse bei gescrolltem Content — Header bekommt subtile Trennlinie.",
      "Footer Scroll-Border: Gleiche Logik — Footer bekommt obere Trennlinie bei gescrolltem Content.",
      "Light Dismiss: Klick auf ::backdrop schliesst Drawer. JS: dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close() }).",
      "Close-Button: Sichtbar auf allen Richtungen (v2.0: nicht mehr nur bei left/right). Absolut positioniert oben-rechts.",
      "Mobile Prioritaet: Bottom-Sheet (direction=bottom) ist die bevorzugte Overlay-Variante fuer Touch-Geraete (Daumenzone).",
      "Elevation: elevation-modal (L3) — gleiche Schattenstufe wie Modal. Ueberlagert gesamte Anwendungsebene.",
      "Spring Animation: cubic-bezier(0.175, 0.885, 0.32, 1.275) fuer physisch-reaktionsschnelles Slide-in.",
      "Body Scroll Lock: body:has(.nc-drawer[open]) { overflow: hidden }.",
      "Side-Width: 380px (mobile) → 440px (tablet) → 500px (desktop) — responsive Breakpoints."
    ]
  },
  "axes": {
    "direction": {
      "label": "Direction",
      "description": "Slide-Richtung — bottom (Standard, Bottom-Sheet), top, left, right (Side-Panel)",
      "values": {
        "bottom": {
          "modifier": null,
          "tokenGroups": [
            "handle"
          ]
        },
        "top": {
          "modifier": "nc-drawer--top",
          "tokenGroups": [
            "handle"
          ]
        },
        "left": {
          "modifier": "nc-drawer--left",
          "tokenGroups": []
        },
        "right": {
          "modifier": "nc-drawer--right",
          "tokenGroups": []
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "open",
      "scrolled"
    ],
    "precedence": [
      "scrolled",
      "open",
      "default"
    ],
    "rules": [
      {
        "state": "open",
        "condition": "[open] Attribut via showModal()"
      },
      {
        "state": "scrolled",
        "condition": ".is-scrolled Klasse. Content wurde gescrollt — Header/Footer Scroll-Border sichtbar."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard",
        "focusTrap"
      ],
      "note": "Natives <dialog>: role=dialog, aria-modal=true, Fokus-Trap, ESC-Close. aria-labelledby → Title, aria-describedby → Description. Light Dismiss: Klick auf Backdrop schliesst Drawer."
    },
    "overrides": [
      {
        "when": {
          "direction": [
            "bottom",
            "top"
          ]
        },
        "suggest": [
          "swipe-to-dismiss"
        ],
        "note": "Bottom/Top Drawers: Handle signalisiert Swipe-to-Dismiss. JS: Touch-Geste erkennen und Drawer schliessen."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "aria-labelledby"
        ],
        "notes": [
          "Drawer braucht aria-labelledby das auf die Title-ID verweist."
        ]
      },
      {
        "when": {},
        "require": [
          "esc-close"
        ],
        "notes": [
          "ESC schliesst Drawer (nativ bei <dialog>)."
        ]
      },
      {
        "when": {},
        "require": [
          "light-dismiss"
        ],
        "notes": [
          "Klick auf Backdrop muss Drawer schliessen (JS-seitig)."
        ]
      },
      {
        "when": {},
        "require": [
          "focus-trap"
        ],
        "notes": [
          "Fokus bleibt innerhalb des Drawers (nativ bei showModal())."
        ]
      }
    ],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-drawer"
    ],
    "baseTokenGroups": [
      "container",
      "header",
      "content",
      "close-button",
      "animation"
    ],
    "tokenGroups": {
      "container": {
        "label": "Container",
        "tokens": [
          "nc-drawer-max-width",
          "nc-drawer-max-height",
          "nc-drawer-width",
          "nc-drawer-side-width",
          "nc-drawer-padding",
          "nc-drawer-radius",
          "nc-drawer-bg",
          "nc-drawer-shadow",
          "nc-drawer-overlay-bg"
        ]
      },
      "header": {
        "label": "Header",
        "tokens": [
          "nc-drawer-title-font-size",
          "nc-drawer-title-font-weight",
          "nc-drawer-title-color",
          "nc-drawer-desc-font-size",
          "nc-drawer-desc-color",
          "nc-drawer-header-gap",
          "nc-drawer-header-border-color"
        ]
      },
      "content": {
        "label": "Content & Footer",
        "tokens": [
          "nc-drawer-section-gap",
          "nc-drawer-footer-gap",
          "nc-drawer-footer-border-color"
        ]
      },
      "handle": {
        "label": "Handle (Bottom-Sheet)",
        "tokens": [
          "nc-drawer-handle-width",
          "nc-drawer-handle-height",
          "nc-drawer-handle-radius",
          "nc-drawer-handle-bg"
        ]
      },
      "close-button": {
        "label": "Close Button",
        "tokens": [
          "nc-drawer-close-size",
          "nc-drawer-close-radius",
          "nc-drawer-close-bg",
          "nc-drawer-close-bg-hover",
          "nc-drawer-close-icon-size",
          "nc-drawer-close-offset"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-drawer-duration",
          "nc-drawer-ease"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.direction.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "bottom-sheet",
      "label": "Bottom Sheet (Default)",
      "description": "Standard Bottom-Sheet mit Handle, Header, Content und Footer",
      "matrix": {
        "axes": {
          "direction": [
            "bottom"
          ]
        },
        "states": [
          "open"
        ]
      },
      "layout": "row",
      "render": {
        "label": "bottom",
        "compositionType": "drawer-bottom"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Bottom-Sheet: Handle signalisiert Swipe-to-Dismiss. Daumenzone optimal erreichbar."
      }
    },
    {
      "id": "direction-comparison",
      "label": "All Directions",
      "description": "Alle 4 Richtungen: bottom, top, left, right",
      "matrix": {
        "axes": {
          "direction": "*"
        },
        "states": [
          "open"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "direction"
      },
      "render": {
        "label": "{direction}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Fokus-Trap, ESC-Close, aria-labelledby. Handle nur bei bottom/top."
      }
    },
    {
      "id": "side-panel-right",
      "label": "Side Panel (Right)",
      "description": "Seitliches Panel von rechts — Navigation, Settings, Details",
      "matrix": {
        "axes": {
          "direction": [
            "right"
          ]
        },
        "states": [
          "open"
        ]
      },
      "focusTokenGroups": [
        "container",
        "close-button"
      ],
      "layout": "row",
      "render": {
        "label": "right",
        "compositionType": "drawer-side-panel"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Kein Handle. Close-Button oben-rechts. Side-Width konfigurierbar."
      }
    },
    {
      "id": "scrolled-content",
      "label": "Scrolled Content",
      "description": "Lange Liste — sticky Header/Footer mit Scroll-Border",
      "matrix": {
        "axes": {
          "direction": [
            "right"
          ]
        },
        "states": [
          "scrolled"
        ]
      },
      "focusTokenGroups": [
        "header",
        "content"
      ],
      "layout": "row",
      "render": {
        "label": "scrolled",
        "compositionType": "drawer-scrolled"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Header und Footer sticky. Scroll-Border erscheint bei gescrolltem Content."
      }
    },
    {
      "id": "with-form",
      "label": "With Form Content",
      "description": "Drawer mit Formularinhalt — Footer mit Action-Buttons",
      "matrix": {
        "axes": {
          "direction": [
            "right"
          ]
        },
        "states": [
          "open"
        ]
      },
      "layout": "row",
      "render": {
        "label": "form",
        "compositionType": "drawer-form"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Formular im Drawer: Footer pinned am unteren Rand mit Save/Cancel."
      }
    },
    {
      "id": "light-dismiss",
      "label": "Light Dismiss",
      "description": "Klick auf Backdrop schliesst Drawer — Overlay mit Cursor-Pointer",
      "matrix": {
        "axes": {
          "direction": [
            "bottom"
          ]
        },
        "states": [
          "open"
        ]
      },
      "focusTokenGroups": [
        "animation"
      ],
      "layout": "row",
      "render": {
        "label": "light-dismiss",
        "compositionType": "drawer-light-dismiss"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Light Dismiss: Klick ausserhalb des Panels schliesst Drawer. Backdrop hat cursor:pointer."
      }
    }
  ]
}
