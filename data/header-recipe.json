    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "06.10.2026 (Plan v3, Phase 4, duenne Recipes): Specimen default zeigt die Zustaende default/hidden; neu ohne-conversion",
          "Arena-Rahmen ra-bildschirm statt Inline-Stilen am DS-Element (position: fixed bezieht sich auf die Zelle)"
        ]
      }
    ],
    "status": "stable",
    "tags": [
      "navigation",
      "layout",
      "interactive"
