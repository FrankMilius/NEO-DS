    "tags": [
      "display",
      "content",
      "interactive"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/solutions-docs"
    },
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_solutions.scss"
      ],
      "story": "stories/organisms/solutions.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/solutions-docs.html"
    },
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Vorlage mit der Mobil-Tableiste als erstem Kind des Wrappers (Slot mobile-tabs) — vorher war .solutions das erste Kind und auf dem Desktop display:none, die Arena blieb leer",
          "Specimen default zeigt default und open (eine andere Loesung offen, immer genau eine); Rahmen ra-desktop",
          "Specimens composes: label (Labels-Container) und button",
          "pipeline.arena zeigt auf die RecipeArena"
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".solutions"
    },
    "slots": [
      {
        "name": "accordion",
        "element": ".accordion--solutions",
        "optional": false
      },
      {
        "name": "side-panel",
        "element": ".solutions > :nth-child(1)",
        "optional": true
      },
      {
        "name": "content-panel",
        "element": ".solutions > :last-child",
        "optional": true
      },
      {
        "name": "wrapper",
        "element": ".solutions-wrapper",
        "optional": true
      },
      {
        "name": "mobile-tabs",
        "element": ".solutions-wrapper > div:first-child",
        "optional": false
      }
    ],
    "convenience": [],
    "domNotes": [
      "Desktop: 3-Spalten Grid (6+1+5) mit grid-areas accordion/side/content.",
      "Mobile: Horizontal-Scroll Accordion mit scroll-snap, Tabs oben.",
      "Accordion-Items: Details/Summary, progress-bar Animation (12s linear).",
      "Side/Content Panels: nur Desktop sichtbar, grid-area overlay.",
      "Wrapper: erstes Kind ist die Mobil-Tableiste (div > ul > li[.selected] > span), auf dem Desktop ausgeblendet; danach .solutions. Fehlt die Tableiste, ist .solutions das erste Kind und auf dem Desktop unsichtbar."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Einzige Variante",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "solutions-default"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "open"
    ],
    "precedence": [
      "open",
      "default"
    ],
    "rules": [
      {
        "state": "open",
        "condition": "Ein anderes Accordion-Item [open] — immer genau eines offen, sein Fortschritt (.accordion-progress.active) laeuft"
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Accordion: details/summary nativ. Mobile Tabs: scroll-snap, selected-Indicator. Progress-Animation: reduced-motion."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "solutions"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": []
      }
    }
