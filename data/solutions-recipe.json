    },
    "resolution": {
      "classList": [
        "styling.baseClasses"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "default",
      "label": "Solutions Section",
      "description": "Akkordeon mit Seiten- und Inhaltspanel (Desktop) — Startzustand und eine andere Loesung geoeffnet",
