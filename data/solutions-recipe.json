        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default",
          "open"
        ]
      },
      "layout": "row",
      "render": {
        "label": "solutions"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Accordion nativ. Progress: reduced-motion."
      },
      "composes": [
        "button",
        "label"
      ]
    }
