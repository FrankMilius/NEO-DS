  "states": {
    "supported": [
      "default",
      "hover",
      "focus"
    ],
    "precedence": [
      "focus",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "focus"
        ],
        "note": "Hover: bg-hover auf Ergebnis-Item."
      },
      {
        "state": "focus",
        "unless": [],
        "note": "Focus: focus-ring auf Input oder aktivem Item. aria-selected='true' auf navigiertem Item."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Root: role='combobox', aria-haspopup='listbox', aria-expanded. Input: aria-autocomplete='list', aria-controls. Results: role='listbox'. Items: role='option', aria-selected. Clear-Trigger: aria-label='Suche zuruecksetzen'. Keyboard: ArrowDown/Up navigiert, Enter waehlt, Escape schliesst (3-stufig: Ghost → Results → Blur)."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "resultsState": [
              "empty"
            ]
          }
        },
        "suggest": [
          "aria-live"
        ],
        "note": "Empty-State: 'Keine Ergebnisse' via aria-live='polite' ankuendigen."
      },
      {
        "when": {
          "axes": {
            "resultsState": [
              "loading"
            ]
          }
        },
        "suggest": [
          "aria-busy"
        ],
        "note": "Loading-State: aria-busy='true' auf dem Results-Container."
      },
      {
        "when": {
          "axes": {
            "scope": [
              "scoped"
            ]
          }
        },
        "suggest": [
          "aria-label"
        ],
        "note": "Scope-Trigger: aria-label beschreibt aktuellen Suchbereich."
      },
      {
        "when": {
          "axes": {
            "width": [
              "viewport"
            ]
          }
        },
        "require": [
          "focus-trap",
          "aria-modal"
        ],
        "note": "Mobile Full-Screen: Focus-Trap aktiv, aria-modal='true', Escape schliesst."
      },
      {
        "when": {
          "slots": [
            "clear-trigger"
          ]
        },
        "require": [
          "aria-label"
        ],
        "note": "Clear-Trigger: aria-label='Suche zuruecksetzen'. Nur sichtbar bei value.length > 0."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-combobox",
          "aria-haspopup"
        ],
        "notes": [
          "Root braucht role='combobox' und aria-haspopup='listbox'."
        ]
      },
      {
        "when": {},
        "require": [
          "aria-autocomplete",
          "aria-controls"
        ],
        "notes": [
          "Input: aria-autocomplete='list' und aria-controls zeigt auf Results-ID."
        ]
      },
      {
        "when": {},
        "require": [
          "role-listbox",
          "role-option"
        ],
        "notes": [
          "Results: role='listbox'. Items: role='option'."
        ]
      },
      {
        "when": {
          "slots": [
            "clear-trigger"
          ]
        },
        "require": [
          "aria-label",
          "conditional-visibility"
        ],
        "notes": [
          "Clear-Trigger nur anzeigen wenn input.value.length > 0. Muss aria-label haben."
        ]
      },
      {
        "when": {
          "axes": {
            "width": [
              "viewport"
            ]
          }
        },
        "require": [
          "focus-trap",
          "escape-close"
        ],
        "notes": [
          "Mobile Full-Screen braucht Focus-Trap und Escape zum Schliessen."
        ]
      },
      {
        "when": {
          "axes": {
            "scope": [
              "scoped"
            ]
          }
        },
        "require": [
          "aria-label-scope"
        ],
        "notes": [
          "Scope-Trigger braucht aria-label mit aktuellem Bereichsnamen."
        ]
      }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 40,
        "note": "Placeholder beschreibt den Suchkontext."
      },
      "emptyMessage": {
        "maxChars": 80,
        "note": "Leerzustands-Text."
      },
      "ghostText": {
        "maxChars": 60,
        "note": "Type-Ahead Vorschlag, muss mit Eingabe beginnen."
      },
      "historyLabel": {
        "maxChars": 30,
        "note": "Label fuer History-Sektion (z.B. 'Letzte Suchen')."
      },
      "popularLabel": {
        "maxChars": 30,
        "note": "Label fuer Popular-Sektion (z.B. 'Beliebte Suchbegriffe')."
      }
    }
  },
