{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "search",
    "version": "2.0.0",
    "status": "stable",
    "tags": ["interactive", "form", "navigation", "combobox"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/search-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "Scoped Search: scope-trigger Button (links) + scope-menu Dropdown fuer Bereichsfilter",
          "Command Palette: Modales Overlay (Cmd+K), zentriert, nc-dialog-shadow",
          "Type-Ahead / Ghost-Writing: Vorschlagstext in Grau waehrend der Eingabe",
          "Appearance: Minimal (Header-Search, transparent), XL (Hero-Search, 64px)",
          "Mode-Axis: instant (sofortige Suche) vs manual (debounced/Enter)",
          "Scope-Axis: global (alles) vs scoped (Bereich eingeschraenkt)",
          "Token-Abhaengigkeiten: nc-input-radius → nc-search, nc-dropdown-shadow → nc-search-results-shadow"
        ]
      },
      { "version": "1.0.0", "changes": ["Initiale Implementierung: Combobox mit Ergebnisliste, Gruppen, Highlight, Shortcut-Hint"] }
    ]
  },

  "anatomy": {
    "root": { "element": ".nc-search" },
    "slots": [
      { "name": "input-wrapper", "element": ".nc-search__input-wrapper", "optional": false },
      { "name": "scope-trigger", "element": ".nc-search__scope-trigger", "optional": true },
      { "name": "icon", "element": ".nc-search__icon", "optional": false },
      { "name": "input", "element": ".nc-search__input", "optional": false },
      { "name": "ghost", "element": ".nc-search__ghost", "optional": true },
      { "name": "shortcut", "element": ".nc-search__shortcut", "optional": true },
      { "name": "scope-menu", "element": ".nc-search__scope-menu", "optional": true },
      { "name": "results", "element": ".nc-search__results", "optional": false },
      { "name": "group", "element": ".nc-search__group", "optional": true },
      { "name": "group-label", "element": ".nc-search__group-label", "optional": true },
      { "name": "item", "element": ".nc-search__item", "optional": false },
      { "name": "item-icon", "element": ".nc-search__item-icon", "optional": true },
      { "name": "item-label", "element": ".nc-search__item-label", "optional": false },
      { "name": "highlight", "element": ".nc-search__highlight", "optional": true },
      { "name": "empty", "element": ".nc-search__empty", "optional": true },
      { "name": "loading", "element": ".nc-search__loading", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Root: role='combobox', aria-haspopup='listbox', aria-expanded='true|false'.",
      "Input-Wrapper: relative Container mit Scope-Trigger (optional), Such-Icon (links), Input (Mitte), Ghost (optional), Shortcut-Hint (rechts).",
      "Scope-Trigger: Button links im Input-Wrapper, zeigt aktuellen Suchbereich + Chevron. Oeffnet scope-menu.",
      "Ghost: Absolute positionierter, transparenter Vorschlagstext (Type-Ahead). pointer-events: none.",
      "Such-Icon: absolute positioniert, pointer-events:none, dekorativ (aria-hidden).",
      "Input: nutzt nc-input Tokens, extra padding-start fuer Icon. aria-autocomplete='list', aria-controls.",
      "Shortcut-Hint: optionales Kbd-Element (z.B. Cmd+K), absolute rechts, dekorativ.",
      "Scope-Menu: Absolute Dropdown unter dem Input-Wrapper mit Bereichsauswahl.",
      "Results: position:absolute, role='listbox'. Versteckt via [hidden]. Animation: fnd-dropdown-enter.",
      "Item: role='option', aria-selected='true|false'. Hover und aria-selected bekommen bg-hover.",
      "Highlight: <mark> Element mit Warning-30% Background fuer Treffer-Hervorhebung.",
      "Command Palette: position:fixed Overlay, zentriert, aria-modal='true', role='dialog'.",
      "Minimal: Transparenter Input ohne Border, ideal fuer Header-Integration.",
      "XL: 64px Hoehe, groessere Schrift, fuer Hero-Suchfelder."
    ]
  },

  "axes": {
    "width": {
      "label": "Width",
      "description": "Breite — default (320px), full (100%)",
      "values": {
        "default": { "modifier": null,             "tokenGroups": [],          "renderHint": "search-default" },
        "full":    { "modifier": "nc-search--full", "tokenGroups": [],          "renderHint": "search-full" }
      }
    },

    "appearance": {
      "label": "Appearance",
      "description": "Visuelle Variante — default (Standard mit Border), minimal (Header-Search, transparent), xl (Hero-Search, 64px)",
      "values": {
        "default": { "modifier": null,                "tokenGroups": ["input-area"],   "renderHint": "search-appearance-default" },
        "minimal": { "modifier": "nc-search--minimal", "tokenGroups": ["minimal"],     "renderHint": "search-appearance-minimal" },
        "xl":      { "modifier": "nc-search--xl",      "tokenGroups": ["xl"],          "renderHint": "search-appearance-xl" }
      }
    },

    "scope": {
      "label": "Scope",
      "description": "Suchbereich — global (alles durchsuchen), scoped (eingeschraenkt auf Bereich)",
      "values": {
        "global": { "modifier": null, "tokenGroups": [],                             "renderHint": "search-scope-global" },
        "scoped": { "modifier": null, "tokenGroups": ["scope"], "slotConfig": { "scope-trigger": true, "scope-menu": true }, "renderHint": "search-scope-scoped" }
      }
    },

    "content": {
      "label": "Content",
      "description": "Inhaltsvariante — plain (einfache Liste), with-icons (Items mit Icons), grouped (Gruppen mit Label), with-shortcut (Input mit Shortcut-Hint)",
      "values": {
        "plain":         { "modifier": null, "tokenGroups": [],       "renderHint": "search-plain" },
        "with-icons":    { "modifier": null, "tokenGroups": [],       "slotConfig": { "item-icon": true }, "renderHint": "search-with-icons" },
        "grouped":       { "modifier": null, "tokenGroups": [],       "slotConfig": { "group": true, "group-label": true }, "renderHint": "search-grouped" },
        "with-shortcut": { "modifier": null, "tokenGroups": [],       "slotConfig": { "shortcut": true }, "renderHint": "search-with-shortcut" }
      }
    },

    "mode": {
      "label": "Mode",
      "description": "Suchverhalten — instant (sofortige Suche bei Eingabe), manual (Suche bei Enter/Button)",
      "values": {
        "instant": { "modifier": null, "tokenGroups": [], "renderHint": "search-mode-instant" },
        "manual":  { "modifier": null, "tokenGroups": [], "renderHint": "search-mode-manual" }
      }
    },

    "resultsState": {
      "label": "Results State",
      "description": "Zustand der Ergebnisliste — results (Treffer), empty (keine Treffer), loading (wird geladen), closed (geschlossen)",
      "values": {
        "results": { "modifier": null, "tokenGroups": [], "renderHint": "search-results" },
        "empty":   { "modifier": null, "tokenGroups": [], "slotConfig": { "empty": true }, "renderHint": "search-empty" },
        "loading": { "modifier": null, "tokenGroups": [], "slotConfig": { "loading": true }, "renderHint": "search-loading" },
        "closed":  { "modifier": null, "tokenGroups": [], "renderHint": "search-closed" }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus"],
    "precedence": ["focus", "hover", "default"],
    "rules": [
      { "state": "hover", "unless": ["focus"],  "note": "Hover: bg-hover auf dem Ergebnis-Item." },
      { "state": "focus", "unless": [],          "note": "Focus: focus-ring auf dem Input oder dem aktiven Item. aria-selected='true' auf dem navigierten Item." }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Root: role='combobox', aria-haspopup='listbox', aria-expanded. Input: aria-autocomplete='list', aria-controls zeigt auf Results-ID. Results: role='listbox'. Items: role='option', aria-selected. Keyboard: ArrowDown/Up navigiert Items, Enter waehlt, Escape schliesst Results. Such-Icon: aria-hidden='true'."
    },
    "overrides": [
      {
        "when": { "axes": { "resultsState": ["empty"] } },
        "suggest": ["aria-live"],
        "note": "Empty-State: 'Keine Ergebnisse' via aria-live='polite' ankuendigen."
      },
      {
        "when": { "axes": { "resultsState": ["loading"] } },
        "suggest": ["aria-busy"],
        "note": "Loading-State: aria-busy='true' auf dem Results-Container waehrend der Suche."
      },
      {
        "when": { "axes": { "scope": ["scoped"] } },
        "suggest": ["aria-label"],
        "note": "Scope-Trigger: aria-label beschreibt aktuellen Suchbereich (z.B. 'Suche in: Dokumente'). Scope-Menu: role='listbox' mit aria-label='Suchbereich waehlen'."
      },
      {
        "when": { "axes": { "appearance": ["xl"] } },
        "suggest": ["aria-label"],
        "note": "XL: aria-label statt Placeholder fuer barrierefreie Beschreibung des Hero-Suchfelds."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["role-combobox", "aria-haspopup"], "notes": ["Root braucht role='combobox' und aria-haspopup='listbox'."] },
      { "when": {}, "require": ["aria-autocomplete", "aria-controls"], "notes": ["Input: aria-autocomplete='list' und aria-controls zeigt auf Results-ID."] },
      { "when": {}, "require": ["role-listbox", "role-option"], "notes": ["Results: role='listbox'. Items: role='option'."] },
      { "when": { "axes": { "scope": ["scoped"] } }, "require": ["aria-label-scope"], "notes": ["Scope-Trigger braucht aria-label mit aktuellem Bereichsnamen."] }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 40,
        "note": "Placeholder beschreibt den Suchkontext (z.B. 'Suche...', 'Seiten durchsuchen')."
      },
      "emptyMessage": {
        "maxChars": 80,
        "note": "Leerzustands-Text (z.B. 'Keine Ergebnisse fuer Ihre Suche')."
      },
      "ghostText": {
        "maxChars": 60,
        "note": "Type-Ahead Vorschlag, muss mit der aktuellen Eingabe beginnen."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-search"],
    "baseTokenGroups": ["input-area", "results-panel", "item", "highlight", "group", "shortcut"],

    "tokenGroups": {
      "input-area": {
        "label": "Input Area",
        "tokens": [
          "nc-search-width",
          "nc-search-max-width"
        ]
      },
      "results-panel": {
        "label": "Results Panel",
        "tokens": [
          "nc-search-results-bg",
          "nc-search-results-border",
          "nc-search-results-border-width",
          "nc-search-results-radius",
          "nc-search-results-shadow",
          "nc-search-results-max-height",
          "nc-search-results-padding",
          "nc-search-results-z-index",
          "nc-search-results-animation"
        ]
      },
      "item": {
        "label": "Item",
        "tokens": [
          "nc-search-item-height",
          "nc-search-item-padding",
          "nc-search-item-radius",
          "nc-search-item-color",
          "nc-search-item-bg-hover",
          "nc-search-item-icon-size",
          "nc-search-item-icon-color",
          "nc-search-item-gap",
          "nc-search-item-font-size"
        ]
      },
      "highlight": {
        "label": "Highlight",
        "tokens": [
          "nc-search-highlight-bg",
          "nc-search-highlight-color"
        ]
      },
      "group": {
        "label": "Group Label",
        "tokens": [
          "nc-search-group-label-color",
          "nc-search-group-label-size",
          "nc-search-group-label-weight",
          "nc-search-group-label-padding"
        ]
      },
      "shortcut": {
        "label": "Shortcut",
        "tokens": [
          "nc-search-shortcut-color",
          "nc-search-shortcut-size"
        ]
      },
      "scope": {
        "label": "Scope",
        "tokens": [
          "nc-search-scope-bg",
          "nc-search-scope-color",
          "nc-search-scope-border",
          "nc-search-scope-radius",
          "nc-search-scope-font-size",
          "nc-search-scope-padding",
          "nc-search-scope-gap"
        ]
      },
      "minimal": {
        "label": "Minimal (Header)",
        "tokens": [
          "nc-search-minimal-bg",
          "nc-search-minimal-border",
          "nc-search-minimal-border-focus"
        ]
      },
      "xl": {
        "label": "XL (Hero)",
        "tokens": [
          "nc-search-xl-height",
          "nc-search-xl-font-size",
          "nc-search-xl-icon-size",
          "nc-search-xl-radius",
          "nc-search-xl-shadow"
        ]
      },
      "command": {
        "label": "Command Palette",
        "tokens": [
          "nc-search-command-max-width",
          "nc-search-command-shadow",
          "nc-search-command-radius",
          "nc-search-command-overlay-bg"
        ]
      },
      "ghost": {
        "label": "Type-Ahead",
        "tokens": [
          "nc-search-ghost-color"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.width.values.*.modifier",
        "axes.appearance.values.*.modifier",
        "axes.scope.values.*.modifier",
        "axes.content.values.*.modifier",
        "axes.mode.values.*.modifier",
        "axes.resultsState.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "default",
      "label": "Default Search",
      "description": "Standard-Suchfeld mit einfacher Ergebnisliste",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["default"], "scope": ["global"], "content": ["with-icons"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-simple", "label": "default" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Item-Text 4.5:1 gegen Results-BG. Highlight-BG darf Text-Kontrast nicht brechen."
      }
    },
    {
      "id": "scoped-search",
      "label": "Scoped Search",
      "description": "Suchfeld mit Bereichsfilter (Scope-Trigger + Scope-Menu)",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["default"], "scope": ["scoped"], "content": ["with-icons"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-scoped", "label": "scoped" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Scope-Trigger: aria-label mit aktuellem Bereich. Scope-Menu: role='listbox'."
      }
    },
    {
      "id": "command-palette",
      "label": "Command Palette",
      "description": "Modales Overlay (Cmd+K) — zentriert mit Overlay-Hintergrund",
      "matrix": {
        "axes": { "width": ["full"], "appearance": ["default"], "scope": ["global"], "content": ["grouped"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "single",
      "render": { "compositionType": "search-command", "label": "command-palette" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "role='dialog', aria-modal='true'. Escape schliesst. Focus-Trap innerhalb des Dialogs."
      }
    },
    {
      "id": "appearance-minimal",
      "label": "Minimal (Header)",
      "description": "Transparenter Header-Search ohne sichtbaren Border",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["minimal"], "scope": ["global"], "content": ["plain"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-minimal", "label": "minimal" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Trotz fehlender Border: Focus-Indikator muss sichtbar bleiben."
      }
    },
    {
      "id": "appearance-xl",
      "label": "XL (Hero)",
      "description": "Hero-Suchfeld mit 64px Hoehe und groesserer Schrift",
      "matrix": {
        "axes": { "width": ["full"], "appearance": ["xl"], "scope": ["global"], "content": ["with-shortcut"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-xl", "label": "xl" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "aria-label statt Placeholder fuer barrierefreie Beschreibung."
      }
    },
    {
      "id": "type-ahead",
      "label": "Type-Ahead",
      "description": "Vorschlagstext (Ghost) waehrend der Eingabe",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["default"], "scope": ["global"], "content": ["with-icons"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-ghost", "label": "type-ahead" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Ghost-Text rein visuell (pointer-events: none). Tab oder Pfeil-rechts zum Uebernehmen."
      }
    },
    {
      "id": "grouped-highlight",
      "label": "Grouped with Highlight",
      "description": "Gruppierte Ergebnisse mit hervorgehobenen Treffern",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["default"], "scope": ["global"], "content": ["grouped"], "mode": ["instant"], "resultsState": ["results"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "search-grouped-highlight", "label": "grouped" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Highlight-BG (warning 30%) darf Text-Kontrast nicht unter 4.5:1 druecken."
      }
    },
    {
      "id": "results-states",
      "label": "Results States",
      "description": "Results, Empty, Loading, Closed — alle Zustaende der Ergebnisliste",
      "matrix": {
        "axes": { "width": ["default"], "appearance": ["default"], "scope": ["global"], "content": ["plain"], "mode": ["instant"], "resultsState": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "resultsState" },
      "render": { "label": "{resultsState}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Empty: aria-live='polite'. Loading: aria-busy='true'. Closed: aria-expanded='false'."
      }
    }
  ]
}
