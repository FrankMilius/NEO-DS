{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "search",
    "version": "3.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "form",
      "navigation",
      "combobox"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/search-docs"
    },
    "changelog": [
      {
        "version": "3.0.0",
        "changes": [
          "Clear-Trigger Slot: Button am rechten Input-Ende, erscheint bei value.length > 0, setzt Input zurueck",
          "Width-Achse erweitert: viewport (Full-Screen / Mobile Takeover)",
          "Animation-Achse: slide-down (Default), fade, expand — konfigurierbar fuer Results-Panel",
          "Usage-Patterns: type-to-select, history-first, recent-popular dokumentiert",
          "Escape-Verhalten: 1× loescht Ghost → 2× schliesst Results → 3× blur",
          "Mobile Full-Screen Takeover (< 768px): Modale Suche mit Zurueck-Icon + Input + Clear",
          "Navigation-Integration: top-offset Token fuer Results-Panel unter Header, Backdrop-Layer",
          "Neue Tokens: nc-search-clear-*, nc-search-animation, nc-search-mobile-*, nc-search-backdrop-*",
          "Input-Tokens: nc-search-input-radius, nc-search-input-height (von Input-Komponente erbbar)"
        ]
      },
      {
        "version": "2.0.0",
        "changes": [
          "Scoped Search, Command Palette, Type-Ahead, Appearance (Minimal/XL), Mode (instant/manual), Scope (global/scoped)"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiale Implementierung"
        ]
      }
    ],
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_search.scss"
      ],
      "story": "stories/organisms/search.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/search-docs.html"
    }
  },
  "anatomy": {
    "root": {
