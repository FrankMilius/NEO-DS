{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "notification",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "feedback",
      "news-alert",
      "floating-card",
      "in-app"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/notification-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "News-Alert Spezialisierung",
          "Media-Slot (Thumbnails/Avatare, 48×48)",
          "Read-Receipt Logik (Unread-Dot + BG-Akzent)",
          "Floating Card Surface (surface-elevated + elevation-overlay L2)",
          "Header/Footer Slots (strukturierte Anatomie)",
          "Priority-Axis (low/high mit Akzent-Border)",
          "Type-Axis (feature/system/promo mit Akzentfarbe)",
          "Interaction-Axis (dismissible/permanent)",
          "Dismiss-Animation (Hoehen-Collapse)",
          "BEM-Refactoring (.nc-notification)",
          "High Contrast Mode",
          "Reduced Motion Support"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Initiales Recipe: Sticky-Top Notification Banner mit Show/Hide und Close-Button"
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_notification.scss"
      ],
      "story": "stories/organisms/notification.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/NotificationArena.vue",
      "drupal": [],
      "docs": "docs/notification-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-notification"
    },
    "slots": [
      {
        "name": "media",
        "element": ".nc-notification__media",
        "optional": true
      },
      {
        "name": "content",
        "element": ".nc-notification__content",
        "optional": false
      },
      {
        "name": "header",
        "element": ".nc-notification__header",
        "optional": false
      },
      {
        "name": "title",
        "element": ".nc-notification__title",
        "optional": false
      },
      {
        "name": "meta",
        "element": ".nc-notification__meta",
        "optional": true
      },
      {
        "name": "body",
        "element": ".nc-notification__body",
        "optional": true
      },
      {
        "name": "footer",
        "element": ".nc-notification__footer",
        "optional": true
      },
      {
        "name": "action",
        "element": ".nc-notification__action",
        "optional": true
      },
      {
        "name": "close",
        "element": ".nc-notification__close",
        "optional": true
      },
      {
        "name": "unread",
        "element": ".nc-notification__unread",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Floating-Card Surface: surface-elevated BG + elevation-overlay Schatten (L2). Gleiche Ebene wie Popover.",
      "role='article' auf jedem Notification-Item. aria-label mit Titel + Zeitstempel.",
      "Media-Slot: 48×48 Thumbnail oder Avatar. Optional. Flexibles img/svg/div.",
      "Header: Titel (semibold) + Meta-Zeile (Zeitstempel, Kategorie). Auf gleicher Zeile mit space-between.",
      "Footer: Action-Links (CTA). Optional. Horizontale Anordnung mit gap.",
      "Unread-Dot: 8px Kreis in Akzentfarbe. aria-hidden='true' — Status per aria-label am Root.",
      "Unread-BG: Subtiler Akzent-Hintergrund (6% Mix der interaktiven Farbe) bei --unread Modifier.",
      "Priority High: 4px Akzent-Border links. Farbe per Type-Variante steuerbar.",
      "Type-Varianten setzen Akzentfarbe fuer Unread-Dot UND Priority-Border: feature (blau), system (gelb), promo (gruen).",
      "Interaction: 'dismissible' zeigt Close-Button, 'permanent' versteckt ihn.",
      "Close-Button: Absolut positioniert oben-rechts. aria-label='Benachrichtigung schliessen'.",
      "Dismiss-Animation: max-height + padding + opacity → 0. JS fuegt .is-dismissing hinzu.",
      "Shell-Integration: In Notification-Panel (Popover/Drawer) als Liste von .nc-notification Items.",
      "Read-Receipt JS: Unread-Status per localStorage oder API. JS entfernt --unread Modifier nach Klick/Lesen.",
      "Keyboard: Tab durchlaeuft Header → Actions → Close. Fokus-Ring auf interaktiven Elementen."
    ]
  },
  "axes": {
    "priority": {
      "label": "Priority",
      "description": "Prioritaet — low (Standard, kein Akzent) oder high (Akzent-Border links)",
      "values": {
        "low": {
          "modifier": null,
          "tokenGroups": []
        },
        "high": {
          "modifier": "nc-notification--priority-high",
          "tokenGroups": [
            "priority"
          ]
        }
      }
    },
    "type": {
      "label": "Type",
      "description": "Inhaltskategorie — feature (blau), system (gelb), promo (gruen)",
      "values": {
        "feature": {
          "modifier": "nc-notification--feature",
          "tokenGroups": [
            "type-colors"
          ]
        },
        "system": {
          "modifier": "nc-notification--system",
          "tokenGroups": [
            "type-colors"
          ]
        },
        "promo": {
          "modifier": "nc-notification--promo",
          "tokenGroups": [
            "type-colors"
          ]
        }
      }
    },
    "interaction": {
      "label": "Interaction",
      "description": "Interaktionsmodell — dismissible (Close-Button) oder permanent (kein Close)",
      "values": {
        "dismissible": {
          "modifier": null,
          "tokenGroups": [
            "close-button"
          ]
        },
        "permanent": {
          "modifier": "nc-notification--permanent",
          "tokenGroups": []
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "unread",
      "dismissing"
    ],
    "precedence": [
      "dismissing",
      "unread",
      "default"
    ],
    "rules": [
      {
        "state": "unread",
        "condition": "--unread Modifier aktiv. Subtiler BG-Akzent + Unread-Dot sichtbar."
      },
      {
        "state": "dismissing",
        "condition": ".is-dismissing Klasse. Hoehen-Collapse Animation."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "role='article' auf jedem Item. aria-label mit Titel. Unread-Dot ist aria-hidden — Status wird per aria-label am Root kommuniziert. Close: aria-label. Actions: fokussierbar mit focus-ring."
    },
    "overrides": [
      {
        "when": {
          "states": [
            "unread"
          ]
        },
        "suggest": [
          "aria-label-unread"
        ],
        "note": "Ungelesene Items: aria-label enthaelt 'Ungelesen:' Praefix oder aria-live Region fuer Zaehler-Update."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-article"
        ],
        "notes": [
          "Jedes Notification-Item braucht role='article' mit aria-label."
        ]
      },
      {
        "when": {
          "interaction": "dismissible"
        },
        "require": [
          "close-aria-label"
        ],
        "notes": [
          "Close-Button braucht aria-label='Benachrichtigung schliessen'."
        ]
      },
      {
        "when": {},
        "require": [
          "keyboard-navigation"
        ],
        "notes": [
          "Tab-Reihenfolge: Header → Actions → Close. Focus-Ring auf allen interaktiven Elementen."
        ]
      }
    ],
    "copy": {
      "title": {
        "maxChars": 60,
        "note": "Titel soll praegnant sein. Fuer Kontext nutze Body-Text."
      },
      "body": {
        "maxChars": 200,
        "note": "Body-Text fuer Details. Fuer laengere Inhalte Link zu Detail-Seite."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-notification"
    ],
    "baseTokenGroups": [
      "container",
      "header",
      "body"
    ],
    "tokenGroups": {
      "container": {
        "label": "Container",
        "tokens": [
          "nc-notification-padding",
          "nc-notification-radius",
          "nc-notification-shadow",
          "nc-notification-bg",
          "nc-notification-border-width",
          "nc-notification-border-color",
          "nc-notification-max-width",
          "nc-notification-gap"
        ]
      },
      "header": {
        "label": "Header",
        "tokens": [
          "nc-notification-header-gap",
          "nc-notification-title-size",
          "nc-notification-title-weight",
          "nc-notification-title-color",
          "nc-notification-meta-size",
          "nc-notification-meta-color"
        ]
      },
      "body": {
        "label": "Body",
        "tokens": [
          "nc-notification-body-size",
          "nc-notification-body-color",
          "nc-notification-body-line-height"
        ]
      },
      "media": {
        "label": "Media Slot",
        "tokens": [
          "nc-notification-media-size",
          "nc-notification-media-radius"
        ]
      },
      "unread": {
        "label": "Unread Indicator",
        "tokens": [
          "nc-notification-unread-dot-size",
          "nc-notification-unread-dot-color",
          "nc-notification-unread-bg"
        ]
      },
      "close-button": {
        "label": "Close Button",
        "tokens": [
          "nc-notification-close-size",
          "nc-notification-close-radius",
          "nc-notification-close-opacity",
          "nc-notification-close-opacity-hover"
        ]
      },
      "footer": {
        "label": "Footer / Actions",
        "tokens": [
          "nc-notification-footer-gap",
          "nc-notification-action-size",
          "nc-notification-action-weight",
          "nc-notification-action-color"
        ]
      },
      "priority": {
        "label": "Priority (High)",
        "tokens": [
          "nc-notification-priority-border-width",
          "nc-notification-priority-border-color"
        ]
      },
      "type-colors": {
        "label": "Type Colors",
        "tokens": [
          "nc-notification-feature-color",
          "nc-notification-system-color",
          "nc-notification-promo-color"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-notification-transition-duration",
          "nc-notification-dismiss-duration"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.priority.values.*.modifier",
        "axes.type.values.*.modifier",
        "axes.interaction.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "basic",
      "label": "Basic Notification",
      "description": "Standard News-Alert mit Titel, Body und Meta-Info",
      "matrix": {
        "axes": {
          "type": [
            "feature"
          ],
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "basic",
        "compositionType": "notification-basic"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Floating Card mit surface-elevated BG. Text-Primary Titel auf surface-elevated Hintergrund."
      }
    },
    {
      "id": "with-media",
      "label": "With Media Slot",
      "description": "Notification mit Thumbnail/Avatar (48×48)",
      "matrix": {
        "axes": {
          "type": "feature",
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "media"
      ],
      "layout": "row",
      "render": {
        "label": "with-media",
        "compositionType": "notification-media"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Media-Slot: img mit alt-Text oder dekoratives SVG mit aria-hidden."
      }
    },
    {
      "id": "unread-state",
      "label": "Unread State",
      "description": "Ungelesene Notification mit Dot und subtiler BG-Hervorhebung",
      "matrix": {
        "axes": {
          "type": [
            "feature",
            "system",
            "promo"
          ],
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "unread"
        ]
      },
      "focusTokenGroups": [
        "unread"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "type"
      },
      "render": {
        "label": "{type}",
        "compositionType": "notification-unread"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Unread-Dot: aria-hidden='true'. Status per aria-label am Root: 'Ungelesen: [Titel]'."
      }
    },
    {
      "id": "priority-high",
      "label": "Priority High",
      "description": "Hohe Prioritaet mit Akzent-Border links",
      "matrix": {
        "axes": {
          "type": [
            "feature",
            "system",
            "promo"
          ],
          "priority": [
            "high"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "priority",
        "type-colors"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "type"
      },
      "render": {
        "label": "{type}",
        "compositionType": "notification-priority"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Akzent-Border links signalisiert Wichtigkeit. Nicht alleiniges Signal — Titel kommuniziert Dringlichkeit."
      }
    },
    {
      "id": "type-variants",
      "label": "Type Variants",
      "description": "Drei Inhaltskategorien mit unterschiedlichen Akzentfarben",
      "matrix": {
        "axes": {
          "type": "*",
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "type-colors"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "type"
      },
      "render": {
        "label": "{type}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Farbe nie alleiniges Signal. Type-Label oder Icon kommuniziert Kategorie."
      }
    },
    {
      "id": "with-actions",
      "label": "With Footer Actions",
      "description": "Notification mit Action-Links im Footer",
      "matrix": {
        "axes": {
          "type": [
            "feature"
          ],
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "footer"
      ],
      "layout": "row",
      "render": {
        "label": "with-actions",
        "compositionType": "notification-actions"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Action-Links fokussierbar. Tab-Reihenfolge: Actions vor Close-Button."
      }
    },
    {
      "id": "permanent",
      "label": "Permanent (No Close)",
      "description": "Nicht-schliessbare Notification fuer permanente Hinweise",
      "matrix": {
        "axes": {
          "type": [
            "system"
          ],
          "priority": [
            "high"
          ],
          "interaction": [
            "permanent"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "permanent",
        "compositionType": "notification-permanent"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Kein Close-Button. Notification bleibt sichtbar bis externer Trigger sie entfernt."
      }
    },
    {
      "id": "dismiss-animation",
      "label": "Dismiss Animation",
      "description": "Hoehen-Collapse beim Schliessen",
      "matrix": {
        "axes": {
          "type": [
            "feature"
          ],
          "priority": [
            "low"
          ],
          "interaction": [
            "dismissible"
          ]
        },
        "states": [
          "dismissing"
        ]
      },
      "focusTokenGroups": [
        "animation"
      ],
      "layout": "row",
      "render": {
        "label": "dismissing",
        "compositionType": "notification-dismiss"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Reduced Motion: Dismiss ohne Animation (display:none). pointer-events:none waehrend Animation."
      }
    }
  ]
}
