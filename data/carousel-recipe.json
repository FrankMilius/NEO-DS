{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "carousel",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["display", "interactive", "slider"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/carousel-docs" }
  },
  "anatomy": {
    "root": { "element": ".carousel" },
    "slots": [
      { "name": "slides-wrapper", "element": ".carousel-slides-wrapper", "optional": false },
      { "name": "bottom-nav", "element": ".carousel-bottom-nav-wrapper", "optional": false },
      { "name": "line-wrapper", "element": ".carousel-line-wrapper", "optional": true },
      { "name": "navigations", "element": ".carousel-navigations-wrapper", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Slides: ul/li, flex nowrap, dynamische Breite via carousel-slide-width-{1-12}.",
      "Progress-Lines: 2px Hoehe, active-Line 112px breit, autoplay mit CSS-Animation.",
      "Navigation-Buttons: 32×32, icon-only, :disabled state, focus-ring."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Variante — default, autoplay",
      "values": {
        "default":  { "modifier": null,  "tokenGroups": [], "renderHint": "carousel-default" },
        "autoplay": { "modifier": null,  "tokenGroups": [], "renderHint": "carousel-autoplay" }
      }
    }
  },
  "states": {
    "supported": ["default", "disabled"],
    "precedence": ["disabled", "default"],
    "rules": [
      { "state": "disabled", "condition": "Navigation-Button am Anfang/Ende" }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Touch: pan-y. Navigation: aria-label, disabled state. Autoplay: pausierbar. Progress-Lines: dekorativ. Focus-Ring auf Buttons."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["carousel"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison", "label": "Carousel Variants",
      "description": "Default vs Autoplay",
      "matrix": { "axes": { "variant": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "variant" }, "render": { "label": "{variant}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Autoplay: pausierbar bei Hover/Focus." }
    }
  ]
}
