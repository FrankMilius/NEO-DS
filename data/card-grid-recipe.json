{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "card-grid",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "display",
      "content",
      "grid",
      "cards"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/card-grid-docs"
    },
    "changelog": [
      {
        "version": "1.0.0",
        "changes": [
          "Grid aus Cards mit konfigurierbarem Pattern und Behavior."
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [],
      "story": "stories/organisms/card-grid.stories.js",
      "arena": null,
      "drupal": [
        "block--block-content--neo-card-grid.html.twig",
        "block--inline-block--neo-card-grid.html.twig"
      ],
      "docs": null
    },
    "dependencies": [
      "card"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-card-grid"
    },
    "slots": [
      {
        "name": "card",
        "element": ".nc-card",
        "optional": false,
        "description": "Einzelne Card im Grid."
      }
    ],
    "convenience": [],
    "domNotes": [
      "CSS Grid mit auto-fit oder fester Spaltenanzahl. Cards per JSON gerendert."
    ]
  },
  "axes": {
    "pattern": {
      "label": "Pattern",
      "description": "Card-Variante",
      "values": {
        "standard": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "card-grid-standard"
        },
        "preview": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "card-grid-preview"
        },
        "featured": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "card-grid-featured"
        },
        "horizontal": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ],
          "renderHint": "card-grid-horizontal"
        }
      }
    },
    "animation": {
      "label": "Animation",
      "description": "Scroll-basierte Einblendanimation",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "card-grid-no-animation"
        },
        "reverse-domino": {
          "modifier": null,
          "tokenGroups": [
            "animation"
          ],
          "renderHint": "card-grid-reverse-domino"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover"
    ],
    "precedence": [
      "hover",
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Cards: semantic article/a elements."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-card-grid"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-card-grid-columns",
          "nc-card-grid-gap",
          "nc-card-grid-title-size",
          "nc-card-grid-title-margin"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-card-grid-anim-duration",
          "nc-card-grid-anim-delay",
          "nc-card-grid-anim-translate-y"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "standard",
      "label": "Standard Grid",
      "description": "Standard-Cards mit Bild, Titel, Beschreibung.",
      "matrix": {
        "axes": {
          "pattern": [
            "standard"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "layout"
      ],
      "layout": "single",
      "render": {
        "compositionType": "card-grid-standard",
        "label": "standard"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Standard."
      }
    },
    {
      "id": "reverse-domino",
      "label": "Reverse Domino",
      "description": "Cards werden nacheinander von unten eingeblendet (staggered slide-up) beim Scrollen in den Viewport.",
      "matrix": {
        "axes": {
          "pattern": [
            "standard"
          ],
          "animation": [
            "reverse-domino"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "layout",
        "animation"
      ],
      "layout": "single",
      "render": {
        "compositionType": "card-grid-reverse-domino",
        "label": "reverse-domino"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Animation respektiert prefers-reduced-motion."
      }
    }
  ]
}
