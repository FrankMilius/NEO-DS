{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "code-snippet",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["static", "content", "code"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/code-snippet-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-code-snippet" },
    "slots": [
      { "name": "pre",       "element": ".nc-code-snippet__pre",       "optional": false },
      { "name": "code",      "element": ".nc-code-snippet__code",      "optional": false },
      { "name": "copy",      "element": ".nc-code-snippet__copy",      "optional": true },
      { "name": "show-more", "element": ".nc-code-snippet__show-more", "optional": true },
      { "name": "label",     "element": ".nc-code-snippet__label",     "optional": true }
    ],
    "convenience": [
      { "name": "copy-icon",       "element": ".nc-code-snippet__copy-icon",        "optional": true, "description": "Icon im Copy-Button (Copy/Check)" },
      { "name": "copy-icon-copy",  "element": ".nc-code-snippet__copy-icon--copy",  "optional": true, "description": "Copy-Icon (Standard)" },
      { "name": "copy-icon-check", "element": ".nc-code-snippet__copy-icon--check", "optional": true, "description": "Check-Icon (Erfolg)" }
    ],
    "domNotes": [
      "Inline: <code class='nc-code-snippet nc-code-snippet--inline'>. Kein Copy-Button.",
      "Single: <div class='nc-code-snippet nc-code-snippet--single'><pre><code>. Copy-Button oben rechts.",
      "Multi:  <div class='nc-code-snippet nc-code-snippet--multi'><pre><code>. Copy-Button + Show-More.",
      "Copy-Button: aria-label='Code kopieren'. Dual-Icon Pattern (Copy → Check bei Erfolg).",
      "Show-More: aria-expanded='true/false'. Gradient-Fade im collapsed Zustand.",
      "Sprach-Label (optional): Badge oben links mit Sprach-Kennung (z.B. 'HTML', 'SCSS').",
      "Syntax-Highlighting via Prism.js — .token-Klassen werden auf --nc-cs-syntax-* Tokens gemappt."
    ]
  },

  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Anzeige-Typ — inline (Fliesstext), single-line (Block, 1 Zeile), multi-line (Block, collapsible)",
      "values": {
        "inline": {
          "modifier": "nc-code-snippet--inline",
          "tokenGroups": ["variant-inline"],
          "elementHint": "code",
          "renderHint": "code-inline"
        },
        "single": {
          "modifier": "nc-code-snippet--single",
          "tokenGroups": ["variant-block", "feature-copy"],
          "renderHint": "code-single"
        },
        "multi": {
          "modifier": "nc-code-snippet--multi",
          "tokenGroups": ["variant-block", "feature-copy", "feature-show-more"],
          "renderHint": "code-multi"
        }
      }
    },

    "syntax": {
      "label": "Syntax",
      "description": "Syntax-Highlighting aktivieren oder deaktivieren",
      "values": {
        "none":        { "modifier": null, "tokenGroups": [] },
        "highlighted": { "modifier": null, "tokenGroups": ["syntax-highlighting"] }
      }
    }
  },

  "states": {
    "supported": ["default", "expanded"],
    "precedence": ["expanded", "default"],
    "rules": [
      {
        "state": "expanded",
        "onlyWhen": { "axes": { "variant": ["multi"] } },
        "note": "Expanded-State nur fuer Multi-Line-Variante relevant. Entfernt max-height und Gradient-Fade."
      }
    ],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "Code-Snippet ist primaer nicht-interaktiv. Copy- und Show-More-Buttons sind interaktive Sub-Elemente mit eigener a11y."
    },
    "overrides": [
      {
        "when": { "axes": { "variant": ["single", "multi"] } },
        "suggest": ["aria-label"],
        "note": "Copy-Button braucht aria-label='Code kopieren'. Erfolgs-Feedback sollte ueber aria-live kommuniziert werden."
      },
      {
        "when": { "states": ["expanded"] },
        "suggest": ["aria-expanded"],
        "note": "Show-More-Button braucht aria-expanded='true/false'. Button-Text wechselt zwischen 'Mehr anzeigen' und 'Weniger anzeigen'."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": { "axes": { "variant": ["single", "multi"] } }, "require": ["aria-label-copy"], "notes": ["Copy-Button braucht aria-label='Code kopieren'."] },
      { "when": { "axes": { "variant": ["multi"] } }, "require": ["aria-expanded"], "notes": ["Show-More-Button braucht aria-expanded Attribut."] }
    ],
    "copy": {
      "label": {
        "maxChars": 12,
        "note": "Sprach-Label soll kurz sein (z.B. 'HTML', 'SCSS', 'JavaScript'). Uppercase per CSS."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-code-snippet"],
    "baseTokenGroups": ["core-typography"],

    "tokenGroups": {
      "core-typography": {
        "label": "Typography",
        "tokens": [
          "nc-cs-font-family",
          "nc-cs-font-size",
          "nc-cs-line-height",
          "nc-cs-font-weight",
          "nc-cs-tab-size"
        ]
      },
      "variant-block": {
        "label": "Block Surface",
        "tokens": [
          "nc-cs-bg",
          "nc-cs-color",
          "nc-cs-border",
          "nc-cs-border-width",
          "nc-cs-radius",
          "nc-cs-padding",
          "nc-cs-padding-inline"
        ]
      },
      "variant-inline": {
        "label": "Inline",
        "tokens": [
          "nc-cs-inline-bg",
          "nc-cs-inline-color",
          "nc-cs-inline-radius",
          "nc-cs-inline-padding-x",
          "nc-cs-inline-padding-y",
          "nc-cs-inline-font-size"
        ]
      },
      "feature-copy": {
        "label": "Copy Button",
        "tokens": [
          "nc-cs-copy-size",
          "nc-cs-copy-bg",
          "nc-cs-copy-bg-hover",
          "nc-cs-copy-color",
          "nc-cs-copy-color-hover",
          "nc-cs-copy-border",
          "nc-cs-copy-radius",
          "nc-cs-copy-icon-size"
        ]
      },
      "feature-show-more": {
        "label": "Show More",
        "tokens": [
          "nc-cs-multi-max-height",
          "nc-cs-show-more-bg",
          "nc-cs-show-more-color",
          "nc-cs-show-more-font-size",
          "nc-cs-show-more-height"
        ]
      },
      "syntax-highlighting": {
        "label": "Syntax Colors",
        "tokens": [
          "nc-cs-syntax-comment",
          "nc-cs-syntax-keyword",
          "nc-cs-syntax-string",
          "nc-cs-syntax-number",
          "nc-cs-syntax-function",
          "nc-cs-syntax-operator",
          "nc-cs-syntax-class",
          "nc-cs-syntax-property",
          "nc-cs-syntax-tag",
          "nc-cs-syntax-attr-name",
          "nc-cs-syntax-attr-value",
          "nc-cs-syntax-selector",
          "nc-cs-syntax-punctuation"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.syntax.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants",
      "description": "Inline, Single-Line und Multi-Line im Vergleich",
      "matrix": {
        "axes": { "variant": "*", "syntax": ["highlighted"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle Varianten muessen Mindestkontrast fuer Code-Text einhalten."
      }
    },
    {
      "id": "inline-in-context",
      "label": "Inline in Fliesstext",
      "description": "Inline-Code eingebettet in einen Textabsatz",
      "composes": ["paragraph"],
      "matrix": {
        "axes": { "variant": ["inline"], "syntax": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-inline"],
      "layout": "row",
      "render": { "compositionType": "code-in-paragraph", "label": "inline" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Inline-BG muss vom umgebenden Text-BG unterscheidbar sein. Font erbt line-height vom Fliesstext."
      }
    },
    {
      "id": "single-line",
      "label": "Single-Line with Copy",
      "description": "Einzeilige Code-Anzeige mit Copy-Button",
      "matrix": {
        "axes": { "variant": ["single"], "syntax": ["highlighted"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-block", "feature-copy"],
      "layout": "row",
      "render": { "label": "single-line" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Copy-Button wird bei Hover/Focus sichtbar. Braucht aria-label='Code kopieren'."
      }
    },
    {
      "id": "multi-collapsed-expanded",
      "label": "Multi-Line: Collapsed vs Expanded",
      "description": "Collapsible Code-Block in beiden Zustaenden",
      "matrix": {
        "axes": { "variant": ["multi"], "syntax": ["highlighted"] },
        "states": ["default", "expanded"]
      },
      "focusTokenGroups": ["variant-block", "feature-show-more"],
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "note": "Show-More-Button braucht aria-expanded. Gradient-Fade im Collapsed-Zustand ist rein dekorativ."
      }
    },
    {
      "id": "syntax-theme",
      "label": "Syntax Highlighting — Light vs Dark",
      "description": "Syntax-Farben im Licht- und Dunkel-Theme",
      "matrix": {
        "axes": { "variant": ["multi"], "syntax": ["highlighted"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["syntax-highlighting"],
      "layout": "row",
      "render": { "label": "syntax", "themeVariants": ["light", "dark"] },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle Syntax-Farben muessen 4.5:1 Kontrast gegen den Code-Hintergrund einhalten — sowohl im Light- als auch im Dark-Theme."
      }
    },
    {
      "id": "with-language-label",
      "label": "With Language Label",
      "description": "Block-Snippet mit Sprach-Badge (z.B. HTML, SCSS)",
      "composes": ["label"],
      "matrix": {
        "axes": { "variant": ["single", "multi"], "syntax": ["highlighted"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "code-with-label", "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Sprach-Label ist rein informativ. Kein interaktives Element."
      }
    },
    {
      "id": "no-syntax",
      "label": "Plain Code (No Highlighting)",
      "description": "Block-Snippet ohne Syntax-Highlighting",
      "matrix": {
        "axes": { "variant": ["single", "multi"], "syntax": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["variant-block", "core-typography"],
      "layout": "row",
      "render": { "label": "{variant}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Ohne Highlighting nur Basis-Textfarbe. Kontrast muss trotzdem eingehalten werden."
      }
    }
  ]
}
