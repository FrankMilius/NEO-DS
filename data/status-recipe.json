{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "status",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "static",
      "indicator",
      "presence"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/status-docs"
    },
    "layer": "atom",
    "pipeline": {
      "scss": [
        "scss/scss/05-atoms/_status.scss"
      ],
      "story": "stories/organisms/status.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/status-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-status"
    },
    "slots": [],
    "convenience": [
      {
        "name": "label-wrapper",
        "element": ".nc-status-label",
        "optional": true,
        "description": "Container fuer Dot + Text (inline-flex, gap: spacing-02)"
      },
      {
        "name": "label-text",
        "element": ".nc-status-label__text",
        "optional": true,
        "description": "Begleitender Text (fs-sm, text-secondary)"
      }
    ],
    "domNotes": [
      "Status ist rein dekorativ — immer aria-hidden='true' auf dem Dot.",
      "Begleitender Text ueber .nc-status-label oder .u-sr-only fuer Screen-Reader.",
      "Farbe nie als einziges Signal — immer mit Text kombinieren (R3).",
      "Pulse-Animation respektiert prefers-reduced-motion automatisch."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Status-Semantik der Anzeige",
      "values": {
        "neutral": {
          "modifier": null,
          "tokenGroups": [
            "variant-neutral"
          ]
        },
        "online": {
          "modifier": "nc-status--online",
          "tokenGroups": [
            "variant-online"
          ]
        },
        "offline": {
          "modifier": "nc-status--offline",
          "tokenGroups": [
            "variant-offline"
          ]
        },
        "busy": {
          "modifier": "nc-status--busy",
          "tokenGroups": [
            "variant-busy"
          ]
        },
        "away": {
          "modifier": "nc-status--away",
          "tokenGroups": [
            "variant-away"
          ]
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groessenabstufung — xs (6px) / sm (8px, Standard) / md (12px)",
      "values": {
        "xs": {
          "modifier": "nc-status--xs",
          "tokenGroups": []
        },
        "sm": {
          "modifier": null,
          "tokenGroups": []
        },
        "md": {
          "modifier": "nc-status--md",
          "tokenGroups": []
        }
      }
    },
    "decorator": {
      "label": "Decorator",
      "description": "Visuelle Erweiterungen: Ring (weisser Rand) oder Pulse (Live-Animation)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "ring": {
          "modifier": "nc-status--ring",
          "tokenGroups": [
            "decorator-ring"
          ]
        },
        "pulse": {
          "modifier": "nc-status--pulse",
          "tokenGroups": [
            "decorator-pulse"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [
        "doNotRelyOnColorOnly",
        "hasAccessibleName"
      ],
      "note": "Status-Dot ist rein dekorativ (aria-hidden='true'). Status muss immer durch begleitenden Text kommuniziert werden."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "decorator": [
              "pulse"
            ]
          }
        },
        "suggest": [
          "aria-live"
        ],
        "note": "Pulse signalisiert Live-Status. Aenderungen ueber aria-live='polite' auf dem Container kommunizieren."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "aria-hidden"
        ],
        "notes": [
          "Status-Dot immer aria-hidden='true'. Text-Begleitung oder .u-sr-only pflicht."
        ]
      }
    ],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-status"
    ],
    "baseTokenGroups": [
      "core-sizing"
    ],
    "tokenGroups": {
      "core-sizing": {
        "label": "Sizing",
        "tokens": [
          "nc-status-size-xs",
          "nc-status-size-sm",
          "nc-status-size-md"
        ]
      },
      "variant-online": {
        "label": "Online",
        "tokens": [
          "nc-status-online"
        ]
      },
      "variant-offline": {
        "label": "Offline",
        "tokens": [
          "nc-status-offline"
        ]
      },
      "variant-busy": {
        "label": "Busy",
        "tokens": [
          "nc-status-busy"
        ]
      },
      "variant-away": {
        "label": "Away",
        "tokens": [
          "nc-status-away"
        ]
      },
      "variant-neutral": {
        "label": "Neutral",
        "tokens": [
          "nc-status-neutral"
        ]
      },
      "decorator-ring": {
        "label": "Ring",
        "tokens": [
          "nc-status-ring-width",
          "nc-status-ring-color"
        ]
      },
      "decorator-pulse": {
        "label": "Pulse",
        "tokens": [
          "nc-status-pulse-duration"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.decorator.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants — SM",
      "description": "Alle 5 Status-Varianten in Standardgroesse",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "sm"
          ],
          "decorator": [
            "none"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Jede Farbvariante muss durch begleitenden Text unterscheidbar sein."
      }
    },
    {
      "id": "size-grid",
      "label": "Variant × Size",
      "description": "Alle Varianten in allen 3 Groessen",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": "*",
          "decorator": [
            "none"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "core-sizing"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant",
        "colAxis": "size"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "XS (6px) ist der kleinste zulässige Indikator. Unter 6px nicht WCAG-konform."
      }
    },
    {
      "id": "with-ring",
      "label": "Ring Modifier",
      "description": "Weisser Ring fuer Verwendung auf farbigen Hintergruenden",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "sm"
          ],
          "decorator": [
            "ring"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "decorator-ring"
      ],
      "layout": "row",
      "render": {
        "label": "{variant}",
        "stage": "colored"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Ring stellt sicher, dass der Status-Dot auf farbigen Hintergruenden erkennbar bleibt."
      }
    },
    {
      "id": "pulse-animation",
      "label": "Pulse Animation",
      "description": "Live-Status-Anzeige mit pulsierender Animation",
      "matrix": {
        "axes": {
          "variant": [
            "online",
            "busy"
          ],
          "size": [
            "sm"
          ],
          "decorator": [
            "pulse"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "decorator-pulse"
      ],
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "note": "Animation respektiert prefers-reduced-motion. Pulse nur fuer aktive Live-Status verwenden (online, busy)."
      }
    },
    {
      "id": "with-label",
      "label": "Status mit Label",
      "description": "Dot + begleitender Text ueber .nc-status-label",
      "composes": [
        "label"
      ],
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "sm"
          ],
          "decorator": [
            "none"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "status-label",
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label-Text kommuniziert den Status textuell. Dot bleibt aria-hidden='true'."
      }
    },
    {
      "id": "on-avatar",
      "label": "Status on Avatar",
      "description": "Positionierung auf Avatar-Ecke mit Ring",
      "composes": [
        "avatar"
      ],
      "matrix": {
        "axes": {
          "variant": [
            "online",
            "busy",
            "away"
          ],
          "size": [
            "sm"
          ],
          "decorator": [
            "ring"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "decorator-ring"
      ],
      "layout": "row",
      "render": {
        "compositionType": "avatar-status",
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "roleSuggestion": "aria-label=\"{name}, {variant}\"",
        "note": "Status muss im aria-label des Avatars kommuniziert werden. Dot ist aria-hidden."
      }
    }
  ]
}
