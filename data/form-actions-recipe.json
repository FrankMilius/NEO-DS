{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-actions",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "form",
      "layout",
      "action"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-actions-docs"
    },
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_form-actions.scss"
      ],
      "story": "stories/organisms/form-actions.stories.js",
      "arena": null,
      "drupal": [],
      "docs": "docs/form-actions-docs.html"
    },
    "dependencies": [
      "form"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-form-actions"
    },
    "slots": [],
    "convenience": [],
    "domNotes": [
      "Flex-Container fuer Formular-Buttons (Submit, Cancel, Reset).",
      "Default: flex-start. Modifier: --center, --end, --spread (space-between).",
      "--sticky: sticky bottom:0 mit BG + Shadow + border-top. Fuer lange Formulare.",
      "--stacked: flex-column, Buttons volle Breite. Fuer Mobile.",
      "--bordered: border-top Trennlinie, margin-top.",
      "--responsive: automatisch stacked unter 479px.",
      "Primary Action an erster Stelle im DOM."
    ]
  },
  "axes": {
    "alignment": {
      "label": "Alignment",
      "description": "Ausrichtung — start (links), center, end (rechts), spread (space-between)",
      "values": {
        "start": {
          "modifier": "nc-form-actions--start",
          "tokenGroups": [],
          "renderHint": "form-actions-start"
        },
        "center": {
          "modifier": "nc-form-actions--center",
          "tokenGroups": [],
          "renderHint": "form-actions-center"
        },
        "end": {
          "modifier": "nc-form-actions--end",
          "tokenGroups": [],
          "renderHint": "form-actions-end"
        },
        "spread": {
          "modifier": "nc-form-actions--spread",
          "tokenGroups": [],
          "renderHint": "form-actions-spread"
        }
      }
    },
    "variant": {
      "label": "Variant",
      "description": "Layout-Variante — default (inline), sticky (haftet unten), stacked (vertikal), bordered (Trennlinie)",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-actions-default"
        },
        "sticky": {
          "modifier": "nc-form-actions--sticky",
          "tokenGroups": [],
          "renderHint": "form-actions-sticky"
        },
        "stacked": {
          "modifier": "nc-form-actions--stacked",
          "tokenGroups": [],
          "renderHint": "form-actions-stacked"
        },
        "bordered": {
          "modifier": "nc-form-actions--bordered",
          "tokenGroups": [],
          "renderHint": "form-actions-bordered"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [
        "hasAccessibleName"
      ],
      "note": "role='group' mit aria-label='Formular-Aktionen'. Primary Action an erster Stelle im DOM. Buttons haben eigene A11y."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "role-group",
          "aria-label"
        ],
        "notes": [
          "Container: role='group' + aria-label='Formular-Aktionen'."
        ]
      }
    ],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-form-actions"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-form-actions-gap"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.alignment.values.*.modifier",
        "axes.variant.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "komposition": [
    { "art": "enthaelt", "recipe": "button" }
  ],
  "specimens": [
    {
      "id": "alignment-variants",
      "label": "Alignment Variants",
      "description": "Start, Center, End, Spread Ausrichtungen",
      "matrix": {
        "axes": {
          "alignment": "*",
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "alignment"
      },
      "render": {
        "label": "{alignment}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Buttons behalten eigene A11y. Ausrichtung rein visuell."
      }
    },
    {
      "id": "layout-variants",
      "label": "Layout Variants",
      "description": "Default, Sticky, Stacked, Bordered",
      "matrix": {
        "axes": {
          "alignment": [
            "end"
          ],
          "variant": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Sticky: z-index + Shadow fuer Sichtbarkeit. Stacked: Buttons volle Breite, min. 44px Touch-Target."
      }
    },
    {
      "id": "spread-layout",
      "label": "Spread Layout",
      "description": "Cancel links, Submit rechts — typisches Formular-Pattern",
      "matrix": {
        "axes": {
          "alignment": [
            "spread"
          ],
          "variant": [
            "bordered"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-actions-spread",
        "label": "spread"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Primary Action im DOM zuerst, visuell rechts. Screen Reader liest Submit zuerst."
      }
    },
    {
      "id": "sticky-actions",
      "label": "Sticky Actions",
      "description": "Sticky am unteren Rand — fuer lange Formulare",
      "matrix": {
        "axes": {
          "alignment": [
            "end"
          ],
          "variant": [
            "sticky"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-actions-sticky",
        "label": "sticky"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Sticky: Background + Shadow verdeckt Content. Border-top als visuelle Trennung."
      }
    },
    {
      "id": "stacked-mobile",
      "label": "Stacked (Mobile)",
      "description": "Vertikale Anordnung fuer schmale Viewports",
      "matrix": {
        "axes": {
          "alignment": [
            "start"
          ],
          "variant": [
            "stacked"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-actions-stacked",
        "label": "stacked"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Buttons full-width, min. 44px Hoehe. Reihenfolge: Primary oben."
      }
    },
    {
      "id": "in-form",
      "label": "In Form Context",
      "description": "Form-Actions am Ende eines Formulars mit Fieldsets",
      "composes": [
        "form",
        "form-field"
      ],
      "matrix": {
        "axes": {
          "alignment": [
            "end"
          ],
          "variant": [
            "bordered"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-actions-in-form",
        "label": "in-form"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Tab-Reihenfolge: letztes Feld → Submit → Cancel. Enter im Input submitted das Formular."
      }
    }
  ]
}
