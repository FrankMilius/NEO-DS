{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "nav-molecules",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["navigation", "interactive"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/nav-molecules-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-nav-molecules" },
    "slots": [
      { "name": "nav-link", "element": ".nc-nav-link", "optional": true },
      { "name": "nav-toggle", "element": ".nc-nav-toggle", "optional": true },
      { "name": "search-panel", "element": ".nc-search-panel", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Nav-Link: flex, align-items center, gap, padding. Hover: text-accent. Active: font-weight semibold, border-bottom accent.",
      "Nav-Toggle: button-Stil, icon rotation bei aria-expanded. Search-Panel: input + results container."
    ]
  },
  "axes": {
    "element": {
      "label": "Element",
      "description": "Nav-Molekuel-Typ — link, toggle, search",
      "values": {
        "link":   { "modifier": null, "tokenGroups": [], "renderHint": "nav-link" },
        "toggle": { "modifier": null, "tokenGroups": [], "renderHint": "nav-toggle" },
        "search": { "modifier": null, "tokenGroups": [], "renderHint": "search-panel" }
      }
    }
  },
  "states": {
    "supported": ["default", "hover", "active", "focus"],
    "precedence": ["focus", "active", "hover", "default"],
    "rules": [
      { "state": "active", "condition": ".is-active oder aria-current=page" }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Nav-Links: role link, keyboard-navigierbar. Toggle: aria-expanded. Search: role search, label."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["nc-nav-molecules"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "elements", "label": "Nav Molecules",
      "description": "Link, Toggle, Search Panel",
      "matrix": { "axes": { "element": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "element" }, "render": { "label": "{element}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Alle interaktiv: focus-ring erforderlich." }
    }
  ]
}
