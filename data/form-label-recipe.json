{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-label",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["form", "text", "label"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-label-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-form-label" },
    "slots": [
      { "name": "text", "element": ".nc-form-label__text", "optional": false },
      { "name": "required", "element": ".nc-form-label__required", "optional": true },
      { "name": "optional", "element": ".nc-form-label__optional", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Semantisch ein <label for='input-id'> Element.",
      "Flexbox-Layout: Text + Required/Optional-Indikator inline, align-items: baseline.",
      "margin-bottom via --nc-form-label-gap — Abstand zum darunterliegenden Input.",
      "Required-Sternchen ('*'): aria-hidden='true' — Screen Reader liest aria-required am Input.",
      "Optional-Text ('(Optional)'): kleiner, leichteres Gewicht, tertiaere Farbe.",
      "cursor: pointer — Klick auf Label fokussiert den verknuepften Input.",
      "Im .nc-form-field Wrapper wird margin-bottom: 0 gesetzt (gap uebernimmt)."
    ]
  },

  "axes": {
    "indicator": {
      "label": "Indicator",
      "description": "Pflichtfeld-Indikator — none (Standard), required (rotes *), optional (grauer Text)",
      "values": {
        "none":     { "modifier": null, "tokenGroups": [], "renderHint": "form-label-plain" },
        "required": { "modifier": null, "tokenGroups": [], "slotConfig": { "required": true }, "renderHint": "form-label-required" },
        "optional": { "modifier": null, "tokenGroups": [], "slotConfig": { "optional": true }, "renderHint": "form-label-optional" }
      }
    },

    "layout": {
      "label": "Layout",
      "description": "Layout-Variante — block (Standard, Label ueber Input), inline (Label neben Input)",
      "values": {
        "block":  { "modifier": null,                       "tokenGroups": [], "renderHint": "form-label-block" },
        "inline": { "modifier": "nc-form-label--inline",    "tokenGroups": [], "renderHint": "form-label-inline" }
      }
    }
  },

  "states": {
    "supported": ["default", "disabled"],
    "precedence": ["disabled", "default"],
    "rules": [
      { "state": "disabled", "unless": [], "note": "Disabled: text-disabled Farbe, cursor: not-allowed. Spiegelt den Disabled-State des verknuepften Inputs." }
    ],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "<label for='input-id'> verknuepft Label mit Input. Klick auf Label fokussiert den Input. Required-Sternchen ist aria-hidden='true' — Pflichtfeld wird via aria-required='true' am Input kommuniziert."
    },
    "overrides": [
      {
        "when": { "axes": { "indicator": ["required"] } },
        "suggest": ["aria-hidden"],
        "note": "Required-Indikator ('*') muss aria-hidden='true' haben. Pflichtfeld-Semantik liegt auf dem Input (aria-required='true')."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": [],
        "note": "Disabled-Label benoetigt keine eigene ARIA-Annotation — der Disabled-State liegt auf dem Input."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["label-for"], "notes": ["Label muss via for-Attribut mit dem Input verknuepft sein."] }
    ],
    "copy": {
      "text": {
        "maxChars": 60,
        "note": "Label-Text soll kurz und beschreibend sein. Keine Doppelpunkte am Ende."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-form-label"],
    "baseTokenGroups": ["core-geometry", "core-colors"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-form-label-font-size",
          "nc-form-label-font-weight",
          "nc-form-label-gap"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-form-label-color",
          "nc-form-label-required-color",
          "nc-form-label-optional-color"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.indicator.values.*.modifier",
        "axes.layout.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "default",
      "label": "Default Label",
      "description": "Standard-Label ohne Indikator",
      "matrix": {
        "axes": { "indicator": ["none"], "layout": ["block"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "label": "default" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Primary-Text Farbe muss 4.5:1 Kontrast gegen Hintergrund haben."
      }
    },
    {
      "id": "indicator-variants",
      "label": "Indicator Variants",
      "description": "Alle Indikator-Varianten: none, required (*), optional",
      "matrix": {
        "axes": { "indicator": "*", "layout": ["block"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "indicator" },
      "render": { "label": "{indicator}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Required-Farbe (danger) muss 4.5:1 Kontrast haben. Optional-Farbe (tertiary) muss 4.5:1 Kontrast haben."
      }
    },
    {
      "id": "layout-variants",
      "label": "Layout Variants",
      "description": "Block (ueber Input) vs Inline (neben Input)",
      "matrix": {
        "axes": { "indicator": ["none"], "layout": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "layout" },
      "render": { "label": "{layout}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Inline-Label hat kein margin-bottom und ein margin-inline-end. Block-Label hat margin-bottom via gap-Token."
      }
    },
    {
      "id": "all-states",
      "label": "All States",
      "description": "Default vs Disabled",
      "matrix": {
        "axes": { "indicator": ["required"], "layout": ["block"] },
        "states": ["default", "disabled"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled: text-disabled Farbe, cursor: not-allowed. Kein eigener ARIA-State noetig."
      }
    },
    {
      "id": "with-input",
      "label": "With Input Field",
      "description": "Label ueber einem Input-Feld (typischer Anwendungsfall)",
      "composes": ["input"],
      "matrix": {
        "axes": { "indicator": ["required"], "layout": ["block"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-label-with-input", "label": "label + input" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label hat for='input-id', Input hat id='input-id'. Klick auf Label fokussiert den Input."
      }
    },
    {
      "id": "in-form-field",
      "label": "In Form Field Context",
      "description": "Label im .nc-form-field Wrapper mit Input, Hint und Error",
      "composes": ["form-field", "input", "form-hint", "form-error"],
      "matrix": {
        "axes": { "indicator": ["required"], "layout": ["block"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "form-field-complete", "label": "form-field" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Im Form-Field: Label margin-bottom wird 0 (gap uebernimmt). Required am Label + aria-required am Input."
      }
    }
  ]
}
