{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "metric",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "display",
      "data",
      "content",
      "dashboard"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/metric-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_metric.scss"
      ],
      "story": "stories/organisms/metric.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/MetricArena.vue",
      "drupal": [],
      "docs": "docs/metric-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-metric"
    },
    "slots": [
      {
        "name": "label",
        "element": ".nc-metric__label",
        "optional": true
      },
      {
        "name": "value-row",
        "element": ".nc-metric__value-row",
        "optional": false
      },
      {
        "name": "value",
        "element": ".nc-metric__value",
        "optional": false
      },
      {
        "name": "unit",
        "element": ".nc-metric__unit",
        "optional": true
      },
      {
        "name": "trend",
        "element": ".nc-metric__trend",
        "optional": true
      },
      {
        "name": "footer",
        "element": ".nc-metric__footer",
        "optional": true
      }
    ],
    "convenience": [
      {
        "name": "trend-icon",
        "element": ".nc-metric__trend-icon",
        "optional": true,
        "description": "Pfeil-Icon im Trend-Slot (SVG arrow-up/arrow-down/minus)"
      }
    ],
    "domNotes": [
      "Container: Flex-Column mit gap. Solid: inverse BG + inverse Text. Subtle: helle BG + primaere Farben.",
      "Label: Dezente Beschriftung ueber dem Wert (z.B. 'Gesamtumsatz', 'Aktive Nutzer').",
      "Value-Row: Flex align-baseline Zeile fuer Value + Unit nebeneinander.",
      "Value: Grosse Zahl — font-heading, font-weight-black, accent-Farbe. tabular-nums fuer stabile Breite.",
      "Unit: Einheit neben dem Wert ($, %, kg). Gleiche accent-Farbe, kleinere Schrift.",
      "Trend: Inline-Flex mit Icon + Prozentwert. Farbe via Modifier: --trend-up (Success), --trend-down (Danger), --trend-neutral.",
      "Trend-Icon: SVG 16px, stroke: currentColor. Arrow-up fuer positiv, arrow-down fuer negativ, minus fuer neutral.",
      "Footer: Vergleichszeitraum (z.B. 'vs. Vorjahr', 'letzte 30 Tage'). Gedaempfte Opazitaet.",
      "Size md: Kompakt fuer Sidebar-Cards und Dense-Grids. Reduzierte Font-Sizes und Padding.",
      "Size xl: Hero-Groesse fuer Marketing-Sektionen. Uebergrosse Zahl (fs-8xl)."
    ]
  },
  "axes": {
    "emphasis": {
      "label": "Emphasis",
      "description": "Hintergrund-Stil — solid (inverse, dunkel) oder subtle (hell, dezent)",
      "values": {
        "solid": {
          "modifier": null,
          "tokenGroups": [
            "container",
            "value",
            "label",
            "footer"
          ]
        },
        "subtle": {
          "modifier": "nc-metric--subtle",
          "tokenGroups": [
            "subtle"
          ]
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groesse — md (kompakt), lg (Standard), xl (Hero)",
      "values": {
        "md": {
          "modifier": "nc-metric--md",
          "tokenGroups": [
            "size-md"
          ]
        },
        "lg": {
          "modifier": null,
          "tokenGroups": []
        },
        "xl": {
          "modifier": "nc-metric--xl",
          "tokenGroups": [
            "size-xl"
          ]
        }
      }
    },
    "trend": {
      "label": "Trend",
      "description": "Richtungsindikator — up (positiv/Success), down (negativ/Danger), neutral (unveraendert)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "up": {
          "modifier": "nc-metric--trend-up",
          "tokenGroups": [
            "trend"
          ]
        },
        "down": {
          "modifier": "nc-metric--trend-down",
          "tokenGroups": [
            "trend"
          ]
        },
        "neutral": {
          "modifier": "nc-metric--trend-neutral",
          "tokenGroups": [
            "trend"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA large text (3:1)",
      "assertions": [],
      "note": "Value: grosse Schrift (fs-6xl+) — large text Kontrast genuegt. Label und Footer: normal text Kontrast (4.5:1) beachten. Trend-Farben: Success/Danger gegen BG pruefen."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "emphasis": [
              "subtle"
            ]
          }
        },
        "suggest": [],
        "note": "Subtle: Value-Color und Label-Color muessen 4.5:1 gegen helle BG einhalten."
      },
      {
        "when": {
          "axes": {
            "trend": [
              "up",
              "down"
            ]
          }
        },
        "suggest": [],
        "note": "Trend-Farben: Success (#16a34a) und Danger (#dc2626) muessen 3:1 gegen BG einhalten. Nicht nur auf Farbe verlassen — Icon als zusaetzlicher Indikator."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "value-present"
        ],
        "notes": [
          "Jede Metric braucht mindestens einen Value."
        ]
      }
    ],
    "copy": {
      "label": {
        "maxChars": 30,
        "note": "Label: kurze Beschreibung der Kennzahl (z.B. 'Gesamtumsatz', 'Aktive Nutzer')."
      },
      "unit": {
        "maxChars": 5,
        "note": "Unit: Kurzzeichen der Einheit ($, %, kg, ms)."
      },
      "footer": {
        "maxChars": 30,
        "note": "Footer: Vergleichszeitraum (z.B. 'vs. Vorjahr', 'letzte 30 Tage')."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-metric"
    ],
    "baseTokenGroups": [
      "container",
      "value"
    ],
    "tokenGroups": {
      "container": {
        "label": "Container",
        "tokens": [
          "nc-metric-bg",
          "nc-metric-color",
          "nc-metric-radius",
          "nc-metric-padding",
          "nc-metric-gap"
        ]
      },
      "value": {
        "label": "Value (Big Number)",
        "tokens": [
          "nc-metric-value-font-family",
          "nc-metric-value-font-size",
          "nc-metric-value-font-weight",
          "nc-metric-value-color",
          "nc-metric-value-line-height"
        ]
      },
      "unit": {
        "label": "Unit",
        "tokens": [
          "nc-metric-unit-font-size",
          "nc-metric-unit-color",
          "nc-metric-unit-font-weight"
        ]
      },
      "label": {
        "label": "Label",
        "tokens": [
          "nc-metric-label-font-size",
          "nc-metric-label-color",
          "nc-metric-label-font-weight",
          "nc-metric-label-opacity"
        ]
      },
      "trend": {
        "label": "Trend Indicator",
        "tokens": [
          "nc-metric-trend-font-size",
          "nc-metric-trend-font-weight",
          "nc-metric-trend-gap",
          "nc-metric-trend-icon-size",
          "nc-metric-trend-up-color",
          "nc-metric-trend-down-color",
          "nc-metric-trend-neutral-color"
        ]
      },
      "footer": {
        "label": "Footer",
        "tokens": [
          "nc-metric-footer-font-size",
          "nc-metric-footer-color",
          "nc-metric-footer-opacity"
        ]
      },
      "subtle": {
        "label": "Subtle Emphasis",
        "tokens": [
          "nc-metric-subtle-bg",
          "nc-metric-subtle-color",
          "nc-metric-subtle-value-color",
          "nc-metric-subtle-label-color",
          "nc-metric-subtle-label-opacity",
          "nc-metric-subtle-footer-color",
          "nc-metric-subtle-footer-opacity"
        ]
      },
      "size-md": {
        "label": "Size MD",
        "tokens": [
          "nc-metric-md-padding",
          "nc-metric-md-value-font-size",
          "nc-metric-md-unit-font-size",
          "nc-metric-md-label-font-size"
        ]
      },
      "size-xl": {
        "label": "Size XL",
        "tokens": [
          "nc-metric-xl-padding",
          "nc-metric-xl-value-font-size",
          "nc-metric-xl-unit-font-size",
          "nc-metric-xl-label-font-size"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.emphasis.values.*.modifier",
        "axes.size.values.*.modifier",
        "axes.trend.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "default",
      "label": "Default (Solid)",
      "description": "Kennzahl mit Label, Value, Trend und Footer auf inversem Hintergrund",
      "matrix": {
        "axes": {
          "emphasis": [
            "solid"
          ],
          "size": [
            "lg"
          ],
          "trend": [
            "up"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "metric-full",
        "label": "solid"
      },
      "a11y": {
        "contrastTarget": "WCAG AA large text (3:1)",
        "note": "Value: accent gegen inverse BG. Label: text-inverse gegen inverse BG."
      }
    },
    {
      "id": "emphasis-comparison",
      "label": "Solid vs Subtle",
      "description": "Vergleich: inverse (solid) vs helle (subtle) Variante",
      "matrix": {
        "axes": {
          "emphasis": "*",
          "size": [
            "lg"
          ],
          "trend": [
            "up"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "emphasis"
      },
      "render": {
        "label": "{emphasis}"
      }
    },
    {
      "id": "size-comparison",
      "label": "Size Comparison",
      "description": "MD (kompakt) vs LG (Standard) vs XL (Hero)",
      "matrix": {
        "axes": {
          "emphasis": [
            "solid"
          ],
          "size": "*",
          "trend": [
            "up"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      }
    },
    {
      "id": "trend-variants",
      "label": "Trend Variants",
      "description": "Up (Success), Down (Danger), Neutral — Richtungsindikatoren",
      "matrix": {
        "axes": {
          "emphasis": [
            "solid"
          ],
          "size": [
            "lg"
          ],
          "trend": [
            "up",
            "down",
            "neutral"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "trend"
      },
      "render": {
        "label": "{trend}"
      }
    },
    {
      "id": "subtle-trends",
      "label": "Subtle + Trends",
      "description": "Helle Variante mit verschiedenen Trend-Richtungen",
      "matrix": {
        "axes": {
          "emphasis": [
            "subtle"
          ],
          "size": [
            "lg"
          ],
          "trend": [
            "up",
            "down",
            "neutral"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "trend"
      },
      "render": {
        "label": "{trend}"
      }
    },
    {
      "id": "dashboard-grid",
      "label": "Dashboard Grid",
      "description": "4 Metriken nebeneinander — typisches Dashboard-Layout",
      "matrix": {
        "axes": {
          "emphasis": [
            "subtle"
          ],
          "size": [
            "md"
          ],
          "trend": [
            "up"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "metric-grid",
        "label": "grid"
      }
    },
    {
      "id": "hero-metric",
      "label": "Hero Metric",
      "description": "XL Hero-Kennzahl fuer Marketing-Sektionen",
      "matrix": {
        "axes": {
          "emphasis": [
            "solid"
          ],
          "size": [
            "xl"
          ],
          "trend": [
            "up"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "metric-hero",
        "label": "hero"
      }
    },
    {
      "id": "value-only",
      "label": "Value Only",
      "description": "Minimale Variante: nur Wert ohne Label/Trend/Footer",
      "matrix": {
        "axes": {
          "emphasis": [
            "solid"
          ],
          "size": [
            "lg"
          ],
          "trend": [
            "none"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "metric-minimal",
        "label": "minimal"
      }
    }
  ],
  "tokenDependencies": [
    {
      "source": "nc-card-radius",
      "target": "nc-metric-radius",
      "reason": "Metric-Radius konsistent mit Card-Radius fuer Dashboard-Grids"
    }
  ]
}
