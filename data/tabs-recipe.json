{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "tabs",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "navigation",
      "interactive",
      "disclosure"
    ],
    "links": {
      "docs": "/docs/tabs-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_tabs.scss"
      ],
      "story": null,
      "arena": null,
      "drupal": [],
      "docs": "docs/tabs-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-tabs"
    },
    "slots": [
      {
        "name": "list",
        "element": ".nc-tabs__list",
        "optional": false,
        "description": "Container fuer Tab-Trigger (role=tablist)."
      },
      {
        "name": "trigger",
        "element": ".nc-tabs__trigger",
        "optional": false,
        "description": "Einzelner Tab-Button (role=tab)."
      },
      {
        "name": "trigger-icon",
        "element": ".nc-tabs__trigger-icon",
        "optional": true,
        "description": "Icon innerhalb des Triggers."
      },
      {
        "name": "trigger-label",
        "element": ".nc-tabs__trigger-label",
        "optional": true,
        "description": "Text-Label im Trigger."
      },
      {
        "name": "panel",
        "element": ".nc-tabs__panel",
        "optional": false,
        "description": "Inhaltspanel (role=tabpanel), per aria-labelledby verknuepft."
      },
      {
        "name": "scroll-btn",
        "element": ".nc-tabs__scroll-btn",
        "optional": true,
        "description": "Scroll-Buttons bei Overflow (--scrollable)."
      }
    ],
    "domNotes": [
      "Tabs verwenden WAI-ARIA Tabs Pattern (role=tablist/tab/tabpanel).",
      "aria-selected markiert den aktiven Tab, aria-controls verknuepft Tab mit Panel.",
      "Keyboard: Arrow Left/Right navigiert Tabs, Home/End springt zum ersten/letzten.",
      "Line-Variante (Default): Underline-Indikator unter dem aktiven Tab.",
      "Contained-Variante: Gefuellter Hintergrund mit Shadow fuer aktiven Tab.",
      "Groessen nutzen die Button-Scale (SM=32px, MD=40px, LG=48px)."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variante",
      "description": "Visuelle Darstellung der Tabs.",
      "values": [
        {
          "value": "line",
          "modifier": "nc-tabs--line",
          "label": "Line (Underline-Indikator)",
          "default": true
        },
        {
          "value": "contained",
          "modifier": "nc-tabs--contained",
          "label": "Contained (gefuellter Hintergrund)"
        }
      ]
    },
    "orientation": {
      "label": "Orientierung",
      "description": "Anordnung der Tab-Leiste.",
      "values": [
        {
          "value": "horizontal",
          "label": "Horizontal (Standard)",
          "default": true
        },
        {
          "value": "vertical",
          "modifier": "nc-tabs--vertical",
          "label": "Vertikal (seitlich)"
        }
      ]
    },
    "size": {
      "label": "Groesse",
      "description": "Hoehe der Tab-Trigger.",
      "values": [
        {
          "value": "sm",
          "modifier": "nc-tabs--sm",
          "label": "Small (32px)"
        },
        {
          "value": "md",
          "modifier": "nc-tabs--md",
          "label": "Medium (40px, Default)",
          "default": true
        },
        {
          "value": "lg",
          "modifier": "nc-tabs--lg",
          "label": "Large (48px)"
        }
      ]
    },
    "overflow": {
      "label": "Overflow",
      "description": "Verhalten bei zu vielen Tabs.",
      "values": [
        {
          "value": "wrap",
          "label": "Wrap (Zeilenumbruch)",
          "default": true
        },
        {
          "value": "scrollable",
          "modifier": "nc-tabs--scrollable",
          "label": "Scrollable (Scroll-Buttons)"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "active",
      "focus",
      "disabled"
    ],
    "rules": [
      "Genau ein Tab ist immer aktiv (aria-selected=true).",
      "Disabled Tabs sind nicht anklickbar (aria-disabled=true, opacity: --fnd-opacity-disabled)."
    ]
  },
  "styling": {
    "baseClasses": [
      ".nc-tabs"
    ],
    "tokenGroups": [
      {
        "name": "Trigger",
        "tokens": [
          {
            "token": "--nc-tabs-trigger-color",
            "property": "color"
          },
          {
            "token": "--nc-tabs-trigger-color-hover",
            "property": "color"
          },
          {
            "token": "--nc-tabs-trigger-color-active",
            "property": "color"
          },
          {
            "token": "--nc-tabs-trigger-font-weight",
            "property": "font-weight"
          },
          {
            "token": "--nc-tabs-trigger-font-weight-active",
            "property": "font-weight"
          }
        ]
      },
      {
        "name": "Line Variant",
        "tokens": [
          {
            "token": "--nc-tabs-line-border-color",
            "property": "border-color"
          },
          {
            "token": "--nc-tabs-line-indicator-color",
            "property": "border-color (active)"
          }
        ]
      },
      {
        "name": "Contained Variant",
        "tokens": [
          {
            "token": "--nc-tabs-contained-bg",
            "property": "background"
          },
          {
            "token": "--nc-tabs-contained-trigger-bg-active",
            "property": "background (active)"
          },
          {
            "token": "--nc-tabs-contained-trigger-shadow",
            "property": "box-shadow (active)"
          }
        ]
      },
      {
        "name": "Sizes",
        "tokens": [
          {
            "token": "--nc-tabs-height-sm",
            "property": "height"
          },
          {
            "token": "--nc-tabs-height-md",
            "property": "height"
          },
          {
            "token": "--nc-tabs-height-lg",
            "property": "height"
          }
        ]
      }
    ]
  },
  "keyboard": {
    "ArrowRight": { "action": "focus-next-tab", "note": "Fokussiert naechsten Tab (horizontal)." },
    "ArrowLeft": { "action": "focus-prev-tab", "note": "Fokussiert vorherigen Tab (horizontal)." },
    "ArrowDown": { "action": "focus-next-tab", "note": "Fokussiert naechsten Tab (vertikal).", "onlyWhen": { "axes": { "orientation": ["vertical"] } } },
    "ArrowUp": { "action": "focus-prev-tab", "note": "Fokussiert vorherigen Tab (vertikal).", "onlyWhen": { "axes": { "orientation": ["vertical"] } } },
    "Home": { "action": "focus-first-tab", "note": "Springt zum ersten Tab." },
    "End": { "action": "focus-last-tab", "note": "Springt zum letzten Tab." },
    "Enter": { "action": "activate-tab", "note": "Aktiviert den fokussierten Tab (falls nicht auto-activate)." },
    "Space": { "action": "activate-tab", "note": "Aktiviert den fokussierten Tab." },
    "Tab": { "action": "focus-panel", "note": "Springt direkt zum aktiven Panel-Inhalt (nicht durch alle Tabs)." }
  },
  "testSelectors": {
    "root": "[data-testid='tabs']",
    "list": "[data-testid='tabs-list']",
    "trigger": "[data-testid='tabs-trigger']",
    "panel": "[data-testid='tabs-panel']"
  },
  "events": {
    "tab-change": { "bubbles": true, "detail": { "value": "string", "previousValue": "string" }, "note": "Gefeuert wenn der aktive Tab wechselt." }
  },
  "specimens": [
    {
      "id": "line-default",
      "label": "Line Variant",
      "matrix": {
        "axes": {
          "variant": [
            "line"
          ],
          "size": [
            "md"
          ]
        }
      }
    },
    {
      "id": "contained-default",
      "label": "Contained Variant",
      "matrix": {
        "axes": {
          "variant": [
            "contained"
          ],
          "size": [
            "md"
          ]
        }
      }
    },
    {
      "id": "vertical",
      "label": "Vertical Tabs",
      "matrix": {
        "axes": {
          "orientation": [
            "vertical"
          ]
        }
      }
    },
    {
      "id": "all-sizes",
      "label": "Size Scale",
      "matrix": {
        "axes": {
          "size": "*"
        }
      }
    }
  ],
  "a11y": {
    "base": {
      "role": "tablist",
      "assertions": [
        "Tab-Leiste hat role=tablist, Tabs haben role=tab, Panels haben role=tabpanel.",
        "aria-selected=true auf aktivem Tab.",
        "aria-controls auf Tab verweist auf Panel-ID, aria-labelledby auf Panel verweist auf Tab-ID.",
        "Arrow Keys navigieren horizontal, Home/End springen zum Anfang/Ende.",
        "Tab-Key springt direkt zum aktiven Panel-Inhalt (nicht durch alle Tabs)."
      ]
    }
  }
}
