    "changelog": [
      {
        "version": "1.2.0",
        "changes": [
          "07.10.2026 (Plan v3, Phase 5): Slot icon (.nc-tbl-icon) mit --check (Haken im Akzentkreis) und --dash (Strich, text-tertiary) — bisher nur in domNotes."
        ]
      },
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Specimens default (Zeilenkopf und Wertzelle), info-knopf (hover/focus), untertitel (__sub), werte (Haken/Strich) und symbol-ueber-text (__icon-block); jede Zelle steht in einer Tabelle (Rahmen ra-tabelle), weil das SCSS nach th[scope=row]/td unterscheidet",
          "domNotes nach SCSS und geerntetem Markup",
          "Recipe-Form nach recipe-schema.json: axes, states, constraints, recipes, baseClasses, tokenGroups als Objekt bzw. ergaenzt (Draft aus der Aufnahme hatte Listen) — Lint-Fehler weniger"
        ]
      },
      {
        "version": "1.0.0",
        "changes": [
          "Aus dem Drupal-Theme aufgenommen (neo-overrides.css).",
          "Anatomie aus den Klassennamen des SCSS abgeleitet, nicht spezifiziert.",
          "Status draft: Anatomie und Achsen vor der Freigabe durchsehen."
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-tbl-cell"
    },
    "slots": [
      {
        "name": "icon-block",
        "element": ".nc-tbl-cell__icon-block",
        "optional": false
      },
      {
        "name": "info-btn",
        "element": ".nc-tbl-cell__info-btn",
        "optional": false
