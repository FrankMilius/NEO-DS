{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "banner",
    "version": "2.0.0",
    "status": "stable",
    "tags": ["feedback", "notification", "layout"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/banner-docs" },
    "changelog": [
      { "version": "2.0.0", "changes": ["Border-Accent Stil-Modus (dezente BG + Akzent-Border)", "Title-Prefix Element (__title) fuer bessere Scanbarkeit", "Dismiss-Animation (slide-up mit Hoehen-Transition)", "Dismiss-Persist (localStorage domNotes)", "Layout-Shift-Vermeidung (body padding-top domNotes)", "Icon-Size Token", "High Contrast Mode", "Neue Specimens: accent-variants, with-title, dismiss-animation"] },
      { "version": "1.0.0", "changes": ["Initiales Recipe: 4 Severity-Varianten, 3 Positionen, Close-Button, CTA-Link"] }
    ]
  },

  "anatomy": {
    "root": { "element": ".nc-banner" },
    "slots": [
      { "name": "icon", "element": ".nc-banner__icon", "optional": true },
      { "name": "content", "element": ".nc-banner__content", "optional": false },
      { "name": "title", "element": ".nc-banner__title", "optional": true },
      { "name": "link", "element": ".nc-banner__link", "optional": true },
      { "name": "close", "element": ".nc-banner__close", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Seitenbreite Benachrichtigungsleiste — Unterschied zu Alert: Banner ist sticky/fixed, seitenbreit.",
      "Root: flex-Layout, zentriert, volle Breite. Farbe via private Custom Props --_banner-bg/--_banner-color.",
      "Icon: Token-gesteuert (--nc-banner-icon-size), dekorativ (aria-hidden), optional links.",
      "Content: flex-wrap, zentriert. Text + optionaler CTA-Link.",
      "Title: Fettgedruckter Praefix (z.B. 'Wartung:') fuer bessere Scanbarkeit. Token: --nc-banner-title-weight.",
      "Link: erbt Farbe, bold + underline. Hover: opacity-prominent.",
      "Close-Button: 20px, opacity medium → 1 bei Hover. BG via color-mix(currentColor 15%).",
      "Varianten setzen --_banner-bg und --_banner-color auf die jeweiligen Feedback-Farben.",
      "Border-Accent (--accent): color-mix(bg 12%, transparent) + 4px border-left. Textfarbe wechselt zu text-primary.",
      "Position: --sticky (sticky top:0) oder --fixed (fixed top:0 left:0 right:0).",
      "z-index: notification-Ebene fuer Sichtbarkeit ueber anderem Content.",
      "Dismiss-Animation: .is-dismissing → @keyframes nc-banner-dismiss (max-height + padding + opacity → 0).",
      "Layout-Shift-Vermeidung: Bei --fixed sollte JS den body/shell padding-top um die Banner-Hoehe erhoehen. Beim Dismiss padding-top zuruecksetzen.",
      "Dismiss-Persist: JS sollte data-banner-id + localStorage nutzen, damit geschlossene Banner beim naechsten Seitenaufruf nicht erneut angezeigt werden.",
      "Reduced Motion: Dismiss ohne Animation (display:none).",
      "High Contrast Mode: 1px solid ButtonText, Focus-Ring 2px Highlight."
    ]
  },

  "axes": {
    "severity": {
      "label": "Severity",
      "description": "Schweregrad — info (Standard, Hauptfarbe), warning (Warnung), danger (Kritisch), success (Erfolg)",
      "values": {
        "info":    { "modifier": null,                     "tokenGroups": ["severity-info"],    "renderHint": "banner-info" },
        "warning": { "modifier": "nc-banner--warning",     "tokenGroups": ["severity-warning"], "renderHint": "banner-warning" },
        "danger":  { "modifier": "nc-banner--danger",      "tokenGroups": ["severity-danger"],  "renderHint": "banner-danger" },
        "success": { "modifier": "nc-banner--success",     "tokenGroups": ["severity-success"], "renderHint": "banner-success" }
      }
    },

    "position": {
      "label": "Position",
      "description": "Positionierung — static (im Flow), sticky (haftet oben), fixed (ueber allem fixiert)",
      "values": {
        "static": { "modifier": null,                     "tokenGroups": [], "renderHint": "banner-static" },
        "sticky": { "modifier": "nc-banner--sticky",      "tokenGroups": [], "renderHint": "banner-sticky" },
        "fixed":  { "modifier": "nc-banner--fixed",        "tokenGroups": [], "renderHint": "banner-fixed" }
      }
    },

    "style": {
      "label": "Style",
      "description": "Visueller Stil — solid (volle Farbflaeche), accent (dezente BG + Akzent-Border)",
      "values": {
        "solid":  { "modifier": null,                     "tokenGroups": [],              "renderHint": "banner-solid" },
        "accent": { "modifier": "nc-banner--accent",      "tokenGroups": ["accent"],       "renderHint": "banner-accent" }
      }
    },

    "content": {
      "label": "Content",
      "description": "Inhaltsvariante — text-only, with-icon, with-title, with-link, with-close, full",
      "values": {
        "text-only":  { "modifier": null, "tokenGroups": [], "renderHint": "banner-text-only" },
        "with-icon":  { "modifier": null, "tokenGroups": [], "slotConfig": { "icon": true }, "renderHint": "banner-with-icon" },
        "with-title": { "modifier": null, "tokenGroups": [], "slotConfig": { "title": true }, "renderHint": "banner-with-title" },
        "with-link":  { "modifier": null, "tokenGroups": [], "slotConfig": { "link": true }, "renderHint": "banner-with-link" },
        "with-close": { "modifier": null, "tokenGroups": [], "slotConfig": { "close": true }, "renderHint": "banner-with-close" },
        "full":       { "modifier": null, "tokenGroups": [], "slotConfig": { "icon": true, "title": true, "link": true, "close": true }, "renderHint": "banner-full" }
      }
    }
  },

  "states": {
    "supported": ["default", "dismissing"],
    "precedence": ["dismissing", "default"],
    "rules": [
      { "state": "dismissing", "unless": [], "note": "Dismissing: Slide-up Animation, danach Banner aus dem DOM entfernen." }
    ],
    "interactive": false
  },

  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName"],
      "note": "role='banner' fuer allgemeine Hinweise, role='alert' fuer dringende Meldungen (danger). Close-Button: aria-label='Banner schliessen'. Link: normales <a> oder <button>. Wird als erstes im DOM platziert fuer korrekte Screen-Reader-Reihenfolge."
    },
    "overrides": [
      {
        "when": { "axes": { "severity": ["danger"] } },
        "suggest": ["role-alert"],
        "note": "Danger: role='alert' fuer sofortige Screen-Reader-Ankuendigung. Oder aria-live='assertive'."
      },
      {
        "when": { "axes": { "severity": ["warning"] } },
        "suggest": ["role-alert"],
        "note": "Warning: role='alert' oder aria-live='polite' je nach Dringlichkeit."
      },
      {
        "when": { "axes": { "style": ["accent"] } },
        "suggest": ["contrast-check-accent"],
        "note": "Accent-Modus: Textfarbe ist text-primary auf 12%-Mix-BG. Kontrast gegen subtilen Hintergrund pruefen."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["role-banner-or-alert"], "notes": ["Banner braucht role='banner' (allgemein) oder role='alert' (dringend)."] },
      { "when": {}, "require": ["close-aria-label"], "notes": ["Close-Button: aria-label='Banner schliessen' fuer Screen Reader."] },
      { "when": { "axes": { "position": ["fixed"] } }, "require": ["layout-shift-prevention"], "notes": ["Bei --fixed: body/shell padding-top dynamisch anpassen, damit Content nicht verdeckt wird."] }
    ],
    "copy": {
      "text": {
        "maxChars": 120,
        "note": "Banner-Text: Kurz, klar, einzeilig. Soll sofort verstaendlich sein."
      },
      "title": {
        "maxChars": 25,
        "note": "Titel-Praefix: Max. 1-2 Worte (z.B. 'Wartung:', 'Achtung:', 'Neu:')."
      },
      "linkLabel": {
        "maxChars": 30,
        "note": "CTA-Link: Kurze Aktion (z.B. 'Mehr erfahren', 'Jetzt aktualisieren')."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-banner"],
    "baseTokenGroups": ["base", "severity-info", "severity-warning", "severity-danger", "severity-success", "accent", "close", "link", "dismiss"],

    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": [
          "nc-banner-padding",
          "nc-banner-gap",
          "nc-banner-z-index",
          "nc-banner-font-size",
          "nc-banner-font-weight",
          "nc-banner-icon-size"
        ]
      },
      "severity-info": {
        "label": "Info",
        "tokens": ["nc-banner-info-bg", "nc-banner-info-color"]
      },
      "severity-warning": {
        "label": "Warning",
        "tokens": ["nc-banner-warning-bg", "nc-banner-warning-color"]
      },
      "severity-danger": {
        "label": "Danger",
        "tokens": ["nc-banner-danger-bg", "nc-banner-danger-color"]
      },
      "severity-success": {
        "label": "Success",
        "tokens": ["nc-banner-success-bg", "nc-banner-success-color"]
      },
      "accent": {
        "label": "Border-Accent",
        "tokens": ["nc-banner-accent-border-width", "nc-banner-accent-border-color"]
      },
      "close": {
        "label": "Close Button",
        "tokens": ["nc-banner-close-size", "nc-banner-close-radius", "nc-banner-close-opacity", "nc-banner-close-opacity-hover"]
      },
      "link": {
        "label": "Link",
        "tokens": ["nc-banner-link-weight", "nc-banner-link-underline"]
      },
      "dismiss": {
        "label": "Dismiss Animation",
        "tokens": ["nc-banner-dismiss-duration", "nc-banner-title-weight"]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.severity.values.*.modifier",
        "axes.position.values.*.modifier",
        "axes.style.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "severity-variants",
      "label": "Severity Variants",
      "description": "Info, Warning, Danger, Success — volle Farbflaeche",
      "matrix": {
        "axes": { "severity": "*", "position": ["static"], "style": ["solid"], "content": ["with-close"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "severity" },
      "render": { "label": "{severity}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Text-on-Color muss 4.5:1 Kontrast gegen Severity-BG haben."
      }
    },
    {
      "id": "accent-variants",
      "label": "Border-Accent Variants",
      "description": "Info, Warning, Danger, Success — dezente BG + Akzent-Border",
      "matrix": {
        "axes": { "severity": "*", "position": ["static"], "style": ["accent"], "content": ["with-close"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "severity" },
      "render": { "label": "{severity} (accent)" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Accent-Modus: text-primary auf 12%-Mix-BG. Kontrast pruefen."
      }
    },
    {
      "id": "with-title",
      "label": "With Title Prefix",
      "description": "Banner mit fettgedrucktem Titel-Praefix fuer bessere Scanbarkeit",
      "matrix": {
        "axes": { "severity": ["warning"], "position": ["static"], "style": ["solid"], "content": ["full"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "banner-with-title", "label": "with-title" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Titel-Praefix: Erhoht Scanbarkeit. Kein eigenes ARIA-Label noetig — Text reicht."
      }
    },
    {
      "id": "content-variants",
      "label": "Content Variants",
      "description": "Text-Only, With Icon, With Title, With Link, With Close, Full",
      "matrix": {
        "axes": { "severity": ["info"], "position": ["static"], "style": ["solid"], "content": "*" },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "content" },
      "render": { "label": "{content}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icon dekorativ (aria-hidden). Link: Standard-<a>-Semantik. Close: aria-label='Banner schliessen'."
      }
    },
    {
      "id": "dismiss-animation",
      "label": "Dismiss Animation",
      "description": "Slide-up Animation beim Schliessen — Hoehe schrumpft auf 0",
      "matrix": {
        "axes": { "severity": ["info"], "position": ["static"], "style": ["solid"], "content": ["with-close"] },
        "states": ["dismissing"]
      },
      "layout": "row",
      "render": { "compositionType": "banner-dismiss", "label": "dismiss" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Dismiss: Reduced Motion → sofortiges display:none. localStorage persistiert Entscheidung."
      }
    },
    {
      "id": "position-variants",
      "label": "Position Variants",
      "description": "Static, Sticky, Fixed — Positionierung des Banners",
      "matrix": {
        "axes": { "severity": ["info"], "position": "*", "style": ["solid"], "content": ["full"] },
        "states": ["default"]
      },
      "layout": "grid",
      "layoutConfig": { "rowAxis": "position" },
      "render": { "label": "{position}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Fixed: z-index notification. body padding-top dynamisch anpassen."
      }
    },
    {
      "id": "danger-alert",
      "label": "Danger Alert Banner",
      "description": "Kritisches Banner mit role='alert' fuer sofortige Ankuendigung",
      "matrix": {
        "axes": { "severity": ["danger"], "position": ["fixed"], "style": ["solid"], "content": ["full"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "banner-danger-alert", "label": "danger-alert" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "role='alert' fuer sofortige Screen-Reader-Ankuendigung. on-danger muss 4.5:1 gegen danger-bg."
      }
    },
    {
      "id": "with-cta",
      "label": "With CTA Link",
      "description": "Banner mit eingebettetem Call-to-Action Link",
      "matrix": {
        "axes": { "severity": ["info"], "position": ["sticky"], "style": ["solid"], "content": ["with-link"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "banner-cta", "label": "with-cta" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Link erbt Farbe — underline + bold fuer visuelle Unterscheidung. Focus-Ring auf dem Link."
      }
    },
    {
      "id": "dismissible",
      "label": "Dismissible Banner",
      "description": "Banner mit Close-Button — Dismiss wird in localStorage gespeichert",
      "matrix": {
        "axes": { "severity": ["warning"], "position": ["static"], "style": ["solid"], "content": ["with-close"] },
        "states": ["default"]
      },
      "layout": "row",
      "render": { "compositionType": "banner-dismissible", "label": "dismissible" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Close-Button: aria-label='Banner schliessen'. localStorage: Banner nicht erneut anzeigen."
      }
    }
  ]
}
