        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison",
      "label": "Text-Only Variants",
      "description": "Default vs Scroll-Animation",
      "matrix": {
        "axes": {
          "variant": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Scroll-Variante: reduced-motion beachten."
      },
      "composes": [
        "button"
      ]
    },
    {
      "id": "ohne-knopf",
      "label": "Ohne Knopf",
