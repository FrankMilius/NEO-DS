{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "text-only",
    "version": "1.1.0",
    "status": "stable",
    "tags": [
      "display",
      "content",
      "text"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/text-only-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_text-only.scss"
      ],
      "story": "stories/organisms/text-only.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/text-only-docs.html"
    },
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Specimen ohne-knopf (nur der Absatz); Vorlage im Rahmen ra-desktop, has-scroll nicht mehr an der Wurzel (kein CSS — die Einfaerbung macht p.visible)",
          "Befund (Entscheidungsfall): die Recipe-Klassen nc-text-only*, __scroll-text und der Modifier has-scroll haben kein CSS; gebaut sind .text-only/.text-only-wrapper",
          "pipeline.arena zeigt auf die RecipeArena",
          "Specimens composes: button (Button-Container)"
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-text-only"
    },
    "slots": [
      {
        "name": "title",
        "element": ".nc-text-only__title",
        "optional": true
      },
      {
        "name": "text",
        "element": ".nc-text-only__text",
        "optional": false
      },
      {
        "name": "scroll-text",
        "element": ".nc-text-only__scroll-text",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Container: max-width, padding. Title: heading-Stil.",
      "Scroll-Text: perspective 600px, 3D-Rotation mit scroll-animation, rotateX + translateZ + scale. Reduced-Motion: Animation deaktiviert.",
      "Gebaut sind die Altklassen: .text-only-wrapper > .text-only > div > div (Raster ab desktop-up), p mit Wort-Spans (p.visible faerbt sie ein), .button-container. nc-text-only, __title, __text, __scroll-text und has-scroll haben kein CSS (Entscheidung offen)."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Variante — default, scroll",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "text-only-default"
        },
        "scroll": {
          "modifier": "has-scroll",
          "tokenGroups": [],
          "renderHint": "text-only-scroll"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Text lesbar. Scroll-Animation: prefers-reduced-motion respektieren, Animation deaktivieren."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "nc-text-only"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": []
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison",
      "label": "Text-Only Variants",
      "description": "Default vs Scroll-Animation",
      "matrix": {
        "axes": {
          "variant": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Scroll-Variante: reduced-motion beachten."
      },
      "composes": [
        "button"
      ]
    },
    {
      "id": "ohne-knopf",
      "label": "Ohne Knopf",
      "description": "Nur der Absatz (Doku „Standard-Ansicht“)",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "composition",
      "render": {
        "compositionType": "ohne-knopf"
      },
      "a11y": {
        "contrastTarget": "WCAG AA large text (3:1)"
      },
      "composes": [
        "button"
      ]
    }
  ]
}
