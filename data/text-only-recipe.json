      "matrix": {
        "axes": {
          "variant": [
            "default"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "composition",
      "render": {
        "compositionType": "ohne-knopf"
      },
      "a11y": {
        "contrastTarget": "WCAG AA large text (3:1)"
      },
      "composes": [
        "button"
      ]
    }
  ]
