{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "form-section",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "form",
      "layout",
      "grouping"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/form-section-docs"
    },
    "layer": "organism",
    "pipeline": {
      "scss": [
        "scss/scss/07-organisms/_form-section.scss"
      ],
      "story": "stories/organisms/form-section.stories.js",
      "arena": null,
      "drupal": [],
      "docs": "docs/form-section-docs.html"
    },
    "dependencies": [
      "form"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-form-section"
    },
    "slots": [
      {
        "name": "header",
        "element": ".nc-form-section__header",
        "optional": true
      },
      {
        "name": "title",
        "element": ".nc-form-section__title",
        "optional": true
      },
      {
        "name": "description",
        "element": ".nc-form-section__description",
        "optional": true
      },
      {
        "name": "content",
        "element": ".nc-form-section__content",
        "optional": false
      }
    ],
    "convenience": [],
    "domNotes": [
      "Logische Gruppierung innerhalb eines Formulars mit optionalem Titel + Beschreibung.",
      "Root: flex-column, gap via nc-form-gap. Aufeinanderfolgende Sections: margin-top section-gap.",
      "Header: flex-column, Titel (H2/H3) + Beschreibung. margin-bottom spacing-02.",
      "Content: flex-column mit nc-form-gap, enthaelt .nc-form-field Kinder.",
      "Bordered: border-top + padding-top. Erste Section: keine Border.",
      "Compact: reduzierte Abstaende (spacing-03 statt spacing-06).",
      "Trennlinie: .nc-form-divider als eigenstaendiges <hr>-Element."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Variante — default (ohne Trennlinie), bordered (border-top), compact (weniger Abstand)",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-section-default"
        },
        "bordered": {
          "modifier": "nc-form-section--bordered",
          "tokenGroups": [],
          "renderHint": "form-section-bordered"
        },
        "compact": {
          "modifier": "nc-form-section--compact",
          "tokenGroups": [],
          "renderHint": "form-section-compact"
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhalt — fields-only (nur Fields), with-header (Titel + Beschreibung + Fields), with-title (nur Titel + Fields)",
      "values": {
        "fields-only": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "form-section-fields"
        },
        "with-header": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "header": true,
            "title": true,
            "description": true
          },
          "renderHint": "form-section-header"
        },
        "with-title": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "header": true,
            "title": true
          },
          "renderHint": "form-section-title"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName"
      ],
      "note": "<section> oder role='group' mit aria-labelledby auf den Titel. H2/H3 als Heading-Hierarchie je nach Kontext. Beschreibung: aria-describedby optional."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "aria-labelledby"
        ],
        "notes": [
          "Section braucht aria-labelledby auf den Titel fuer Screen Reader."
        ]
      }
    ],
    "copy": {
      "title": {
        "maxChars": 60,
        "note": "Section-Titel: 'Persoenliche Daten', 'Adresse', 'Zahlungsinformationen'."
      },
      "description": {
        "maxChars": 120,
        "note": "Beschreibung: Kurze Erklaerung des Abschnitts."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-form-section"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-form-section-gap",
          "nc-form-gap",
          "nc-form-divider-color"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "komposition": [
    { "art": "enthaelt", "recipe": "form-field" },
    { "art": "enthaelt", "recipe": "form-label" },
    { "art": "enthaelt", "recipe": "input" }
  ],
  "specimens": [
    {
      "id": "default",
      "label": "Default Section",
      "description": "Section mit Titel, Beschreibung und Form-Fields",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "content": [
            "with-header"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-section-default",
        "label": "default"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Titel 4.5:1 gegen Hintergrund. aria-labelledby auf Section."
      }
    },
    {
      "id": "variant-comparison",
      "label": "Variant Comparison",
      "description": "Default, Bordered, Compact",
      "matrix": {
        "axes": {
          "variant": "*",
          "content": [
            "with-title"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Bordered: border-top 3:1 gegen BG. Compact: gleiche A11y, weniger Platz."
      }
    },
    {
      "id": "content-variants",
      "label": "Content Variants",
      "description": "Fields-Only, With Title, With Header",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "content": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "content"
      },
      "render": {
        "label": "{content}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Fields-Only: aria-label statt aria-labelledby. With-Header: Beschreibung optional via aria-describedby."
      }
    },
    {
      "id": "multiple-sections",
      "label": "Multiple Sections",
      "description": "Mehrere Sections nacheinander mit Bordered-Trennlinien",
      "matrix": {
        "axes": {
          "variant": [
            "bordered"
          ],
          "content": [
            "with-header"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-section-multiple",
        "label": "multiple"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Section eigenes aria-labelledby. Heading-Hierarchie konsistent (alle H3 oder alle H2)."
      }
    },
    {
      "id": "with-divider",
      "label": "With Divider",
      "description": "Sections getrennt durch .nc-form-divider <hr>",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "content": [
            "with-header"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-section-divider",
        "label": "divider"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "<hr> ist semantische Trennung. Screen Reader kuendigt 'Horizontale Linie' an."
      }
    },
    {
      "id": "compact-form",
      "label": "Compact Form",
      "description": "Kompakte Sections fuer platzbeschraenkte Formulare",
      "matrix": {
        "axes": {
          "variant": [
            "compact"
          ],
          "content": [
            "with-title"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "form-section-compact",
        "label": "compact"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Kompaktere Abstaende aendern nichts an Zugaenglichkeit."
      }
    }
  ]
}
