{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "item",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["display", "content", "list"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/item-docs" }
  },
  "anatomy": {
    "root": { "element": ".nc-item" },
    "slots": [
      { "name": "media", "element": ".nc-item__media", "optional": true },
      { "name": "content", "element": ".nc-item__content", "optional": false },
      { "name": "title", "element": ".nc-item__title", "optional": false },
      { "name": "description", "element": ".nc-item__description", "optional": true },
      { "name": "meta", "element": ".nc-item__meta", "optional": true },
      { "name": "action", "element": ".nc-item__action", "optional": true }
    ],
    "convenience": [],
    "domNotes": [
      "Flex-Layout: align-items center, gap spacing-03, padding spacing-03.",
      "Variant outline: border 1px border-primary, radius-sm. Variant muted: background-secondary, radius-sm.",
      "Size sm: padding-02, gap-02. Size xs: padding-01, gap-02, fs-sm.",
      "Media icon/image/avatar: unterschiedliche Groessen und border-radius.",
      "Interactive (.is-interactive): hover bg-secondary, cursor pointer. Gruppen mit nc-item-group."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default, outline, muted",
      "values": {
        "default": { "modifier": null,           "tokenGroups": [], "renderHint": "item-default" },
        "outline": { "modifier": "nc-item--outline", "tokenGroups": [], "renderHint": "item-outline" },
        "muted":   { "modifier": "nc-item--muted",   "tokenGroups": [], "renderHint": "item-muted" }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groesse — default, sm, xs",
      "values": {
        "default": { "modifier": null,         "tokenGroups": [], "renderHint": "item-size-default" },
        "sm":      { "modifier": "nc-item--sm", "tokenGroups": [], "renderHint": "item-size-sm" },
        "xs":      { "modifier": "nc-item--xs", "tokenGroups": [], "renderHint": "item-size-xs" }
      }
    },
    "media": {
      "label": "Media",
      "description": "Media-Typ — default (kein), icon, image, avatar",
      "values": {
        "default": { "modifier": null,                  "tokenGroups": [], "renderHint": "item-media-none" },
        "icon":    { "modifier": "nc-item--media-icon",  "tokenGroups": [], "renderHint": "item-media-icon" },
        "image":   { "modifier": "nc-item--media-image", "tokenGroups": [], "renderHint": "item-media-image" },
        "avatar":  { "modifier": "nc-item--media-avatar","tokenGroups": [], "renderHint": "item-media-avatar" }
      }
    }
  },
  "states": {
    "supported": ["default", "hover", "active", "disabled"],
    "precedence": ["disabled", "active", "hover", "default"],
    "rules": [
      { "state": "hover",    "condition": "Nur bei .is-interactive" },
      { "state": "active",   "condition": "Nur bei .is-interactive" },
      { "state": "disabled", "condition": ".is-disabled oder [aria-disabled=true]" }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Interactive Items: role button/link, keyboard-navigierbar. Disabled: aria-disabled. Gruppen: role=list."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["nc-item"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses", "axes.variant.values.*.modifier", "axes.size.values.*.modifier", "axes.media.values.*.modifier"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison", "label": "Variants",
      "description": "Default, Outline, Muted",
      "matrix": { "axes": { "variant": "*", "size": ["default"], "media": ["default"] }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "variant" }, "render": { "label": "{variant}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Outline: border-Kontrast 3:1." }
    },
    {
      "id": "size-comparison", "label": "Sizes",
      "description": "Default, SM, XS",
      "matrix": { "axes": { "variant": ["default"], "size": "*", "media": ["default"] }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "size" }, "render": { "label": "{size}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "XS: fs-sm muss noch 4.5:1 erfuellen." }
    },
    {
      "id": "media-comparison", "label": "Media Types",
      "description": "Ohne, Icon, Image, Avatar",
      "matrix": { "axes": { "variant": ["default"], "size": ["default"], "media": "*" }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "media" }, "render": { "label": "{media}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Media dekorativ: aria-hidden." }
    },
    {
      "id": "interactive-states", "label": "Interactive States",
      "description": "Hover, Active, Disabled",
      "matrix": { "axes": { "variant": ["default"], "size": ["default"], "media": ["icon"] }, "states": ["default", "hover", "active", "disabled"] },
      "layout": "grid", "render": { "label": "{state}" },
      "a11y": { "contrastTarget": "WCAG AA normal text (4.5:1)", "note": "Disabled: opacity + aria-disabled." }
    }
  ]
}
