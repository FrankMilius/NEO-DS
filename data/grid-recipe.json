{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "grid",
    "version": "3.0.0",
    "status": "stable",
    "tags": [
      "layout",
      "object",
      "grid"
    ],
    "links": {
      "docs": "/docs/grid-docs.html"
    },
    "changelog": [
      {
        "version": "3.0.0",
        "changes": [
          "Modifier gebaut (Entscheidung 06.10.2026, layout-grid-modifier): o-grid--flow-col (grid-auto-flow: column), o-grid--dense (grid-auto-flow: row dense), o-grid--mobile-1/2/6 (Spaltenzahl unter 768px ueber --nc-grid-mobile-columns; zu breite Spannen laufen ueber die volle Breite, bei 6 Spalten behalten Spannen 5 und 6 ihre Breite). Neue Klassen, bestehende Regeln unveraendert.",
          "Achse subgrid (o-grid--subgrid, --subgrid-rows, --subgrid-both) und Specimen subgrid-modes gestrichen (Entscheidung 06.10.2026) — nie gebaut. Breaking fuer Recipe-Leser, die die Achse erwarten."
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [],
      "story": "stories/organisms/grid.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/grid-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".o-grid"
    },
    "slots": [
      {
        "name": "column",
        "element": ".o-col-*",
        "optional": false,
        "description": "Grid-Spalte mit konfigurierter Breite (1-12)."
      }
    ],
    "domNotes": [
      "12-Spalten-Grid basierend auf CSS Grid.",
      "Gap skaliert fluid von 12px (Mobile) bis 24px (Desktop).",
      "Mobile-Spalten konfigurierbar: Standard 4, alternativ 1, 2 oder 6 Spalten (o-grid--mobile-*, setzt --nc-grid-mobile-columns).",
      "Responsive Spans ueber .o-col-sm-* (Tablet) und .o-col-lg-* (Desktop).",
      "Flow-Achse steuert grid-auto-flow: row (Standard), column oder dense.",
      "Grid-Overlay kann im Konfigurator persistiert werden fuer visuelles Debugging."
    ]
  },
  "axes": {
    "gap": {
      "label": "Gap",
      "description": "Abstand zwischen Grid-Spalten.",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Standard-Gap: fluid clamp(12px, 1.5vw, 24px)."
        },
        "sm": {
          "modifier": "o-grid--gap-sm",
          "tokenGroups": [
            "geometry",
            "gap-variants"
          ],
          "description": "Kleiner Gap: var(--fnd-spacing-04) = 16px."
        },
        "lg": {
          "modifier": "o-grid--gap-lg",
          "tokenGroups": [
            "geometry",
            "gap-variants"
          ],
          "description": "Grosser Gap: var(--fnd-spacing-08) = 32px."
        }
      }
    },
    "layout": {
      "label": "Layout-Modus",
      "description": "Grid-Template-Strategie.",
      "values": {
        "fixed": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Festes 12-Spalten-Grid mit expliziten Spans."
        },
        "auto-fit": {
          "modifier": "o-grid--auto-fit",
          "tokenGroups": [],
          "description": "Content-driven Spalten via auto-fit. Keine Breakpoints noetig."
        }
      }
    },
    "alignment": {
      "label": "Alignment",
      "description": "Vertikale Ausrichtung der Grid-Items.",
      "values": {
        "start": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Items am oberen Rand ausgerichtet (Standard)."
        },
        "center": {
          "modifier": "o-grid--center",
          "tokenGroups": [],
          "description": "Items vertikal zentriert."
        },
        "end": {
          "modifier": "o-grid--end",
          "tokenGroups": [],
          "description": "Items am unteren Rand ausgerichtet."
        }
      }
    },
    "flow": {
      "label": "Flow",
      "description": "Automatische Platzierung von Items im Grid.",
      "values": {
        "row": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Standard-Fluss nach Zeilen (grid-auto-flow: row)."
        },
        "column": {
          "modifier": "o-grid--flow-col",
          "tokenGroups": [],
          "description": "Fluss nach Spalten (grid-auto-flow: column). Items fuellen Spalten zuerst — sichtbar, wenn die Seite Zeilen vorgibt (grid-template-rows); sonst entstehen implizite Spalten."
        },
        "dense": {
          "modifier": "o-grid--dense",
          "tokenGroups": [],
          "description": "Fuellt Luecken im Grid nach Zeilen auf (grid-auto-flow: row dense). Ideal fuer Masonry-aehnliche Layouts; visuelle Reihenfolge kann von der DOM-Reihenfolge abweichen."
        }
      }
    },
    "mobile-columns": {
      "label": "Mobile Spalten",
      "description": "Spaltenanzahl auf Mobile-Viewports (< 768px). Standard: 4 Spalten.",
      "values": {
        "1": {
          "modifier": "o-grid--mobile-1",
          "tokenGroups": [
            "responsive"
          ],
          "description": "1 Spalte auf Mobile (< 768px). Full-width Stacking aller Items."
        },
        "2": {
          "modifier": "o-grid--mobile-2",
          "tokenGroups": [
            "responsive"
          ],
          "description": "2 Spalten auf Mobile (< 768px). Spannen > 2 laufen ueber die volle Breite. Ideal fuer einfache Listen-Layouts."
        },
        "4": {
          "modifier": null,
          "tokenGroups": [
            "responsive"
          ],
          "description": "4 Spalten auf Mobile (Standard). Spans > 4 werden full-width."
        },
        "6": {
          "modifier": "o-grid--mobile-6",
          "tokenGroups": [
            "responsive"
          ],
          "description": "6 Spalten auf Mobile (< 768px). Spannen 5 und 6 behalten ihre Breite, groessere laufen ueber die volle Breite. Fuer dichte Dashboard-UIs."
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "interactive": false,
    "rules": []
  },
  "a11y": {
    "base": {
      "interactive": false,
      "assertions": [
        "Grid ist ein visuelles Layout-Werkzeug — DOM-Reihenfolge muss logisch bleiben.",
        "Spalten-Umordnung per CSS (order) nur wenn Lesereihenfolge identisch bleibt.",
        "Dense-Modus kann visuelle Reihenfolge von DOM-Reihenfolge abweichen — fuer Screen Reader problematisch."
      ]
    },
    "overrides": []
  },
  "styling": {
    "baseClasses": [
      "o-grid"
    ],
    "baseTokenGroups": [
      "geometry"
    ],
    "tokenGroups": {
      "geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-grid-columns",
          "nc-grid-gap",
          "nc-grid-gap-sm",
          "nc-grid-gap-lg"
        ]
      },
      "gap-variants": {
        "label": "Gap-Varianten",
        "tokens": [
          "nc-grid-gap-sm",
          "nc-grid-gap-lg"
        ]
      },
      "responsive": {
        "label": "Responsive",
        "tokens": [
          "nc-grid-mobile-columns",
          "nc-grid-tablet-columns"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes"
      ],
      "output": [
        "classList",
        "tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "gap-variants",
      "label": "Gap-Varianten",
      "description": "Alle Gap-Groessen im Vergleich.",
      "matrix": {
        "axes": {
          "gap": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "layout-modes",
      "label": "Layout-Modi",
      "description": "Fixed vs. Auto-fit Grid.",
      "matrix": {
        "axes": {
          "layout": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "flow-variants",
      "label": "Flow-Varianten",
      "description": "Platzierungsverhalten: row, column, dense.",
      "matrix": {
        "axes": {
          "flow": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "alignment",
      "label": "Alignment",
      "description": "Vertikale Ausrichtungs-Varianten.",
      "matrix": {
        "axes": {
          "alignment": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "mobile-breakpoints",
      "label": "Mobile Spalten",
      "description": "Spaltenraster auf Mobile-Viewports.",
      "matrix": {
        "axes": {
          "mobile-columns": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "responsive-matrix",
      "label": "Responsive Matrix",
      "description": "Grid-Verhalten ueber alle Breakpoints: Mobile, Tablet, Desktop.",
      "matrix": {
        "axes": {
          "mobile-columns": "*",
          "gap": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "mobile-columns",
        "colAxis": "gap"
      }
    }
  ]
}
