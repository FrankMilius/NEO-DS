{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "grid",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "layout",
      "object",
      "grid"
    ],
    "links": {
      "docs": "/docs/grid-docs.html"
    },
    "layer": "organism",
    "pipeline": {
      "scss": [],
      "story": "stories/organisms/grid.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/GridArena.vue",
      "drupal": [],
      "docs": "docs/grid-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".o-grid"
    },
    "slots": [
      {
        "name": "column",
        "element": ".o-col-*",
        "optional": false,
        "description": "Grid-Spalte mit konfigurierter Breite (1-12)."
      }
    ],
    "domNotes": [
      "12-Spalten-Grid basierend auf CSS Grid.",
      "Gap skaliert fluid von 12px (Mobile) bis 24px (Desktop).",
      "Mobile-Spalten konfigurierbar: Standard 4, alternativ 2 oder 6 Spalten.",
      "Responsive Spans ueber .o-col-sm-* (Tablet) und .o-col-lg-* (Desktop).",
      "Flow-Achse steuert grid-auto-flow: row (Standard), column oder dense.",
      "Subgrid erlaubt verschachtelte Grids die das Eltern-Raster uebernehmen (z.B. fuer Header-Alignment in Cards).",
      "Grid-Overlay kann im Konfigurator persistiert werden fuer visuelles Debugging."
    ]
  },
  "axes": {
    "gap": {
      "label": "Gap",
      "description": "Abstand zwischen Grid-Spalten.",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Standard-Gap: fluid clamp(12px, 1.5vw, 24px)."
        },
        "sm": {
          "modifier": "o-grid--gap-sm",
          "tokenGroups": [
            "geometry",
            "gap-variants"
          ],
          "description": "Kleiner Gap: var(--fnd-spacing-04) = 16px."
        },
        "lg": {
          "modifier": "o-grid--gap-lg",
          "tokenGroups": [
            "geometry",
            "gap-variants"
          ],
          "description": "Grosser Gap: var(--fnd-spacing-08) = 32px."
        }
      }
    },
    "layout": {
      "label": "Layout-Modus",
      "description": "Grid-Template-Strategie.",
      "values": {
        "fixed": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Festes 12-Spalten-Grid mit expliziten Spans."
        },
        "auto-fit": {
          "modifier": "o-grid--auto-fit",
          "tokenGroups": [],
          "description": "Content-driven Spalten via auto-fit. Keine Breakpoints noetig."
        }
      }
    },
    "alignment": {
      "label": "Alignment",
      "description": "Vertikale Ausrichtung der Grid-Items.",
      "values": {
        "start": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Items am oberen Rand ausgerichtet (Standard)."
        },
        "center": {
          "modifier": "o-grid--center",
          "tokenGroups": [],
          "description": "Items vertikal zentriert."
        },
        "end": {
          "modifier": "o-grid--end",
          "tokenGroups": [],
          "description": "Items am unteren Rand ausgerichtet."
        }
      }
    },
    "flow": {
      "label": "Flow",
      "description": "Automatische Platzierung von Items im Grid.",
      "values": {
        "row": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Standard-Fluss nach Zeilen (grid-auto-flow: row)."
        },
        "column": {
          "modifier": "o-grid--flow-col",
          "tokenGroups": [],
          "description": "Fluss nach Spalten (grid-auto-flow: column). Items fuellen Spalten zuerst."
        },
        "dense": {
          "modifier": "o-grid--dense",
          "tokenGroups": [],
          "description": "Fuellt Luecken im Grid optimal aus (grid-auto-flow: dense). Ideal fuer Masonry-aehnliche Layouts."
        }
      }
    },
    "mobile-columns": {
      "label": "Mobile Spalten",
      "description": "Spaltenanzahl auf Mobile-Viewports (< 768px). Standard: 4 Spalten.",
      "values": {
        "1": {
          "modifier": "o-grid--mobile-1",
          "tokenGroups": [
            "responsive"
          ],
          "description": "1 Spalte auf Mobile. Full-width Stacking aller Items."
        },
        "2": {
          "modifier": "o-grid--mobile-2",
          "tokenGroups": [
            "responsive"
          ],
          "description": "2 Spalten auf Mobile. Ideal fuer einfache Listen-Layouts."
        },
        "4": {
          "modifier": null,
          "tokenGroups": [
            "responsive"
          ],
          "description": "4 Spalten auf Mobile (Standard). Spans > 4 werden full-width."
        },
        "6": {
          "modifier": "o-grid--mobile-6",
          "tokenGroups": [
            "responsive"
          ],
          "description": "6 Spalten auf Mobile. Fuer dichte Dashboard-UIs mit kleinen Widgets."
        }
      }
    },
    "subgrid": {
      "label": "Subgrid",
      "description": "Verschachteltes Grid das das Spaltenraster des Eltern-Grids uebernimmt.",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [],
          "description": "Kein Subgrid (Standard). Verschachtelte Grids sind unabhaengig."
        },
        "columns": {
          "modifier": "o-grid--subgrid",
          "tokenGroups": [],
          "description": "Subgrid auf Spaltenachse. Kind-Grid erbt grid-template-columns vom Eltern."
        },
        "rows": {
          "modifier": "o-grid--subgrid-rows",
          "tokenGroups": [],
          "description": "Subgrid auf Zeilenachse. Ermoeglicht Header-Alignment ueber mehrere Cards."
        },
        "both": {
          "modifier": "o-grid--subgrid-both",
          "tokenGroups": [],
          "description": "Subgrid auf beiden Achsen. Vollstaendige Rasteruebernahme."
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "interactive": false,
    "rules": []
  },
  "a11y": {
    "base": {
      "interactive": false,
      "assertions": [
        "Grid ist ein visuelles Layout-Werkzeug — DOM-Reihenfolge muss logisch bleiben.",
        "Spalten-Umordnung per CSS (order) nur wenn Lesereihenfolge identisch bleibt.",
        "Dense-Modus kann visuelle Reihenfolge von DOM-Reihenfolge abweichen — fuer Screen Reader problematisch.",
        "Subgrid aendert keine Semantik — nur das visuelle Raster wird geteilt."
      ]
    },
    "overrides": []
  },
  "styling": {
    "baseClasses": [
      "o-grid"
    ],
    "baseTokenGroups": [
      "geometry"
    ],
    "tokenGroups": {
      "geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-grid-columns",
          "nc-grid-gap",
          "nc-grid-gap-sm",
          "nc-grid-gap-lg"
        ]
      },
      "gap-variants": {
        "label": "Gap-Varianten",
        "tokens": [
          "nc-grid-gap-sm",
          "nc-grid-gap-lg"
        ]
      },
      "responsive": {
        "label": "Responsive",
        "tokens": [
          "nc-grid-mobile-columns",
          "nc-grid-tablet-columns"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes"
      ],
      "output": [
        "classList",
        "tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "gap-variants",
      "label": "Gap-Varianten",
      "description": "Alle Gap-Groessen im Vergleich.",
      "matrix": {
        "axes": {
          "gap": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "layout-modes",
      "label": "Layout-Modi",
      "description": "Fixed vs. Auto-fit Grid.",
      "matrix": {
        "axes": {
          "layout": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "flow-variants",
      "label": "Flow-Varianten",
      "description": "Platzierungsverhalten: row, column, dense.",
      "matrix": {
        "axes": {
          "flow": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "alignment",
      "label": "Alignment",
      "description": "Vertikale Ausrichtungs-Varianten.",
      "matrix": {
        "axes": {
          "alignment": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "mobile-breakpoints",
      "label": "Mobile Spalten",
      "description": "Spaltenraster auf Mobile-Viewports.",
      "matrix": {
        "axes": {
          "mobile-columns": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "subgrid-modes",
      "label": "Subgrid",
      "description": "Verschachteltes Raster mit Eltern-Uebernahme.",
      "matrix": {
        "axes": {
          "subgrid": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "responsive-matrix",
      "label": "Responsive Matrix",
      "description": "Grid-Verhalten ueber alle Breakpoints: Mobile, Tablet, Desktop.",
      "matrix": {
        "axes": {
          "mobile-columns": "*",
          "gap": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "mobile-columns",
        "colAxis": "gap"
      }
    }
  ]
}
