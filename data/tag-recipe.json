{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "tag",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "label",
      "feedback"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/tag-docs"
    },
    "layer": "atom",
    "pipeline": {
      "scss": [
        "scss/scss/05-atoms/_tag.scss"
      ],
      "story": "stories/atoms/tag.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/tag-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-tag"
    },
    "slots": [
      {
        "name": "icon",
        "element": ".nc-tag__icon",
        "optional": true
      },
      {
        "name": "label",
        "element": ".nc-tag__label",
        "optional": true
      },
      {
        "name": "remove",
        "element": ".nc-tag__remove",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Statischer Tag: <span class='nc-tag'>. Nicht fokussierbar, kein interaktives Element.",
      "Navigations-Tag: <a href='...' class='nc-tag nc-tag--interactive'>. Immer mit --interactive Modifier.",
      "Entfernbarer Tag: <span class='nc-tag nc-tag--removable'> mit <button class='nc-tag__remove'> als Kind.",
      "Remove-Button ist ein eigenstaendiger <button> mit aria-label (z.B. 'Tag entfernen').",
      "7 Farbvarianten: default, outline, primary, success, warning, error, info.",
      "Pill-Shape via --fnd-radius-full (border-radius: 9999px).",
      "Deprecated: --destructive und --danger sind Aliase fuer --error.",
      "Interactive: Hover-BG, Active-Scale(0.98), focus-ring. Disabled: opacity + cursor:not-allowed."
    ]
  },
  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (24px) / md (32px, Standard) / lg (40px). Versetzt zum Button-Scale.",
      "values": {
        "sm": {
          "modifier": "nc-tag--sm",
          "tokenGroups": []
        },
        "md": {
          "modifier": null,
          "tokenGroups": []
        },
        "lg": {
          "modifier": "nc-tag--lg",
          "tokenGroups": []
        }
      }
    },
    "variant": {
      "label": "Variant",
      "description": "Farbvariante — default (filled neutral), outline (transparent + Border), primary (interactive-BG), success, warning, error, info",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "variant-default"
          ]
        },
        "outline": {
          "modifier": "nc-tag--outline",
          "tokenGroups": [
            "variant-outline"
          ]
        },
        "primary": {
          "modifier": "nc-tag--primary",
          "tokenGroups": [
            "variant-primary"
          ]
        },
        "success": {
          "modifier": "nc-tag--success",
          "tokenGroups": [
            "variant-success"
          ]
        },
        "warning": {
          "modifier": "nc-tag--warning",
          "tokenGroups": [
            "variant-warning"
          ]
        },
        "error": {
          "modifier": "nc-tag--error",
          "tokenGroups": [
            "variant-error"
          ]
        },
        "info": {
          "modifier": "nc-tag--info",
          "tokenGroups": [
            "variant-info"
          ]
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Inhalt — text (nur Label), icon-text (Icon + Label), removable (Label + Dismiss-Button)",
      "values": {
        "text": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "tag-text"
        },
        "icon-text": {
          "modifier": null,
          "tokenGroups": [],
          "slotConfig": {
            "icon": true
          },
          "renderHint": "tag-icon-text"
        },
        "removable": {
          "modifier": "nc-tag--removable",
          "tokenGroups": [
            "elements"
          ],
          "slotConfig": {
            "remove": true
          },
          "renderHint": "tag-removable"
        }
      }
    },
    "interactive": {
      "label": "Interactive",
      "description": "Interaktivitaet — static (Standard, nicht klickbar), interactive (Hover/Active/Focus mit Shadow fuer Links/Buttons)",
      "values": {
        "static": {
          "modifier": null,
          "tokenGroups": []
        },
        "interactive": {
          "modifier": "nc-tag--interactive",
          "tokenGroups": [
            "animation",
            "interactive-shadow"
          ]
        }
      }
    },
    "selected": {
      "label": "Selected",
      "description": "Toggle-State fuer Filter-Chips — false (Standard), true (aktiv, aria-pressed)",
      "values": {
        "false": {
          "modifier": null,
          "tokenGroups": []
        },
        "true": {
          "modifier": "nc-tag--selected",
          "tokenGroups": [
            "state-selected"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "active",
      "disabled",
      "focus"
    ],
    "precedence": [
      "disabled",
      "focus",
      "active",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "disabled"
        ],
        "note": "Hover nur auf interactive Tags"
      },
      {
        "state": "active",
        "unless": [
          "disabled"
        ],
        "note": "Active: scale(0.98) auf interactive Tags"
      },
      {
        "state": "focus",
        "unless": [
          "disabled"
        ],
        "note": "Focus-Ring via :focus-visible"
      },
      {
        "state": "disabled",
        "unless": [],
        "note": "Nur auf interactive Tags anwendbar"
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [],
      "note": "Statischer Tag ist ein <span> — nicht fokussierbar. Farbe nie alleiniges Signal (R7). Text-Kontrast 4.5:1 gegen Tag-BG."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "interactive": [
              "interactive"
            ]
          }
        },
        "require": [
          "hasAccessibleName",
          "supportsKeyboard"
        ],
        "note": "Interactive Tags (<a> oder <button>) muessen fokussierbar und per Tastatur bedienbar sein."
      },
      {
        "when": {
          "axes": {
            "content": [
              "removable"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "note": "Remove-Button braucht aria-label (z.B. 'Tag-Name entfernen'). Ist ein eigenstaendiges <button>-Element."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' auf dem Tag-Element. pointer-events: none verhindert Klick."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {
          "axes": {
            "interactive": [
              "interactive"
            ]
          }
        },
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Interactive Tags brauchen zugaenglichen Namen."
        ]
      },
      {
        "when": {
          "axes": {
            "content": [
              "removable"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "notes": [
          "Remove-Button braucht aria-label."
        ]
      }
    ],
    "copy": {
      "label": {
        "maxChars": 30,
        "note": "Tag-Labels sollen kurz und praegnant sein."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-tag"
    ],
    "baseTokenGroups": [
      "core-geometry",
      "core-typography"
    ],
    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-tag-height-sm",
          "nc-tag-height-md",
          "nc-tag-height-lg",
          "nc-tag-padding-x",
          "nc-tag-padding-y",
          "nc-tag-radius",
          "nc-tag-gap"
        ]
      },
      "core-typography": {
        "label": "Typography",
        "tokens": [
          "nc-tag-font-size",
          "nc-tag-font-size-sm",
          "nc-tag-font-size-lg",
          "nc-tag-font-weight"
        ]
      },
      "variant-default": {
        "label": "Default Colors",
        "tokens": [
          "nc-tag-default-bg",
          "nc-tag-default-color",
          "nc-tag-default-border",
          "nc-tag-default-bg-hover"
        ]
      },
      "variant-outline": {
        "label": "Outline Colors",
        "tokens": [
          "nc-tag-outline-bg",
          "nc-tag-outline-color",
          "nc-tag-outline-border",
          "nc-tag-outline-bg-hover"
        ]
      },
      "variant-primary": {
        "label": "Primary Colors",
        "tokens": [
          "nc-tag-primary-bg",
          "nc-tag-primary-color",
          "nc-tag-primary-border",
          "nc-tag-primary-bg-hover"
        ]
      },
      "variant-success": {
        "label": "Success Colors",
        "tokens": [
          "nc-tag-success-bg",
          "nc-tag-success-color",
          "nc-tag-success-border",
          "nc-tag-success-bg-hover"
        ]
      },
      "variant-warning": {
        "label": "Warning Colors",
        "tokens": [
          "nc-tag-warning-bg",
          "nc-tag-warning-color",
          "nc-tag-warning-border",
          "nc-tag-warning-bg-hover"
        ]
      },
      "variant-error": {
        "label": "Error Colors",
        "tokens": [
          "nc-tag-error-bg",
          "nc-tag-error-color",
          "nc-tag-error-border",
          "nc-tag-error-bg-hover"
        ]
      },
      "variant-info": {
        "label": "Info Colors",
        "tokens": [
          "nc-tag-info-bg",
          "nc-tag-info-color",
          "nc-tag-info-border",
          "nc-tag-info-bg-hover"
        ]
      },
      "elements": {
        "label": "Elements",
        "tokens": [
          "nc-tag-remove-size",
          "nc-tag-remove-hover-bg",
          "nc-tag-icon-size"
        ]
      },
      "state-disabled": {
        "label": "Disabled",
        "tokens": [
          "nc-tag-disabled-bg",
          "nc-tag-disabled-color",
          "nc-tag-disabled-border",
          "nc-tag-opacity-disabled"
        ]
      },
      "animation": {
        "label": "Animation",
        "tokens": [
          "nc-tag-transition-duration"
        ]
      },
      "interactive-shadow": {
        "label": "Interactive Shadow",
        "tokens": [
          "nc-tag-interactive-shadow-hover"
        ]
      },
      "state-selected": {
        "label": "Selected State",
        "tokens": [
          "nc-tag-selected-bg",
          "nc-tag-selected-color",
          "nc-tag-selected-border",
          "nc-tag-selected-bg-hover"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.content.values.*.modifier",
        "axes.interactive.values.*.modifier",
        "axes.selected.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "all-variants",
      "label": "All Variants — MD",
      "description": "Alle 7 Farbvarianten in Default-Groesse",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": "*",
          "content": [
            "text"
          ],
          "interactive": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Jede Variante muss 4.5:1 Text-Kontrast gegen ihren BG haben. Farbe nie als einziges Signal."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": {
          "size": "*",
          "variant": [
            "default"
          ],
          "content": [
            "text"
          ],
          "interactive": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "core-geometry",
        "core-typography"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hoehe folgt Button-Scale versetzt (24/32/40px). Pill-Radius bleibt konstant."
      }
    },
    {
      "id": "interactive-states",
      "label": "Interactive States",
      "description": "Interactive Tag in allen Zustaenden",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": [
            "default"
          ],
          "content": [
            "text"
          ],
          "interactive": [
            "interactive"
          ]
        },
        "states": [
          "default",
          "hover",
          "active",
          "disabled",
          "focus"
        ]
      },
      "focusTokenGroups": [
        "state-disabled",
        "animation"
      ],
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring. Disabled hat reduzierte Opacity."
      }
    },
    {
      "id": "content-types",
      "label": "Content Types",
      "description": "Text-only vs Icon+Text vs Removable",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": [
            "default"
          ],
          "content": "*",
          "interactive": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "elements"
      ],
      "layout": "row",
      "render": {
        "label": "{content}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Removable: Remove-Button braucht aria-label. Icon-Size (14px) muss erkennbar bleiben."
      }
    },
    {
      "id": "variants-interactive",
      "label": "Variants × Interactive Hover",
      "description": "Alle Varianten als Interactive mit Hover-State",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": "*",
          "content": [
            "text"
          ],
          "interactive": [
            "interactive"
          ]
        },
        "states": [
          "default",
          "hover"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Hover-BG muss sich vom Default-BG unterscheiden. Primary-Hover nutzt interactive-hover (dunkleres Blau)."
      }
    },
    {
      "id": "removable-variants",
      "label": "Removable × Variants",
      "description": "Entfernbare Tags in verschiedenen Varianten",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": [
            "default",
            "outline",
            "primary",
            "error"
          ],
          "content": [
            "removable"
          ],
          "interactive": [
            "static"
          ]
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "elements"
      ],
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Remove-Button erbt currentColor. Hover-BG via color-mix(currentColor 15%, transparent). Jeder Remove-Button braucht aria-label."
      }
    },
    {
      "id": "selectable-filter",
      "label": "Selectable Tags (Filter-Chips)",
      "description": "Toggle-Tags mit Selected-State — aria-pressed fuer Filter-Muster",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": [
            "default",
            "primary",
            "success"
          ],
          "content": [
            "text"
          ],
          "interactive": [
            "interactive"
          ],
          "selected": "*"
        },
        "states": [
          "default"
        ]
      },
      "focusTokenGroups": [
        "state-selected"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant",
        "colAxis": "selected"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Selectable Tags muessen aria-pressed='true'/'false' setzen. Selected-State muss visuell klar unterscheidbar sein."
      }
    },
    {
      "id": "interactive-shadow",
      "label": "Interactive Shadow Hover",
      "description": "Shadow-Indikator auf interaktiven Tags fuer deutlichere Klickbarkeit",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "variant": [
            "default",
            "outline",
            "primary"
          ],
          "content": [
            "text"
          ],
          "interactive": [
            "interactive"
          ]
        },
        "states": [
          "default",
          "hover"
        ]
      },
      "focusTokenGroups": [
        "interactive-shadow",
        "animation"
      ],
      "layout": "row",
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Shadow-Hover verstaerkt die visuelle Klickbarkeit bei Navigations-Tags."
      }
    }
  ]
}
