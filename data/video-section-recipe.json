    "changelog": [
      {
        "version": "1.2.0",
        "changes": [
          "Titel und Text (.nc-video__title, .nc-video__text) in text-primary (Entscheidung 06.10.2026): folgen dem Farbkontext — auf heller Flaeche dunkel, auf dunkler Flaeche (dunkles Theme am Block) hell; vorher always-light (Weiss auf Hell)"
        ]
      },
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Zustand playing im Specimen default; Specimens auf-dunkel (render.flaeche dunkel — wie Drupal mit neo-dark-theme am Block) und video-element (<video poster>); Rahmen ra-desktop",
          "Befund (Entscheidungsfall, website-sichtbar): .nc-video__title und __text sind always-light — auf heller Flaeche Weiss auf Hell",
          "pipeline.arena zeigt auf die RecipeArena"
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-video"
    },
    "slots": [
      {
        "name": "media",
        "element": ".nc-video__media",
        "optional": false
      },
      {
        "name": "content",
        "element": ".nc-video__content",
        "optional": false
      },
      {
        "name": "title",
        "element": ".nc-video__title",
        "optional": true
      },
      {
        "name": "text",
        "element": ".nc-video__text",
        "optional": true
      },
      {
        "name": "overlay",
        "element": ".nc-video__overlay",
        "optional": true
      },
      {
        "name": "overlay-icon",
        "element": ".nc-video__overlay-icon",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "2-Spalten Grid: media + content, gap 4rem. Single-Column unter 900px.",
      "Media: 16:9 aspect-ratio, always-dark BG, radius-sm, overflow hidden.",
      "Play-Overlay: Gradient-Overlay, 72×72 runder Button mit Play-Triangle.",
      "is-playing: Overlay ausblenden (opacity 0, pointer-events none).",
      "Titel und Text: text-primary — die Farbe kommt aus dem Farbkontext (helle oder dunkle Flaeche), nicht fest always-light (Entscheidung 06.10.2026)."
    ]
  },
