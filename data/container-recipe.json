{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "container",
    "version": "2.1.1",
    "status": "stable",
    "tags": [
      "layout",
      "object",
      "container"
    ],
    "links": {
      "docs": "/docs/layout-architecture-docs.html"
    },
    "changelog": [
      {
        "version": "2.1.1",
        "changes": [
          "06.10.2026 (Entscheidung container-breiten, \"Wide breiter als Standard\"): --nc-container-max-width-wide 1600px statt --container-wide (1290px) — Wide war schmaler als der Standard (--container-xwide, 1536px). Beschreibungen nannten noch 1200/1440px. --container-xwide unveraendert (Shell-Breite Navigation Tab-Mega). Freigabe ausstehend."
        ]
      },
      {
        "version": "2.1.0",
        "changes": [
          "Modifier gebaut (Entscheidung 06.10.2026, layout-container-modifier): --vspace-sm/md/lg (padding-block aus --nc-container-padding-block-*), --align-start/--align-end (ueber --nc-container-margin-start/-end, wirksam ab lg), --surface (Hintergrund, Radius, Schatten, Polsterung aus --nc-container-surface-*; ab xxl eigene Inline-Polsterung). Neue Klassen, bestehende Regeln unveraendert."
        ]
      }
    ],
    "layer": "organism",
    "pipeline": {
      "scss": [],
      "story": "stories/organisms/container.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/container-docs.html"
    },
    "dependencies": [
      "hero"
    ]
  },
  "anatomy": {
    "root": {
      "element": ".nc-container"
    },
    "slots": [
      {
        "name": "content",
        "element": ".nc-container > *",
        "optional": false,
        "description": "Beliebiger Inhalt innerhalb des Containers."
      }
    ],
    "domNotes": [
      "Container zentriert Inhalt horizontal und begrenzt die maximale Breite.",
      "Fluid Padding Inline skaliert von 16px (320px Viewport) bis 48px (1600px) via clamp().",
      "Ab XXL (1920px) entfaellt das Inline-Padding, stattdessen greift max-width.",
      "Full-bleed Kinder (z.B. .nc-hero) brechen per negativem Margin aus dem Container aus.",
      "Vertical Spacing (padding-block) definiert den Abstand zur umgebenden Section/Shell.",
      "Alignment steuert die horizontale Ausrichtung (zentriert, links, rechts).",
      "Surface-Variante erlaubt Hintergrundfarbe und Schatten auf Layout-Ebene.",
      "Vertical Spacing und Surface setzen padding-block; ein --vspace-* gewinnt gegen die Polsterung von --surface (steht spaeter im CSS)."
    ]
  },
  "axes": {
    "width": {
      "label": "Breite",
      "description": "Maximale Breite des Containers ab XXL-Breakpoint.",
      "values": {
        "standard": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Standard-Container: max-width 1536px (--container-xwide, wie Navigation und Footer)."
        },
        "wide": {
          "modifier": "nc-container--wide",
          "tokenGroups": [
            "geometry",
            "wide"
          ],
          "description": "Breiter Container: max-width 1600px — breiter als der Standard (1536px)."
        },
        "narrow": {
          "modifier": "nc-container--narrow",
          "tokenGroups": [
            "geometry"
          ],
          "description": "Schmaler Container: max-width 768px. Ideal fuer Formulare."
        },
        "full": {
          "modifier": "nc-container--full",
          "tokenGroups": [
            "geometry"
          ],
          "description": "Volle Breite ohne max-width Begrenzung."
        }
      }
    },
    "vertical-spacing": {
      "label": "Vertical Spacing",
      "description": "Vertikales Padding (padding-block) fuer den Abstand zur umgebenden Section oder Shell.",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Kein vertikales Padding (Standard)."
        },
        "sm": {
          "modifier": "nc-container--vspace-sm",
          "tokenGroups": [
            "geometry",
            "vertical-spacing"
          ],
          "description": "Kleiner vertikaler Abstand: 16px – 24px (fluid, --nc-container-padding-block-sm)."
        },
        "md": {
          "modifier": "nc-container--vspace-md",
          "tokenGroups": [
            "geometry",
            "vertical-spacing"
          ],
          "description": "Mittlerer vertikaler Abstand: 32px – 48px (fluid, --nc-container-padding-block-md)."
        },
        "lg": {
          "modifier": "nc-container--vspace-lg",
          "tokenGroups": [
            "geometry",
            "vertical-spacing"
          ],
          "description": "Grosser vertikaler Abstand: 48px – 80px (fluid, --nc-container-padding-block-lg)."
        }
      }
    },
    "alignment": {
      "label": "Alignment",
      "description": "Horizontale Ausrichtung des Containers innerhalb des Viewports.",
      "values": {
        "center": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Zentriert (Standard): margin-inline: auto."
        },
        "start": {
          "modifier": "nc-container--align-start",
          "tokenGroups": [
            "geometry",
            "alignment"
          ],
          "description": "Linksbuendig: margin-inline-start: 0; margin-inline-end: auto. Wirksam ab lg (dort greift max-width)."
        },
        "end": {
          "modifier": "nc-container--align-end",
          "tokenGroups": [
            "geometry",
            "alignment"
          ],
          "description": "Rechtsbuendig: margin-inline-start: auto; margin-inline-end: 0. Wirksam ab lg (dort greift max-width)."
        }
      }
    },
    "surface": {
      "label": "Surface",
      "description": "Optionale Hintergrund-Surface auf Layout-Ebene (aehnlich Card, aber als Container).",
      "values": {
        "transparent": {
          "modifier": null,
          "tokenGroups": [
            "geometry"
          ],
          "description": "Kein Hintergrund (Standard)."
        },
        "elevated": {
          "modifier": "nc-container--surface",
          "tokenGroups": [
            "geometry",
            "surface"
          ],
          "description": "Surface-Container mit Hintergrundfarbe, Border-Radius, Schatten und Polsterung (--nc-container-surface-*). Ab xxl behaelt er seine Inline-Polsterung."
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "interactive": false,
    "rules": []
  },
  "a11y": {
    "base": {
      "interactive": false,
      "assertions": [
        "Container ist ein reines Layout-Element ohne semantische Rolle.",
        "Inhalt innerhalb des Containers muss eigenstaendig zugaenglich sein.",
        "Surface-Container sollten als <section> oder <article> mit aria-label genutzt werden."
      ]
    },
    "overrides": []
  },
  "styling": {
    "baseClasses": [
      "nc-container"
    ],
    "baseTokenGroups": [
      "geometry"
    ],
    "tokenGroups": {
      "geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-container-max-width",
          "nc-container-padding-inline",
          "nc-container-padding-inline-xxl",
          "nc-container-max-width-wide"
        ]
      },
      "wide": {
        "label": "Wide",
        "tokens": [
          "nc-container-max-width-wide"
        ]
      },
      "vertical-spacing": {
        "label": "Vertical Spacing",
        "tokens": [
          "nc-container-padding-block-sm",
          "nc-container-padding-block-md",
          "nc-container-padding-block-lg"
        ]
      },
      "alignment": {
        "label": "Alignment",
        "tokens": [
          "nc-container-margin-start",
          "nc-container-margin-end"
        ]
      },
      "surface": {
        "label": "Surface",
        "tokens": [
          "nc-container-surface-bg",
          "nc-container-surface-radius",
          "nc-container-surface-shadow",
          "nc-container-surface-padding"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes"
      ],
      "output": [
        "classList",
        "tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "width-scale",
      "label": "Breiten-Varianten",
      "description": "Alle Container-Breiten im Vergleich.",
      "matrix": {
        "axes": {
          "width": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "vertical-spacing-scale",
      "label": "Vertical Spacing",
      "description": "Vertikales Padding in drei Stufen.",
      "matrix": {
        "axes": {
          "vertical-spacing": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "alignment-options",
      "label": "Alignment",
      "description": "Horizontale Ausrichtung: zentriert, links, rechts.",
      "matrix": {
        "axes": {
          "alignment": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    },
    {
      "id": "surface-variants",
      "label": "Surface",
      "description": "Transparenter vs. Surface-Container.",
      "matrix": {
        "axes": {
          "surface": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row"
    }
  ]
}
