{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "app-store",
    "version": "1.0.0",
    "status": "stable",
    "tags": [
      "media",
      "app",
      "app-store"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/app-store-docs"
    },
    "layer": "molecule",
    "pipeline": {
      "scss": [
        "scss/scss/06-molecules/_app-store.scss"
      ]
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-app-store"
    },
    "slots": [
      {
        "name": "badges",
        "element": ".nc-app-store__badges",
        "optional": true,
        "description": "Store-Abzeichen. Ein leeres Adressfeld blendet sein Abzeichen aus — ein toter Verweis ist schlimmer als ein fehlender."
      },
      {
        "name": "qr",
        "element": ".nc-app-store__qr",
        "optional": true,
        "description": "QR-Code. Erst ab md sichtbar: Wer die Seite auf dem Telefon liest, braucht keinen Code, um aufs Telefon zu kommen."
      },
      {
        "name": "note",
        "element": ".nc-app-store__note",
        "optional": true,
        "description": "Kleingedrucktes — Voraussetzungen, Groesse, Sprachen."
      }
    ],
    "domNotes": [
      "Die Abzeichen sind KEINE Nachbauten der Marken von Apple und Google. Beide geben eigene Bilddateien und Gestaltungsvorgaben vor; bis die vorliegen, steht hier eine Schaltflaeche im Systemstil.",
      "Der QR-Code wird als Bild erwartet, nicht im Browser gerechnet — eine QR-Bibliothek waere ein weiteres Skript fuer etwas, das sich einmal erzeugen laesst."
    ]
  },
  "axes": {
    "surface": {
      "label": "Flaeche",
      "values": {
        "light": {
          "modifier": null,
          "tokenGroups": [
            "layout"
          ]
        },
        "dark": {
          "modifier": "nc-app-store--on-dark",
          "tokenGroups": [
            "layout"
          ]
        }
      }
    },
    "align": {
      "label": "Ausrichtung",
      "values": {
        "start": {
          "modifier": null,
          "tokenGroups": []
        },
        "center": {
          "modifier": "nc-app-store--center",
          "tokenGroups": []
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": []
  },
  "a11y": {
    "base": [
      "--on-dark ist Pflicht, sobald die Zeile auf dunkler Flaeche steht: Flaeche und Vordergrund sind ein Paar, sonst dunkler Rahmen auf dunklem Grund.",
      "Die Abzeichen sind Verweise, keine Schaltflaechen — sie fuehren fort, sie loesen nichts aus."
    ],
    "overrides": []
  },
  "constraints": {
    "rules": []
  },
  "styling": {
    "baseClasses": [
      "nc-app-store"
    ],
    "baseTokenGroups": [
      "layout"
    ],
    "tokenGroups": {
      "layout": {
        "label": "Layout",
        "tokens": [
          "nc-app-store-gap",
          "nc-app-store-badge-gap",
          "nc-app-store-badge-pad",
          "nc-app-store-badge-radius",
          "nc-app-store-badge-border-width",
          "nc-app-store-badge-border",
          "nc-app-store-badge-border-hover",
          "nc-app-store-badge-bg",
          "nc-app-store-badge-bg-hover",
          "nc-app-store-badge-color",
          "nc-app-store-kicker-size",
          "nc-app-store-name-size",
          "nc-app-store-icon-size",
          "nc-app-store-qr-size"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.orientation.values.*.modifier",
        "axes.mode.values.*.modifier",
        "axes.display.values.*.modifier",
        "axes.validation.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": []
}