{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "radio",
    "version": "2.0.0",
    "status": "stable",
    "tags": [
      "interactive",
      "form",
      "selection"
    ],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/radio-docs"
    },
    "changelog": [
      {
        "version": "2.0.0",
        "changes": [
          "A: Neue Achse alignment (center / top) — Control obenbuendig bei mehrzeiligen Labels",
          "B: Neue Achse variant (default / card) — Card-Variante mit umgebendem Rahmen und Checked-Hintergrund",
          "Neue Tokens: nc-radio-card-bg, nc-radio-card-bg-checked, nc-radio-card-border, nc-radio-card-border-checked, nc-radio-card-border-hover, nc-radio-card-radius, nc-radio-card-padding"
        ]
      }
    ],
    "layer": "atom",
    "pipeline": {
      "scss": [
        "scss/scss/05-atoms/_radio.scss"
      ],
      "story": "stories/atoms/radio.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/radio-docs.html"
    }
  },
  "anatomy": {
    "root": {
      "element": ".nc-radio"
    },
    "slots": [
      {
        "name": "input",
        "element": ".nc-radio__input",
        "optional": false
      },
      {
        "name": "control",
        "element": ".nc-radio__control",
        "optional": false
      },
      {
        "name": "label",
        "element": ".nc-radio__label",
        "optional": true
      }
    ],
    "convenience": [],
    "domNotes": [
      "Wrapper ist ein <label class='nc-radio'> — Klick auf Label aktiviert Input.",
      "Native <input type='radio'> wird via sr-only versteckt, bleibt im DOM fuer Accessibility.",
      "__control ist ein <span> mit border-radius: 50% (Kreis).",
      ":checked → Dot via ::after pseudo-element, skaliert mit transform: scale(dot-scale).",
      ":focus-visible auf dem Native Input delegiert den Focus-Ring auf __control.",
      "Radio-Buttons in einer Gruppe teilen sich den gleichen name-Attribut. Nur einer kann gleichzeitig checked sein.",
      "Error kann per .nc-radio--error gesetzt werden.",
      "Alignment --top: Control obenbuendig bei mehrzeiligen Labels (margin-top: 0.15em).",
      "Card-Variante (--card): Wrapper bekommt Padding, Border, Radius. Checked-State zeigt aktiven BG + Border."
    ]
  },
  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (16px) / md (20px, Standard) / lg (24px)",
      "values": {
        "sm": {
          "modifier": "nc-radio--sm",
          "tokenGroups": []
        },
        "md": {
          "modifier": null,
          "tokenGroups": []
        },
        "lg": {
          "modifier": "nc-radio--lg",
          "tokenGroups": []
        }
      }
    },
    "alignment": {
      "label": "Alignment",
      "description": "Vertikale Ausrichtung des Controls zum Label — center (Standard, zentriert), top (obenbuendig, fuer mehrzeilige Labels)",
      "values": {
        "center": {
          "modifier": null,
          "tokenGroups": []
        },
        "top": {
          "modifier": "nc-radio--top",
          "tokenGroups": []
        }
      }
    },
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default (Standard-Radio), card (umgebender Rahmen mit Checked-Hintergrund)",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": []
        },
        "card": {
          "modifier": "nc-radio--card",
          "tokenGroups": [
            "card"
          ]
        }
      }
    },
    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "error": {
          "modifier": "nc-radio--error",
          "tokenGroups": [
            "state-error"
          ]
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "checked",
      "disabled",
      "focus"
    ],
    "precedence": [
      "disabled",
      "focus",
      "checked",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "disabled"
        ],
        "note": "Hover nur wenn nicht disabled"
      },
      {
        "state": "focus",
        "unless": [
          "disabled"
        ],
        "note": "Focus nur wenn nicht disabled"
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "Native <input type='radio'> bleibt im DOM (sr-only). Label via <label> Wrapper. Pfeil-Tasten navigieren innerhalb der Radio-Gruppe."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "note": "Error-State braucht aria-invalid='true' auf dem Input und aria-describedby das auf die Fehlermeldung verweist."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt wenn Radio Teil eines sichtbaren Formulars ist."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "accessible-name"
        ],
        "notes": [
          "Radio braucht immer ein <label> (Wrapper oder for/id) oder aria-label."
        ]
      },
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "notes": [
          "Error braucht aria-invalid='true' + Verweis auf Fehlermeldung."
        ]
      }
    ],
    "copy": {
      "label": {
        "maxChars": 80,
        "note": "Label-Text soll praegnant sein. Fuer laengere Erklaerungen aria-describedby nutzen."
      }
    }
  },
  "styling": {
    "baseClasses": [
      "nc-radio"
    ],
    "baseTokenGroups": [
      "core-geometry",
      "core-colors"
    ],
    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-radio-size-sm",
          "nc-radio-size-md",
          "nc-radio-size-lg",
          "nc-radio-border-width"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-radio-bg",
          "nc-radio-border",
          "nc-radio-border-hover"
        ]
      },
      "state-checked": {
        "label": "Checked",
        "tokens": [
          "nc-radio-bg-checked",
          "nc-radio-border-checked",
          "nc-radio-dot-color",
          "nc-radio-dot-scale"
        ]
      },
      "state-disabled": {
        "label": "Disabled",
        "tokens": [
          "nc-radio-disabled-bg",
          "nc-radio-disabled-border",
          "nc-radio-disabled-opacity"
        ]
      },
      "state-error": {
        "label": "Error",
        "tokens": [
          "nc-radio-border-error"
        ]
      },
      "label": {
        "label": "Label",
        "tokens": [
          "nc-radio-label-gap",
          "nc-radio-label-color"
        ]
      },
      "interaction": {
        "label": "Interaction",
        "tokens": [
          "nc-radio-transition-duration"
        ]
      },
      "card": {
        "label": "Card Variant",
        "tokens": [
          "nc-radio-card-bg",
          "nc-radio-card-bg-checked",
          "nc-radio-card-border",
          "nc-radio-card-border-checked",
          "nc-radio-card-border-hover",
          "nc-radio-card-radius",
          "nc-radio-card-padding"
        ]
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.alignment.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.validation.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD",
      "description": "Radio in allen interaktiven Zustaenden",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "hover",
          "checked",
          "disabled",
          "focus"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring. Checked-Dot muss klar erkennbar sein."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": {
          "size": "*",
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "core-geometry"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "SM (16px) muss 44px Touch-Target einhalten (ggf. durch Label-Wrapper oder padding)."
      }
    },
    {
      "id": "alignment-comparison",
      "label": "Alignment: Center vs Top",
      "description": "Vergleich der vertikalen Ausrichtung bei mehrzeiligem Label",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": "*",
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "checked"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "alignment"
      },
      "render": {
        "compositionType": "radio-multiline-label",
        "label": "{alignment}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Bei top-Alignment: Control bleibt an erster Textzeile ausgerichtet. Touch-Target muss weiterhin 44px erfuellen."
      }
    },
    {
      "id": "checked-unchecked",
      "label": "Default vs Checked",
      "description": "Vergleich unchecked und checked mit Dot-Animation",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "state-checked"
      ],
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Dot muss 3:1 Kontrast gegen bg-checked haben. Dot-Scale (0.4) erzeugt einen visuell klaren Indikator."
      }
    },
    {
      "id": "radio-group",
      "label": "Radio Group",
      "description": "Mehrere Radios in einer Gruppe — nur einer kann aktiv sein",
      "composes": [
        "label",
        "fieldset"
      ],
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "label"
      ],
      "layout": "row",
      "render": {
        "compositionType": "radio-group",
        "label": "group"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Radio-Gruppe sollte in <fieldset> mit <legend> stehen. Pfeil-Tasten navigieren zwischen den Optionen."
      }
    },
    {
      "id": "error-state",
      "label": "Error State",
      "description": "Error-Validierung fuer die Radio-Gruppe",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "error"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "state-error"
      ],
      "layout": "row",
      "render": {
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-Border muss 3:1 Kontrast zum Hintergrund haben. Farbe nie als einziges Signal — immer mit Fehlermeldung kombinieren."
      }
    },
    {
      "id": "disabled-states",
      "label": "Disabled States",
      "description": "Disabled in unchecked und checked",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "disabled"
        ]
      },
      "focusTokenGroups": [
        "state-disabled"
      ],
      "layout": "row",
      "render": {
        "label": "disabled"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Disabled hat reduzierte Opacity. Label-Farbe wechselt zu text-disabled. Kein Hover/Focus moeglich."
      }
    },
    {
      "id": "with-label",
      "label": "With Label Text",
      "description": "Radio mit Label-Text in allen Groessen",
      "composes": [
        "label"
      ],
      "matrix": {
        "axes": {
          "size": "*",
          "alignment": [
            "center"
          ],
          "variant": [
            "default"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "label"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "size"
      },
      "render": {
        "compositionType": "radio-with-label",
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Label-Text muss 4.5:1 Kontrast einhalten. Klick auf Label toggled das Radio."
      }
    },
    {
      "id": "card-variant",
      "label": "Card Variant",
      "description": "Radio als Card mit umgebendem Rahmen — default, checked, disabled",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": [
            "card"
          ],
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked",
          "disabled"
        ]
      },
      "focusTokenGroups": [
        "card"
      ],
      "layout": "row",
      "render": {
        "compositionType": "radio-card",
        "label": "{state}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Card-Border muss 3:1 Kontrast gegen Hintergrund haben. Checked-State zeigt aktiven Hintergrund + Akzent-Border."
      }
    },
    {
      "id": "variant-comparison",
      "label": "Default vs Card",
      "description": "Vergleich der Standard-Radio mit der Card-Variante",
      "matrix": {
        "axes": {
          "size": [
            "md"
          ],
          "alignment": [
            "center"
          ],
          "variant": "*",
          "validation": [
            "none"
          ]
        },
        "states": [
          "default",
          "checked"
        ]
      },
      "focusTokenGroups": [
        "card",
        "core-colors"
      ],
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "compositionType": "radio-with-label",
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Beide Varianten muessen gleiche A11y-Garantien bieten: Focus-Ring, Kontrast, Keyboard-Support."
      }
    }
  ]
}
