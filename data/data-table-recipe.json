      }
    ],
    "convenience": [],
    "domNotes": [
      "Wrapper: border, radius, overflow:hidden. Semantisches <table> mit <thead>/<tbody>.",
      "Scroll-Container: horizontaler Scroll mit CSS-Schatten-Indikatoren.",
      "Title-Bar: Titel + Beschreibung. Toolbar: Suche + Filter + Batch-Actions.",
      "Density: default (40px), compact (32px), comfortable (48px).",
      "Striped: nth-child(even of :not(expand-row)). Bordered: border-inline-end.",
      "Sticky Header: position:sticky top:0 auf <th>.",
      "Sticky Columns: erste/letzte Spalte fixiert mit Schatten-Indikator.",
      "Stacked Layout: Mobile Card-View via data-label auf <td>.",
      "Card Variante: erhobene Tabelle mit elevation-raised Shadow.",
      "Glass Variante: transparente Zeilen mit backdrop-filter fuer Dashboards.",
      "Batch-Bar v2: Zaehler (aria-live) + Clear-All Button + Aktionen.",
      "Skeleton Varianten: avatar (rund), numeric (schmal), text (75%).",
      "Content Wrapping: --wrap Modifier fuer mehrzeiligen Zelleninhalt."
    ]
  },
  "axes": {
    "density": {
      "label": "Density",
      "description": "Zeilendichte — default (40px), compact (32px), comfortable (48px)",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [
            "row"
          ],
          "renderHint": "dt-default"
        },
        "compact": {
          "modifier": "nc-data-table--compact",
          "tokenGroups": [
            "row"
          ],
          "renderHint": "dt-compact"
        },
        "comfortable": {
          "modifier": "nc-data-table--comfortable",
          "tokenGroups": [
            "row"
          ],
          "renderHint": "dt-comfortable"
        }
      }
    },
    "feature": {
      "label": "Feature",
      "description": "Feature-Set — basic, sortable, selectable, expandable",
      "values": {
        "basic": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "dt-basic"
        },
        "sortable": {
          "modifier": "nc-data-table--sortable",
          "tokenGroups": [
            "sort"
          ],
          "slotConfig": {
            "sort-button": true
          },
          "renderHint": "dt-sortable"
        },
        "selectable": {
          "modifier": "nc-data-table--selectable",
          "tokenGroups": [
            "checkbox",
            "batch"
          ],
          "slotConfig": {
            "checkbox-cell": true,
            "batch-bar": true
          },
          "renderHint": "dt-selectable"
        },
        "expandable": {
          "modifier": "nc-data-table--expandable",
          "tokenGroups": [
            "expand"
          ],
          "slotConfig": {
            "expand-button": true,
            "expand-panel": true
          },
          "renderHint": "dt-expandable"
        }
      }
    },
    "selection": {
      "label": "Selection Mode",
      "description": "Zeilen-Auswahl — none, checkbox (multi-select), radio (single-select)",
      "values": {
        "none": {
          "modifier": null,
          "tokenGroups": []
        },
        "checkbox": {
          "modifier": "nc-data-table--selectable",
          "tokenGroups": [
            "checkbox",
            "batch"
          ],
          "slotConfig": {
            "checkbox-cell": true,
            "batch-bar": true
          },
          "renderHint": "dt-checkbox"
        },
        "radio": {
          "modifier": null,
          "tokenGroups": [
            "radio"
          ],
          "slotConfig": {
            "radio-cell": true
          },
          "renderHint": "dt-radio"
        }
      }
    },
    "variant": {
      "label": "Variant",
      "description": "Visuelles Layout — flat (Standard), striped, bordered, card (erhobene Card), glass (transparente Dashboard-Tabelle)",
      "values": {
        "flat": {
          "modifier": null,
          "tokenGroups": [
            "container"
          ],
          "renderHint": "dt-flat"
        },
        "striped": {
          "modifier": "nc-data-table--striped",
          "tokenGroups": [
            "container"
          ],
          "renderHint": "dt-striped"
        },
        "bordered": {
          "modifier": "nc-data-table--bordered",
          "tokenGroups": [
            "container"
          ],
          "renderHint": "dt-bordered"
        },
        "card": {
          "modifier": "nc-data-table--card",
          "tokenGroups": [
            "container",
            "card"
          ],
          "renderHint": "dt-card"
        },
        "glass": {
          "modifier": "nc-data-table--glass",
          "tokenGroups": [
            "container",
            "glass"
          ],
          "renderHint": "dt-glass"
        }
      }
    },
    "content": {
      "label": "Content",
      "description": "Zelleninhalt-Behandlung — truncate (Ellipsis, Standard), wrap (mehrzeilig)",
      "values": {
        "truncate": {
          "modifier": null,
          "tokenGroups": []
        },
        "wrap": {
          "modifier": "nc-data-table--wrap",
          "tokenGroups": [
            "content"
          ],
          "renderHint": "dt-wrap"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "selected",
      "loading",
      "error",
      "empty"
    ],
    "precedence": [
      "error",
      "loading",
      "empty",
      "selected",
      "hover",
      "default"
    ],
    "rules": [
      {
        "state": "hover",
        "unless": [
          "loading",
          "error",
          "empty"
        ],
        "note": "Hover: row-bg-hover auf Zeile."
      },
      {
        "state": "selected",
        "unless": [
          "loading",
          "error",
          "empty"
        ],
        "note": "Selected: row-bg-selected, aria-selected='true'."
      },
      {
        "state": "loading",
        "unless": [
          "error"
        ],
        "note": "Loading: Skeleton-Zeilen, Body opacity-disabled."
      },
      {
        "state": "error",
        "unless": [],
        "note": "Error: border-danger, Fehlermeldung statt Daten."
      },
      {
        "state": "empty",
        "unless": [
          "loading",
          "error"
        ],
        "note": "Empty: Leerzustand mit Icon + Text."
      }
    ],
    "interactive": true
  },
  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": [
        "hasAccessibleName",
        "supportsKeyboard"
      ],
      "note": "aria-sort auf <th>. aria-selected auf <tr>. aria-expanded auf Expand-Button. Checkboxen: aria-label mit Zeilenkontext. Batch-Bar Zaehler: aria-live='polite'. Toolbar: role='toolbar'."
    },
    "overrides": [
      {
        "when": {
          "axes": {
            "feature": [
              "selectable"
            ]
          }
        },
        "suggest": [
          "aria-selected",
          "aria-live"
        ],
        "note": "Selectable: aria-selected auf Zeilen. Batch-Bar Zaehler: aria-live='polite'."
      },
      {
        "when": {
          "axes": {
            "feature": [
              "sortable"
            ]
          }
        },
        "suggest": [
          "aria-sort"
        ],
        "note": "Sortable: aria-sort='ascending|descending|none' auf sortierte <th>."
      },
      {
        "when": {
          "axes": {
            "feature": [
              "expandable"
            ]
          }
        },
        "suggest": [
          "aria-expanded",
          "aria-controls"
        ],
        "note": "Expandable: aria-expanded + aria-controls auf Expand-Button."
      },
      {
        "when": {
          "axes": {
            "selection": [
              "radio"
            ]
          }
        },
        "suggest": [
          "aria-selected"
        ],
        "note": "Radio-Selection: aria-selected auf ausgewaehlte Zeile. Nur eine Zeile gleichzeitig."
      }
    ]
  },
  "constraints": {
    "rules": [
      {
        "when": {},
        "require": [
          "caption-or-aria-label"
        ],
        "notes": [
          "<table> braucht <caption> oder aria-label fuer Screen Reader."
        ]
      },
      {
        "when": {
          "variant": "glass"
        },
        "require": [
          "sufficient-contrast"
        ],
        "notes": [
          "Glass-Variante: Auf ausreichenden Kontrast gegen Hintergrund achten (min. 4.5:1)."
        ]
      }
    ],
    "copy": {
      "title": {
        "maxChars": 60,
        "note": "Table-Titel: 'Benutzerverwaltung', 'Bestelluebersicht', 'Audit Log'."
      }
    }
  },
