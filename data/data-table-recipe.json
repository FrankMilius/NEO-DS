  "tokenDependencies": [
    {
      "source": "nc-button-radius-sm → nc-dt-radius",
      "reason": "Eckenradius harmoniert mit restlichen Formular-Elementen."
    },
    {
      "source": "nc-shadow-md → nc-dt-batch-shadow",
      "reason": "Batch-Aktionsleiste schwebt ueber der Tabelle mit klarer Elevation."
    },
    {
      "source": "nc-status-success → nc-dt-progress-fill-success",
      "reason": "Fortschrittsbalken nutzen die globale Status-Semantik."
    }
  ],
  "specimens": [
    {
      "id": "basic",
      "label": "Basic Table",
      "description": "Einfache Tabelle ohne interaktive Features",
      "matrix": {
        "axes": {
          "density": [
            "default"
          ],
          "feature": [
            "basic"
          ],
          "variant": [
            "flat"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "dt-basic",
        "label": "basic"
      },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "caption oder aria-label auf <table>."
      }
    },
    {
      "id": "density-variants",
      "label": "Density Variants",
      "description": "Default (40px), Compact (32px), Comfortable (48px)",
