  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.density.values.*.modifier",
        "axes.feature.values.*.modifier",
        "axes.variant.values.*.modifier",
        "axes.selection.values.*.modifier",
        "axes.content.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
