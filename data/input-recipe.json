{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "input",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["interactive", "form", "text-input"],
    "links": {
      "figma": "",
      "storybook": "",
      "docs": "/docs/input-docs"
    }
  },

  "anatomy": {
    "root": { "element": ".nc-input" },
    "slots": [
      { "name": "icon",     "element": ".nc-input__icon",      "optional": true },
      { "name": "icon-end", "element": ".nc-input__icon--end",  "optional": true }
    ],
    "convenience": [
      { "name": "wrapper", "element": ".nc-input-wrapper", "optional": true, "description": "Positionierungs-Container fuer Icon-Prefix/Suffix (position: relative)" }
    ],
    "domNotes": [
      "Input ist immer ein <input> Element mit type='text|email|url|tel|password|search|number|color'.",
      "Icon-Prefix/Suffix erfordert .nc-input-wrapper als Container.",
      "Search-Typ: padding-left fuer Lupe. Password-Typ: padding-right fuer Reveal-Toggle.",
      ":focus-visible triggert Focus-Ring. :disabled und [aria-disabled] haben eigenes Styling.",
      "[readonly] hat eigene BG/Border-Tokens — kein disabled-Opacity.",
      "Error kann per .nc-input--error ODER [aria-invalid='true'] gesetzt werden."
    ]
  },

  "axes": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px)",
      "values": {
        "sm": { "modifier": "nc-input--sm", "tokenGroups": [] },
        "md": { "modifier": null,           "tokenGroups": [] },
        "lg": { "modifier": "nc-input--lg", "tokenGroups": [] }
      }
    },

    "type": {
      "label": "Type",
      "description": "Input-Typ — text (Standard), search (Lupe links), password (Reveal rechts)",
      "values": {
        "text":     { "modifier": null,                   "tokenGroups": [],            "elementHint": "input", "renderHint": "input-text" },
        "search":   { "modifier": "nc-input--search",     "tokenGroups": ["icon-slot"], "elementHint": "input", "renderHint": "input-search" },
        "password": { "modifier": "nc-input--password",   "tokenGroups": ["icon-slot"], "elementHint": "input", "renderHint": "input-password" }
      }
    },

    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": {
        "none":    { "modifier": null,                "tokenGroups": [] },
        "error":   { "modifier": "nc-input--error",   "tokenGroups": ["state-error"] },
        "success": { "modifier": "nc-input--success", "tokenGroups": ["state-success"] }
      }
    }
  },

  "states": {
    "supported": ["default", "hover", "focus", "disabled", "readonly"],
    "precedence": ["disabled", "readonly", "focus", "hover", "default"],
    "rules": [
      { "state": "hover",    "unless": ["disabled", "readonly", "focus"], "note": "Hover nur wenn nicht disabled, readonly oder fokussiert" },
      { "state": "focus",    "unless": ["disabled"],                      "note": "Focus nur wenn nicht disabled" },
      { "state": "readonly", "unless": ["disabled"],                      "note": "Readonly und disabled sind mutually exclusive" }
    ],
    "interactive": true
  },

  "a11y": {
    "base": {
      "interactive": true,
      "contrastTarget": "WCAG AA normal text (4.5:1)",
      "assertions": ["hasAccessibleName", "supportsKeyboard"],
      "note": "Input braucht immer ein zugehoeriges <label> (via for/id) oder aria-label. Placeholder ist KEIN Label-Ersatz."
    },
    "overrides": [
      {
        "when": { "axes": { "validation": ["error"] } },
        "require": ["aria-invalid", "aria-describedby"],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby das auf die Fehlermeldung verweist."
      },
      {
        "when": { "states": ["disabled"] },
        "suggest": ["aria-disabled"],
        "note": "aria-disabled='true' bevorzugt, wenn Input Teil eines Formulars ist das noch sichtbar bleiben soll."
      },
      {
        "when": { "axes": { "type": ["search"] } },
        "suggest": ["role-search"],
        "note": "Search-Input sollte in einem <form role='search'> oder <search> Element stehen."
      }
    ]
  },

  "constraints": {
    "rules": [
      { "when": {}, "require": ["accessible-name"], "notes": ["Input braucht immer <label for='...'>  oder aria-label. Placeholder ist kein Label-Ersatz."] },
      { "when": { "axes": { "validation": ["error"] } }, "require": ["aria-invalid", "aria-describedby"], "notes": ["Error braucht aria-invalid='true' + Verweis auf Fehlermeldung."] }
    ],
    "copy": {
      "placeholder": {
        "maxChars": 50,
        "note": "Placeholder soll Eingabeformat zeigen, nicht das Label ersetzen. Kurz und praegnant."
      }
    }
  },

  "styling": {
    "baseClasses": ["nc-input"],
    "baseTokenGroups": ["core-geometry", "core-colors"],

    "tokenGroups": {
      "core-geometry": {
        "label": "Geometry",
        "tokens": [
          "nc-input-height-sm",
          "nc-input-height-md",
          "nc-input-height-lg",
          "nc-input-padding-x-sm",
          "nc-input-padding-x-md",
          "nc-input-padding-x-lg",
          "nc-input-padding-y-sm",
          "nc-input-padding-y-md",
          "nc-input-padding-y-lg",
          "nc-input-font-size-sm",
          "nc-input-font-size-md",
          "nc-input-font-size-lg",
          "nc-input-radius",
          "nc-input-border-width"
        ]
      },
      "core-colors": {
        "label": "Colors",
        "tokens": [
          "nc-input-bg",
          "nc-input-color",
          "nc-input-border",
          "nc-input-placeholder",
          "nc-input-border-hover",
          "nc-input-border-focus"
        ]
      },
      "state-error": {
        "label": "Error",
        "tokens": [
          "nc-input-border-error"
        ]
      },
      "state-success": {
        "label": "Success",
        "tokens": [
          "nc-input-border-success"
        ]
      },
      "state-disabled": {
        "label": "Disabled",
        "tokens": [
          "nc-input-disabled-bg",
          "nc-input-disabled-color",
          "nc-input-disabled-border",
          "nc-input-disabled-opacity"
        ]
      },
      "state-readonly": {
        "label": "Readonly",
        "tokens": [
          "nc-input-bg-readonly",
          "nc-input-border-readonly"
        ]
      },
      "icon-slot": {
        "label": "Icon",
        "tokens": [
          "nc-input-icon-size",
          "nc-input-icon-color"
        ]
      },
      "interaction": {
        "label": "Interaction",
        "tokens": [
          "nc-input-transition-duration"
        ]
      }
    }
  },

  "recipes": {
    "mode": "derived",
    "derive": {
      "from": ["axes", "states", "styling.tokenGroups"],
      "output": ["classList", "resolvedTokens", "a11yAssertions"]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.size.values.*.modifier",
        "axes.type.values.*.modifier",
        "axes.validation.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups",
        "axes.*.values.*.tokenGroups"
      ]
    }
  },

  "specimens": [
    {
      "id": "all-states",
      "label": "All States — MD",
      "description": "Input in allen interaktiven Zustaenden",
      "matrix": {
        "axes": { "size": ["md"], "type": ["text"], "validation": ["none"] },
        "states": ["default", "hover", "focus", "disabled", "readonly"]
      },
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Alle States muessen visuell unterscheidbar sein. Focus braucht sichtbaren Ring."
      }
    },
    {
      "id": "size-scale",
      "label": "Size Scale — SM / MD / LG",
      "description": "Alle 3 Groessen im Vergleich",
      "matrix": {
        "axes": { "size": "*", "type": ["text"], "validation": ["none"] },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["core-geometry"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "SM (32px) muss 44px Touch-Target einhalten (ggf. durch Wrapper mit padding)."
      }
    },
    {
      "id": "validation-states",
      "label": "Validation States",
      "description": "Error und Success im Vergleich zu Default",
      "matrix": {
        "axes": { "size": ["md"], "type": ["text"], "validation": "*" },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["state-error", "state-success"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "validation" },
      "render": { "label": "{validation}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-Rand muss 3:1 Kontrast zum Hintergrund haben. Farbe nie als einziges Signal — immer mit Fehlermeldung kombinieren."
      }
    },
    {
      "id": "input-types",
      "label": "Input Types",
      "description": "Text, Search und Password im Vergleich",
      "matrix": {
        "axes": { "size": ["md"], "type": "*", "validation": ["none"] },
        "states": ["default"]
      },
      "focusTokenGroups": ["icon-slot"],
      "layout": "row",
      "render": { "label": "{type}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Search sollte in <search> oder role='search' stehen. Password-Reveal braucht aria-label."
      }
    },
    {
      "id": "with-icons",
      "label": "With Prefix/Suffix Icon",
      "description": "Input mit Icon-Prefix und/oder -Suffix im Wrapper",
      "composes": ["icon"],
      "matrix": {
        "axes": { "size": ["md"], "type": ["text"], "validation": ["none"] },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["icon-slot"],
      "layout": "row",
      "render": { "compositionType": "input-with-icon", "label": "icon" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Icons sind dekorativ (aria-hidden='true'). pointer-events: none verhindert Klick auf Icon."
      }
    },
    {
      "id": "disabled-readonly",
      "label": "Disabled vs Readonly",
      "description": "Vergleich der nicht-editierbaren Zustaende",
      "matrix": {
        "axes": { "size": ["md"], "type": ["text"], "validation": ["none"] },
        "states": ["disabled", "readonly"]
      },
      "focusTokenGroups": ["state-disabled", "state-readonly"],
      "layout": "row",
      "render": { "label": "{state}" },
      "a11y": {
        "contrastTarget": "WCAG AA normal text (4.5:1)",
        "note": "Disabled hat Opacity-Reduktion. Readonly hat eigene BG/Border-Farben aber volle Opacity — Text bleibt lesbar und selektierbar."
      }
    },
    {
      "id": "error-with-sizes",
      "label": "Error × Size",
      "description": "Error-State in allen Groessen",
      "matrix": {
        "axes": { "size": "*", "type": ["text"], "validation": ["error"] },
        "states": ["default", "focus"]
      },
      "focusTokenGroups": ["state-error", "core-geometry"],
      "layout": "grid",
      "layoutConfig": { "rowAxis": "size" },
      "render": { "label": "{size}" },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Error-Border muss in allen Groessen sichtbar und kontrastreich sein."
      }
    }
  ]
}
