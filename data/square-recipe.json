{
  "$schema": "./recipe-schema.json",
  "meta": {
    "schemaVersion": "3.1.0",
    "component": "square",
    "version": "1.0.0",
    "status": "stable",
    "tags": ["decorative", "display"],
    "links": { "figma": "", "storybook": "", "docs": "/docs/square-docs" }
  },
  "anatomy": {
    "root": { "element": ".square" },
    "slots": [],
    "convenience": [],
    "domNotes": [
      "Dekoratives Quadrat via ::before Pseudo-Element.",
      "Varianten: default (accent/gruen), white, dark, adaptive (inverse), blinking.",
      "Groessen: default (10px), square-l (12px), square-s (8px)."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Farbvariante — default (accent), white, dark, adaptive, blinking",
      "values": {
        "default":  { "modifier": null,    "tokenGroups": [], "renderHint": "square-default" },
        "white":    { "modifier": null,    "tokenGroups": [], "renderHint": "square-white" },
        "dark":     { "modifier": null,    "tokenGroups": [], "renderHint": "square-dark" },
        "adaptive": { "modifier": null,    "tokenGroups": [], "renderHint": "square-adaptive" },
        "blinking": { "modifier": null,    "tokenGroups": [], "renderHint": "square-blinking" }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groesse — sm (8px), md (10px Standard), lg (12px)",
      "values": {
        "sm": { "modifier": "square-s",  "tokenGroups": [], "renderHint": "square-sm" },
        "md": { "modifier": null,        "tokenGroups": [], "renderHint": "square-md" },
        "lg": { "modifier": "square-l",  "tokenGroups": [], "renderHint": "square-lg" }
      }
    }
  },
  "states": { "supported": ["default"], "precedence": ["default"], "rules": [], "interactive": false },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [],
      "note": "Rein dekoratives Element. aria-hidden='true' empfohlen."
    },
    "overrides": []
  },
  "constraints": { "rules": [], "copy": {} },
  "styling": {
    "baseClasses": ["square"],
    "baseTokenGroups": [],
    "tokenGroups": { "base": { "label": "Base", "tokens": [] } }
  },
  "recipes": {
    "mode": "derived",
    "derive": { "from": ["axes", "states", "styling.tokenGroups"], "output": ["classList", "resolvedTokens", "a11yAssertions"] },
    "resolution": {
      "classList": ["styling.baseClasses", "axes.variant.values.*.modifier", "axes.size.values.*.modifier"],
      "tokenGroups": ["styling.baseTokenGroups"]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison", "label": "Variant Comparison",
      "description": "Default, White, Dark, Adaptive, Blinking",
      "matrix": { "axes": { "variant": "*", "size": ["md"] }, "states": ["default"] },
      "layout": "grid", "layoutConfig": { "rowAxis": "variant" }, "render": { "label": "{variant}" },
      "a11y": { "contrastTarget": "WCAG AA non-text (3:1)", "note": "Dekorativ — kein Kontrastziel erforderlich." }
    }
  ]
}
