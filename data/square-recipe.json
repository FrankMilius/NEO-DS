        "scss/scss/05-atoms/_square.scss"
      ],
      "story": "stories/organisms/square.stories.js",
      "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
      "drupal": [],
      "docs": "docs/square-docs.html"
    },
    "changelog": [
      {
        "version": "1.1.0",
        "changes": [
          "Plan v3, Phase 4 (bloecke-2): Specimens size-comparison, legende und liste (Anwendungsbeispiele der Doku); alle Zellen aus der Vorlage",
          "Varianten als eigene Klassen beschrieben (white-square, dark-square, adaptive-square, blinking-square ersetzen .square — so in Doku und SCSS); die Vorlage setzt genau eine, white im Rahmen ra-kulisse statt Inline-Gestaltung",
          "pipeline.arena zeigt auf die RecipeArena"
        ]
      }
    ]
  },
  "anatomy": {
    "root": {
      "element": ".square"
    },
    "slots": [],
    "convenience": [],
    "domNotes": [
      "Dekoratives Quadrat via ::before Pseudo-Element.",
      "Varianten: default (accent/gruen), white, dark, adaptive (inverse), blinking.",
      "Groessen: default (10px), square-l (12px), square-s (8px).",
      "Varianten sind eigene Klassen, keine Modifier: genau eine von .square, .white-square, .dark-square, .adaptive-square, .blinking-square; Groesse zusaetzlich mit .square-s/.square-l."
    ]
  },
  "axes": {
    "variant": {
      "label": "Variant",
      "description": "Farbvariante — default (accent), white, dark, adaptive, blinking",
      "values": {
        "default": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-default",
          "description": ".square: Akzentfarbe."
        },
        "white": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-white",
          "description": "Eigene Klasse .white-square (ersetzt .square): weisses Quadrat fuer dunklen Grund."
        },
        "dark": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-dark",
          "description": "Eigene Klasse .dark-square (ersetzt .square): always-dark."
        },
        "adaptive": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-adaptive",
          "description": "Eigene Klasse .adaptive-square (ersetzt .square): background-inverse, folgt dem Theme."
        },
        "blinking": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-blinking",
          "description": "Eigene Klasse .blinking-square (ersetzt .square): Akzent, blinkt (animations-flash)."
        }
      }
    },
    "size": {
      "label": "Size",
      "description": "Groesse — sm (8px), md (10px Standard), lg (12px)",
      "values": {
        "sm": {
          "modifier": "square-s",
          "tokenGroups": [],
          "renderHint": "square-sm"
        },
        "md": {
          "modifier": null,
          "tokenGroups": [],
          "renderHint": "square-md"
        },
        "lg": {
          "modifier": "square-l",
          "tokenGroups": [],
          "renderHint": "square-lg"
        }
      }
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "precedence": [
      "default"
    ],
    "rules": [],
    "interactive": false
  },
  "a11y": {
    "base": {
      "interactive": false,
      "contrastTarget": "WCAG AA non-text (3:1)",
      "assertions": [],
      "note": "Rein dekoratives Element. aria-hidden='true' empfohlen."
    },
    "overrides": []
  },
  "constraints": {
    "rules": [],
    "copy": {}
  },
  "styling": {
    "baseClasses": [
      "square"
    ],
    "baseTokenGroups": [],
    "tokenGroups": {
      "base": {
        "label": "Base",
        "tokens": []
      }
    }
  },
  "recipes": {
    "mode": "derived",
    "derive": {
      "from": [
        "axes",
        "states",
        "styling.tokenGroups"
      ],
      "output": [
        "classList",
        "resolvedTokens",
        "a11yAssertions"
      ]
    },
    "resolution": {
      "classList": [
        "styling.baseClasses",
        "axes.variant.values.*.modifier",
        "axes.size.values.*.modifier"
      ],
      "tokenGroups": [
        "styling.baseTokenGroups"
      ]
    }
  },
  "specimens": [
    {
      "id": "variant-comparison",
      "label": "Variant Comparison",
      "description": "Default, White, Dark, Adaptive, Blinking",
      "matrix": {
        "axes": {
          "variant": "*",
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "grid",
      "layoutConfig": {
        "rowAxis": "variant"
      },
      "render": {
        "label": "{variant}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Dekorativ — kein Kontrastziel erforderlich."
      }
    },
    {
      "id": "size-comparison",
      "label": "Größen",
      "description": "sm (8px), md (10px), lg (12px)",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "size": "*"
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "label": "{size}"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Dekorativ — die Bedeutung steht im Text daneben."
      }
    },
    {
      "id": "legende",
      "label": "Legende",
      "description": "Marker als Legende — aktiv, inaktiv (adaptive), live (blinking), wie in der Doku",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "legende"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Blinken bei „Bewegung reduzieren“ aus (02-generic/_reset)."
      }
    },
    {
      "id": "liste",
      "label": "Aufzählung",
      "description": "Marker als Aufzaehlungszeichen untereinander",
      "matrix": {
        "axes": {
          "variant": [
            "default"
          ],
          "size": [
            "md"
          ]
        },
        "states": [
          "default"
        ]
      },
      "layout": "row",
      "render": {
        "compositionType": "liste"
      },
      "a11y": {
        "contrastTarget": "WCAG AA non-text (3:1)",
        "note": "Dekorativ — die Bedeutung steht im Text daneben."
      }
    }
  ]
}
