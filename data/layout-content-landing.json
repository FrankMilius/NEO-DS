{
  "$schema": "./layout-spec-schema.json",
  "meta": {
    "id": "layout-content-landing",
    "label": "Content Landing",
    "description": "Landing-Page-artiges Content-Layout mit grosszuegigem Section-Padding. Fuer Story-getriebene Seiten.",
    "extends": "layout-content",
    "tags": ["content", "landing", "story"],
    "templateClass": ".t-content-landing"
  },
  "container": {
    "ref": "container.standard",
    "overrides": {}
  },
  "grid": {
    "ref": "grid.default",
    "overrides": {}
  },
  "spacing": {
    "ref": "spacing.section",
    "overrides": {}
  },
  "section": {
    "ref": "section.spacious",
    "overrides": {}
  }
}
