{
  "$schema": "./layout-spec-schema.json",
  "meta": {
    "id": "layout-marketing",
    "label": "Marketing",
    "description": "Grosszuegiges Layout fuer Landing Pages und Marketing-Sektionen. Breiter Container, grosser Grid-Gap, viel vertikaler Raum.",
    "tags": ["marketing", "landing", "hero"],
    "templateClass": ".t-marketing"
  },
  "container": {
    "ref": "container.wide",
    "overrides": {}
  },
  "grid": {
    "ref": "grid.default",
    "overrides": {
      "--nc-grid-gap": "var(--nc-grid-gap-lg)"
    }
  },
  "spacing": {
    "ref": "spacing.section",
    "overrides": {}
  },
  "section": {
    "ref": "section.spacious",
    "overrides": {}
  }
}
