{
  "name": "website26",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/primitives-aus-quelle.cjs --schreiben && node scripts/semantik-aus-bruecke.cjs --schreiben && node scripts/generate-tokens.cjs",
    "tokens:semantik": "node scripts/semantik-aus-bruecke.cjs",
    "tokens:semantik:check": "node scripts/semantik-aus-bruecke.cjs --pruefen",
    "tokens:validate": "node scripts/validate-tokens.cjs",
    "tokens:diff": "node scripts/diff-tokens.cjs",
    "tokens:golden": "cp data/design-tokens.json data/design-tokens.golden.json && echo '  ✓ Golden master updated'",
    "tokens:pipeline": "npm run tokens:validate && npm run tokens && npm run build:css && npm run test",
    "tokens:check": "npm run tokens:validate && npm run tokens:diff",
    "icons": "node scripts/generate-icons-manifest.cjs",
    "icons:sync": "node scripts/sync-tabler-icons.cjs",
    "icons:sync-heroicons": "node scripts/sync-heroicons.cjs",
    "icons:sync-all": "npm run icons:sync && npm run icons:sync-heroicons",
    "icons:sync-and-build": "npm run icons:sync-all && npm run icons",
    "icons:add": "node scripts/add-icon-library.cjs",
    "icons:watch": "node scripts/watch-icons.cjs",
    "build": "npm run tokens && npm run icons:sync && npm run icons && sass scss/scss/main.scss:styles.css --style=compressed",
    "build:css": "sass scss/scss/main.scss:styles.css --style=compressed",
    "build:theme": "node scripts/extract-theme-css.js",
    "build:theme:template": "node scripts/extract-theme-css.js --template",
    "sync:drupal": "node scripts/sync-drupal-css.js",
    "build:drupal": "npm run build:css && npm run sync:drupal",
    "check:drupal-images": "node scripts/check-drupal-image-breakpoints.js",
    "build:website": "sass website/scss/main.scss:website/styles.css --style=compressed",
    "watch": "sass scss/scss/main.scss:styles.css --watch --poll",
    "watch:drupal": "sass scss/scss/main.scss:../DRUPAL11/web/themes/custom/neo_fe/css/styles.css --watch --poll --style=expanded",
    "watch:website": "sass website/scss/main.scss:website/styles.css --watch --poll",
    "docs": "node scripts/docs-server.js",
    "config:build": "cd apps/theme-configurator && npx vite build",
    "docs:build": "node scripts/build-docs.cjs && npm run docs:sidebar && npm run docs:index",
    "docs:watch": "node scripts/build-docs.cjs --watch",
    "docs:extract": "node scripts/build-docs.cjs --extract",
    "docs:sidebar": "node scripts/generate-docs-sidebar.cjs",
    "docs:index": "node scripts/generate-docs-index.cjs",
    "docs:sync-recipes": "node scripts/update-docs-from-recipes.cjs",
    "tokens:sync": "node scripts/sync-component-tokens.cjs --fix",
    "tokens:sync:check": "node scripts/sync-component-tokens.cjs --check",
    "lint:tokens": "node scripts/lint-tokens.js",
    "lint:docs-tokens": "node scripts/lint-docs-tokens.cjs",
    "lint:fragments": "node scripts/_audit-fragments.cjs",
    "lint:docs-scripts": "node scripts/lint-docs-scripts.cjs",
    "lint:recipes": "node scripts/lint-recipes.mjs",
    "lint:markup": "node scripts/pruefe-markup.mjs",
    "lint:recipes:strict": "node scripts/lint-recipes.mjs --strict",
    "sync:all": "npm run tokens && npm run build:css && npm run config:build",
    "pipeline:check": "node scripts/pipeline-guard.cjs",
    "test:build": "sass scss/scss/main.scss:styles.css --style=compressed --no-source-map",
    "test:unit": "npx vitest run",
    "test": "npm run test:build && npm run test:unit && npm run pipeline:check && npm run tokens:sync:check && npm run tokens:semantik:check && npm run lint:schwellen && npm run lint:recipe-form && npm run lint:markup && npm run lint:klassen",
    "figma:pull": "node scripts/figma-sync.mjs --pull",
    "figma:diff": "node scripts/figma-sync.mjs --diff",
    "figma:components": "node scripts/figma-sync.mjs --components",
    "figma:import": "node scripts/figma-sync.mjs --from-file",
    "dashboard": "node scripts/dashboard-metrics.mjs",
    "dashboard:snapshot": "node scripts/dashboard-metrics.mjs --snapshot",
    "dashboard:json": "node scripts/dashboard-metrics.mjs --json",
    "agents": "node agents/orchestrator.mjs",
    "agents:quick": "node agents/orchestrator.mjs --quick",
    "agents:full": "node agents/orchestrator.mjs --full",
    "dev": "node scripts/dev.cjs",
    "skills": "node scripts/skills-pruefen.js",
    "zustand": "node scripts/zustand-pruefen.js",
    "artefakt": "node scripts/artefakt-pruefen.js",
    "widerlegen": "node scripts/widerlegen.js",
    "kontrast": "node scripts/kontrast-pruefen.js",
    "konfig:nachtragen": "node scripts/konfig-nachtragen.js",
    "registry": "node scripts/generate-component-registry.js",
    "registry:enhance": "node scripts/generate-component-registry.js && node scripts/enhance-recipes.js",
    "specs": "node scripts/generate-component-specs.js",
    "components": "node scripts/generate-component-index.js --clean",
    "specs:json": "node scripts/generate-component-specs.js --format=json",
    "specs:md": "node scripts/generate-component-specs.js --format=md",
    "generate:stories": "node scripts/generate-stories.mjs",
    "storybook": "storybook dev -p 6006",
    "prestorybook": "npm run generate:stories",
    "build-storybook": "npm run generate:stories && storybook build",
    "sync:drupal-icons": "node scripts/sync-drupal-icons.js",
    "skill:build": "node scripts/build-skill-references.js",
    "skill:pack": "npm run skill:build && cd skill && rm -f neo-design-system.skill neo-design-system.zip && zip -r -X neo-design-system.zip neo-design-system -x '*.DS_Store' >/dev/null && cp neo-design-system.zip neo-design-system.skill && echo '→ skill/neo-design-system.skill (+ .zip, gleicher Inhalt)'",
    "baseline:capture": "node scripts/baseline.js",
    "baseline:diff": "node scripts/baseline-diff.js",
    "drift:check": "node scripts/drift-check.js",
    "token:triage": "node scripts/token-triage.js",
    "phase2": "node scripts/phase2-extract.js",
    "aufnehmen": "node scripts/komponente-aufnehmen.js",
    "recipe": "node scripts/recipe-aus-komponente.js",
    "risiko": "node scripts/aufnahme-risiko.js",
    "bilanz": "node scripts/arbeitsbilanz.js",
    "geometrie": "node scripts/geometrie.js",
    "lint:ernte": "node scripts/pruefe-ernte.mjs",
    "ernte:markup": "node scripts/ernte-markup.mjs",
    "lint:klassen": "node scripts/pruefe-klassen.mjs",
    "lint:recipe-form": "node scripts/pruefe-recipe-form.mjs",
    "nutzung": "node scripts/nutzung-pruefen.mjs",
    "primitives:aus-quelle": "node scripts/primitives-aus-quelle.cjs",
    "lint:schwellen": "node scripts/pruefe-linter-schwellen.mjs",
    "pptx:vorlage": "node scripts/pptx-vorlage.mjs",
    "pptx:beispiel": "node scripts/pptx-beispiel.mjs",
    "pptx:pruefen": "node scripts/pptx-pruefen.mjs",
    "pptx": "npm run pptx:vorlage && npm run pptx:beispiel && npm run pptx:pruefen"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/html": "8.6.18",
    "@storybook/html-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tabler/icons": "^3.36.1",
    "heroicons": "^2.2.0",
    "pptxgenjs": "^4.0.1",
    "prismjs": "^1.30.0",
    "sass": "^1.69.5",
    "storybook": "8.6.18",
    "vitest": "^4.1.1"
  }
}
