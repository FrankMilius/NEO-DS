exports[`Arena-Vorlagen: Snapshots > solution-tabs / vertical 1`] = `
[
  {
    "html": "<div class="nc-solution-tabs nc-solution-tabs--vertical nc-tab-nav" data-autoplay="off">
<div class="nc-solution-tabs__tablist" role="tablist">
<button class="nc-solution-tabs__tab is-active" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off-t0" aria-controls="solution-tabs-vertical-vertical-line-off-p0" aria-selected="true" tabindex="0">neo workplace</button>
<button class="nc-solution-tabs__tab" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off-t1" aria-controls="solution-tabs-vertical-vertical-line-off-p1" aria-selected="false" tabindex="-1">neo app</button>
<button class="nc-solution-tabs__tab" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off-t2" aria-controls="solution-tabs-vertical-vertical-line-off-p2" aria-selected="false" tabindex="-1">neo AI</button>
</div>
<div class="nc-solution-tabs__panel nc-tab-nav__panel is-active" role="tabpanel" id="solution-tabs-vertical-vertical-line-off-p0" aria-labelledby="solution-tabs-vertical-vertical-line-off-t0">
<div class="nc-tab-nav__panel-body">
<h3 class="nc-solution-tabs__panel-title">Social Intranet und Mitarbeitendenportal</h3>
<p class="nc-solution-tabs__panel-text">Das soziale Herzstück für Ihre digitale Arbeitswelt. Informationen fließen, Teams arbeiten zusammen, und Ihr Wissen ist auf Knopfdruck verfügbar.</p>
<div class="nc-tab-nav__module">
<ul class="nc-feature-list__items">
<li class="nc-feature-list__item"><span class="nc-feature-list__icon"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false"><circle cx="18" cy="18" r="18" fill="#AEF359"></circle><path d="M12 18L16 22L24 14" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="nc-feature-list__item-text">Personalisierter News-Feed und Newskanäle</span></li>
<li class="nc-feature-list__item"><span class="nc-feature-list__icon"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false"><circle cx="18" cy="18" r="18" fill="#AEF359"></circle><path d="M12 18L16 22L24 14" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="nc-feature-list__item-text">Wissens- und Inhaltsseiten</span></li>
<li class="nc-feature-list__item"><span class="nc-feature-list__icon"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false"><circle cx="18" cy="18" r="18" fill="#AEF359"></circle><path d="M12 18L16 22L24 14" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span class="nc-feature-list__item-text">Vernetzung und Zusammenarbeit</span></li>
</ul>
</div>
<a href="#" onclick="return false" class="nc-button nc-button--accent nc-button--lg nc-solution-tabs__cta"><span>Mehr erfahren</span></a>
</div>
</div>
</div>",
    "id": "vertical-line-off",
    "label": "Standard",
    "tokenGroups": [
      "layout",
      "tabs",
    ],
  },
  {
    "html": "<div class="nc-solution-tabs nc-solution-tabs--vertical nc-tab-nav" data-autoplay="off">
<div class="nc-solution-tabs__tablist" role="tablist">
<button class="nc-solution-tabs__tab" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off--active-t0" aria-controls="solution-tabs-vertical-vertical-line-off--active-p0" aria-selected="false" tabindex="-1">neo workplace</button>
<button class="nc-solution-tabs__tab is-active" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off--active-t1" aria-controls="solution-tabs-vertical-vertical-line-off--active-p1" aria-selected="true" tabindex="0">neo app</button>
<button class="nc-solution-tabs__tab" type="button" role="tab" id="solution-tabs-vertical-vertical-line-off--active-t2" aria-controls="solution-tabs-vertical-vertical-line-off--active-p2" aria-selected="false" tabindex="-1">neo AI</button>
