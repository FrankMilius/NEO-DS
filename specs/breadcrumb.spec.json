    ],
    "story": "stories/molecules/breadcrumb.stories.js",
    "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
    "drupal": [],
    "docs": "docs/breadcrumb-docs.html"
  }
}
