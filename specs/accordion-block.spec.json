{
  "$schema": "../data/component-spec-schema.json",
  "component": "accordion-block",
  "version": "1.0.0",
  "status": "draft",
  "layer": "organism",
  "tags": [
    "content",
    "organisms",
    "website-block"
  ],
  "anatomy": {
    "rootElement": ".nc-accordion-block",
    "slots": [
      {
        "name": "inner",
        "selector": ".nc-accordion-block__inner",
        "required": true,
        "description": "Raster aus Kopf und Akkordeon; traegt zusaetzlich .nc-container (Breite und Polster)."
      },
      {
        "name": "text",
        "selector": ".nc-accordion-block__text",
        "required": true,
        "description": "Kopf (neo_fe:block-header, --flush); klebt neben dem Akkordeon (sticky)."
      },
      {
        "name": "accordion",
        "selector": ".nc-accordion-block__accordion",
        "required": true,
        "description": "Spalte mit .nc-accordion und optional .nc-accordion-toggle-all."
      }
    ],
    "notes": [
      "Website-Block neo_accordion: <section class=\"nc-section nc-accordion-block nc-accordion-block--{ratio}\"> > .nc-container.nc-accordion-block__inner > __text + __accordion.",
      "Breitenverhaeltnis ueber --nc-accordion-cols (Override --mod-accordion-cols): zwei-drittel 1fr 2fr (Vorgabe), halb 1fr 1fr, voll 1fr (Kopf oben, Lesebreite --nc-accordion-voll-measure).",
      "Die Varianten register und lese des Akkordeons erzwingen in Drupal ratio voll.",
      "Unter 768 px Fensterbreite einspaltig, Kopf nicht mehr sticky.",
      "Die Anschnittlinie kommt vom .nc-container (seit 20.08.2026 keine eigene Hoechstbreite mehr)."
    ]
  },
  "api": null,
  "variants": {
    "ratio": {
      "label": "Verhaeltnis",
      "description": "Breiten von Kopf und Akkordeon",
      "values": [
        {
          "value": "zwei-drittel",
          "cssModifier": "nc-accordion-block--zwei-drittel",
          "default": false,
          "label": "zwei-drittel"
        },
        {
          "value": "halb",
          "cssModifier": "nc-accordion-block--halb",
          "default": false,
          "label": "halb"
        },
        {
          "value": "voll",
          "cssModifier": "nc-accordion-block--voll",
          "default": false,
          "label": "voll"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "interactive": false,
    "rules": []
  },
  "cssApi": {
    "baseClasses": [
      "nc-accordion-block"
    ],
    "tokenGroups": {
      "Layout": [
        {
          "token": "--nc-accordion-cols"
        },
        {
          "token": "--nc-accordion-voll-measure"
        }
      ]
    },
    "modTokens": [
      "--mod-accordion-cols",
      "--mod-accordion-voll-measure"
    ]
  },
  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [],
    "overrides": []
  },
  "dependencies": [],
  "pipeline": {
    "scss": [
      "scss/scss/07-organisms/_accordion-block.scss"
    ],
    "story": null,
    "arena": null,
    "drupal": [
      "block/block--block-content--neo-accordion.html.twig"
    ],
    "docs": null
  }
}
