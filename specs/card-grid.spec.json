{
  "$schema": "../data/component-spec-schema.json",
  "component": "card-grid",
  "version": "1.3.1",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "display",
    "content",
    "grid",
    "cards"
  ],
  "anatomy": {
    "rootElement": ".nc-card-grid",
    "slots": [
      {
        "name": "card",
        "selector": ".nc-card",
        "required": true,
        "description": "Einzelne Card im Grid."
      },
      {
        "name": "cq",
        "selector": ".nc-card-grid-cq",
        "required": false,
        "description": "container-type: inline-size am .nc-container des Blocks — die Karten reagieren auf die Blockbreite. Steht AUSSEN."
      }
    ],
    "notes": [
      "CSS Grid mit auto-fit oder fester Spaltenanzahl. Karten aus field_cards_json, aufbereitet in includes/neo_card_grid.inc und im Twig gerendert (ohne Skript vollstaendig); Kartenbild alt=\"\", Icons (summary) als SVG aria-hidden."
    ]
  },
  "api": null,
  "variants": {
    "pattern": {
      "label": "Pattern",
      "description": "Card-Variante",
      "values": [
        {
          "value": "standard",
          "cssModifier": null,
          "default": false,
          "label": "standard"
        },
        {
          "value": "preview",
          "cssModifier": null,
          "default": false,
          "label": "preview"
        },
        {
          "value": "featured",
          "cssModifier": null,
          "default": false,
          "label": "featured"
        },
        {
          "value": "horizontal",
          "cssModifier": null,
          "default": false,
          "label": "horizontal"
        }
      ]
    },
    "animation": {
      "label": "Animation",
      "description": "Scroll-basierte Einblendanimation",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "reverse-domino",
          "cssModifier": null,
          "default": false,
          "label": "reverse-domino"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover"
    ],
    "interactive": false,
    "rules": []
  },
  "cssApi": {
    "baseClasses": [
      "nc-card-grid"
    ],
    "tokenGroups": {
      "Layout": [
        {
          "token": "--nc-card-grid-columns"
        },
        {
          "token": "--nc-card-grid-gap"
        }
      ],
      "Animation": [
        {
          "token": "--nc-card-grid-anim-duration"
        },
        {
          "token": "--nc-card-grid-anim-translate-y"
        }
      ]
    },
    "modTokens": [
      "--mod-card-grid-gap",
      "--mod-card-grid-anim-duration",
      "--mod-card-grid-anim-translate-y"
    ]
  },
  "keyboard": {
    "Tab": {
      "action": "focus-next",
      "note": "Keine eigene Bedienung: verlinkte Glieder in Dokumentreihenfolge. Die Einblendung versteckt nur optisch (opacity); ein noch nicht eingeblendetes Glied wird beim Fokussieren ins Bild gescrollt und dabei eingeblendet."
    }
  },
  "testSelectors": null,
  "events": {
    "einblenden": {
      "bubbles": true,
      "detail": {
        "reason": "string"
      },
      "note": "Gefeuert an der Wurzel beim Einblenden (Behavior einblenden): reason \"sicht\" (15 % im Bild), \"reduzierte-bewegung\" oder \"ohne-beobachter\" (sofort). Erneutes Binden einer schon eingeblendeten Wurzel meldet nicht."
    }
  },
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [],
    "overrides": []
  },
  "dependencies": [
    "card"
  ],
  "pipeline": {
    "scss": [],
    "story": "stories/organisms/card-grid.stories.js",
    "arena": null,
    "drupal": [
      "block--block-content--neo-card-grid.html.twig",
      "block--inline-block--neo-card-grid.html.twig",
      "includes/neo_card_grid.inc (Karten aus field_cards_json, neo_cg_cards)"
    ],
    "docs": null
  }
}
