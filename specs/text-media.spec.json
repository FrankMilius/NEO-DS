{
  "$schema": "../data/component-spec-schema.json",
  "component": "text-media",
  "version": "1.1.2",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "display",
    "content",
    "media",
    "split-layout"
  ],
  "anatomy": {
    "rootElement": ".nc-text-media",
    "slots": [
      {
        "name": "media",
        "selector": ".nc-text-media__media",
        "required": true,
        "description": "Video oder Bild."
      },
      {
        "name": "content",
        "selector": ".nc-text-media__content",
        "required": true,
        "description": "Headline, Subline, CTA."
      }
    ],
    "notes": [
      "Grid: 2 Spalten, media + content. Responsive: stacked auf mobile.",
      "ACHTUNG Divergenz DS <-> Drupal: im DS ist .nc-text-media selbst das Grid (Container-Queries). Das Drupal-Template nutzt ein zusaetzliches .nc-text-media__grid, das in neo-overrides.css gestylt wird. Die Modifier greifen dort.",
      "Ohne Medium darf der Medien-Container NICHT gerendert werden - sonst bleibt bei 1fr 1fr eine leere Spalte stehen (gemessen: 487px ungenutzt, Text nur 48% Breite).",
      "media-right tauscht per order, nicht per DOM-Reihenfolge - die Vorlesereihenfolge bleibt damit unveraendert."
    ]
  },
  "api": null,
  "variants": {
    "layout": {
      "label": "Layout",
      "description": "Media links oder rechts",
      "values": [
        {
          "value": "media-left",
          "cssModifier": null,
          "default": false,
          "label": "media-left"
        },
        {
          "value": "media-right",
          "cssModifier": "nc-text-media--reversed",
          "default": false,
          "label": "media-right"
        }
      ]
    },
    "textAlign": {
      "label": "Text Alignment (no media)",
      "description": "Ausrichtung des Textblocks, wenn KEIN Medium gesetzt ist. Mit Medium bestimmt layout die Anordnung.",
      "values": [
        {
          "value": "left",
          "cssModifier": null,
          "default": true,
          "label": "left"
        },
        {
          "value": "center",
          "cssModifier": null,
          "default": false,
          "label": "center"
        },
        {
          "value": "right",
          "cssModifier": null,
          "default": false,
          "label": "right"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "interactive": false,
    "rules": []
  },
  "cssApi": {
    "baseClasses": [
      "nc-text-media"
    ],
    "tokenGroups": {
      "Layout": [
        {
          "token": "--nc-text-media-gap"
        },
        {
          "token": "--nc-text-media-headline-size"
        },
        {
          "token": "--nc-text-media-subline-color"
        },
        {
          "token": "--nc-text-media-content-gap"
        },
        {
          "token": "--nc-text-media-video-radius"
        }
      ],
      "Geraeterahmen": [
        {
          "token": "--nc-text-media-device-width"
        }
      ]
    },
    "modTokens": [
      "--mod-text-media-gap",
      "--mod-text-media-content-gap",
      "--mod-text-media-video-radius",
      "--mod-text-media-device-width"
    ]
  },
  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [],
    "overrides": []
  },
  "dependencies": [],
  "pipeline": {
    "scss": [
      "scss/scss/07-organisms/_text-media.scss"
    ],
    "story": "stories/organisms/text-media.stories.js",
    "arena": null,
    "drupal": [
      "block--block-content--neo-text-media.html.twig",
      "block--inline-block--neo-text-media.html.twig"
    ],
    "docs": null
  }
}
