{
  "$schema": "../data/component-spec-schema.json",
  "component": "expanding-panels",
  "version": "1.1.0",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "display",
    "content",
    "interactive",
    "disclosure"
  ],
  "anatomy": {
    "rootElement": ".nc-expanding-panels",
    "slots": [
      {
        "name": "panel",
        "selector": ".nc-expanding-panels__panel",
        "required": true,
        "description": "Einzelnes Panel. <button> mit aria-expanded. Expandiert bei Hover/Fokus/Aktiv via flex-grow."
      },
      {
        "name": "label",
        "selector": ".nc-expanding-panels__label",
        "required": true,
        "description": "Vertikales Label im Ruhezustand. Wird beim Expandieren ausgeblendet."
      },
      {
        "name": "num",
        "selector": ".nc-expanding-panels__num",
        "required": false,
        "description": "Laufende Nummer oben links."
      },
      {
        "name": "body",
        "selector": ".nc-expanding-panels__body",
        "required": true,
        "description": "Detail-Inhalt, sichtbar wenn Panel aktiv. Enthaelt Chip, Titel, Text."
      },
      {
        "name": "bg",
        "selector": ".nc-expanding-panels__bg",
        "required": false,
        "description": "Dekorativer Radial-Hintergrund pro Panel. aria-hidden."
      }
    ],
    "notes": [
      "Root .nc-expanding-panels: display:flex, gap, feste Hoehe (--nc-expanding-panels-height).",
      "Panel: button[aria-expanded], flex:1; bei :hover/:focus-within/[aria-expanded=true] flex-grow:--nc-expanding-panels-grow.",
      "Label (.nc-expanding-panels__label): writing-mode:vertical-rl + rotate(180deg); opacity:0 wenn Panel aktiv.",
      "Body (.nc-expanding-panels__body): position:absolute, justify-content:flex-end; opacity:0/translateY bis aktiv.",
      "Chip im Body: margin-bottom:auto schiebt ihn nach oben.",
      "Single-Open: JS setzt aria-expanded='true' am geklickten Panel, 'false' an allen anderen; initial erstes Panel aktiv.",
      "Tastatur: Enter/Space aktiviert (nativer Button-Klick); ArrowLeft/Right wechselt das aktive Panel.",
      "Responsive 820px: flex-direction:column (vertikales Akkordeon); Label horizontal; Body zentriert.",
      "prefers-reduced-motion: keine Transitions."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Einzige Variante",
      "values": [
        {
          "value": "default",
