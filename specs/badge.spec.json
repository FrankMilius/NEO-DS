  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "doNotRelyOnColorOnly"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "decorator": [
              "dot"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Dot-Mode benoetigt immer ein begleitendes Text-Label oder aria-label. Dot allein ist nicht zugaenglich."
      },
      {
        "when": {
          "axes": {
            "decorator": [
              "counter"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-label"
        ],
        "note": "Counter zeigt visuell '99+', aber aria-label muss den echten Wert enthalten (z.B. aria-label='142 Benachrichtigungen')."
      }
    ]
  },
