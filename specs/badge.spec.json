{
  "$schema": "../data/component-spec-schema.json",
  "component": "badge",
  "version": "2.2.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "static",
    "indicator",
    "label"
  ],
  "anatomy": {
    "rootElement": ".nc-badge",
    "slots": [
      {
        "name": "icon",
        "selector": ".nc-badge__icon",
        "required": false,
        "description": null
      },
      {
        "name": "label",
        "selector": ".nc-badge__label",
        "required": true,
        "description": null
      }
    ],
    "notes": [
      "Badge ist NIEMALS fokussierbar — immer <span>, kein role='button', kein tabindex.",
      "Farbe nie als einziges Signal verwenden — immer mit Text oder Icon kombinieren.",
      "Dot-Mode: slot-loses Display, zeigt nur Farbe ohne Text. Benoetigt begleitendes aria-label.",
      "Counter-Mode: numerischer Inhalt mit min-width fuer gleichmaessige Kreise.",
      "Decorator-Mode: position:absolute auf Parent (braucht position:relative). Ring-Shadow fuer Abgrenzung.",
      "Pulse-Animation: --dot.--pulse fuer kritische Status (error). Dezentes Pulsieren.",
      "Status-String: --status-string — reiner Text ohne BG, fuer Tabellen / dichte UIs."
    ]
  },
  "api": null,
  "variants": {
    "tone": {
      "label": "Tone",
      "description": "Farb-Semantik der Badge",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "secondary",
          "cssModifier": "nc-badge--secondary",
          "default": false,
          "label": "secondary"
        },
        {
          "value": "success",
          "cssModifier": "nc-badge--success",
          "default": false,
          "label": "success"
        },
        {
          "value": "warning",
          "cssModifier": "nc-badge--warning",
          "default": false,
          "label": "warning"
        },
        {
          "value": "error",
          "cssModifier": "nc-badge--error",
          "default": false,
          "label": "error"
        },
        {
          "value": "info",
          "cssModifier": "nc-badge--info",
          "default": false,
          "label": "info"
        }
      ]
    },
    "emphasis": {
      "label": "Emphasis",
      "description": "Visuelle Gewichtung — Solid (Standard), Outline (Rand), Soft (reduzierte Deckkraft)",
      "values": [
        {
          "value": "solid",
          "cssModifier": null,
          "default": false,
          "label": "solid"
        },
        {
          "value": "outline",
          "cssModifier": "nc-badge--outline",
          "default": false,
          "label": "outline"
        },
        {
          "value": "soft",
          "cssModifier": "nc-badge--soft",
          "default": false,
          "label": "soft"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "Groessenabstufung — SM (20px) / MD (24px, Standard)",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-badge--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        }
      ]
    },
    "decorator": {
      "label": "Decorator",
      "description": "Zusaetzliche visuelle Elemente oder Render-Modi",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "icon",
          "cssModifier": null,
          "default": false,
          "label": "icon"
        },
        {
          "value": "dot",
          "cssModifier": "nc-badge--dot",
          "default": false,
          "label": "dot"
        },
        {
          "value": "counter",
          "cssModifier": null,
          "default": false,
          "label": "counter"
        },
        {
          "value": "decorator",
          "cssModifier": "nc-badge--decorator",
          "default": false,
          "label": "decorator"
        },
        {
          "value": "pulse",
          "cssModifier": "nc-badge--dot nc-badge--pulse",
          "default": false,
          "label": "pulse"
        },
        {
          "value": "status-string",
          "cssModifier": "nc-badge--status-string",
          "default": false,
          "label": "status-string"
        }
      ]
    }
  },
  "states": {
