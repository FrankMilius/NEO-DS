  "tags": [
    "interactive",
    "form",
    "navigation",
    "combobox"
  ],
  "anatomy": {
    "rootElement": ".nc-search",
    "slots": [
      {
        "name": "input-wrapper",
        "selector": ".nc-search__input-wrapper",
        "required": true,
        "description": null
      },
      {
