  "keyboard": {
    "ArrowDown": {
      "action": "highlight-next",
      "note": "Oeffnet die Liste und markiert den naechsten sichtbaren Eintrag (rundum, aria-activedescendant)."
    },
    "ArrowUp": {
      "action": "highlight-prev",
      "note": "Oeffnet die Liste und markiert den vorherigen sichtbaren Eintrag (rundum)."
    },
    "Enter": {
      "action": "select-highlighted",
      "note": "Uebernimmt den markierten Eintrag ins Feld und schliesst die Liste."
    },
    "Escape": {
      "action": "close",
      "note": "Schliesst die Ergebnisliste."
    },
    "Tab": {
      "action": "close",
      "note": "Fokus verlaesst die Suche — die Liste schliesst."
    }
  },
  "testSelectors": null,
  "events": {
    "search-open": {
      "bubbles": true,
      "detail": {
        "open": "boolean"
      },
      "note": "Gefeuert wenn die Ergebnisliste auf- oder zugeht."
    },
    "search-select": {
      "bubbles": true,
      "detail": {
        "value": "string"
      },
      "note": "Gefeuert wenn ein Eintrag gewaehlt wird (Enter oder Klick)."
    }
  },
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "resultsState": [
              "empty"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-live"
        ],
        "note": "Empty-State: 'Keine Ergebnisse' via aria-live='polite' ankuendigen."
      },
      {
        "when": {
          "axes": {
            "resultsState": [
              "loading"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-busy"
        ],
        "note": "Loading-State: aria-busy='true' auf dem Results-Container."
      },
      {
        "when": {
          "axes": {
            "scope": [
              "scoped"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-label"
        ],
        "note": "Scope-Trigger: aria-label beschreibt aktuellen Suchbereich."
      },
      {
        "when": {
          "axes": {
            "width": [
              "viewport"
            ]
          }
        },
        "require": [
          "focus-trap",
          "aria-modal"
        ],
        "suggest": [],
        "note": "Mobile Full-Screen: Focus-Trap aktiv, aria-modal='true', Escape schliesst."
      },
      {
        "when": {
          "slots": [
            "clear-trigger"
          ]
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Clear-Trigger: aria-label='Suche zuruecksetzen'. Nur sichtbar bei value.length > 0."
      }
    ]
  },
