      "--mod-form-control-minimal-border-focus",
      "--mod-input-label-color",
      "--mod-input-label-color-focus",
      "--mod-input-label-font-size",
      "--mod-input-label-font-size-float",
      "--mod-input-label-offset-y",
      "--mod-input-label-scale",
      "--mod-input-label-padding-top",
      "--mod-input-affix-color",
      "--mod-input-affix-font-size",
      "--mod-input-affix-padding-x",
