{
  "$schema": "../data/component-spec-schema.json",
  "component": "input",
  "version": "2.0.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "interactive",
    "form",
    "text-input"
  ],
  "anatomy": {
    "rootElement": ".nc-input",
    "slots": [
      {
        "name": "label",
        "selector": ".nc-input__label",
        "required": true,
        "description": "Floating Label — bewegt sich beim Focus/Not-Empty nach oben. Pflicht fuer Accessibility."
      },
      {
        "name": "icon",
        "selector": ".nc-input__icon",
        "required": false,
        "description": null
      },
      {
        "name": "icon-end",
        "selector": ".nc-input__icon--end",
        "required": false,
        "description": null
      },
      {
        "name": "prefix-text",
        "selector": ".nc-input__prefix",
        "required": false,
        "description": "Text-Praefix (z.B. 'https://', 'EUR'). Nicht klickbar, rein dekorativ."
      },
      {
        "name": "suffix-text",
        "selector": ".nc-input__suffix",
        "required": false,
        "description": "Text-Suffix (z.B. '€', 'kg', '.com'). Nicht klickbar, rein dekorativ."
      },
      {
        "name": "clear",
        "selector": ".nc-input__clear",
        "required": false,
        "description": "Clear-Button (×). Sichtbar nur wenn Input nicht leer (:not(:placeholder-shown))."
      }
    ],
    "notes": [
      "Input ist immer ein <input> Element mit type='text|email|url|tel|password|search|number|color'.",
      "Icon-Prefix/Suffix, Label und Text-Affixe erfordern .nc-input-wrapper als Container.",
      "Search-Typ: padding-left fuer Lupe. Password-Typ: padding-right fuer Reveal-Toggle.",
      ":focus-visible triggert Focus-Ring. :disabled und [aria-disabled] haben eigenes Styling.",
      "[readonly] hat eigene BG/Border-Tokens — kein disabled-Opacity.",
      "Error kann per .nc-input--error ODER [aria-invalid='true'] gesetzt werden.",
      "Floating Label: Label steht initial ueber dem Placeholder. Bei :focus oder :not(:placeholder-shown) schwebt es nach oben (transform + font-size).",
      "Text-Affixe (.nc-input__prefix / .nc-input__suffix) sind inline-flex Elemente mit eigener Geometrie. Input-Padding wird automatisch angepasst.",
      "Clear-Button ist per CSS unsichtbar wenn :placeholder-shown aktiv ist. Sichtbar sobald Inhalt vorhanden.",
      "Touch-Target: Ein ::after Pseudo-Element auf .nc-input sichert min 44x44px Klickflaeche, auch bei sm-Groesse."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — outlined (Standard, Rahmen), filled (Flaeche mit Unterstreichung), borderless (minimalistisch, In-Line Editing)",
      "values": [
        {
          "value": "outlined",
          "cssModifier": null,
          "default": false,
          "label": "outlined"
        },
        {
          "value": "filled",
          "cssModifier": "nc-input--filled",
          "default": false,
          "label": "filled"
        },
        {
          "value": "borderless",
          "cssModifier": "nc-input--borderless",
          "default": false,
          "label": "borderless"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px)",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-input--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-input--lg",
          "default": false,
          "label": "lg"
        }
      ]
    },
    "type": {
      "label": "Type",
      "description": "Input-Typ — text (Standard), search (Lupe links), password (Reveal rechts)",
      "values": [
        {
          "value": "text",
          "cssModifier": null,
          "default": false,
          "label": "text"
        },
        {
          "value": "search",
          "cssModifier": "nc-input--search",
          "default": false,
          "label": "search"
        },
        {
          "value": "password",
          "cssModifier": "nc-input--password",
          "default": false,
          "label": "password"
        }
      ]
    },
    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "error",
          "cssModifier": "nc-input--error",
          "default": false,
          "label": "error"
        },
        {
          "value": "success",
          "cssModifier": "nc-input--success",
          "default": false,
          "label": "success"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus",
      "disabled",
      "readonly",
      "not-empty"
    ],
    "interactive": true,
    "rules": [
      {
        "state": "hover",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "focus",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "readonly",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "not-empty",
        "effects": [],
        "attributes": {},
        "description": null
      }
    ]
  },
  "cssApi": {
    "baseClasses": [
      "nc-input"
    ],
    "tokenGroups": {
      "Geometry": [
        {
          "token": "--nc-input-height-sm"
        },
        {
          "token": "--nc-input-height-md"
        },
        {
          "token": "--nc-input-height-lg"
        },
        {
          "token": "--nc-input-padding-x-sm"
        },
        {
          "token": "--nc-input-padding-x-md"
        },
        {
          "token": "--nc-input-padding-x-lg"
        },
        {
          "token": "--nc-input-padding-y-sm"
        },
        {
          "token": "--nc-input-padding-y-md"
        },
        {
          "token": "--nc-input-padding-y-lg"
        },
        {
          "token": "--nc-input-font-size-sm"
        },
        {
          "token": "--nc-input-font-size-md"
