  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "suggest": [],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby das auf die Fehlermeldung verweist."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt, wenn Input Teil eines Formulars ist das noch sichtbar bleiben soll."
      },
      {
        "when": {
          "axes": {
            "type": [
              "search"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-search"
        ],
        "note": "Search-Input sollte in einem <form role='search'> oder <search> Element stehen."
      },
      {
        "when": {
          "slots": [
            "clear"
          ]
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Clear-Button braucht aria-label (z.B. 'Eingabe loeschen'). Typ button, nicht submit."
      },
      {
        "when": {
          "slots": [
            "prefix-text",
            "suffix-text"
          ]
        },
        "require": [],
        "suggest": [
          "aria-describedby"
        ],
        "note": "Text-Affixe sollten per aria-describedby mit dem Input verknuepft sein, damit Screenreader den Kontext vermitteln."
      }
    ]
  },
  "dependencies": [],
