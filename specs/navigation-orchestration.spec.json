        "required": false,
        "description": null
      },
      {
        "name": "nav-badge",
        "selector": ".nc-nav__badge",
        "required": false,
        "description": null
      },
      {
        "name": "mobile-toggle",
        "selector": ".nc-mobile-toggle",
        "required": false,
        "description": null
      },
      {
        "name": "actions",
        "selector": ".nc-nav__actions",
        "required": false,
        "description": null
      },
      {
        "name": "tools",
        "selector": ".nc-tools",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Ebene 1 — Shell: .nc-shell__navbar Slot reserviert die Grid-Row. nc-shell-z-navbar bestimmt den Z-Index.",
      "Ebene 2 — Navigation: .nc-header fuellt den Shell-Slot. Sticky, Blur, Emphasis, Mobile-Toggle.",
      "Ebene 3 — NavigationMenu: .nc-navigation-menu sitzt in .nc-nav__inner. Steuert Link-Verteilung und Dropdowns.",
      "Ebene 4 — Nav-Molecules: .nc-nav__link wird als Item im Menu gerendert. Shared Hover/Active Tokens.",
      "Ebene 5 — Nav-Atoms: .nc-nav__icon + .nc-nav__label werden innerhalb der Links genutzt. Konsistente 24px Icons.",
      "Mobile: Unterhalb lg wird .nc-navigation-menu ausgeblendet, .nc-mobile-toggle eingeblendet → Shell Drawer."
    ]
  },
  "api": null,
  "variants": {
    "viewport": {
      "label": "Viewport",
      "description": "Responsive Modus — desktop (Navigation-Menu sichtbar), mobile (Hamburger → Drawer)",
      "values": [
        {
          "value": "desktop",
          "cssModifier": null,
          "default": false,
          "label": "desktop"
        },
        {
          "value": "mobile",
          "cssModifier": null,
          "default": false,
          "label": "mobile"
        }
      ]
    },
    "density": {
      "label": "Density",
      "description": "Gesamtdichte der Navigation — default, compact (reduzierte Hoehe/Gaps)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "compact",
          "cssModifier": "nc-header--compact",
          "default": false,
          "label": "compact"
        }
      ]
    }
  },
