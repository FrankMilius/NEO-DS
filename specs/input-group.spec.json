  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-invalid",
          "aria-describedby"
        ],
        "note": "Error: aria-invalid='true' auf dem Input. Fehlermeldung via aria-describedby."
      },
      {
        "when": {
          "axes": {
            "validation": [
              "success"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-describedby"
        ],
        "note": "Success: Erfolgsmeldung via aria-describedby. Kein aria-invalid."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "Disabled: disabled-Attribut auf dem Input."
      },
      {
        "when": {
          "states": [
            "readonly"
          ]
        },
        "require": [],
        "suggest": [
          "aria-readonly"
        ],
        "note": "Readonly: readonly-Attribut auf dem Input. aria-readonly='true' fuer assistive Technologien."
      }
    ]
  },
  "dependencies": [
