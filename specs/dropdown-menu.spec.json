{
  "$schema": "../data/component-spec-schema.json",
  "component": "dropdown-menu",
  "version": "2.0.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "interactive",
    "navigation",
    "action",
    "selection"
  ],
  "anatomy": {
    "rootElement": ".nc-dropdown",
    "slots": [
      {
        "name": "trigger",
        "selector": ".nc-dropdown__trigger",
        "required": true,
        "description": null
