    "overrides": [
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "Disabled Items: aria-disabled='true' oder disabled-Attribut. Nicht fokussierbar."
      },
      {
        "when": {
          "axes": {
            "itemVariant": [
              "danger"
            ]
          }
        },
        "require": [],
        "suggest": [],
        "note": "Danger-Items: Farbe allein ist kein Signal — Label muss die destruktive Aktion beschreiben (z.B. 'Loeschen')."
      },
      {
        "when": {
          "axes": {
            "selectionMode": [
              "single"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-menuitemradio",
          "aria-checked"
        ],
        "note": "Single-Select: Items muessen role='menuitemradio' und aria-checked='true|false' haben. Screen Reader meldet 'Radiobutton, aktiviert'."
      },
      {
        "when": {
          "axes": {
            "selectionMode": [
              "multiple"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-menuitemcheckbox",
          "aria-checked"
        ],
        "note": "Multi-Select: Items muessen role='menuitemcheckbox' und aria-checked='true|false' haben. Screen Reader meldet 'Kontrollkaestchen, aktiviert'."
      },
      {
        "when": {
          "axes": {
            "content": [
              "with-submenu"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-haspopup-menu",
          "aria-expanded"
        ],
        "note": "Submenu-Item: aria-haspopup='menu', aria-expanded='true|false'. Keyboard: ArrowRight oeffnet Submenu, ArrowLeft/Escape schliesst es."
      }
    ]
