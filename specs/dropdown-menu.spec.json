        "required": true,
        "description": null
      },
      {
        "name": "item",
        "selector": ".nc-dropdown__item",
        "required": true,
        "description": null
      },
      {
        "name": "item-check",
        "selector": ".nc-dropdown__item-check",
        "required": false,
        "description": null
      },
      {
        "name": "item-icon",
        "selector": ".nc-dropdown__item-icon",
        "required": false,
        "description": null
      },
      {
        "name": "item-label",
        "selector": ".nc-dropdown__item-label",
        "required": false,
        "description": null
      },
      {
        "name": "item-shortcut",
        "selector": ".nc-dropdown__item-shortcut",
        "required": false,
        "description": null
