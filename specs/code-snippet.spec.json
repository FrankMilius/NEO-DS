{
  "$schema": "../data/component-spec-schema.json",
  "component": "code-snippet",
  "version": "2.0.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "static",
    "content",
    "code"
  ],
  "anatomy": {
    "rootElement": ".nc-code-snippet",
    "slots": [
      {
        "name": "header",
        "selector": ".nc-code-snippet__header",
        "required": false,
        "description": null
      },
      {
        "name": "pre",
        "selector": ".nc-code-snippet__pre",
        "required": true,
        "description": null
      },
      {
        "name": "code",
        "selector": ".nc-code-snippet__code",
        "required": true,
        "description": null
      },
      {
        "name": "line",
        "selector": ".nc-code-snippet__line",
        "required": false,
        "description": null
      },
      {
        "name": "copy",
        "selector": ".nc-code-snippet__copy",
        "required": false,
        "description": null
      },
      {
        "name": "show-more",
        "selector": ".nc-code-snippet__show-more",
        "required": false,
        "description": null
      },
      {
        "name": "label",
        "selector": ".nc-code-snippet__label",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Inline: <code class='nc-code-snippet nc-code-snippet--inline'>. Kein Copy-Button.",
      "Single: <div class='nc-code-snippet nc-code-snippet--single'><pre><code>. Copy-Button oben rechts.",
      "Multi:  <div class='nc-code-snippet nc-code-snippet--multi'><pre><code>. Copy-Button + Show-More.",
      "Copy-Button: aria-label='Code kopieren'. Dual-Icon Pattern (Copy → Check bei Erfolg).",
      "Copy-Tooltip: .nc-code-snippet__copy-tooltip — erscheint bei Erfolg unter dem Copy-Button.",
      "Show-More: aria-expanded='true/false'. Gradient-Fade im collapsed Zustand.",
      "Header: optionale Titelleiste mit Dateiname. Plain/macOS/Window-Varianten.",
      "macOS-Dots: .nc-code-snippet__header-dot--close/--minimize/--maximize. Dekorativ.",
      "Zeilennummern: CSS-Counter auf .nc-code-snippet__line::before. user-select:none.",
      "Zeilen-Highlight: .nc-code-snippet__line--highlighted — farbige Hervorhebung.",
      "Wrap: white-space:pre-wrap statt horizontalem Scroll.",
      "Sprach-Label (optional): Badge oben links mit Sprach-Kennung (z.B. 'HTML', 'SCSS').",
      "Syntax-Highlighting via Prism.js — .token-Klassen werden auf --nc-cs-syntax-* Tokens gemappt."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Anzeige-Typ — inline (Fliesstext), single-line (Block, 1 Zeile), multi-line (Block, collapsible)",
      "values": [
        {
          "value": "inline",
          "cssModifier": "nc-code-snippet--inline",
          "default": false,
          "label": "inline"
        },
        {
          "value": "single",
          "cssModifier": "nc-code-snippet--single",
          "default": false,
          "label": "single"
        },
        {
          "value": "multi",
          "cssModifier": "nc-code-snippet--multi",
          "default": false,
          "label": "multi"
        }
      ]
    },
    "header": {
      "label": "Header",
      "description": "Titelleisten-Stil — none (kein Header), plain (Dateiname), macos (Traffic-Light Dots), window (Fensterleiste)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "plain",
          "cssModifier": "nc-code-snippet--header-plain",
          "default": false,
          "label": "plain"
        },
        {
          "value": "macos",
          "cssModifier": "nc-code-snippet--header-macos",
          "default": false,
          "label": "macos"
        },
        {
          "value": "window",
          "cssModifier": "nc-code-snippet--header-window",
          "default": false,
          "label": "window"
        }
      ]
    },
    "wrap": {
      "label": "Line Wrapping",
      "description": "Zeilenumbruch — none (horizontaler Scroll), wrap (Umbruch bei langen Zeilen)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "wrap",
          "cssModifier": "nc-code-snippet--wrap",
          "default": false,
          "label": "wrap"
        }
      ]
    },
    "features": {
      "label": "Features",
      "description": "Zusaetzliche Funktionen — default, with-line-numbers (Zeilennummern), line-highlight (Zeilen hervorheben)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "with-line-numbers",
          "cssModifier": "nc-code-snippet--with-line-numbers",
          "default": false,
          "label": "with-line-numbers"
        },
        {
          "value": "line-highlight",
          "cssModifier": "nc-code-snippet--line-highlight",
          "default": false,
          "label": "line-highlight"
        }
      ]
    },
    "syntax": {
      "label": "Syntax",
      "description": "Syntax-Highlighting aktivieren oder deaktivieren",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "highlighted",
          "cssModifier": null,
          "default": false,
          "label": "highlighted"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "expanded"
    ],
    "interactive": false,
    "rules": [
      {
        "state": "expanded",
        "effects": [],
        "attributes": {},
        "description": null
      }
    ]
