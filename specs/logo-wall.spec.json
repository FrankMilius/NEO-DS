{
  "$schema": "../data/component-spec-schema.json",
  "component": "logo-wall",
  "version": "2.3.1",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "display",
    "branding",
    "logos",
    "partner",
    "marquee"
  ],
  "anatomy": {
    "rootElement": ".nc-logo-wall",
    "slots": [
      {
        "name": "pill",
        "selector": ".nc-logo-pill",
        "required": true,
        "description": "Einzelnes Logo-Item. Flex-Container mit Border, Radius, Padding."
      },
      {
        "name": "track",
        "selector": ".nc-logo-wall__track",
        "required": false,
        "description": "Marquee-Track. Flex-Container mit verdoppeltem Inhalt fuer Endlosschleife."
      },
      {
        "name": "pause",
        "selector": ".nc-logo-wall__pause",
        "required": false,
        "description": "Pause-Knopf des Laufbands vor der Spur (WCAG 2.2.2): Symbol .nc-logo-wall__pause-icon (Pfade -pause/-play, Wahl per data-playing) und Beschriftung .nc-logo-wall__pause-label „Laufband anhalten“/„Laufband fortsetzen“; Tokens und Verhalten aus marquee."
      }
    ],
    "notes": [
      "Root: display:grid (default), display:flex (marquee/cluster). Gap via Token.",
      "Pill: Flex-Container, align-items:center, justify-content:center. Border + Radius + Shadow.",
      "Pill-Img: object-fit:contain. Max-height begrenzt Logo-Groesse.",
      "Monochrome: CSS filter:grayscale(100%) auf Img. Hover entfernt Filter.",
      "Fade-In: neo-behaviors einblenden (Plan v4, Phase 6b) setzt .is-visible + transition-delay pro Index (IntersectionObserver); ausgeblendet nur, solange es gebunden ist (data-neo-behavior~=\"einblenden\"). Nicht im Laufband.",
      "Cluster: flex-wrap:wrap, justify-content:center. Organisches Layout.",
      "prefers-reduced-motion: Marquee stoppt. Fade-In ohne Animation.",
      "Marquee: Wurzel als Block; Knopf .nc-logo-wall__pause, dann die Spur (.nc-logo-wall__track, max-content) mit dupliziertem Inhalt, @keyframes translateX(-50%). Kopien aria-hidden, Links darin tabindex=-1 (neo-behaviors marquee; nicht inert, Maus und Hover bleiben); Ruhe per .is-paused/.is-stopped (ungebunden :hover).",
      "Name: img alt bzw. Text der Pille — kein aria-label an Pille oder Wand (div ohne Rolle). Externe Links (target=_blank) mit .u-sr-only „öffnet in neuem Fenster“."
    ]
  },
  "api": null,
  "variants": {
    "layout": {
      "label": "Layout",
      "description": "Anordnung — grid (responsives Raster), marquee (Endlos-Ticker), cluster (organisch)",
      "values": [
        {
          "value": "grid",
          "cssModifier": null,
          "default": false,
          "label": "grid"
        },
        {
          "value": "marquee",
          "cssModifier": "nc-logo-wall--marquee",
          "default": false,
          "label": "marquee"
        },
        {
          "value": "cluster",
          "cssModifier": "nc-logo-wall--cluster",
          "default": false,
          "label": "cluster"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "Groesse der Logo-Boxen — sm (kompakt/Footer), md (Standard), lg (Feature)",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-logo-wall--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-logo-wall--lg",
          "default": false,
          "label": "lg"
        }
      ]
    },
    "appearance": {
      "label": "Appearance",
      "description": "Darstellung — original (Markenfarben), mono (Grayscale, Hover = Farbe)",
      "values": [
        {
          "value": "original",
          "cssModifier": null,
          "default": false,
          "label": "original"
        },
        {
          "value": "mono",
          "cssModifier": "nc-logo-wall--mono",
          "default": false,
          "label": "mono"
        }
      ]
    },
    "animation": {
      "label": "Animation",
      "description": "Einblendung — none (sofort), fadein (gestaffeltes Einblenden per Intersection Observer)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "fadein",
          "cssModifier": "nc-logo-wall--fadein",
          "default": false,
          "label": "fadein"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "paused",
      "stopped"
    ],
    "interactive": false,
    "rules": [
      {
        "state": "hover",
        "effects": [],
