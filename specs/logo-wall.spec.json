  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "layout": [
              "marquee"
            ]
          }
        },
        "require": [],
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Marquee muss bei prefers-reduced-motion pausieren."
      },
      {
        "when": {
          "axes": {
            "animation": [
              "fadein"
            ]
          }
        },
        "require": [],
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Fade-In bei reduced-motion deaktivieren."
      }
    ]
  },
  "dependencies": [],
  "pipeline": {
    "scss": [
