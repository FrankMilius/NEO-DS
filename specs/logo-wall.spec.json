  "keyboard": {
    "Tab": {
      "action": "focus-next",
      "note": "Keine eigene Bedienung: verlinkte Glieder in Dokumentreihenfolge. Die Einblendung versteckt nur optisch (opacity); ein noch nicht eingeblendetes Glied wird beim Fokussieren ins Bild gescrollt und dabei eingeblendet."
    }
  },
  "testSelectors": null,
  "events": {
    "einblenden": {
      "bubbles": true,
      "detail": {
        "reason": "string"
      },
      "note": "Gefeuert an der Wurzel beim Einblenden (Behavior einblenden): reason \"sicht\" (15 % im Bild), \"reduzierte-bewegung\" oder \"ohne-beobachter\" (sofort). Erneutes Binden einer schon eingeblendeten Wurzel meldet nicht."
    }
  },
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "2.2.2: Laufband mit Pause-Knopf vor der Spur (Beschriftung wechselt), Maus/Fokus halten voruebergehend an, prefers-reduced-motion: stehend (Behavior marquee).",
      "2.4.3/4.1.2: Kopien im Laufband aria-hidden mit tabindex=-1 — nicht per Tab erreichbar, nicht vorgelesen, mit der Maus anklickbar.",
      "4.1.2: Kein aria-label an div ohne Rolle; Name aus alt bzw. Linktext.",
      "3.2.5/2.4.4: Externe Links mit Hinweis „öffnet in neuem Fenster“ (.u-sr-only)."
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "layout": [
              "marquee"
            ]
          }
        },
        "require": [],
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Marquee muss bei prefers-reduced-motion pausieren."
      },
      {
        "when": {
          "axes": {
            "animation": [
              "fadein"
            ]
          }
        },
        "require": [],
        "suggest": [
          "prefers-reduced-motion"
        ],
        "note": "Fade-In bei reduced-motion deaktivieren."
      }
    ]
  },
