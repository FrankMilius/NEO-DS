    "modTokens": [
      "--mod-logo-wall-gap",
      "--mod-logo-wall-padding-block",
      "--mod-logo-wall-padding-inline",
      "--mod-logo-wall-grid-min",
      "--mod-logo-wall-align",
      "--mod-logo-wall-item-bg",
      "--mod-logo-wall-item-border",
      "--mod-logo-wall-item-border-width",
      "--mod-logo-wall-item-radius",
      "--mod-logo-wall-item-padding",
      "--mod-logo-wall-item-aspect-ratio",
      "--mod-logo-wall-item-shadow",
      "--mod-logo-wall-item-transition",
      "--mod-logo-wall-item-width-sm",
      "--mod-logo-wall-item-width-lg",
      "--mod-logo-wall-logo-max-height",
      "--mod-logo-wall-logo-opacity",
      "--mod-logo-wall-logo-filter",
      "--mod-logo-wall-logo-filter-hover",
      "--mod-logo-wall-logo-opacity-hover",
      "--mod-logo-wall-font-size",
      "--mod-logo-wall-font-weight",
      "--mod-logo-wall-color",
      "--mod-logo-wall-marquee-speed",
      "--mod-logo-wall-marquee-gap",
      "--mod-logo-wall-fadein-duration",
      "--mod-logo-wall-fadein-easing",
