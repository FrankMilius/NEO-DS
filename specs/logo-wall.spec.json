    "story": "stories/molecules/logo-wall.stories.js",
    "arena": null,
    "drupal": [
      "block--block-content--neo-logo-wall.html.twig",
      "block--inline-block--neo-logo-wall.html.twig"
    ],
    "docs": "docs/logo-wall-docs.html"
  }
}
