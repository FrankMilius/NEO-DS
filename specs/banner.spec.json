      "action": "dismiss",
      "note": "Wie Enter auf dem Schliessen-Knopf."
    }
  },
  "testSelectors": null,
  "events": {
    "banner-dismiss": {
      "bubbles": true,
      "detail": {
        "reason": "string",
        "id": "string"
      },
      "note": "Gefeuert beim Schliessen (reason: 'close'). id: data-banner-id oder null."
    }
