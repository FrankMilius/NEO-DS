      "values": [
        {
          "value": "solid",
          "cssModifier": null,
          "default": false,
          "label": "solid"
        },
        {
          "value": "accent",
          "cssModifier": "nc-banner--accent",
          "default": false,
          "label": "accent"
        }
      ]
    },
    "content": {
      "label": "Content",
      "description": "Inhaltsvariante — text-only, with-icon, with-title, with-link, with-close, full",
      "values": [
        {
          "value": "text-only",
          "cssModifier": null,
          "default": false,
          "label": "text-only"
        },
        {
          "value": "with-icon",
          "cssModifier": null,
          "default": false,
          "label": "with-icon"
        },
        {
          "value": "with-title",
          "cssModifier": null,
          "default": false,
          "label": "with-title"
        },
        {
          "value": "with-link",
          "cssModifier": null,
          "default": false,
          "label": "with-link"
        },
        {
          "value": "with-close",
          "cssModifier": null,
          "default": false,
          "label": "with-close"
        },
        {
          "value": "full",
          "cssModifier": null,
          "default": false,
          "label": "full"
        }
      ]
    }
  },
