  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "severity": [
              "danger"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-alert"
        ],
        "note": "Danger: role='alert' fuer sofortige Screen-Reader-Ankuendigung. Oder aria-live='assertive'."
      },
      {
        "when": {
          "axes": {
            "severity": [
              "warning"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-region"
        ],
        "note": "Warning: role='region' mit aria-label wie info/success (z. B. 'Wartungshinweis'). role='alert' bleibt danger vorbehalten."
      },
      {
        "when": {
          "axes": {
            "style": [
              "accent"
            ]
          }
        },
        "require": [],
        "suggest": [
          "contrast-check-accent"
        ],
        "note": "Accent-Modus: Textfarbe ist text-primary auf 12%-Mix-BG. Kontrast gegen subtilen Hintergrund pruefen."
      }
    ]
