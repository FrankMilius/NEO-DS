{
  "$schema": "../data/component-spec-schema.json",
  "component": "select",
  "version": "2.0.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "interactive",
    "form",
    "selection"
  ],
  "anatomy": {
    "rootElement": ".nc-select",
    "slots": [
      {
        "name": "indicator",
        "selector": ".nc-select__indicator",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Select ist ein natives <select class='nc-select'>. Kein JS fuer Basis-Funktion noetig.",
      "Custom Arrow via background-image (SVG Chevron Down) oder via __indicator im Wrapper.",
      "Nutzt --nc-input-* Tokens als Basis (gleiche form-control Mixins wie Input).",
      "Eigene --nc-select-* Tokens fuer Indicator, Extra-Padding und Optgroup-Styling.",
      "Optgroup: <optgroup label='...'> wird via nc-select-optgroup-font-weight (semibold) und nc-select-optgroup-padding-left hervorgehoben. Options innerhalb der Gruppe werden zusaetzlich eingerueckt.",
      "Multi-Select: .nc-select--multiple oder [multiple]. Kein Arrow, height: auto. ACHTUNG: Natives multiple-Select ist schwer bedienbar (Ctrl+Click). Fuer komplexe UIs wird eine Multi-Select-Combobox-Komponente (JS-basiert) mit Tag-Cloud oder Checkbox-Liste empfohlen.",
      "Open-State: .is-open am Wrapper setzt Chevron transform: rotate(180deg). Benoetigt kleinen JS-Hook (focus/blur oder mousedown). CSS allein reicht nicht, da native Selects keinen :open Pseudo-Klassen-Support haben.",
      "Placeholder-Color-Hack: select:required:invalid { color: var(--nc-input-placeholder-color) } — funktioniert wenn Select required ist und leere Option <option value='' disabled selected> gewaehlt ist. Sobald eine valide Option gewaehlt wird, greift die normale Textfarbe.",
      "::-ms-expand wird versteckt (IE11 Arrow entfernen).",
      "Error via .nc-select--error ODER [aria-invalid='true']."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — outlined (Standard, Rahmen), filled (Flaeche mit Unterstreichung), borderless (minimalistisch)",
      "values": [
        {
          "value": "outlined",
          "cssModifier": null,
          "default": false,
          "label": "outlined"
        },
        {
          "value": "filled",
          "cssModifier": "nc-select--filled",
          "default": false,
          "label": "filled"
        },
        {
          "value": "borderless",
          "cssModifier": "nc-select--borderless",
          "default": false,
          "label": "borderless"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (32px) / md (40px, Standard) / lg (48px). Nutzt Input-Size-Tokens.",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-select--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-select--lg",
          "default": false,
          "label": "lg"
        }
      ]
    },
    "type": {
      "label": "Type",
      "description": "Auswahl-Typ — single (Standard-Dropdown), multiple (native Mehrfachauswahl, nur Fallback)",
      "values": [
        {
          "value": "single",
          "cssModifier": null,
          "default": false,
          "label": "single"
        },
        {
          "value": "multiple",
          "cssModifier": "nc-select--multiple",
          "default": false,
          "label": "multiple"
        }
      ]
    },
    "content": {
      "label": "Content",
      "description": "Inhaltsvarianten — flat (flache Options-Liste), grouped (mit Optgroups)",
      "values": [
        {
          "value": "flat",
          "cssModifier": null,
          "default": false,
          "label": "flat"
        },
        {
          "value": "grouped",
          "cssModifier": null,
          "default": false,
          "label": "grouped"
        }
      ]
    },
    "validation": {
      "label": "Validation",
      "description": "Validierungszustand — none (Standard), error (roter Rand), success (gruener Rand)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "error",
          "cssModifier": "nc-select--error",
          "default": false,
          "label": "error"
        },
        {
          "value": "success",
          "cssModifier": "nc-select--success",
          "default": false,
          "label": "success"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus",
      "disabled",
      "open",
      "placeholder"
    ],
    "interactive": true,
    "rules": [
      {
        "state": "hover",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "focus",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "open",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "placeholder",
        "effects": [],
        "attributes": {},
        "description": null
      }
    ]
  },
  "cssApi": {
    "baseClasses": [
      "nc-select"
    ],
    "tokenGroups": {
      "Indicator": [
        {
          "token": "--nc-select-indicator-size"
        },
        {
          "token": "--nc-select-indicator-color"
        }
      ],
      "Geometry": [
        {
          "token": "--nc-select-padding-right"
        }
      ],
      "Colors (Outlined)": [
        {
          "token": "--nc-form-control-bg"
        },
        {
          "token": "--nc-form-control-border-color"
        },
        {
          "token": "--nc-form-control-color"
        }
      ],
      "Colors (Filled)": [
        {
          "token": "--nc-form-control-filled-bg"
        },
        {
          "token": "--nc-form-control-filled-border-bottom"
        },
        {
          "token": "--nc-form-control-filled-color"
        }
      ],
      "Colors (Borderless)": [
        {
          "token": "--nc-form-control-minimal-bg-hover"
        },
        {
          "token": "--nc-form-control-minimal-border-focus"
        }
      ],
      "Optgroup": [
        {
          "token": "--nc-select-optgroup-font-weight"
        },
        {
          "token": "--nc-select-optgroup-padding-left"
        }
      ],
      "Error": [],
      "Success": []
    },
    "modTokens": [
      "--mod-select-indicator-size",
      "--mod-select-indicator-color",
      "--mod-select-padding-right",
      "--mod-form-control-bg",
      "--mod-form-control-border-color",
      "--mod-form-control-color",
      "--mod-form-control-filled-bg",
      "--mod-form-control-filled-border-bottom",
      "--mod-form-control-filled-color",
      "--mod-form-control-minimal-bg-hover",
      "--mod-form-control-minimal-border-focus",
      "--mod-select-optgroup-font-weight",
      "--mod-select-optgroup-padding-left"
    ]
  },
  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [
          "aria-invalid",
          "aria-describedby"
        ],
        "suggest": [],
        "note": "Error-State braucht aria-invalid='true' und aria-describedby auf Fehlermeldung."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt wenn Select Teil eines sichtbaren Formulars ist."
      },
      {
        "when": {
          "axes": {
            "type": [
              "multiple"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-multiselectable"
        ],
        "note": "Multiple-Select hat implizit aria-multiselectable. Ctrl+Click fuer Mehrfachauswahl ist schwer discoverable — fuer komplexe UIs eine JS-basierte Multi-Select-Combobox mit role='listbox' und aria-multiselectable='true' nutzen."
      },
      {
        "when": {
          "axes": {
            "content": [
              "grouped"
            ]
          }
        },
        "require": [],
        "suggest": [],
        "note": "Optgroups nutzen natives <optgroup label='...'>. Die label-Attribute werden von Screenreadern automatisch vorgelesen. Keine zusaetzliche ARIA-Annotation noetig."
      }
    ]
  },
  "dependencies": [],
  "pipeline": {
    "scss": [
      "scss/scss/05-atoms/_select.scss"
    ],
    "story": "stories/atoms/select.stories.js",
    "arena": "apps/theme-configurator/src/components/laboratory/RecipeArena.vue",
    "drupal": [],
    "docs": "docs/select-docs.html"
  }
}
