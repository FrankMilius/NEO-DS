      "--mod-section-padding-block-sm",
      "--mod-section-padding-block-lg",
      "--mod-section-bg",
      "--mod-section-color",
      "--mod-section-accent-bg",
      "--mod-section-accent-color",
      "--mod-section-accent-color-secondary",
      "--mod-section-divider-color",
      "--mod-section-divider-width",
