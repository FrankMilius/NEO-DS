  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA non-text (3:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "validation": [
              "error"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-invalid",
          "aria-describedby"
        ],
        "note": "Error-State: aria-invalid='true' auf dem Input. Fehlermeldung via aria-describedby verknuepft."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "Disabled: disabled-Attribut auf dem Input. Alternativ aria-disabled='true'."
      },
      {
        "when": {
          "axes": {
            "mode": [
              "range"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-label-min",
          "aria-label-max"
        ],
        "note": "Range-Modus: Jeder Input braucht ein eigenes aria-label, z.B. 'Minimum Preis' und 'Maximum Preis'. aria-valuemin/aria-valuemax unabhaengig setzen."
      },
      {
        "when": {
          "axes": {
            "display": [
              "with-tooltip"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-hidden-tooltip"
        ],
        "note": "Floating Tooltip ist rein visuell — aria-hidden='true'. Der Wert wird bereits via aria-valuenow/aria-valuetext kommuniziert."
      }
    ]
  },
  "dependencies": [],
