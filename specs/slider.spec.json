        {
          "token": "nc-slider-tooltip-color"
        },
        {
          "token": "nc-slider-tooltip-radius"
        },
        {
          "token": "nc-slider-tooltip-font-size"
        },
        {
          "token": "nc-slider-tooltip-padding"
        },
        {
          "token": "nc-slider-tooltip-offset-y"
        }
