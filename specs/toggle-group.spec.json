    "overrides": [
      {
        "when": {
          "axes": {
            "type": [
              "single"
            ]
          }
        },
        "require": [
          "role-radiogroup",
          "aria-checked"
        ],
        "suggest": [],
        "note": "Single-Select braucht role='radiogroup' auf Container und role='radio' + aria-checked auf Items."
      },
      {
        "when": {
          "axes": {
            "type": [
              "multiple"
            ]
          }
        },
        "require": [
          "role-group",
          "aria-pressed"
        ],
        "suggest": [],
        "note": "Multi-Select braucht role='group' auf Container und aria-pressed auf Items."
      },
      {
        "when": {
          "axes": {
            "content": [
              "icon-only"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Icon-only Items brauchen aria-label — kein sichtbarer Text vorhanden."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt. Einzelne Items oder gesamte Gruppe koennen disabled sein."
      }
    ]
