        {
          "value": "sm",
          "cssModifier": "nc-divider--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-divider--lg",
          "default": false,
          "label": "lg"
        },
        {
          "value": "none",
          "cssModifier": "nc-divider--none",
          "default": false,
          "label": "none"
        }
      ]
    }
  },
