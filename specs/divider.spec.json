{
  "$schema": "../data/component-spec-schema.json",
  "component": "divider",
  "version": "1.0.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "static",
    "layout",
    "separator"
  ],
  "anatomy": {
    "rootElement": ".nc-divider",
    "slots": [],
    "notes": [
      "Standard: <hr class='nc-divider'>. Nativer role='separator' ist implizit.",
      "Vertikal: .nc-divider--vertical. Braucht aria-orientation='vertical'.",
      "Label-Variante: <div class='nc-divider-label' role='separator'><span>Text</span></div>.",
      "Label-Variante nutzt ::before/::after Pseudo-Elemente fuer die Linien links und rechts.",
      "Spacing-Modifier: --sm (8px), --lg (24px), --none (0).",
      "Style-Modifier: --dashed, --dotted (aendert border-style).",
      "Strong-Modifier: --strong (dickere Linie, staerkere Farbe)."
    ]
  },
  "api": null,
  "variants": {
    "orientation": {
      "label": "Orientation",
      "description": "Ausrichtung — horizontal (Standard) oder vertikal",
      "values": [
        {
          "value": "horizontal",
          "cssModifier": null,
          "default": false,
          "label": "horizontal"
        },
        {
          "value": "vertical",
          "cssModifier": "nc-divider--vertical",
          "default": false,
          "label": "vertical"
        }
      ]
    },
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default, strong (dickere Linie), with-label (Text in der Mitte)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "strong",
          "cssModifier": "nc-divider--strong",
          "default": false,
          "label": "strong"
        },
        {
          "value": "with-label",
          "cssModifier": null,
          "default": false,
          "label": "with-label"
        }
      ]
    },
    "style": {
      "label": "Style",
      "description": "Linien-Stil — solid (Standard), dashed, dotted",
      "values": [
        {
          "value": "solid",
          "cssModifier": null,
          "default": false,
          "label": "solid"
        },
        {
          "value": "dashed",
          "cssModifier": "nc-divider--dashed",
          "default": false,
          "label": "dashed"
        },
        {
          "value": "dotted",
          "cssModifier": "nc-divider--dotted",
          "default": false,
          "label": "dotted"
        }
      ]
    },
    "spacing": {
      "label": "Spacing",
      "description": "Abstand ober-/unterhalb — sm (8px), md (16px, Standard), lg (24px), none (0)",
