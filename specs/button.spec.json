  "states": {
    "supported": [
      "default",
      "hover",
      "active",
      "focus-visible",
      "disabled",
      "loading",
      "pressed"
    ],
    "interactive": null,
    "rules": [
      {
        "state": "loading",
        "effects": [
          "blockInteraction"
        ],
        "attributes": {
          "aria-busy": true,
          "aria-disabled": true
        },
        "description": null
      },
      {
        "state": "disabled",
        "effects": [
          "blockInteraction"
        ],
        "attributes": {
          "disabled?": true,
          "aria-disabled": true
        },
        "description": null
      },
      {
        "state": "pressed",
        "effects": [],
        "attributes": {
          "aria-pressed": "true|false"
        },
        "description": null
      }
    ]
  },
