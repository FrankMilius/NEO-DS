  "keyboard": {
    "Enter": {
      "action": "activate",
      "note": "Loest den Click-Handler aus (nativ). Toggle (.nc-button--toggle): schaltet aria-pressed um (neo-behaviors button)."
    },
    "Space": {
      "action": "activate",
      "note": "Loest den Click-Handler aus (nativ, beim Loslassen). Verhindert Page-Scroll. Toggle: schaltet aria-pressed um wie Enter."
    }
  },
  "testSelectors": {
    "root": "[data-testid='button']",
    "label": "[data-testid='button-label']",
    "icon": "[data-testid='button-icon']",
    "spinner": "[data-testid='button-spinner']"
  },
  "events": {
    "click": {
      "bubbles": true,
      "note": "Standard DOM click Event."
    },
    "button-toggle": {
      "bubbles": true,
      "detail": {
        "pressed": "boolean",
        "value": "string"
      },
      "note": "Gefeuert, wenn ein Umschaltknopf (.nc-button--toggle) aria-pressed wechselt. value: data-value, sonst aria-label, sonst die Beschriftung. Gesperrte Knoepfe melden nichts.",
      "onlyWhen": {
        "axes": {
          "composition": [
            "toggle"
          ]
        }
      }
    }
  },
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": "focus-ring mixin, :focus-visible",
    "assertions": [
      "hasAccessibleName",
      "focusIndicatorVisible"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "pattern": [
              "icon-only"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Icon-Only Buttons benoetigen immer aria-label. Quadratische Flaeche fuer einfaches Treffen."
      },
      {
        "when": {
          "axes": {
            "size": [
              "xs",
              "sm"
            ]
          }
        },
        "require": [],
        "suggest": [],
        "note": "XS/SM erhalten ::before Touch-Target (44px) fuer WCAG 2.5.8 Target Size."
      },
      {
        "when": {
          "axes": {
            "composition": [
              "group"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role=group",
          "aria-label=Aktionen"
        ],
        "note": "Button-Group benoetigt role='group' mit aria-label. Mittlere Buttons haben keinen Radius."
      },
      {
        "when": {
          "axes": {
            "composition": [
              "toggle"
            ]
          }
        },
        "require": [
          "aria-pressed"
        ],
        "suggest": [],
