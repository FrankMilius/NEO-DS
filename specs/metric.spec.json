{
  "$schema": "../data/component-spec-schema.json",
  "component": "metric",
  "version": "2.0.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "display",
    "data",
    "content",
    "dashboard"
  ],
  "anatomy": {
    "rootElement": ".nc-metric",
    "slots": [
      {
        "name": "label",
        "selector": ".nc-metric__label",
        "required": false,
        "description": null
      },
      {
        "name": "value-row",
        "selector": ".nc-metric__value-row",
        "required": true,
        "description": null
      },
      {
        "name": "value",
        "selector": ".nc-metric__value",
        "required": true,
        "description": null
      },
      {
        "name": "unit",
        "selector": ".nc-metric__unit",
        "required": false,
        "description": null
      },
      {
        "name": "trend",
        "selector": ".nc-metric__trend",
        "required": false,
        "description": null
      },
      {
        "name": "footer",
        "selector": ".nc-metric__footer",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Container: Flex-Column mit gap. Solid: inverse BG + inverse Text. Subtle: helle BG + primaere Farben.",
      "Label: Dezente Beschriftung ueber dem Wert (z.B. 'Gesamtumsatz', 'Aktive Nutzer').",
      "Value-Row: Flex align-baseline Zeile fuer Value + Unit nebeneinander.",
      "Value: Grosse Zahl — font-heading, font-weight-black, accent-Farbe. tabular-nums fuer stabile Breite.",
      "Unit: Einheit neben dem Wert ($, %, kg). Gleiche accent-Farbe, kleinere Schrift.",
      "Trend: Inline-Flex mit Icon + Prozentwert. Farbe via Modifier: --trend-up (Success), --trend-down (Danger), --trend-neutral.",
      "Trend-Icon: SVG 16px, stroke: currentColor. Arrow-up fuer positiv, arrow-down fuer negativ, minus fuer neutral.",
      "Footer: Vergleichszeitraum (z.B. 'vs. Vorjahr', 'letzte 30 Tage'). Gedaempfte Opazitaet.",
      "Size md: Kompakt fuer Sidebar-Cards und Dense-Grids. Reduzierte Font-Sizes und Padding.",
      "Size xl: Hero-Groesse fuer Marketing-Sektionen. Uebergrosse Zahl (fs-8xl)."
    ]
  },
  "api": null,
  "variants": {
    "emphasis": {
      "label": "Emphasis",
      "description": "Hintergrund-Stil — solid (inverse, dunkel) oder subtle (hell, dezent)",
      "values": [
        {
          "value": "solid",
          "cssModifier": null,
          "default": false,
          "label": "solid"
        },
        {
          "value": "subtle",
          "cssModifier": "nc-metric--subtle",
          "default": false,
          "label": "subtle"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "Groesse — md (kompakt), lg (Standard), xl (Hero)",
      "values": [
        {
          "value": "md",
          "cssModifier": "nc-metric--md",
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": null,
          "default": false,
          "label": "lg"
        },
        {
          "value": "xl",
          "cssModifier": "nc-metric--xl",
          "default": false,
          "label": "xl"
        }
      ]
    },
    "trend": {
      "label": "Trend",
      "description": "Richtungsindikator — up (positiv/Success), down (negativ/Danger), neutral (unveraendert)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "up",
          "cssModifier": "nc-metric--trend-up",
          "default": false,
          "label": "up"
        },
        {
          "value": "down",
          "cssModifier": "nc-metric--trend-down",
          "default": false,
          "label": "down"
        },
        {
          "value": "neutral",
          "cssModifier": "nc-metric--trend-neutral",
          "default": false,
          "label": "neutral"
        }
      ]
    }
  },
