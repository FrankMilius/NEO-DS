          "default": false,
          "label": "lese"
        }
      ]
    },
    "density": {
      "label": "Density",
      "description": "Platzbedarf — default, compact, spacious",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "compact",
          "cssModifier": "nc-accordion--compact",
          "default": false,
          "label": "compact"
        },
        {
          "value": "spacious",
          "cssModifier": "nc-accordion--spacious",
          "default": false,
          "label": "spacious"
        }
      ]
    },
    "behavior": {
      "label": "Behavior",
      "description": "Oeffnungs-Verhalten — multiple, single, single-scroll (mit Scroll-Into-View)",
      "values": [
        {
          "value": "multiple",
          "cssModifier": null,
          "default": false,
          "label": "multiple"
        },
        {
          "value": "single",
          "cssModifier": null,
          "default": false,
          "label": "single"
        },
        {
          "value": "single-scroll",
          "cssModifier": null,
          "default": false,
          "label": "single-scroll"
        }
      ]
    },
    "media-layout": {
      "label": "Media Layout",
      "description": "Medien-Positionierung — none, top, side",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "top",
          "cssModifier": "nc-accordion--media-top",
          "default": false,
          "label": "top"
        },
        {
          "value": "side",
          "cssModifier": "nc-accordion--media-side",
          "default": false,
          "label": "side"
        }
      ]
    },
    "sticky": {
      "label": "Sticky Trigger",
      "description": "Trigger bleibt am oberen Rand bei langem Content",
      "values": [
        {
          "value": "off",
          "cssModifier": null,
          "default": false,
          "label": "off"
        },
        {
          "value": "on",
          "cssModifier": "nc-accordion--sticky",
          "default": false,
          "label": "on"
        }
      ]
    },
    "deepLink": {
      "label": "Sprungziel",
      "description": "Jeder Eintrag traegt eine Kennung. /seite#kennung oeffnet ihn und springt hin; der offene Eintrag bekommt eine Marke, damit man sieht, wo man gelandet ist.",
      "values": [
        {
          "value": "on",
          "cssModifier": null,
          "default": false,
          "label": "on"
        }
      ]
    },
    "expandAll": {
      "label": "Alle aufklappen",
      "description": "Schalter ueber der Liste. Sinnvoll ab etwa acht Eintraegen. Bei Verhalten `single` wirkungslos — dort widerspraeche er sich selbst.",
      "values": [
        {
          "value": "off",
          "cssModifier": null,
          "default": false,
          "label": "off"
        },
        {
          "value": "on",
          "cssModifier": "nc-accordion-toggle-all",
          "default": false,
          "label": "on"
        }
      ]
    }
  },
  "states": {
