{
  "$schema": "../data/component-spec-schema.json",
  "component": "accordion",
  "version": "3.2.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "interactive",
    "disclosure",
    "content",
    "navigation",
    "faq",
    "selection"
  ],
  "anatomy": {
    "rootElement": ".nc-accordion",
    "slots": [
      {
        "name": "item",
        "selector": ".nc-accordion__item",
        "required": true,
        "description": "Einzelnes Accordion-Item (details Element)."
      },
      {
        "name": "trigger",
        "selector": ".nc-accordion__trigger",
        "required": true,
        "description": "Klickbarer Header (summary Element). Enthaelt Text, Icon, optional Prefix/Suffix."
      },
      {
        "name": "icon",
        "selector": ".nc-accordion__icon",
        "required": false,
        "description": "Toggle-Icon (Chevron). Rotiert bei Open."
      },
      {
        "name": "content",
        "selector": ".nc-accordion__content",
        "required": true,
        "description": "Content-Container. grid-template-rows: 0fr/1fr Animation."
      },
      {
        "name": "content-inner",
        "selector": ".nc-accordion__content-inner",
        "required": true,
        "description": "Innerer Content mit overflow:hidden."
      },
      {
        "name": "media",
        "selector": ".nc-accordion__media",
        "required": false,
        "description": "Optionaler Bild/Video-Container."
      },
      {
        "name": "trigger-prefix",
        "selector": ".nc-accordion__trigger-prefix",
        "required": false,
        "description": "Platz fuer Checkbox, Radio oder Status-Icon links im Trigger."
      },
      {
        "name": "trigger-suffix",
        "selector": ".nc-accordion__trigger-suffix",
        "required": false,
        "description": "Platz fuer Badges oder Action-Buttons rechts im Trigger (vor dem Toggle-Icon)."
      },
      {
        "name": "footer",
        "selector": ".nc-accordion__footer",
        "required": false,
        "description": "Optionaler Footer am Ende des Contents fuer Buttons/Actions."
      }
    ],
    "notes": [
      "Natives <details>/<summary> oder ARIA-Pattern (role='region').",
      "BEM: .nc-accordion > __item > __trigger + __content > __content-inner.",
      "CSS-Grid-Animation: grid-template-rows 0fr→1fr fuer fluessige Hoehen-Animation.",
      "Trigger-Layout: [prefix] [text] [suffix] [icon] via Flexbox.",
      "Nested: nc-accordion innerhalb eines nc-accordion__content-inner. Innere Ebene eingerueckt (margin-inline-start: --nc-accordion-nested-indent) mit Fuehrungslinie (--nc-accordion-nested-border-width) und kleinerem Zeichen (--nc-accordion-nested-icon-size).",
      "Selection: .nc-accordion__trigger-prefix enthaelt Checkbox/Radio. Checked-State: farbiger Rahmen + BG auch bei geschlossenem Item.",
      "Actionable Header: .nc-accordion__trigger-suffix fuer Badges (rechts, vor Icon; Abstand/Farbe aus --nc-accordion-actions-*, Ghost-Knoepfe in der Aktionsfarbe).",
      "Sticky Trigger: position:sticky auf dem Trigger bei offenem Item (nur bei langem Content).",
      "Scroll-Into-View: scrollIntoView({behavior:'smooth'}) auf den Trigger nach Auto-Close im Single-Mode.",
      "Always Open: data-allow-close='false' auf dem Item verhindert Schliessen.",
      "Footer: Optionaler Aktionsbereich am Content-Ende (z.B. 'Weiter'-Button), rechtsbuendig, Trennlinie ueber die volle Eintragsbreite (--nc-accordion-footer-padding/-border); in den buendigen Fassungen auf der Textkante.",
      "prefers-reduced-motion: Transitions deaktiviert.",
      ".nc-accordion__text ist ein <div>, kein <p>: die Antwort darf Listen enthalten, und ein <ul> in einem <p> bricht den Absatz im Browser auf.",
      "Erlaubte Auszeichnung in der Antwort: p, br, strong, em, b, i, ul, ol, li, a, code, abbr. Alles andere wird verworfen (Drupal: Xss::filter im Preprocess _neo_fe_acc_antwort).",
      "Loser Text vor oder zwischen Bloecken wird in <p> gefasst — sonst klebt eine Liste am Vorspann, denn CSS kann \"steht hinter einem Textknoten\" nicht auswaehlen."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Visueller Stil — default, flush, ghost, separated, elevated, nested, selection",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "flush",
          "cssModifier": "nc-accordion--flush",
          "default": false,
          "label": "flush"
        },
        {
          "value": "ghost",
          "cssModifier": "nc-accordion--ghost",
          "default": false,
          "label": "ghost"
        },
        {
          "value": "separated",
          "cssModifier": "nc-accordion--separated",
          "default": false,
          "label": "separated"
        },
        {
          "value": "elevated",
          "cssModifier": "nc-accordion--elevated",
          "default": false,
          "label": "elevated"
        },
        {
          "value": "nested",
          "cssModifier": "nc-accordion--nested",
