  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA non-text (3:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "mode": [
              "readonly"
            ]
          }
        },
        "require": [
          "role-img",
          "aria-label"
        ],
        "suggest": [],
        "note": "Readonly: aria-label muss vollen Kontext liefern: 'Bewertung: 4.5 von 5 Sternen'. Bei Half-Stars den exakten Wert angeben."
      },
      {
        "when": {
          "axes": {
            "mode": [
              "interactive"
            ]
          }
        },
        "require": [
          "role-radiogroup",
          "aria-label",
          "clear-input"
        ],
        "suggest": [],
        "note": "Interaktiv: role='radiogroup' + aria-label='Bewertung abgeben'. Clear-Input (value=0) als erstes Kind fuer Zuruecksetzen."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' auf dem Container. Opacity reduziert, keine Interaktion."
      },
      {
        "when": {
          "axes": {
            "sentiment": [
              "scale"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-valuetext"
        ],
        "note": "Sentiment-Skala ist rein visuell. Farbwechsel darf nicht alleiniges Signal sein — Stern-Anzahl bleibt primaerer Indikator."
      }
    ]
  },
