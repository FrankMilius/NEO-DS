  "keyboard": {
    "ArrowRight": {
      "action": "focus-next-control",
      "note": "Naechstes Bedienelement der Leiste (rundum, gesperrte uebersprungen; auch in eingebetteten Gruppen wie Toggle-Group). In Eingabefeldern bleibt die Taste im Feld (Cursor). Eingebettete Gruppen flach (Entscheidung 03.10.2026, toolbar-gruppen)."
    },
    "ArrowLeft": {
      "action": "focus-prev-control",
      "note": "Vorheriges Bedienelement (rundum). In Eingabefeldern bleibt die Taste im Feld."
    },
    "Home": {
      "action": "focus-first-control",
      "note": "Erstes Bedienelement. In Eingabefeldern bleibt die Taste im Feld."
    },
    "End": {
      "action": "focus-last-control",
      "note": "Letztes Bedienelement. In Eingabefeldern bleibt die Taste im Feld."
    },
    "Tab": {
      "action": "leave-toolbar",
      "note": "Die Leiste ist eine Tab-Station (roving tabindex); Tab verlaesst sie. Aus einem Eingabefeld: naechstes Bedienelement der Leiste, am Rand raus (Entscheidung 03.10.2026, toolbar-tab)."
    },
    "Shift+Tab": {
      "action": "leave-toolbar-backwards",
      "note": "Wie Tab, rueckwaerts. Aus einem Eingabefeld: vorheriges Bedienelement der Leiste, am Rand raus (Entscheidung 03.10.2026, toolbar-tab)."
    }
  },
  "testSelectors": null,
