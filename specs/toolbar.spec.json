    "toolbar-focus": {
      "bubbles": true,
      "detail": {
        "value": "string",
        "previousValue": "string"
      },
      "note": "Gefeuert wenn ein anderes Bedienelement die Tab-Station uebernimmt (Pfeiltaste, Klick, Fokus). value: aria-label, Text oder placeholder des Elements. Bleibt (Entscheidung 03.10.2026, toolbar-ereignis)."
