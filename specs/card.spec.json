      "Display Context": [
        {
          "token": "nc-card-padding"
        },
        {
          "token": "nc-card-title-font-size"
        },
        {
          "token": "nc-card-title-font-weight"
        },
        {
          "token": "nc-card-title-line-height"
        },
        {
          "token": "nc-card-shadow"
        }
      ]
    },
    "modTokens": []
  },
  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "semanticStructure"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "behavior": [
              "navigational"
            ]
          }
        },
        "require": [
          "href"
        ],
        "suggest": [],
        "note": "Navigational Cards muessen ein gueltiges href-Attribut haben. Bei partial-Navigation: title-link traegt den Link."
      },
      {
        "when": {
          "axes": {
            "behavior": [
              "selectable"
            ]
          }
        },
        "require": [
          "name",
          "value"
        ],
        "suggest": [],
        "note": "Selectable Cards benoetigen name und value auf dem Hidden Input. :has(:checked) steuert den Selected-State."
      },
      {
        "when": {
          "axes": {
            "behavior": [
              "expandable"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-expanded"
        ],
        "note": "details/summary bietet native Expansion. Falls custom JS: aria-expanded erforderlich."
      },
      {
        "when": {
          "axes": {
            "pattern": [
              "status"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Status-Indikator (Farbe) darf nicht das einzige Signal sein. Textuelle Begleitung oder aria-label noetig."
      }
    ]
  },
  "dependencies": [],
  "pipeline": {
    "scss": [
      "scss/scss/05-atoms/_card.scss",
      "scss/scss/06-molecules/_card.scss"
    ],
    "story": "stories/molecules/card.stories.js",
    "arena": "apps/theme-configurator/src/components/laboratory/CardArena.vue",
    "drupal": [],
    "docs": "docs/card-docs.html"
  }
}
