  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "indicator": [
              "required"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-hidden"
        ],
        "note": "Required-Indikator ('*') muss aria-hidden='true' haben. Pflichtfeld-Semantik liegt auf dem Input (aria-required='true')."
      },
      {
        "when": {
          "axes": {
            "indicator": [
              "info"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-label",
          "aria-describedby"
        ],
        "note": "Info-Icon ist ein <button> mit aria-label='Hilfe zu {Feldname}'. Tooltip-Inhalt ist via aria-describedby verknuepft oder wird als role='tooltip' angezeigt. Icon selbst ist aria-hidden='true' — der Button traegt den Accessible Name."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [],
        "note": "Disabled-Label benoetigt keine eigene ARIA-Annotation — der Disabled-State liegt auf dem Input. Info-Button erhaelt tabindex='-1' und aria-disabled='true'."
      }
    ]
  },
  "dependencies": [
