{
  "$schema": "../data/component-spec-schema.json",
  "component": "text-cta",
  "version": "1.1.0",
  "status": "draft",
  "layer": "organism",
  "tags": [
    "content",
    "organisms",
    "website-block",
    "split-layout"
  ],
  "anatomy": {
    "rootElement": ".nc-text-cta",
    "slots": [
      {
        "name": "grid",
        "selector": ".nc-text-cta__grid",
        "required": true,
        "description": "Raster (Container-Query auf .nc-text-cta): gestapelt, ab media-text-stack zweispaltig; mit --no-card immer einspaltig."
      },
      {
        "name": "content",
        "selector": ".nc-text-cta__content",
        "required": true,
        "description": "Textspalte: neo_fe:block-header --flush und Punkteliste."
      },
      {
        "name": "list",
        "selector": ".nc-text-cta__list",
        "required": false,
        "description": "Punkteliste (field_tc_features, eine Zeile je Punkt)."
      },
      {
        "name": "list-item",
        "selector": ".nc-text-cta__list-item",
        "required": false,
        "description": "Punkt mit Haken (::before)."
      },
      {
        "name": "aside",
        "selector": ".nc-text-cta__aside",
        "required": false,
        "description": "Spalte der Karte — entfaellt ohne Karteninhalt."
      },
      {
        "name": "card",
        "selector": ".nc-text-cta__card",
        "required": false,
        "description": "CTA-Karte auf .nc-card (Flaeche, Rahmen, Radius ueber --mod-card-*)."
      },
      {
        "name": "card-icon",
        "selector": ".nc-text-cta__card-icon",
        "required": false,
        "description": "Icon oben in der Karte (dekorativ)."
      },
      {
        "name": "card-action",
        "selector": ".nc-text-cta__card-action",
        "required": false,
        "description": "Button der Karte, volle Breite."
      }
    ],
    "notes": [
      "Website-Block neo_text_cta: <section class=\"nc-section\"><div class=\"nc-container\"><div class=\"nc-text-cta [--card-left] [--no-card]\"><div class=\"nc-text-cta__grid\"> …",
      "Die Karte steht im DOM immer hinter dem Text; --card-left tauscht nur die Anzeige (order) und dreht die Spuren mit (--nc-text-cta-columns-reverse).",
      "Ohne Karteninhalt rendert Drupal kein __aside und setzt nc-text-cta--no-card: eine Spalte in jeder Breite, Inhalt auf Lesebreite (--nc-text-cta-content-measure) gekappt, linksbuendig (Entscheidung Phase 5, 07.10.2026).",
      "Kartenflaeche per field_tc_card_bg als Instanzwert --mod-card-bg am .nc-card (wie in Drupal); Sektionsflaeche aus field_surface am Block-Wrapper."
    ]
  },
  "api": null,
  "variants": {
    "cardPosition": {
      "label": "Lage der Karte",
      "description": "field_tc_card_position",
      "values": [
        {
          "value": "right",
          "cssModifier": null,
          "default": false,
          "label": "right"
        },
        {
          "value": "left",
          "cssModifier": "nc-text-cta--card-left",
          "default": false,
          "label": "left"
        }
      ]
    },
    "card": {
      "label": "Karte",
      "description": "Mit oder ohne Karteninhalt",
      "values": [
        {
          "value": "mit",
          "cssModifier": null,
          "default": false,
          "label": "mit"
        },
        {
          "value": "ohne",
          "cssModifier": "nc-text-cta--no-card",
          "default": false,
          "label": "ohne"
        }
      ]
    }
  },
  "states": {
    "supported": [
