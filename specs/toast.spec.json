  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "severity": [
              "error",
              "warning"
            ]
          }
        },
        "require": [],
        "suggest": [
          "role-alert"
        ],
        "note": "Error/Warning: role='alert' statt role='status' fuer dringende Meldungen."
      },
      {
        "when": {
          "axes": {
            "content": [
              "with-undo"
            ]
          }
        },
        "require": [],
        "suggest": [
          "extended-timeout"
        ],
        "note": "Undo-Toasts: Laengerer Auto-Dismiss (mind. 10s) oder kein Auto-Dismiss. Undo-Aktion muss klar als Button erkennbar sein."
      },
      {
        "when": {
          "states": [
            "swiping"
          ]
        },
        "require": [],
        "suggest": [],
        "note": null
      },
      {
        "require": [],
        "suggest": [
          "aria-hidden-during-swipe"
        ],
        "note": "Waehrend Swipe-Geste keine Screenreader-Updates. Erst nach Dismiss oder Abbruch."
      }
    ]
