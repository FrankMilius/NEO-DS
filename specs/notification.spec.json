      "values": [
        {
          "value": "dismissible",
          "cssModifier": null,
          "default": false,
          "label": "dismissible"
        },
        {
          "value": "permanent",
          "cssModifier": "nc-notification--permanent",
          "default": false,
          "label": "permanent"
        }
      ]
    }
  },
