        "selector": ".nc-notification__header",
        "required": true,
        "description": null
      },
      {
        "name": "title",
        "selector": ".nc-notification__title",
        "required": true,
        "description": null
      },
      {
        "name": "meta",
        "selector": ".nc-notification__meta",
        "required": false,
        "description": null
      },
      {
        "name": "body",
        "selector": ".nc-notification__body",
        "required": false,
        "description": null
      },
      {
        "name": "footer",
        "selector": ".nc-notification__footer",
        "required": false,
        "description": null
