  "keyboard": {
    "ArrowDown": {
      "action": "focus-next-item",
      "note": "Naechster sichtbarer Eintrag (kein Rundum, gesperrte uebersprungen — Entscheidung 03.10.2026, tree-gesperrt). Der Fokus liegt auf dem li[role=treeitem]."
    },
    "ArrowUp": {
      "action": "focus-prev-item",
      "note": "Vorheriger sichtbarer Eintrag."
    },
    "ArrowRight": {
      "action": "expand-or-focus-child",
      "note": "Zweig zu: klappt auf (Fokus bleibt). Zweig offen: erstes Kind. Blatt: nichts."
    },
    "ArrowLeft": {
      "action": "collapse-or-focus-parent",
      "note": "Zweig offen: klappt zu. Sonst: Eltern-Eintrag."
    },
    "Home": {
      "action": "focus-first-item",
      "note": "Erster Eintrag des Baums."
    },
    "End": {
      "action": "focus-last-item",
      "note": "Letzter sichtbarer Eintrag."
    },
    "Enter": {
      "action": "select",
      "note": "Waehlt den Eintrag (single: aria-selected) bzw. hakt ihn an (multiple: aria-checked samt Nachfahren). Steht ein Link in der Zeile (__link), folgt Enter ihm."
    },
    "Space": {
      "action": "select",
      "note": "Wie Enter, ohne dem Link zu folgen."
    },
    "Tab": {
      "action": "focus-row-actions-or-leave",
      "note": "Genau ein Eintrag (li[role=treeitem]) ist im Tab-Fluss (roving tabindex). Hat seine Zeile Aktionen (.nc-treeview__action), fuehrt Tab in diese — nur die Zeile mit dem Tab-Stopp hat sie im Tab-Fluss —, danach verlaesst Tab den Baum (Entscheidung 03.10.2026)."
    },
    "Shift+Tab": {
      "action": "focus-item-from-actions",
      "note": "Von der ersten Zeilen-Aktion zurueck auf den Eintrag (nativ, der Eintrag steht im Dokument davor); vom Eintrag aus vor den Baum."
    },
    "Escape": {
      "action": "focus-item",
      "note": "In einer Zeilen-Aktion: Fokus zurueck auf den Eintrag. Am Eintrag selbst: keine Wirkung."
    }
  },
  "testSelectors": null,
