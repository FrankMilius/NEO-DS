      "note": "Gefeuert beim Auf- und Zuklappen eines Zweigs."
    },
    "treeview-select": {
      "bubbles": true,
      "detail": {
        "value": "string",
        "selected": "boolean",
        "values": "string[]"
      },
      "note": "Gefeuert bei Auswahl (single) bzw. Anhaken (multiple). values: alle gewaehlten Eintraege nach der Aenderung."
