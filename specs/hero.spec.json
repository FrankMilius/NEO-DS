        },
        {
          "token": "nc-hero-overlay-end"
        },
        {
          "token": "nc-hero-overlay-direction"
        }
      ],
      "Kicker": [
        {
          "token": "nc-hero-kicker-size"
        },
        {
          "token": "nc-hero-kicker-weight"
        },
        {
          "token": "nc-hero-kicker-bg"
