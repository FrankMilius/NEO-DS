{
  "$schema": "../data/component-spec-schema.json",
  "component": "hero",
  "version": "2.1.0",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "display",
    "content",
    "hero",
    "landing"
  ],
  "anatomy": {
    "rootElement": ".nc-hero",
    "slots": [
      {
        "name": "content",
        "selector": ".nc-hero__content",
        "required": true,
        "description": null
      },
      {
        "name": "media",
        "selector": ".nc-hero__media",
        "required": false,
        "description": null
      },
      {
        "name": "actions",
        "selector": ".nc-hero__actions",
        "required": false,
        "description": "Primaere und sekundaere CTA-Buttons unterhalb der Highlights."
      },
      {
        "name": "footer",
        "selector": ".nc-hero__footer",
        "required": false,
        "description": "Badges und Kennzahlen unter den Aktionen."
      },
      {
        "name": "cards",
        "selector": ".nc-hero__cards",
        "required": false,
        "description": "Kennzahlen-Raster. Nutzt .nc-metric, kein eigenes Bauteil."
      },
      {
        "name": "mark",
        "selector": ".nc-hero__mark",
        "required": false,
        "description": "Hervorhebung INNERHALB der Ueberschrift. Nicht zu verwechseln mit .nc-hero__highlight, dem Eintrag der Merkmalsliste."
      }
    ],
    "notes": [
      "Grid: 2-Spalten ab 768px (split: 50/50 buendig). Content: text-inverse, gap 1rem.",
      "Title: fs-4xl, max-width 18ch fuer optimale Scanbarkeit.",
      "Highlights: Bullet-Liste mit accent-Punkt, line-height: tight fuer visuellen Zusammenhalt zum Titel.",
      "Card-Variante: radial-gradient dark BG, radius-3xl, Metric + Pulse-Animation.",
      "Picture-Variante: radius-sm, elevation-overlay. Overlay-Gradient sichert Kontrast unabhaengig vom Bildinhalt.",
      "Kicker: <p class='nc-hero__kicker'> ueber dem Titel. Token-gesteuert: --nc-hero-kicker-bg, -color, -size, -weight, -radius, -padding. Kein nc-label — eigenstaendiges Element.",
      "Subtitle: <p class='nc-hero__subtitle'> unter dem Titel. Token-gesteuert: --nc-hero-subtitle-size, -color, -max-width, -line-height.",
      "Overlay: <div class='nc-hero__overlay'> mit linear-gradient. Sichtbarkeit via --nc-hero-overlay-visible (1/0).",
      "Actions: Flex-Row mit gap, primaerer + sekundaerer Button. Alignment folgt der alignment-Achse.",
      "Breadcrumb: nc-breadcrumb am oberen Content-Rand, nur sichtbar wenn Slot befuellt.",
      "Centered: Alle Inhalte text-align center, max-width fuer Titel und Highlights.",
      "Split: Content links, Media rechts buendig (kein Radius), nahtlose Kante zum naechsten Abschnitt."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — picture, mockup, split",
      "values": [
        {
          "value": "picture",
          "cssModifier": null,
          "default": false,
          "label": "picture"
        },
        {
          "value": "split",
          "cssModifier": "nc-hero--split",
          "default": false,
          "label": "split"
        },
        {
          "value": "mockup",
          "cssModifier": null,
          "default": false,
          "label": "mockup"
        }
      ]
    },
    "alignment": {
      "label": "Alignment",
      "description": "Content-Ausrichtung — start (default) oder center",
      "values": [
        {
          "value": "start",
          "cssModifier": null,
          "default": false,
          "label": "start"
        },
        {
          "value": "center",
          "cssModifier": "nc-hero--center",
          "default": false,
          "label": "center"
        }
      ]
    },
    "surface": {
      "label": "Surface",
      "description": "Flaeche und Vordergrund als PAAR. Kommt aus dem projektweiten Feld field_surface. accent (Lime) wird bewusst nicht bedient und faellt auf dark zurueck.",
      "values": [
        {
          "value": "dark",
          "cssModifier": "nc-hero--surface-dark",
          "default": false,
          "label": "dark"
        },
        {
          "value": "muted",
          "cssModifier": "nc-hero--surface-muted",
          "default": false,
          "label": "muted"
        },
        {
          "value": "light",
          "cssModifier": "nc-hero--surface-light",
          "default": false,
          "label": "light"
        }
      ]
    },
    "mediaPosition": {
      "label": "Media Position",
      "description": "Auf welcher Seite das Medium steht. Der Inhalt bleibt im Markup zuerst; die Umstellung laeuft ueber order, nicht ueber die Quellreihenfolge.",
      "values": [
        {
          "value": "end",
          "cssModifier": null,
          "default": false,
          "label": "end"
        },
        {
          "value": "start",
          "cssModifier": "nc-hero--media-start",
          "default": false,
          "label": "start"
        }
      ]
    },
    "markStyle": {
      "label": "Headline Mark",
      "description": "Hervorhebung in der Ueberschrift. Balken faerbt eine Flaeche hinter dem Text und laesst den Kontrast unangetastet; Tinte faerbt den Text selbst und braucht deshalb einen zur Flaeche passenden Wert.",
      "values": [
        {
          "value": "bar",
          "cssModifier": null,
          "default": false,
          "label": "bar"
        },
        {
          "value": "tint",
          "cssModifier": "nc-hero--mark-tint",
          "default": false,
          "label": "tint"
        }
      ]
    },
    "badgesPosition": {
      "label": "Badges Position",
      "description": "Badge-Zeile ueber der Ueberschrift oder im Fuss unter den Aktionen. Vorgabe bleibt top, damit bestehende Seiten sich nicht verschieben.",
      "values": [
        {
          "value": "top",
          "cssModifier": null,
          "default": false,
          "label": "top"
        },
        {
          "value": "bottom",
          "cssModifier": null,
          "default": false,
          "label": "bottom"
        }
      ]
    },
    "cardsAlign": {
      "label": "Ausrichtung der Kennzahlen",
      "description": "Getrennt von der Ausrichtung des Heroes: Ein zentrierter Hero kann linksbuendige Kennzahlen tragen und umgekehrt.",
      "values": [
        {
          "value": "start",
          "cssModifier": "nc-hero__cards--start",
          "default": false,
          "label": "start"
        },
        {
          "value": "center",
          "cssModifier": "nc-hero__cards--center",
          "default": false,
          "label": "center"
        },
        {
          "value": "end",
          "cssModifier": "nc-hero__cards--end",
          "default": false,
          "label": "end"
        }
      ]
    },
    "cardsRule": {
      "label": "Trennlinien der Kennzahlen",
      "description": "Staerke und Farbe. Die Linie gliedert nur und kennzeichnet kein Bedienelement — 1.4.11 greift dort nicht, deshalb ist Lime hier zulaessig, wo es als Schriftfarbe unbrauchbar waere.",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-hero__cards--rule-sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": "nc-hero__cards--rule-md",
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-hero__cards--rule-lg",
          "default": false,
          "label": "lg"
        },
        {
          "value": "accent",
          "cssModifier": "nc-hero__cards--rule-accent",
          "default": false,
          "label": "accent"
        }
      ]
    },
    "cardsSurface": {
      "label": "Flaeche der Kennzahlen-Karten",
      "description": "Gewaehlt wird eine ROLLE, keine Farbe — die Werte folgen dem Thema. Mit gesetzter Flaeche wechselt auch die Schriftfarbe: Sie kommt dann aus den Thementoken statt vom Hero, sonst stuende weisse Schrift auf einer weissen Karte.",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "base",
          "cssModifier": "nc-hero__cards--bg-base",
          "default": false,
          "label": "base"
        },
        {
          "value": "secondary",
          "cssModifier": "nc-hero__cards--bg-secondary",
          "default": false,
          "label": "secondary"
        },
        {
          "value": "tertiary",
          "cssModifier": "nc-hero__cards--bg-tertiary",
          "default": false,
          "label": "tertiary"
        },
        {
          "value": "inverse",
          "cssModifier": "nc-hero__cards--bg-inverse",
          "default": false,
          "label": "inverse"
        }
      ]
    }
  },
