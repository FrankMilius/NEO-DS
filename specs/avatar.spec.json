  "a11y": {
    "role": null,
    "interactive": false,
    "contrastTarget": "WCAG AA non-text (3:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "decorator": [
              "badge-online",
              "badge-offline",
              "badge-busy",
              "badge-away"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Badge ist aria-hidden='true'. Status muss im aria-label des Avatars kommuniziert werden (z.B. 'Max Mustermann, online')."
      },
      {
        "when": {
          "axes": {
            "content": [
              "icon"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Icon-Fallback ist rein dekorativ. aria-label auf dem Avatar-Container ist Pflicht."
      },
      {
        "when": {
          "axes": {
            "interactive": [
              "link",
              "button"
            ]
          }
        },
        "require": [
          "hasAccessibleName",
          "supportsKeyboard"
        ],
        "suggest": [],
        "note": "Interactive Avatare (<a> oder <button>) muessen fokussierbar und per Tastatur bedienbar sein."
