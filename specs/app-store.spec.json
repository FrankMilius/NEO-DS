{
  "$schema": "../data/component-spec-schema.json",
  "component": "app-store",
  "version": "1.1.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "media",
    "app",
    "app-store"
  ],
  "anatomy": {
    "rootElement": ".nc-app-store",
    "slots": [
      {
        "name": "badges",
        "selector": ".nc-app-store__badges",
        "required": false,
        "description": "Store-Abzeichen. Ein leeres Adressfeld blendet sein Abzeichen aus — ein toter Verweis ist schlimmer als ein fehlender."
      },
      {
        "name": "qr",
        "selector": ".nc-app-store__qr",
        "required": false,
        "description": "QR-Code. Erst ab md sichtbar: Wer die Seite auf dem Telefon liest, braucht keinen Code, um aufs Telefon zu kommen."
      },
      {
        "name": "note",
        "selector": ".nc-app-store__note",
        "required": false,
        "description": "Kleingedrucktes — Voraussetzungen, Groesse, Sprachen."
      }
    ],
    "notes": [
      "Die Abzeichen sind KEINE Nachbauten der Marken von Apple und Google. Beide geben eigene Bilddateien und Gestaltungsvorgaben vor; bis die vorliegen, steht hier eine Schaltflaeche im Systemstil.",
      "Der QR-Code wird als Bild erwartet, nicht im Browser gerechnet — eine QR-Bibliothek waere ein weiteres Skript fuer etwas, das sich einmal erzeugen laesst."
    ]
  },
  "api": null,
  "variants": {
    "surface": {
      "label": "Flaeche",
      "description": null,
      "values": [
        {
          "value": "light",
          "cssModifier": null,
          "default": false,
          "label": "light"
        },
        {
          "value": "dark",
          "cssModifier": "nc-app-store--on-dark",
          "default": false,
          "label": "dark"
        }
      ]
    },
    "align": {
      "label": "Ausrichtung",
      "description": null,
      "values": [
        {
          "value": "start",
          "cssModifier": null,
          "default": false,
          "label": "start"
        },
        {
          "value": "center",
          "cssModifier": "nc-app-store--center",
          "default": false,
          "label": "center"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "interactive": null,
