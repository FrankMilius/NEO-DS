        {
          "value": "horizontal",
          "cssModifier": null,
          "default": false,
          "label": "horizontal"
        }
      ]
    },
    "progress": {
      "label": "Progress",
      "description": "off = statische Linie. scroll = Linie fuellt sich beim Scrollen, Items blenden ein. Bei prefers-reduced-motion und ohne JS ist alles sofort sichtbar.",
      "values": [
        {
          "value": "off",
          "cssModifier": null,
          "default": true,
          "label": "off"
        },
        {
          "value": "scroll",
          "cssModifier": null,
          "default": false,
          "label": "scroll"
        }
      ]
    },
    "cardTone": {
      "label": "Card Status Tone",
