  "keyboard": {
    "Tab": {
      "action": "sequential-focus",
      "note": "Durch alle Links und Ausloeser der obersten Ebene (jeder eine Tab-Station), vom offenen Ausloeser in sein Panel. Verlaesst der Fokus das offene Item oder das Menue, schliesst das Panel."
    },
    "Enter": {
      "action": "toggle",
      "note": "Auf einem Ausloeser: oeffnet bzw. schliesst sein Panel (nativer Klick), der Fokus bleibt; ein anderes offenes Panel schliesst. Auf Links: folgt dem Link."
    },
    "Space": {
      "action": "toggle",
      "note": "Auf einem Ausloeser wie Enter."
    },
    "Escape": {
      "action": "close",
      "note": "Schliesst das offene Panel, Fokus auf dessen Ausloeser (vom Ausloeser oder aus dem Panel)."
    },
    "ArrowRight": {
      "action": "focus-next-top-item",
      "note": "Optional (APG): naechster Eintrag der obersten Ebene (rundum). Das Panel bleibt, wie es ist — verlaesst der Fokus das offene Item, schliesst es."
    },
    "ArrowLeft": {
      "action": "focus-prev-top-item",
      "note": "Optional: wie ArrowRight, rueckwaerts."
    },
    "ArrowDown": {
      "action": "open-or-focus-next",
      "note": "Optional: auf einem Ausloeser oeffnet es das Panel und fokussiert den ersten Link darin; im Panel naechster Link (rundum)."
    },
    "ArrowUp": {
      "action": "focus-prev",
      "note": "Optional: im Panel vorheriger Link (rundum)."
    },
    "Home": {
      "action": "focus-first",
      "note": "Optional: erster Eintrag der obersten Ebene bzw. erster Link im Panel."
    },
    "End": {
      "action": "focus-last",
      "note": "Optional: letzter Eintrag der obersten Ebene bzw. letzter Link im Panel."
    }
  },
  "testSelectors": null,
  "events": {
    "navigation-menu-change": {
      "bubbles": true,
      "detail": {
        "value": "string",
        "previousValue": "string"
      },
      "note": "Gefeuert wenn ein Panel oeffnet, wechselt oder schliesst (Klick, Tastatur, Hover, Escape, Fokusverlust, Klick ausserhalb). value: Name des offenen Panels (Text des Ausloesers), null wenn alle zu. Ein Wechsel ist ein Ereignis (value = neues, previousValue = altes Panel)."
    }
  },
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
