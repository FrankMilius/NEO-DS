{
  "$schema": "../data/component-spec-schema.json",
  "component": "navigation-menu",
  "version": "3.0.1",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "navigation",
    "interactive",
    "dropdown",
    "mega-menu"
  ],
  "anatomy": {
    "rootElement": ".nc-navigation-menu",
    "slots": [
      {
        "name": "list",
        "selector": ".nc-navigation-menu__list",
        "required": true,
        "description": null
      },
      {
        "name": "item",
        "selector": ".nc-navigation-menu__item",
        "required": true,
        "description": null
      },
      {
        "name": "trigger",
        "selector": ".nc-navigation-menu__trigger",
        "required": false,
        "description": null
      },
      {
        "name": "content",
        "selector": ".nc-navigation-menu__content",
        "required": false,
        "description": null
      },
      {
        "name": "link",
        "selector": ".nc-navigation-menu__link",
        "required": false,
        "description": null
      },
      {
        "name": "featured",
        "selector": ".nc-navigation-menu__featured",
        "required": false,
        "description": null
      },
      {
        "name": "callout",
        "selector": ".nc-navigation-menu__callout",
        "required": false,
        "description": null
      },
      {
        "name": "indicator",
        "selector": ".nc-navigation-menu__indicator",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "WAI-ARIA Disclosure-Navigation: nav[aria-label] > ul > li > button[aria-expanded][aria-controls] + Panel (.nc-navigation-menu__content#id) bzw. a.nc-navigation-menu__link--top.",
      "Keine Rollen menubar/menu/menuitem/none, kein roving tabindex — jeder Top-Level-Eintrag ist eine Tab-Station.",
      "Zu: Panel mit [hidden], aria-expanded='false'. Offen: aria-expanded='true', Panel ohne [hidden]; das SCSS zeigt es unter der Leiste in voller Breite der Wurzel.",
      "Aktuelle Seite: aria-current='page' am Link; enthaelt ein Panel die aktuelle Seite, zeigt sein Ausloeser den Unterstrich dauerhaft (alternativ data-current='true').",
      "Indicator: dekorativer Unterstrich/Pfeil, data-state='visible|hidden', Lage per Custom Property --_indicator-left/--_indicator-width.",
      "Mega-Menu: --mega Modifier am Panel, Grid mit konfigurierbaren Spalten (default 3).",
      "Featured Item: Grafischer Highlight-Slot, volle Breite im Grid (grid-column: 1 / -1).",
      "Callout: Highlight-Bereich (linke Spalte, Gradient-BG) im Layout two-col.",
      "Trigger-Mode: data-trigger='hover' (Desktop) vs 'click' (Touch/komplexe Menus)."
    ]
  },
  "api": null,
  "variants": {
    "layout": {
      "label": "Layout",
      "description": "Content-Layout — default (einfache Liste), two-col (2 Spalten mit Callout), mega (Grid-Layout)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "two-col",
          "cssModifier": "nc-navigation-menu__content--two-col",
          "default": false,
          "label": "two-col"
        },
        {
          "value": "mega",
          "cssModifier": "nc-navigation-menu__content--mega",
          "default": false,
          "label": "mega"
        }
      ]
    },
    "trigger": {
      "label": "Trigger Mode",
      "description": "Ausloeser — hover (Desktop, schnell), click (Touch, sicher fuer komplexe Menus)",
      "values": [
        {
          "value": "hover",
          "cssModifier": null,
          "default": false,
          "label": "hover"
        },
        {
          "value": "click",
          "cssModifier": null,
          "default": false,
          "label": "click"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "focus",
      "open"
    ],
    "interactive": true,
    "rules": [
