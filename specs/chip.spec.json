{
  "$schema": "../data/component-spec-schema.json",
  "component": "chip",
  "version": "2.0.0",
  "status": "stable",
  "layer": "atom",
  "tags": [
    "interactive",
    "filter",
    "selection",
    "toggle"
  ],
  "anatomy": {
    "rootElement": ".nc-chip",
    "slots": [
      {
        "name": "icon",
        "selector": ".nc-chip__icon",
        "required": false,
        "description": null
      },
      {
        "name": "avatar",
        "selector": ".nc-chip__avatar",
        "required": false,
        "description": null
      },
      {
        "name": "label",
        "selector": ".nc-chip__label",
        "required": true,
        "description": null
      },
      {
        "name": "count",
        "selector": ".nc-chip__count",
        "required": false,
        "description": null
      },
      {
        "name": "remove",
        "selector": ".nc-chip__remove",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Chip ist immer ein <button> — interaktiv, toggled Filter.",
      "Toggle-State via aria-pressed='true|false' (NICHT aria-selected).",
      "Selected-State via .nc-chip--selected UND/ODER aria-pressed='true'.",
      "Icon-Slot links (dekorativ, aria-hidden='true'). Avatar-Slot links (rundes Bild).",
      "Count-Badge (__count): Numerisches Badge im Chip (z.B. 'Inland (12)').",
      "Remove-Button (__remove) ist ein separater <button> mit aria-label='Entfernen'.",
      "SM-Chips (24px) haben 44px Touch-Target via unsichtbares ::before Pseudo-Element.",
      "Transparente Border im Default-State reserviert Platz — kein Layout-Shift bei Selektion.",
      "font-weight bleibt konstant ueber alle States (kein Sprung bei Bold-Wechsel).",
      "Chip-Group (.nc-chip-group) ist ein flex-wrap Container mit gap.",
      "Chip-Group--scroll hat nowrap + overflow-x: auto + versteckte Scrollbar.",
      "Avatar-Element hat reduziertes Padding-Start fuer buendigen Abschluss mit Chip-Rundung.",
      "Choice-Gruppen: role='radiogroup' (single) oder role='group' (multiple) mit aria-label."
    ]
  },
  "api": null,
  "variants": {
    "size": {
      "label": "Size",
      "description": "3 Groessenabstufungen — sm (24px, 44px Touch-Target) / md (32px, Standard) / lg (40px)",
      "values": [
        {
          "value": "sm",
          "cssModifier": "nc-chip--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-chip--lg",
          "default": false,
          "label": "lg"
        }
      ]
    },
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — filled (Standard, transparent BG + Border), outline (explizit), ghost (keine Border, dezent fuer Dashboards)",
      "values": [
        {
          "value": "filled",
          "cssModifier": null,
          "default": false,
          "label": "filled"
        },
        {
          "value": "outline",
          "cssModifier": "nc-chip--outline",
          "default": false,
          "label": "outline"
        },
        {
          "value": "ghost",
          "cssModifier": "nc-chip--ghost",
          "default": false,
          "label": "ghost"
        }
      ]
    },
    "content": {
      "label": "Content",
      "description": "Inhalt-Typ — text-only, mit Icon, mit Avatar, mit Remove-Button, mit Count-Badge",
      "values": [
        {
          "value": "text",
          "cssModifier": null,
          "default": false,
          "label": "text"
        },
        {
          "value": "with-icon",
          "cssModifier": null,
          "default": false,
          "label": "with-icon"
        },
        {
          "value": "with-avatar",
          "cssModifier": null,
          "default": false,
          "label": "with-avatar"
        },
        {
          "value": "with-count",
          "cssModifier": null,
          "default": false,
          "label": "with-count"
        },
        {
          "value": "removable",
          "cssModifier": null,
          "default": false,
          "label": "removable"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "hover",
      "selected",
      "disabled",
      "focus"
    ],
    "interactive": true,
    "rules": [
      {
        "state": "hover",
        "effects": [],
        "attributes": {},
