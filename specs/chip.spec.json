  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "states": [
            "selected"
          ]
        },
        "require": [
          "aria-pressed"
        ],
        "suggest": [],
        "note": "Selected braucht aria-pressed='true'. Deselected: aria-pressed='false'. NICHT aria-selected verwenden."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' bevorzugt wenn Chip noch sichtbar bleiben soll."
      },
      {
        "when": {
          "axes": {
            "content": [
              "removable"
            ]
          }
        },
        "require": [
          "aria-label-remove"
        ],
        "suggest": [],
        "note": "Remove-Button braucht aria-label='Entfernen' oder aehnlich."
      },
      {
        "when": {
          "axes": {
            "content": [
              "with-count"
            ]
          }
        },
        "require": [],
        "suggest": [
          "aria-describedby"
        ],
        "note": "Count-Badge kann per aria-describedby mit dem Chip verknuepft werden fuer Screen-Reader-Kontext."
      }
    ]
