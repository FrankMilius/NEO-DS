{
  "$schema": "../data/component-spec-schema.json",
  "component": "item",
  "version": "2.1.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "display",
    "content",
    "list",
    "media-object"
  ],
  "anatomy": {
    "rootElement": ".nc-item",
    "slots": [
      {
        "name": "media",
        "selector": ".nc-item__media",
        "required": false,
        "description": null
      },
      {
        "name": "content",
        "selector": ".nc-item__content",
        "required": true,
        "description": null
      },
      {
        "name": "title",
        "selector": ".nc-item__title",
        "required": true,
        "description": null
      },
      {
        "name": "description",
        "selector": ".nc-item__description",
        "required": false,
        "description": null
      },
      {
        "name": "meta",
        "selector": ".nc-item__meta",
        "required": false,
        "description": null
      },
      {
        "name": "actions",
        "selector": ".nc-item__actions",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Flex-Layout: align-items center (oder flex-start via --align-start), gap spacing-03.",
      "Grid-basierte Content-Struktur: title (bold, text-primary) + description (text-secondary).",
      "Left-Accent-Border via ::before Pseudo-Element (2px, interactive-Farbe) bei Hover/Active/Selected.",
      "Density: compact (spacing-01/02), default (spacing-03/04), loose (spacing-04/05).",
      "Thumbnail: 16:9 Aspect-Ratio, konfigurierbarer Breite (120px default).",
      "Meta-Slot: Inline-flex rechts neben Content, fuer Shortcuts/Badges."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Visuelle Variante — default (transparent), outline (Border + Shadow), muted (Hintergrund)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "outline",
          "cssModifier": "nc-item--outline",
          "default": false,
          "label": "outline"
        },
        {
          "value": "muted",
          "cssModifier": "nc-item--muted",
          "default": false,
          "label": "muted"
        }
      ]
    },
    "size": {
      "label": "Size",
      "description": "Groesse — default, sm, xs",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "sm",
          "cssModifier": "nc-item--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "xs",
          "cssModifier": "nc-item--xs",
          "default": false,
          "label": "xs"
        }
      ]
    },
    "density": {
      "label": "Density",
      "description": "Informationsdichte — compact (wenig Platz), default (ausgewogen), loose (viel Platz)",
      "values": [
        {
          "value": "compact",
          "cssModifier": "nc-item--compact",
          "default": false,
          "label": "compact"
        },
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "loose",
          "cssModifier": "nc-item--loose",
          "default": false,
          "label": "loose"
        }
      ]
    },
    "alignment": {
      "label": "Alignment",
      "description": "Vertikale Ausrichtung — center (zentriert), start (oben)",
      "values": [
        {
          "value": "center",
          "cssModifier": null,
          "default": false,
          "label": "center"
        },
        {
          "value": "start",
          "cssModifier": "nc-item--align-start",
          "default": false,
          "label": "start"
        }
      ]
    },
    "media": {
      "label": "Media",
      "description": "Media-Typ — none, icon, image, avatar, thumbnail (16:9)",
      "values": [
        {
          "value": "none",
          "cssModifier": null,
          "default": false,
          "label": "none"
        },
        {
          "value": "icon",
          "cssModifier": "nc-item__media--icon",
          "default": false,
          "label": "icon"
        },
        {
          "value": "image",
          "cssModifier": "nc-item__media--image",
          "default": false,
          "label": "image"
        },
        {
          "value": "avatar",
          "cssModifier": "nc-item__media--avatar",
          "default": false,
          "label": "avatar"
        },
        {
          "value": "thumbnail",
          "cssModifier": "nc-item__media--thumbnail",
          "default": false,
          "label": "thumbnail"
        }
      ]
    }
  },
