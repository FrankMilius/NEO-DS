{
  "$schema": "../data/component-spec-schema.json",
  "component": "navigation",
  "version": "2.0.0",
  "status": "stable",
  "layer": "organism",
  "tags": [
    "navigation",
    "interactive",
    "layout",
    "header"
  ],
  "anatomy": {
    "rootElement": ".nc-header",
    "slots": [
      {
        "name": "nav",
        "selector": ".nc-nav",
        "required": true,
        "description": null
      },
      {
        "name": "inner",
        "selector": ".nc-nav__inner",
        "required": true,
        "description": null
      },
      {
        "name": "brand",
        "selector": ".nc-brand",
        "required": true,
        "description": null
      },
      {
        "name": "list",
        "selector": ".nc-nav__list",
        "required": false,
        "description": null
      },
      {
        "name": "actions",
        "selector": ".nc-nav__actions",
        "required": false,
        "description": null
      },
      {
        "name": "navigation-menu",
        "selector": ".nc-navigation-menu",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "nc-header: sticky top, backdrop-filter blur, bg-base 90% opacity, border-bottom.",
      "nc-nav: full-width, font-size base. Inner: flex, space-between, align-items center, gap.",
      "Transparent: Kein Hintergrund, weisse Schrift — ideal ueber Hero-Images auf Landingpages.",
      "Solid: Voller Hintergrund ohne Blur — besser fuer Performance und einfache Layouts.",
      "Intelligent Sticky: is-hidden beim Runterscrollen (mehr Content-Platz), is-scrolled beim Hochscrollen.",
      "Alignment: --align-center zentriert Links (Landingpage), --align-right rechtsbuendig.",
      "Mobile: Hamburger-Toggle oeffnet nc-drawer mit vertikal gestapelten Links.",
      "Lage: unter lg Mobil-Lage (Burger), ab lg Desktop-Lage (Liste, Aktionen). --mobile (an nc-header) haelt die Mobil-Lage auf jeder Fensterbreite, auch das Navigationsmenue bleibt aus."
    ]
  },
  "api": null,
  "variants": {
    "emphasis": {
      "label": "Emphasis",
      "description": "Visueller Modus — default (Blur 90%), transparent (Hero-Overlay), solid (voller Hintergrund)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "transparent",
          "cssModifier": "nc-header--transparent",
          "default": false,
          "label": "transparent"
        },
        {
          "value": "solid",
          "cssModifier": "nc-header--solid",
          "default": false,
          "label": "solid"
        }
      ]
    },
    "alignment": {
      "label": "Alignment",
      "description": "Ausrichtung der Links — start (links), center (zentriert), right (rechts)",
      "values": [
        {
          "value": "start",
          "cssModifier": null,
          "default": false,
          "label": "start"
        },
        {
          "value": "center",
          "cssModifier": "nc-nav--align-center",
          "default": false,
          "label": "center"
        },
        {
          "value": "right",
          "cssModifier": "nc-nav--align-right",
          "default": false,
          "label": "right"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default",
      "scrolled",
      "hidden"
    ],
    "interactive": true,
    "rules": [
      {
        "state": "scrolled",
        "effects": [],
        "attributes": {},
        "description": null
      },
      {
        "state": "hidden",
        "effects": [],
        "attributes": {},
        "description": null
      }
    ]
  },
  "cssApi": {
    "baseClasses": [
      "nc-header"
    ],
    "tokenGroups": {
