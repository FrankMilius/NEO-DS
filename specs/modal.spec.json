  "keyboard": {
    "Escape": {
      "action": "close",
      "note": "Schliesst den Modal-Dialog."
    },
    "Tab": {
      "action": "trap-focus",
      "note": "Focus bleibt innerhalb des Modals (Focus Trap)."
    },
    "Shift+Tab": {
      "action": "trap-focus-reverse",
      "note": "Rueckwaerts-Navigation innerhalb des Focus Trap."
    }
  },
  "testSelectors": {
    "root": "[data-testid='modal']",
    "overlay": "[data-testid='modal-overlay']",
    "content": "[data-testid='modal-content']",
    "close": "[data-testid='modal-close']",
    "header": "[data-testid='modal-header']",
    "body": "[data-testid='modal-body']",
    "footer": "[data-testid='modal-footer']"
  },
  "events": {
    "modal-open": {
      "bubbles": true,
      "note": "Gefeuert wenn der Modal geoeffnet wird."
    },
    "modal-close": {
      "bubbles": true,
      "detail": {
        "reason": "string"
      },
      "note": "Gefeuert beim Schliessen. Reason: 'escape', 'overlay-click', 'close-button', 'programmatic'."
    }
  },
  "a11y": {
    "role": null,
    "interactive": true,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [
      "hasAccessibleName",
      "supportsKeyboard"
    ],
    "overrides": [
      {
        "when": {
          "axes": {
            "intent": [
              "danger"
            ]
          }
        },
        "require": [],
        "suggest": [],
        "note": "Danger-Modal: Primaere Action (z.B. 'Loeschen') muss Label klar benennen. Farbe allein ist kein Signal. Optional: autofocus auf Cancel statt Confirm."
      },
      {
        "when": {
          "axes": {
            "content": [
              "scrollable"
            ]
          }
        },
        "require": [],
        "suggest": [],
        "note": "Scrollable: Sticky Header/Footer informieren visuell via Border-Erscheinung. Kein A11y-Impact — Scroll ist nativ per Tastatur."
      }
    ]
  },
