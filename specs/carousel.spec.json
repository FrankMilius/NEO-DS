{
  "$schema": "../data/component-spec-schema.json",
  "component": "carousel",
  "version": "1.1.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "layout",
    "media",
    "carousel"
  ],
  "anatomy": {
    "rootElement": ".nc-carousel",
    "slots": [
      {
        "name": "track",
        "selector": ".nc-carousel__track",
        "required": true,
        "description": "Waagerechte Spur mit scroll-snap. Jedes direkte Kind rastet am Anfang ein."
      },
      {
        "name": "controls",
        "selector": ".nc-carousel__controls",
        "required": false,
        "description": "Blaetter-Schaltflaechen, rechtsbuendig unter der Spur."
      }
    ],
    "notes": [
      "Die Spur ist ein Grid mit grid-auto-flow: column — die Elemente stehen nebeneinander, unabhaengig von ihrer Zahl.",
      "Spaltenbreite minmax(360px, 1fr), unter 720px minmax(260px, 85vw). Der angeschnittene Rest der naechsten Karte zeigt, dass es weitergeht.",
      "scroll-snap-type: x mandatory am Track, scroll-snap-align: start an den Kindern."
    ]
  },
  "api": null,
  "variants": {
    "media": {
      "label": "Medien-Variante",
      "description": "Fuer randlose Inhalte: nimmt die Polsterung heraus und gibt die Spaltenbreite frei, statt sie auf 360px zu zwingen.",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "media",
          "cssModifier": "nc-carousel--media",
          "default": false,
          "label": "media"
        }
      ]
    },
    "controls": {
      "label": "Steuerung",
      "description": "Blaetter-Knoepfe (.nc-carousel__controls) — Zugabe, kein Ersatz fuer die bedienbare Spur.",
      "values": [
        {
          "value": "with",
          "cssModifier": null,
          "default": false,
          "label": "with"
        },
        {
          "value": "without",
          "cssModifier": null,
          "default": false,
          "label": "without"
        }
      ]
    }
  },
  "states": {
    "supported": [
      "default"
    ],
    "interactive": null,
    "rules": []
  },
  "cssApi": {
    "baseClasses": [
      "nc-carousel"
    ],
    "tokenGroups": {
      "Layout": []
    },
    "modTokens": []
  },
  "keyboard": null,
  "testSelectors": null,
  "events": null,
  "a11y": {
    "role": null,
    "interactive": null,
    "contrastTarget": null,
    "focusIndicator": null,
