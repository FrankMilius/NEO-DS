          "label": "with-arrow"
        },
        {
          "value": "form",
          "cssModifier": null,
          "default": false,
          "label": "form"
        }
      ]
    },
    "trigger": {
      "label": "Trigger",
      "description": "Interaktionsmodus — click (Standard: Toggle bei Klick), hover (oeffnet nach 300ms Delay, nur fuer nicht-interaktive Vorschau)",
      "values": [
        {
          "value": "click",
          "cssModifier": null,
          "default": false,
          "label": "click"
        },
        {
          "value": "hover",
          "cssModifier": "nc-popover--hover-trigger",
          "default": false,
          "label": "hover"
        }
      ]
    }
  },
