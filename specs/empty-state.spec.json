{
  "$schema": "../data/component-spec-schema.json",
  "component": "empty-state",
  "version": "1.0.0",
  "status": "stable",
  "layer": "molecule",
  "tags": [
    "feedback",
    "layout",
    "placeholder"
  ],
  "anatomy": {
    "rootElement": ".nc-empty-state",
    "slots": [
      {
        "name": "icon",
        "selector": ".nc-empty-state__icon",
        "required": false,
        "description": null
      },
      {
        "name": "title",
        "selector": ".nc-empty-state__title",
        "required": true,
        "description": null
      },
      {
        "name": "description",
        "selector": ".nc-empty-state__description",
        "required": false,
        "description": null
      },
      {
        "name": "actions",
        "selector": ".nc-empty-state__actions",
        "required": false,
        "description": null
      }
    ],
    "notes": [
      "Flex-Column-Container, zentriert (align-items + text-align: center).",
      "max-width: 400px + margin-inline: auto — begrenzt die Breite und zentriert horizontal.",
      "Icon: grosses dekoratives SVG (64px Standard), stroke-basiert, aria-hidden='true'.",
      "Title: Heading (h2/h3 je nach Kontext), font-heading Familie.",
      "Description: sekundaere Farbe, max-width via prose-max-width fuer Lesbarkeit.",
      "Actions: Flex-Row mit gap fuer Button(s), margin-top fuer Abstand.",
      "Compact-Modifier: reduziertes Padding (spacing-06), kleinere Icon/Title/Desc Groessen.",
      "Full-Modifier: min-height: 100% — fuellt den gesamten Container."
    ]
  },
  "api": null,
  "variants": {
    "variant": {
      "label": "Variant",
      "description": "Groessen-Variante — default (grosszuegiges Padding, grosse Elemente), compact (weniger Padding, kleinere Elemente)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "compact",
          "cssModifier": "nc-empty-state--compact",
          "default": false,
          "label": "compact"
        }
      ]
    },
    "height": {
      "label": "Height",
      "description": "Hoehen-Verhalten — auto (natuerliche Hoehe), full (fuellt Container, min-height: 100%)",
      "values": [
        {
          "value": "auto",
          "cssModifier": null,
          "default": false,
          "label": "auto"
        },
        {
          "value": "full",
          "cssModifier": "nc-empty-state--full",
          "default": false,
          "label": "full"
        }
      ]
    },
    "content": {
      "label": "Content",
      "description": "Inhaltskombination — minimal (nur Title), with-description (Title + Beschreibung), with-action (Title + Beschreibung + Button), full (Icon + Title + Beschreibung + Button)",
      "values": [
        {
          "value": "minimal",
          "cssModifier": null,
          "default": false,
          "label": "minimal"
        },
        {
          "value": "with-description",
          "cssModifier": null,
          "default": false,
          "label": "with-description"
        },
        {
          "value": "with-action",
          "cssModifier": null,
          "default": false,
          "label": "with-action"
        },
        {
          "value": "full",
          "cssModifier": null,
          "default": false,
          "label": "full"
        }
      ]
    }
  },
