    "interactive": false,
    "contrastTarget": "WCAG AA normal text (4.5:1)",
    "focusIndicator": null,
    "assertions": [],
    "overrides": [
      {
        "when": {
          "axes": {
            "interactive": [
              "interactive"
            ]
          }
        },
        "require": [
          "hasAccessibleName",
          "supportsKeyboard"
        ],
        "suggest": [],
        "note": "Interactive Tags (<a> oder <button>) muessen fokussierbar und per Tastatur bedienbar sein."
      },
      {
        "when": {
          "axes": {
            "content": [
              "removable"
            ]
          }
        },
        "require": [
          "aria-label"
        ],
        "suggest": [],
        "note": "Remove-Button braucht aria-label (z.B. 'Tag-Name entfernen'). Ist ein eigenstaendiges <button>-Element."
      },
      {
        "when": {
          "states": [
            "disabled"
          ]
        },
        "require": [],
        "suggest": [
          "aria-disabled"
        ],
        "note": "aria-disabled='true' auf dem Tag-Element. pointer-events: none verhindert Klick."
      }
    ]
