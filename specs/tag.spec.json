          "label": "error"
        },
        {
          "value": "info",
          "cssModifier": "nc-tag--info",
          "default": false,
          "label": "info"
        }
      ]
    },
    "content": {
      "label": "Content",
      "description": "Inhalt — text (nur Label), icon-text (Icon + Label), removable (Label + Dismiss-Button)",
      "values": [
        {
          "value": "text",
          "cssModifier": null,
          "default": false,
          "label": "text"
        },
        {
          "value": "icon-text",
          "cssModifier": null,
          "default": false,
          "label": "icon-text"
        },
        {
          "value": "removable",
          "cssModifier": "nc-tag--removable",
          "default": false,
          "label": "removable"
        }
      ]
    },
    "interactive": {
      "label": "Interactive",
      "description": "Interaktivitaet — static (Standard, nicht klickbar), interactive (Hover/Active/Focus mit Shadow fuer Links/Buttons)",
      "values": [
        {
          "value": "static",
          "cssModifier": null,
          "default": false,
          "label": "static"
        },
        {
          "value": "interactive",
          "cssModifier": "nc-tag--interactive",
          "default": false,
          "label": "interactive"
        }
      ]
    },
    "selected": {
      "label": "Selected",
      "description": "Toggle-State fuer Filter-Chips — false (Standard), true (aktiv, aria-pressed)",
      "values": [
        {
          "value": "false",
          "cssModifier": null,
          "default": false,
          "label": "false"
        },
        {
          "value": "true",
          "cssModifier": "nc-tag--selected",
          "default": false,
          "label": "true"
        }
      ]
    }
  },
