  "anatomy": {
    "rootElement": ".nc-spinner",
    "slots": [],
    "notes": [
      "Spinner ist ein <div class='nc-spinner' role='status'> mit ::after Pseudo-Element fuer den rotierenden Ring.",
      "Braucht ein .u-sr-only Kind-Element mit 'Wird geladen...' oder aria-label auf dem Container.",
      "Ring: border-color = Track, border-top-color = Active. Animation: fnd-spin (360° Rotation).",
      "prefers-reduced-motion verlangsamt die Rotation (2s statt 700ms).",
      "Overlay (.nc-spinner-overlay): position:absolute, inset:0, semi-transparenter BG."
    ]
  },
  "api": null,
  "variants": {
    "size": {
      "label": "Size",
      "description": "5 Groessenabstufungen — xs (16px), sm (20px), md (24px, Standard), lg (40px), xl (56px)",
      "values": [
        {
          "value": "xs",
          "cssModifier": "nc-spinner--xs",
          "default": false,
          "label": "xs"
        },
        {
          "value": "sm",
          "cssModifier": "nc-spinner--sm",
          "default": false,
          "label": "sm"
        },
        {
          "value": "md",
          "cssModifier": null,
          "default": false,
          "label": "md"
        },
        {
          "value": "lg",
          "cssModifier": "nc-spinner--lg",
          "default": false,
          "label": "lg"
        },
        {
          "value": "xl",
          "cssModifier": "nc-spinner--xl",
          "default": false,
          "label": "xl"
        }
      ]
    },
    "color": {
      "label": "Color",
      "description": "Farb-Variante — default (interactive), inverse (weiss), success (gruen), danger (rot)",
      "values": [
        {
          "value": "default",
          "cssModifier": null,
          "default": false,
          "label": "default"
        },
        {
          "value": "inverse",
          "cssModifier": "nc-spinner--inverse",
          "default": false,
          "label": "inverse"
        },
        {
          "value": "success",
          "cssModifier": "nc-spinner--success",
          "default": false,
          "label": "success"
        },
        {
          "value": "danger",
          "cssModifier": "nc-spinner--danger",
          "default": false,
          "label": "danger"
        }
      ]
    }
